.io/images/8u2zjhvn/production/c62b871baef624e7b858d10220a71681d64e3b53-3840x1042.webp?w=1600&amp;fit=max&amp;auto=format" srcset="https://cdn.sanity.io/images/8u2zjhvn/production/c62b871baef624e7b858d10220a71681d64e3b53-3840x1042.webp?w=160&amp;fit=max&amp;auto=format 160w, https://cdn.sanity.io/images/8u2zjhvn/production/c62b871baef624e7b858d10220a71681d64e3b53-3840x1042.webp?w=320&amp;fit=max&amp;auto=format 320w, https://cdn.sanity.io/images/8u2zjhvn/production/c62b871baef624e7b858d10220a71681d64e3b53-3840x1042.webp?w=480&amp;fit=max&amp;auto=format 480w, https://cdn.sanity.io/images/8u2zjhvn/production/c62b871baef624e7b858d10220a71681d64e3b53-3840x1042.webp?w=640&amp;fit=max&amp;auto=format 640w, https://cdn.sanity.io/images/8u2zjhvn/production/c62b871baef624e7b858d10220a71681d64e3b53-3840x1042.webp?w=960&amp;fit=max&amp;auto=format 960w, https://cdn.sanity.io/images/8u2zjhvn/production/c62b871baef624e7b858d10220a71681d64e3b53-3840x1042.webp?w=1280&amp;fit=max&amp;auto=format 1280w, https://cdn.sanity.io/images/8u2zjhvn/production/c62b871baef624e7b858d10220a71681d64e3b53-3840x1042.webp?w=1600&amp;fit=max&amp;auto=format 1600w" sizes="8rem" alt="openai logo" width="1600" height="434" loading="lazy" decoding="async" data-astro-cid-7hzkb424></li><li tabindex="0" data-astro-cid-7hzkb424><img src="https://cdn.sanity.io/images/8u2zjhvn/production/64f2df71c3096755b47612b2ef9c2640f0e5e778-3000x2000.avif?w=1600&amp;fit=max&amp;auto=format" srcset="https://cdn.sanity.io/images/8u2zjhvn/production/64f2df71c3096755b47612b2ef9c2640f0e5e778-3000x2000.avif?w=160&amp;fit=max&amp;auto=format 160w, https://cdn.sanity.io/images/8u2zjhvn/production/64f2df71c3096755b47612b2ef9c2640f0e5e778-3000x2000.avif?w=320&amp;fit=max&amp;auto=format 320w, https://cdn.sanity.io/images/8u2zjhvn/production/64f2df71c3096755b47612b2ef9c2640f0e5e778-3000x2000.avif?w=480&amp;fit=max&amp;auto=format 480w, https://cdn.sanity.io/images/8u2zjhvn/production/64f2df71c3096755b47612b2ef9c2640f0e5e778-3000x2000.avif?w=640&amp;fit=max&amp;auto=format 640w, https://cdn.sanity.io/images/8u2zjhvn/production/64f2df71c3096755b47612b2ef9c2640f0e5e778-3000x2000.avif?w=960&amp;fit=max&amp;auto=format 960w, https://cdn.sanity.io/images/8u2zjhvn/production/64f2df71c3096755b47612b2ef9c2640f0e5e778-3000x2000.avif?w=1280&amp;fit=max&amp;auto=format 1280w, https://cdn.sanity.io/images/8u2zjhvn/production/64f2df71c3096755b47612b2ef9c2640f0e5e778-3000x2000.avif?w=1600&amp;fit=max&amp;auto=format 1600w" sizes="8rem" alt="anthropic logo" width="1600" height="1067" loading="lazy" decoding="async" data-astro-cid-7hzkb424></li></ul></div></div></section><section class="content-grid section content-section" data-astro-cid-7wj36s4i><div class="block-inner" data-astro-cid-7wj36s4i><div class="content-layout" data-astro-cid-7yq64bwo><header class="intro" data-astro-cid-7yq64bwo><h2 id="skad-wiedziec-ze-to-dobry-moment-na-wspolprace" data-astro-cid-7yq64bwo>Skąd wiedzieć, że to dobry moment na współpracę?</h2><div class="pt prose flow" data-astro-cid-6amch4or></div></header><ul class="items checklist" data-astro-cid-7yq64bwo><li data-astro-cid-7yq64bwo><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" data-astro-cid-zgufigjl><path d="m5 12 4 4L19 6" data-astro-cid-zgufigjl></path></svg><div class="item-copy" data-astro-cid-7yq64bwo><p class="checklist-title" data-astro-cid-7yq64bwo>Dane o kliencie są rozproszone między CRM, pocztą i dokumentami, excelami.</p></div></li><li data-astro-cid-7yq64bwo><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" data-astro-cid-zgufigjl><path d="m5 12 4 4L19 6" data-astro-cid-zgufigjl></path></svg><div class="item-copy" data-astro-cid-7yq64bwo><p class="checklist-title" data-astro-cid-7yq64bwo>Handlowcy ręcznie przygotowują oferty, raporty i follow-upy, listy potencjalnych klientów, research.</p></div></li><li data-astro-cid-7yq64bwo><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" data-astro-cid-zgufigjl><path d="m5 12 4 4L19 6" data-astro-cid-zgufigjl></path></svg><div class="item-copy" data-astro-cid-7yq64bwo><p class="checklist-title" data-astro-cid-7yq64bwo>Wiedza o skutecznych sposobach pracy zostaje u pojedynczych osób. Każdy sprzedaje inaczej.</p></div></li><li data-astro-cid-7yq64bwo><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" data-astro-cid-zgufigjl><path d="m5 12 4 4L19 6" data-astro-cid-zgufigjl></path></svg><div class="item-copy" data-astro-cid-7yq64bwo><p class="checklist-title" data-astro-cid-7yq64bwo>Nie jesteś w stanie zmierzyć czy zmiany jakie wprowadzasz w sprzedaży są dobre.</p></div></li></ul></div></div></section><section class="content-grid section content-section" data-astro-cid-7wj36s4i><div class="block-inner" data-astro-cid-7wj36s4i><div class="content-layout" data-astro-cid-7yq64bwo><header class="intro" data-astro-cid-7yq64bwo><h2 id="zacznijmy-od-miejsca-ktore-dzis-najbardziej-blokuje-prace-zespolu" data-astro-cid-7yq64bwo>Zacznijmy od miejsca, które dziś najbardziej blokuje pracę zespołu</h2><div class="pt prose flow" data-astro-cid-6amch4or><p data-astro-cid-6amch4or="true">Mogę uporządkować CRM, połączyć używane narzędzia automatyzacjami, wdrożyć agentów AI albo zbudować system pracy w Asana. Poniżej zobaczysz, jaki problem rozwiązuje każda z tych usług i od czego możemy zacząć.</p></div><nav class="inline-links" aria-label="Zacznijmy od miejsca, które dziś najbardziej blokuje pracę zespołu" data-astro-cid-7yq64bwo><a href="#crm" data-astro-cid-7yq64bwo>CRM</a><a href="#ai" data-astro-cid-7yq64bwo>AI dla sprzedaży</a><a href="#automatyzacja" data-astro-cid-7yq64bwo>Automatyzacja</a><a href="#asana" data-astro-cid-7yq64bwo>Asana</a></nav></header></div></div></section><section id="crm" class="content-grid section feature" data-astro-cid-7wj36s4i><div class="block-inner" data-astro-cid-7wj36s4i><div class="feature-layout has-media" data-astro-cid-yr23l7fg><div class="copy" data-astro-cid-yr23l7fg><h2 id="crm-dla-zespolu-sprzedazy" data-astro-cid-yr23l7fg="true">CRM dla zespołu sprzedaży</h2><div class="pt prose flow" data-astro-cid-6amch4or><p data-astro-cid-6amch4or="true">Projektuję proces, konfiguruję Pipedrive, porządkuję dane i szkolę zespół. CRM ma pomagać handlowcom w pracy i dawać managerowi wiarygodny obraz sprzedaży.<br>CRM, który wspiera handlowców i pokazuje prawdziwy stan sprzedaży</p></div><a class="action text" href="/szkolenie-i-wdrozenie-pipedrive" data-astro-cid-j6ocf6pu><span data-astro-cid-j6ocf6pu>Zobacz ofertę wdrożenia Pipedrive</span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" data-astro-cid-zgufigjl><path d="M4 12h16m-6-6 6 6-6 6" data-astro-cid-zgufigjl></path></svg></a></div><figure class="media" data-astro-cid-yr23l7fg><div class="sc" data-diagram="crm-funnel" aria-hidden="true" data-astro-cid-u7yzv347><div class="sc-body" data-astro-cid-u7yzv347><div class="cols" data-astro-cid-u7yzv347><div class="col" data-astro-cid-u7yzv347><div class="head" data-astro-cid-u7yzv347><span class="name" data-astro-cid-u7yzv347>Lead</span><span class="count" data-astro-cid-u7yzv347>3</span></div><ul data-astro-cid-u7yzv347><li data-astro-cid-u7yzv347>Borg</li><li data-astro-cid-u7yzv347>Nexa</li><li data-astro-cid-u7yzv347>Volta</li><li class="slot" data-astro-cid-u7yzv347><span class="deal" data-astro-cid-u7yzv347>Acme</span></li></ul></div><div class="col" data-astro-cid-u7yzv347><div class="head" data-astro-cid-u7yzv347><span class="name" data-astro-cid-u7yzv347>Kwalifikacja</span><span class="count" data-astro-cid-u7yzv347>3</span></div><ul data-astro-cid-u7yzv347><li data-astro-cid-u7yzv347>Helio</li><li data-astro-cid-u7yzv347>Orto</li><li data-astro-cid-u7yzv347>Tera</li><li class="slot" data-astro-cid-u7yzv347><span class="deal" data-astro-cid-u7yzv347>Acme</span></li></ul></div><div class="col" data-astro-cid-u7yzv347><div class="head" data-astro-cid-u7yzv347><span class="name" data-astro-cid-u7yzv347>Oferta</span><span class="count" data-astro-cid-u7yzv347>2</span></div><ul data-astro-cid-u7yzv347><li data-astro-cid-u7yzv347>Juno</li><li data-astro-cid-u7yzv347>Kado</li><li class="slot" data-astro-cid-u7yzv347><span class="deal" data-astro-cid-u7yzv347>Acme</span></li></ul></div><div class="col is-on is-won" data-astro-cid-u7yzv347><div class="head" data-astro-cid-u7yzv347><span class="name" data-astro-cid-u7yzv347>Wygrana</span><span class="count" data-astro-cid-u7yzv347>1</span></div><ul data-astro-cid-u7yzv347><li class="slot is-here" data-astro-cid-u7yzv347><span class="deal" data-astro-cid-u7yzv347>Acme</span></li></ul></div></div><span class="ghost" data-astro-cid-u7yzv347><span class="deal" data-astro-cid-u7yzv347>Acme</span></span><div class="sc-total" data-astro-cid-u7yzv347><span class="sc-total-label" data-astro-cid-u7yzv347>Wartość wygranych</span><span class="sc-total-value" data-total data-astro-cid-u7yzv347>24&nbsp;000&nbsp;€</span></div></div></div><script type="module" src="/_astro/CrmFunnel.astro_astro_type_script_index_0_lang.C-C3mSR1.js"></script></figure></div></div></section><section id="ai" class="content-grid section feature" data-astro-cid-7wj36s4i><div class="block-inner" data-astro-cid-7wj36s4i><div class="feature-layout has-media" data-astro-cid-yr23l7fg><div class="copy" data-astro-cid-yr23l7fg><h2 id="wdrozenie-ai-oparte-na-procesie-i-danych-firmy" data-astro-cid-yr23l7fg="true">Wdrożenie AI oparte na procesie i danych firmy</h2><div class="pt prose flow" data-astro-cid-6amch4or><p data-astro-cid-6amch4or="true">Wybieram powtarzalną pracę, która rzeczywiście zabiera czas: przygotowanie oferty, follow-up, briefing przed spotkaniem albo porządkowanie CRM. Buduję kontekst firmy, łączę agenta z aktualnymi danymi i szkolę zespół na realnych przypadkach.<br>Agenci AI do ofert, follow-upów i briefingu, podłączeni do danych w CRM</p></div><a class="action text" href="/wdrozenie-ai-w-sprzedazy-b2b" data-astro-cid-j6ocf6pu><span data-astro-cid-j6ocf6pu>Dowiedz się więcej o AI dla sprzedaży</span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" data-astro-cid-zgufigjl><path d="M4 12h16m-6-6 6 6-6 6" data-astro-cid-zgufigjl></path></svg></a></div><figure class="media" data-astro-cid-yr23l7fg><div class="sc" data-diagram="zw-ai-sales" aria-hidden="true" data-astro-cid-e7nevnov><div class="sc-body" data-astro-cid-e7nevnov><ol class="rows" data-astro-cid-e7nevnov><li data-row data-astro-cid-e7nevnov><span class="time" data-astro-cid-e7nevnov>08:02</span><span data-astro-cid-e7nevnov>Sprawdził 12 nowych leadów</span><span class="tag" data-astro-cid-e7nevnov>agent</span></li><li data-row data-astro-cid-e7nevnov><span class="time" data-astro-cid-e7nevnov>08:10</span><span data-astro-cid-e7nevnov>Przygotował 4 follow-upy</span><span class="tag" data-astro-cid-e7nevnov>agent</span></li><li data-row data-astro-cid-e7nevnov><span class="time" data-astro-cid-e7nevnov>08:14</span><span data-astro-cid-e7nevnov>Uporządkował rekordy w CRM</span><span class="tag" data-astro-cid-e7nevnov>agent</span></li><li data-row class="ask" data-astro-cid-e7nevnov><span class="time" data-astro-cid-e7nevnov>09:30</span><span data-astro-cid-e7nevnov>„Przygotuj ofertę dla Acme”</span><span class="who" data-astro-cid-e7nevnov>Ty</span><span class="bar" data-astro-cid-e7nevnov><i data-astro-cid-e7nevnov></i></span></li><li data-row class="result" data-astro-cid-e7nevnov><span class="time" data-astro-cid-e7nevnov>09:32</span><span data-astro-cid-e7nevnov>Oferta dla Acme gotowa</span><span data-astro-cid-e7nevnov>24&nbsp;000&nbsp;€</span></li></ol><div class="sc-total" data-total data-astro-cid-e7nevnov><span class="sc-total-label" data-astro-cid-e7nevnov>Od prośby do oferty</span><span class="sc-total-value" data-astro-cid-e7nevnov>2 min</span></div></div></div><script type="module" src="/_astro/ZwAiSales.astro_astro_type_script_index_0_lang.lUUI_Q3y.js"></script></figure></div></div></section><section id="automatyzacja" class="content-grid section feature" data-astro-cid-7wj36s4i><div class="block-inner" data-astro-cid-7wj36s4i><div class="feature-layout has-media" data-astro-cid-yr23l7fg><div class="copy" data-astro-cid-yr23l7fg><h2 id="automatyzacje-wokol-crm" data-astro-cid-yr23l7fg="true">Automatyzacje wokół CRM</h2><div class="pt prose flow" data-astro-cid-6amch4or><p data-astro-cid-6amch4or="true">Łączę formularze, CRM, pocztę, kalendarz, oferty i raportowanie. Dane przechodzą między systemami bez ręcznego kopiowania.</p></div><a class="action text" href="/automatyzacje-dla-pipedrive" data-astro-cid-j6ocf6pu><span data-astro-cid-j6ocf6pu>Dowiedz się więcej o automatyzacji</span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" data-astro-cid-zgufigjl><path d="M4 12h16m-6-6 6 6-6 6" data-astro-cid-zgufigjl></path></svg></a></div><figure class="media" data-astro-cid-yr23l7fg><style>
/* ---- Shared family layer: tokens + responsive shell.
     Copy the :root block verbatim into every animation (same names, same
     values) so the whole set shares one palette, type, radius and shadow
     language. Only zw-automation changes per animation. ---- */
  [data-diagram="zw-automation"] {
    --zw-primary:    #3A48CC;   /* brand — CTA / accent / active state   */
    --zw-primary-10: #EBEDFA;   /* primary tint — soft fills             */
    --zw-primary-30: #8991E0;
    --zw-secondary:  #0ACFFE;   /* cyan accent — "active / in motion"    */
    --zw-secondary-10:#E7FAFF;  /* cyan tint — soft fills                */
    --zw-secondary-soft:rgba(10,207,254,.22); /* cyan halo / ring        */
    --zw-success:    #52C41A;   /* win / resolved                        */
    --zw-bg-soft:    #F9FAFB;   /* lane / track surface                  */
    --zw-border:     #DDE1E6;   /* base border                           */
    --zw-border-soft:#EDF0F3;
    --zw-heading:    #0E0F11;   /* headings / values                     */
    --zw-text:       #1E2024;
    --zw-muted:      #838D95;   /* eyebrow / metadata                    */
    --zw-card:       #FFFFFF;
    --zw-font: 'Satoshi Variable','Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,system-ui,sans-serif;
    --zw-serif: 'Erode Variable','Fraunces','Source Serif 4',Georgia,serif;
    --zw-radius-card: 10px;
    --zw-radius-lane: 14px;
    --zw-shadow-rest: 0 1px 3px rgba(0,0,0,.08);
    --zw-shadow-lift: 1px 8px 22px rgba(14,15,17,.14);

    font-family: var(--zw-font);
    width: 100%;
    max-width: 920px;
    margin: 0 auto;
    box-sizing: border-box;
    -webkit-font-smoothing: antialiased;
  }
  [data-diagram="zw-automation"] *, [data-diagram="zw-automation"] *::before, [data-diagram="zw-automation"] *::after { box-sizing: border-box; }

  /* The scale-to-fit shell: the scene is laid out at a fixed design width
     (DESIGN_W in JS) and scaled down to the container, so proportions stay
     identical from desktop to a 375px phone and cards never overflow. */
  [data-diagram="zw-automation"] .zw-stage { width: 100%; overflow: hidden; }
  [data-diagram="zw-automation"] .zw-fit   { width: 760px; transform-origin: top left; }
  [data-diagram="zw-automation"] .zw-scene { position: relative; }

  /* Confetti (created on demand by the shared confetti() helper) */
  [data-diagram="zw-automation"] .zw-confetti { position: absolute; top: 0; left: 0; width: 0; height: 0; z-index: 9; pointer-events: none; }
  [data-diagram="zw-automation"] .zw-confetti i { position: absolute; width: 8px; height: 8px; border-radius: 2px; will-change: transform, opacity; }

  /* =================== SCENE:STYLE start =================== */
  /* Branching node-flow. Same component DNA as the CRM kanban (white cards,
     --zw-border, eyebrow labels, primary accent, success on the goal), but a
     forked 2D structure instead of a single row. Laid out in a fixed
     760x235 design space; the shell scales it to fit. */
  [data-diagram="zw-automation"] .zw-flow {
    position: relative;
    width: 760px;
    height: 235px;
  }

  /* SVG connectors sit behind the (opaque) node cards */
  [data-diagram="zw-automation"] .zw-wires { position: absolute; top: 0; left: 0; z-index: 1; overflow: visible; opacity: 0; }
  [data-diagram="zw-automation"] .zw-wire-base {
    fill: none; stroke: var(--zw-border); stroke-width: 3; stroke-linecap: round;
  }
  [data-diagram="zw-automation"] .zw-wire-fill {
    fill: none; stroke: var(--zw-primary); stroke-width: 3; stroke-linecap: round;
    stroke-dasharray: 1; stroke-dashoffset: 1;   /* hidden until drawn */
  }

  /* node = a card placed by left/top so its icon center hits a wire endpoint */
  [data-diagram="zw-automation"] .zw-node {
    position: absolute;
    z-index: 2;
    width: 120px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    padding: 18px 10px 14px;
    background: var(--zw-card);
    border: 1px solid var(--zw-border);
    border-radius: var(--zw-radius-lane);
    box-shadow: var(--zw-shadow-rest);
    opacity: 0;                        /* revealed by play() */
    transition: border-color .35s ease, box-shadow .35s ease;
  }
  [data-diagram="zw-automation"] .zw-node--active {
    border-color: var(--zw-primary);
    box-shadow: 0 0 0 3px var(--zw-primary-10);
  }
  [data-diagram="zw-automation"] .zw-node--done {
    border-color: var(--zw-success);
    box-shadow: 0 0 0 3px rgba(82,196,26,.14);
  }
  [data-diagram="zw-automation"] .zw-node-icon {
    width: 38px; height: 38px;
    display: flex; align-items: center; justify-content: center;
    border-radius: 999px;
    background: var(--zw-bg-soft);
    color: var(--zw-muted);
    transition: background-color .35s ease, color .35s ease;
  }
  [data-diagram="zw-automation"] .zw-node--active .zw-node-icon { background: var(--zw-primary-10); color: var(--zw-primary); }
  [data-diagram="zw-automation"] .zw-node--done   .zw-node-icon { background: rgba(82,196,26,.16); color: var(--zw-success); }
  [data-diagram="zw-automation"] .zw-node-label {
    font-size: 12px; font-weight: 700; letter-spacing: .07em;
    text-transform: uppercase; color: var(--zw-muted);
    transition: color .35s ease;
  }
  [data-diagram="zw-automation"] .zw-node--active .zw-node-label { color: var(--zw-primary); }
  [data-diagram="zw-automation"] .zw-node--done   .zw-node-label { color: var(--zw-success); }

  /* packet = a task moving along a wire */
  [data-diagram="zw-automation"] .zw-packet {
    position: absolute; top: 0; left: 0;
    z-index: 6;
    opacity: 0;
    will-change: transform;
  }
  [data-diagram="zw-automation"] .zw-packet-dot {
    display: block;
    width: 14px; height: 14px;
    margin: -7px 0 0 -7px;             /* center on the travel point */
    border-radius: 999px;
    background: var(--zw-primary);
    box-shadow: 0 0 0 4px var(--zw-secondary-soft), var(--zw-shadow-lift);  /* cyan halo: data in motion */
  }

  /* completion pulse — a single calm ring from Done (replaces confetti) */
  [data-diagram="zw-automation"] .zw-done-ring {
    position: absolute; z-index: 3;
    width: 56px; height: 56px;
    margin: -28px 0 0 -28px;
    border-radius: 999px;
    border: 2px solid var(--zw-success);
    opacity: 0;
    pointer-events: none;
  }
  /* ==================== SCENE:STYLE end ==================== */

  /* Accessibility: never move for users who asked not to.
     List every scene element that animates here so it lands resolved. */
  @media (prefers-reduced-motion: reduce) {
    [data-diagram="zw-automation"] .zw-node { opacity: 1; }
    [data-diagram="zw-automation"] .zw-wires { opacity: 1; }
    [data-diagram="zw-automation"] .zw-wire-fill { stroke-dashoffset: 0; }
  }
