75c681ff67477ed-249x64.svg?w=249&amp;fit=max&amp;auto=format" srcset="https://cdn.sanity.io/images/8u2zjhvn/production/ef0e7944efc0b3f7652c57ac775c681ff67477ed-249x64.svg?w=160&amp;fit=max&amp;auto=format 160w, https://cdn.sanity.io/images/8u2zjhvn/production/ef0e7944efc0b3f7652c57ac775c681ff67477ed-249x64.svg?w=249&amp;fit=max&amp;auto=format 249w" sizes="8rem" alt="cash4car logo" width="249" height="64" loading="lazy" decoding="async" data-astro-cid-7hzkb424></li><li tabindex="0" class="difference" data-astro-cid-7hzkb424><img src="https://cdn.sanity.io/images/8u2zjhvn/production/f2d294031922c374c1697ba65ecc9d0d58fc67bd-411x103.svg?w=411&amp;fit=max&amp;auto=format" srcset="https://cdn.sanity.io/images/8u2zjhvn/production/f2d294031922c374c1697ba65ecc9d0d58fc67bd-411x103.svg?w=160&amp;fit=max&amp;auto=format 160w, https://cdn.sanity.io/images/8u2zjhvn/production/f2d294031922c374c1697ba65ecc9d0d58fc67bd-411x103.svg?w=320&amp;fit=max&amp;auto=format 320w, https://cdn.sanity.io/images/8u2zjhvn/production/f2d294031922c374c1697ba65ecc9d0d58fc67bd-411x103.svg?w=411&amp;fit=max&amp;auto=format 411w" sizes="8rem" alt="deky expo logo" width="411" height="103" loading="lazy" decoding="async" data-astro-cid-7hzkb424></li></ul></div></div></section><section class="content-grid section feature" data-astro-cid-7wj36s4i><div class="block-inner" data-astro-cid-7wj36s4i><div class="feature-layout has-media" data-astro-cid-yr23l7fg><div class="copy" data-astro-cid-yr23l7fg><h2 id="aplikacje-nie-wspolpracuja-wiec-handlowiec-robi-za-integracje" data-astro-cid-yr23l7fg="true">Aplikacje nie współpracują, więc handlowiec robi za integrację</h2><div class="pt prose flow" data-astro-cid-6amch4or><p data-astro-cid-6amch4or="true">Lead trafia do CRM z opóźnieniem. Oferta powstaje z cennika, historii maili i notatek ze spotkania. Follow-up wychodzi, kiedy ktoś o nim pamięta. Każdy używa AI po swojemu. Narzędzia są kupione, ale praca nadal przechodzi ręcznie przez zespół.</p></div></div><figure class="media" data-astro-cid-yr23l7fg><div class="sc" data-diagram="zw-manual-relay" aria-hidden="true" data-astro-cid-iridchoj><div class="sc-body" data-astro-cid-iridchoj><ol class="track" data-astro-cid-iridchoj><li class="app" data-astro-cid-iridchoj><span class="ring" data-astro-cid-iridchoj></span><span class="name" data-astro-cid-iridchoj>E-mail</span><span class="what" data-astro-cid-iridchoj>zapytanie klienta</span></li><li class="gap is-slow" data-sum="2 h" data-astro-cid-iridchoj><span class="wait" data-astro-cid-iridchoj>+2 h</span></li><li class="app" data-astro-cid-iridchoj><span class="ring" data-astro-cid-iridchoj></span><span class="name" data-astro-cid-iridchoj>Cennik</span><span class="what" data-astro-cid-iridchoj>wycena</span></li><li class="gap is-slow" data-sum="1 dzień 2 h" data-astro-cid-iridchoj><span class="wait" data-astro-cid-iridchoj>+1 dzień</span></li><li class="app" data-astro-cid-iridchoj><span class="ring" data-astro-cid-iridchoj></span><span class="name" data-astro-cid-iridchoj>CRM</span><span class="what" data-astro-cid-iridchoj>wpis szansy</span></li><li class="gap is-slow" data-sum="1 dzień 5 h" data-astro-cid-iridchoj><span class="wait" data-astro-cid-iridchoj>+3 h</span></li><li class="app" data-astro-cid-iridchoj><span class="ring is-here" data-astro-cid-iridchoj></span><span class="name" data-astro-cid-iridchoj>AI</span><span class="what" data-astro-cid-iridchoj>szkic oferty</span></li></ol><span class="carrier" data-astro-cid-iridchoj></span><div class="sc-total" data-astro-cid-iridchoj><span class="sc-total-label" data-astro-cid-iridchoj>Czekanie przy jednej ofercie</span><span class="sc-total-value is-loss" data-total data-astro-cid-iridchoj>1 dzień 5 h</span></div></div></div><script type="module" src="/_astro/ZwManualRelay.astro_astro_type_script_index_0_lang.I0ykFr0A.js"></script></figure></div></div></section><section class="content-grid section logo-strip" data-astro-cid-7wj36s4i><div class="block-inner" data-astr