w.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%20480%20600%22%3E%3Crect%20width%3D%22100%25%22%20height%3D%22100%25%22%20fill%3D%22%23e6e8f8%22%2F%3E%3Ctext%20x%3D%2250%25%22%20y%3D%2250%25%22%20font-family%3D%22sans-serif%22%20font-size%3D%2234%22%20fill%3D%22%233a48cc%22%20text-anchor%3D%22middle%22%20dominant-baseline%3D%22middle%22%3EREKOMENDACJA%203%3C%2Ftext%3E%3C%2Fsvg%3E" sizes="(width &lt; 48rem) 100vw, 33vw" width="480" height="600" alt="Zrzut rekomendacji numer 3" loading="lazy" decoding="async" data-astro-cid-b4h6gghm><figcaption data-astro-cid-b4h6gghm><div class="attribution" data-astro-cid-b4h6gghm><span class="name" data-astro-cid-b4h6gghm>Rekomendacja 3</span></div></figcaption></figure></li><li data-astro-cid-b4h6gghm><figure class="quote" data-astro-cid-b4h6gghm><img src="data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%20480%20600%22%3E%3Crect%20width%3D%22100%25%22%20height%3D%22100%25%22%20fill%3D%22%23e6e8f8%22%2F%3E%3Ctext%20x%3D%2250%25%22%20y%3D%2250%25%22%20font-family%3D%22sans-serif%22%20font-size%3D%2234%22%20fill%3D%22%233a48cc%22%20text-anchor%3D%22middle%22%20dominant-baseline%3D%22middle%22%3EREKOMENDACJA%204%3C%2Ftext%3E%3C%2Fsvg%3E" sizes="(width &lt; 48rem) 100vw, 33vw" width="480" height="600" alt="Zrzut rekomendacji numer 4" loading="lazy" decoding="async" data-astro-cid-b4h6gghm><figcaption data-astro-cid-b4h6gghm><div class="attribution" data-astro-cid-b4h6gghm><span class="name" data-astro-cid-b4h6gghm>Rekomendacja 4</span></div></figcaption></figure></li></ul></div></section><h2 class="ds-label content-grid" id="ds-faq" data-astro-cid-2n4kpjdp><span data-astro-cid-2n4kpjdp>Faq: typowe dane (emitSchema)</span></h2><section id="faq" class="content-grid section faq" aria-labelledby="faq-heading" data-faq-schema="FAQPage" data-astro-cid-s5r4na5t><div class="inner" data-astro-cid-s5r4na5t><header class="head" data-astro-cid-s5r4na5t><p class="type-tagline" data-astro-cid-s5r4na5t>FAQ</p><h2 id="faq-heading" data-astro-cid-s5r4na5t>Najczęstsze pytania</h2></header><div class="list" data-astro-cid-s5r4na5t><details name="faq" data-astro-cid-s5r4na5t><summary data-astro-cid-s5r4na5t><span class="question type-heading-xs" data-astro-cid-s5r4na5t>Ile trwa wdrożenie?</span><svg class="chevron" viewBox="0 0 16 16" aria-hidden="true" data-astro-cid-s5r4na5t><path d="M8 11.4 2.3 5.7l1.4-1.4L8 8.6l4.3-4.3 1.4 1.4z" data-astro-cid-s5r4na5t></path></svg></summary><div class="answer" data-astro-cid-s5r4na5t><div class="pt prose flow" data-astro-cid-6amch4or><p data-astro-cid-6amch4or="true">Zwykle od dwóch do sześciu tygodni, zależnie od liczby procesów.</p></div></div></details><details name="faq" data-astro-cid-s5r4na5t><summary data-astro-cid-s5r4na5t><span class="question type-heading-xs" data-astro-cid-s5r4na5t>Czy pracujesz zdalnie?</span><svg class="chevron" viewBox="0 0 16 16" aria-hidden="true" data-astro-cid-s5r4na5t><path d="M8 11.4 2.3 5.7l1.4-1.4L8 8.6l4.3-4.3 1.4 1.4z" data-astro-cid-s5r4na5t></path></svg></summary><div class="answer" data-astro-cid-s5r4na5t><div class="pt prose flow" data-astro-cid-6amch4or><p data-astro-cid-6amch4or="true">Tak. Szczegóły ustalimy w <a href="/kontakt">formularzu kontaktowym</a>.</p></div></div></details><details name="faq" data-astro-cid-s5r4na5t><summary data-astro-cid-s5r4na5t><span class="question type-heading-xs" data-astro-cid-s5r4na5t>Co jest w cenie?</span><svg class="chevron" viewBox="0 0 16 16" aria-hidden="true" data-astro-cid-s5r4na5t><path d="M8 11.4 2.3 5.7l1.4-1.4L8 8.6l4.3-4.3 1.4 1.4z" data-astro-cid-s5r4na5t></path></svg></summary><div class="answer" data-astro-cid-s5r4na5t><div class="pt prose flow" data-astro-cid-6amch4or><p data-astro-cid-6amch4or="true">W cenie jest:</p><ul data-astro-cid-3pdvfo4y="true"><li data-astro-cid-3pdvfo4y>warsztat</li><li data-astro-cid-3pdvfo4y>konfiguracja</li><li data-astro-cid-3pdvfo4y>szkolenie</li></ul></div></div></details></div></div></section><h2 class="ds-label content-grid" data-astro-cid-2n4kpjdp><span data-astro-cid-2n4kpjdp>Faq: najgorszy przypadek (emitSchema: false)</span></h2><section id="faq-worst" class="content-grid section faq" aria-labelledby="faq-worst-heading" data-astro-cid-s5r4na5t><div class="inner" data-astro-cid-s5r4na5t><header class="head" data-astro-cid-s5r4na5t><h2 id="faq-worst-heading" data-astro-cid-s5r4na5t>Najczęstsze pytania</h2></header><div class="list" data-astro-cid-s5r4na5t><details name="faq-worst" data-astro-cid-s5r4na5t><summary data-astro-cid-s5r4na5t><span class="question type-heading-xs" data-astro-cid-s5r4na5t>Bardzo długie pytanie, które zajmuje kilka linii i zawiera nierozdzielne słowo KonstantynopolitańczykowianeczkaKonstantynopolitańczykowianeczkaKonstantynopolitańczykowianeczka?</span><svg class="chevron" viewBox="0 0 16 16" aria-hidden="true" data-astro-cid-s5r4na5t><path d="M8 11.4 2.3 5.7l1.4-1.4L8 8.6l4.3-4.3 1.4 1.4z" data-astro-cid-s5r4na5t></path></svg></summary><div class="answer" data-astro-cid-s5r4na5t><div class="pt prose flow" data-astro-cid-6amch4or><p data-astro-cid-6amch4or="true">Odpowiedź ze <a href="https://example.com" rel="noopener">zewnętrznym linkiem</a> i słowem KonstantynopolitańczykowianeczkaKonstantynopolitańczykowianeczkaKonstantynopolitańczykowianeczka.</p><ul data-astro-cid-3pdvfo4y="true"><li data-astro-cid-3pdvfo4y>poziom pierwszy<ol data-astro-cid-3pdvfo4y="true"><li data-astro-cid-3pdvfo4y>poziom drugi</li><li data-astro-cid-3pdvfo4y>poziom drugi, punkt drugi</li></ol></li><li data-astro-cid-3pdvfo4y>znowu poziom pierwszy</li></ul></div></div></details></div></div></section><h2 class="ds-label content-grid" id="ds-contact" data-astro-cid-2n4kpjdp><span data-astro-cid-2n4kpjdp>ContactForm: landing z danymi kontaktowymi</span></h2><section id="kontakt" class="content-grid section contact" aria-labelledby="kontakt-heading" data-astro-cid-mlmkznwb><div class="inner landing" data-astro-cid-mlmkznwb><header class="head" data-astro-cid-mlmkznwb><p class="type-tagline" data-astro-cid-mlmkznwb>Kontakt</p><h2 id="kontakt-heading" class="type-heading-l" data-astro-cid-mlmkznwb="true">Skontaktuj się ze mną</h2></header><div class="card split" data-astro-cid-mlmkznwb><form id="kontakt-form" class="lead-form light" action="/api/form?form=landing-contact" method="post" data-lead-form data-form="landing-contact" data-name="Landing Contact Form" data-astro-cid-gz6njkqh><h3 id="formularz-kontaktowy" class="form-heading" data-astro-cid-mlmkznwb="true">Formularz kontaktowy</h3><div class="field" data-astro-cid-mlmkznwb><label class="visually-hidden" for="kontakt-email" data-astro-cid-mlmkznwb>E-mail <span class="required" data-astro-cid-mlmkznwb>(wymagane)</span></label><input id="kontakt-email" name="email" placeholder="E-mail" type="email" autocomplete="email" maxlength="256" required data-astro-cid-mlmkznwb></div><div class="field" data-astro-cid-mlmkznwb><label class="visually-hidden" for="kontakt-phone" data-astro-cid-mlmkznwb>Telefon</label><input id="kontakt-phone" name="phone" placeholder="Telefon" type="tel" autocomplete="tel" maxlength="256" data-astro-cid-mlmkznwb></div><div class="field" data-astro-cid-mlmkznwb><label class="visually-hidden" for="kontakt-message" data-astro-cid-mlmkznwb>Temat rozmowy</label><textarea id="kontakt-message" name="message" placeholder="Temat rozmowy" maxlength="5000" data-astro-cid-mlmkznwb></textarea></div><p class="note type-body-s" data-astro-cid-mlmkznwb>Twoich danych użyjemy tylko po to, żeby odpowiedzieć na zgłoszenie i umówić rozmowę. Administratorem danych jest Wellbiz sp. z o.o. Szczegóły: <a href="/polityka-prywatnosci" data-astro-cid-mlmkznwb>Polityka prywatności</a>.</p><label class="check type-body-s" data-astro-cid-mlmkznwb><input type="checkbox" name="newsletter" data-astro-cid-mlmkznwb><span data-astro-cid-mlmkznwb>Przy okazji wyślij mi raz w tygodniu nowości dotyczące nowych technologii w sprzedaży B2B. Bez spamu, wypiszesz się jednym kliknięciem.</span>