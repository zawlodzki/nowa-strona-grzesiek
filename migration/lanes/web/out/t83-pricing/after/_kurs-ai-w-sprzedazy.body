    [data-diagram="zw-problem"] .pr-chip, [data-diagram="zw-problem"] .pr-gapline, [data-diagram="zw-problem"] .pr-gaptag { opacity:1; }
    [data-diagram="zw-problem"] .pr-area { opacity:.10; }
    [data-diagram="zw-problem"] .pr-line { stroke-dashoffset:0; }
  }
</style><div class="dg" data-diagram="zw-problem" aria-hidden="true" style="--dg-w: 640; --dg-h: 360;"><div class="zw-stage dg-stage"><div class="zw-fit dg-fit"><div class="zw-scene"><svg class="pr-svg" viewBox="0 0 640 360" width="100%" xmlns="http://www.w3.org/2000/svg"><path class="pr-area" d="M64,250 C220,232 350,150 508,66 L520,244 C370,245 200,247 64,250 Z"></path><g class="pr-axis"><line x1="64" y1="24" x2="64" y2="300"></line><line x1="64" y1="300" x2="606" y2="300"></line></g><text class="pr-cap" x="604" y="328" text-anchor="end">Time since AI &rarr;</text><circle class="pr-origin" cx="64" cy="250" r="5"></circle><path class="pr-flat pr-line" d="M64,250 C200,247 370,245 520,244" pathLength="1"></path><circle class="pr-flat-dot pr-enddot" cx="520" cy="244" r="5"></circle><text class="pr-lbl pr-lbl--flat" x="368" y="232" text-anchor="end">Business result</text><path class="pr-perc pr-line" d="M64,250 C220,232 350,150 508,66" pathLength="1"></path><path class="pr-arrow" d="M-11,-7 L0,0 L-11,7" transform="translate(508,66) rotate(-28)"></path><text class="pr-lbl pr-lbl--perc" x="150" y="120">Perceived speed</text><g class="pr-chip"><rect x="524" y="34" width="66" height="30" rx="15"></rect><text x="557" y="54" text-anchor="middle">+40%</text></g><line class="pr-gapline" x1="514" y1="78" x2="514" y2="236"></line><g class="pr-gaptag"><rect x="522" y="142" width="86" height="30" rx="8"></rect><text x="565" y="162" text-anchor="middle">the gap</text></g></svg></div></div></div></div><script type="module">for(let e of document.querySelectorAll(`[data-diagram="zw-problem"]`))(function(){if(!e||e.dataset.zwInit)return;e.dataset.zwInit=`1`;var t=e.querySelector(`.zw-stage`);e.querySelector(`.zw-fit`);var n=e.querySelector(`.zw-scene`),r=window.matchMedia&&window.matchMedia(`(prefers-reduced-motion: reduce)`).matches,i=`cubic-bezier(0.22, 1, 0.36, 1)`,a=`cubic-bezier(0.645, 0.045, 0.355, 1)`,o=`cubic-bezier(0.34, 1.56, 0.64, 1)`;function s(e){return new Promise(function