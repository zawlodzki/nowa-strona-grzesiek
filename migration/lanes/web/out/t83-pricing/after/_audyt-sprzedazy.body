    </script><link rel="preconnect" href="https://consent.zawlodzki.com" crossorigin><script defer src="https://consent.zawlodzki.com/assets/cmp-v1.js?v=20261113-1"></script><link rel="preload" href="/_astro/Satoshi-Variable.Xrx0dYoJ.woff2" as="font" type="font/woff2" crossorigin><link rel="preload" href="/_astro/Erode-Variable.cMk1Q8rP.woff2" as="font" type="font/woff2" crossorigin><title>Audyt sprzedaży B2B — zakres i cena | Grzegorz Zawłodzki</title><meta name="description" content="Audyt sprzedaży B2B obejmuje strategię, pozycjonowanie, proces sprzedaży, wynagradzanie i CRM. Diagnoza i plan na 90 dni. Cena: 6900 zł netto."><link rel="canonical" href="https://www.zawlodzki.pl/audyt-sprzedazy"><link rel="alternate" type="text/markdown" href="https://www.zawlodzki.pl/audyt-sprzedazy.md"><meta property="og:type" content="website"><meta property="og:title" content="Audyt sprzedaży B2B — zakres i cena | Grzegorz Zawłodzki"><meta property="og:description" content="Audyt sprzedaży B2B obejmuje strategię, pozycjonowanie, proces sprzedaży, wynagradzanie i CRM. Diagnoza i plan na 90 dni. Cena: 6900 zł netto."><meta property="og:url" content="https://www.zawlodzki.pl/audyt-sprzedazy"><meta property="og:site_name" content="zawlodzki.pl"><meta property="og:locale" content="pl_PL"><meta property="og:image" content="https://cdn.sanity.io/images/8u2zjhvn/production/a7b01d0063525ea518d6bc50f67ae4e08249eb97-1200x630.png?w=1200&amp;fit=max&amp;auto=format"><meta property="og:image:width" content="1200"><meta property="og:image:height" content="630"><meta property="og:image:alt" content="Audyt sprzedaży B2B — zakres i cena | Grzegorz Zawłodzki"><meta name="twitter:card" content="summary_large_image"><meta name="twitter:title" content="Audyt sprzedaży B2B — zakres i cena | Grzegorz Zawłodzki"><meta name="twitter:description" content="Audyt sprzedaży B2B obejmuje strategię, pozycjonowanie, proces sprzedaży, wynagradzanie i CRM. Diagnoza i plan na 90 dni. Cena: 6900 zł netto."><meta name="twitter:image" content="https://cdn.sanity.io/images/8u2zjhvn/production/a7b01d0063525ea518d6bc50f67ae4e08249eb97-1200x630.png?w=1200&amp;fit=max&amp;auto=format"><script type="application/ld+json">{"@context":"https://schema.org","@graph":[{"@type":"WebPage","@id":"https://www.zawlodzki.pl/audyt-sprzedazy#webpage","url":"https://www.zawlodzki.pl/audyt-sprzedazy","name":"Audyt sprzedaży B2B, który oddziela przyczyny od objawów","description":"Audyt sprzedaży B2B obejmuje strategię, pozycjonowanie, proces sprzedaży, wynagradzanie i CRM. Diagnoza i plan na 90 dni. Cena: 6900 zł netto.","inLanguage":"pl-PL","isPartOf":{"@id":"https://www.zawlodzki.pl/#website"},"about":{"@id":"https://www.zawlodzki.pl/audyt-sprzedazy#service"},"mainEntity":{"@id":"https://www.zawlodzki.pl/audyt-sprzedazy#service"},"breadcrumb":{"@id":"https://www.zawlodzki.pl/audyt-sprzedazy#breadcrumb"},"primaryImageOfPage":{"@type":"ImageObject","url":"https://cdn.sanity.io/images/8u2zjhvn/production/743f000b6306622a1a32bca730654ee937f8a7fe-800x800.avif?w=800&fit=max&auto=format","width":800,"height":800,"caption":"Grzegorz Zawłodzki zdjęcie profilowe"},"dateModified":"2026-11-12T12:28:34Z"},{"@type":"Service","@id":"https://www.zawlodzki.pl/audyt-sprzedazy#service","name":"Audyt sprzedaży B2B, który oddziela przyczyny od objawów","description":"Audyt sprzedaży B2B obejmuje strategię, pozycjonowanie, proces sprzedaży, wynagradzanie i CRM. Diagnoza i plan na 90 dni. Cena: 6900 zł netto.","url":"https://www.zawlodzki.pl/audyt-sprzedazy","provider":{"@id":"https://www.zawlodzki.pl/#organization"},"areaServed":{"@type":"Country","name":"Polska"},"offers":[{"@type":"Offer","name":"Audyt CRM Pipedrive","price":"3900","priceCurrency":"PLN"},{"@type":"Offer","name":"Audyt sprzedaży","price":"6900","priceCurrency":"PLN"},{"@type":"Offer","name":"Wdrożenie po audycie"}]},{"@type":"Review","@id":"https://www.zawlodzki.pl/audyt-sprzedazy#review-testimonial-6f0a990b3555d094","author":{"@type":"Person","name":"Łukasz Kruszewski-Zelman"},"reviewBody":"\"Naszym problemem był start z działaniem Pipedrive, ponieważ ilość funkcjonalności i ustawień tego narzędzia oraz jego stopień zaawansowania i skomplikowania początkowo nas przerósł. Wystarczyła konsultacja aby Pan Grzegorz wyjaśnił nam zasady działania aplikacji Pipedrive oraz pomógł nam ją skonfigurować i wystartować z jej działaniem.\"","itemReviewed":{"@id":"https://www.zawlodzki.pl/audyt-sprzedazy#service"},"isPartOf":{"@id":"https://www.zawlodzki.pl/audyt-sprzedazy#webpage"}},{"@type":"BreadcrumbList","@id":"https://www.zawlodzki.pl/audyt-sprzedazy#breadcrumb","itemListElement":[{"@type":"ListItem","position":1,"name":"Strona główna","item":"https://www.zawlodzki.pl/"},{"@type":"ListItem","position":2,"name":"Audyt sprzedaży B2B, który oddziela przyczyny od objawów","item":"https://www.zawlodzki.pl/audyt-sprzedazy"}]},{"@type":"FAQPage","@id":"https://www.zawlodzki.pl/audyt-sprzedazy#faq","isPartOf":{"@id":"https://www.zawlodzki.pl/audyt-sprzedazy#webpage"},"about":{"@id":"https://www.zawlodzki.pl/audyt-sprzedazy#service"},"inLanguage":"pl-PL","mainEntity":[{"@type":"Question","name":"Co to jest audyt sprzedaży?","acceptedAnswer":{"@type":"Answer","text":"Audyt sprzedaży to analiza całego sposobu, w jaki firma B2B zdobywa i rozwija klientów. Obejmuje strategię, pozycjonowanie, sposoby sprzedaży, proces, zespół, wynagradzanie, CRM i pomiar. Kończy się diagnozą przyczyn problemów oraz planem działań."}},{"@type":"Question","name":"Ile kosztuje audyt sprzedaży?","acceptedAnswer":{"@type":"Answer","text":"6 900 zł netto. W cenie są analiza materiałów i danych, rozmowy z zespołem, do czterech warsztatów online, raport, priorytety oraz plan działań na 90 dni."}},{"@type":"Question","name":"Ile trwa audyt sprzedaży?","acceptedAnswer":{"@type":"Answer","text":"Zwykle około trzech tygodni. Termin zależy głównie od dostępności danych i osób, z którymi trzeba porozmawiać. Handlowcy w tym czasie pracują normalnie."}},{"@type":"Question","name":"Co obejmuje audyt procesu sprzedaży?","acceptedAnswer":{"@type":"Answer","text":"Sprawdzam kwalifikację, etapy, kryteria wyjścia, spotkania, ofertowanie, follow-up, przekazanie do realizacji oraz dane potrzebne do mierzenia konwersji i długości cyklu. Nie oceniam procesu w oderwaniu od strategii, pozycjonowania i sposobów sprzedaży."}},{"@type":"Question","name":"Czym audyt sprzedaży różni się od audytu CRM?","acceptedAnswer":{"@type":"Answer","text":"Audyt sprzedaży pyta, co blokuje wzrost całego systemu. Audyt CRM pyta, dlaczego Pipedrive nie wspiera ustalonego procesu. W pierwszym CRM jest jednym ze źródeł dowodów. W drugim jest głównym przedmiotem analizy."}},{"@type":"Question","name":"Czy trzeba mieć CRM, żeby zrobić audyt?","acceptedAnswer":{"@type":"Answer","text":"Nie. Jeżeli CRM-u nie ma, korzystam z dostępnych raportów, arkuszy, ofert, korespondencji i rozmów. Brak danych też jest informacją diagnostyczną. Nie trzeba kupować systemu przed audytem."}},{"@type":"Question","name":"Czy analizujesz tylko wybraną liczbę szans sprzedaży?","acceptedAnswer":{"@type":"Answer","text":"Nie ograniczam audytu do arbitralnych 30 szans. Najpierw patrzę na pełny dostępny obraz danych, a konkretne sprawy dobieram do sprawdzenia hipotez, na przykład przyczyn strat, długości cyklu albo jakości kwalifikacji."}},{"@type":"Question","name":"Kogo trzeba zaangażować?","acceptedAnswer":{"@type":"Answer","text":"Właściciela albo osobę odpowiedzialną za wynik sprzedaży oraz wybranych handlowców. Jeżeli marketing lub realizacja mają wpływ na przekazanie leada i klienta, włączam także osoby z tych obszarów."}},{"@type":"Question","name":"Czy audyt ocenia handlowców?","acceptedAnswer":{"@type":"Answer","text":"Nie jest kontrolą pracowników ani rankingiem ludzi. Oceniam system, w którym pracują: cele, reguły, proces, narzędzia i bodźce. Zachowania zespołu są dowodem na to, jak ten system działa w praktyce. Zespół jest z tego powodu ostatnim miejscem, w którym szukam przyczyny spadku, a pięć wcześniejszych sprawdzicie u siebie sami, jeszcze przed audytem. Sześć miejsc, od których zaczynam"}},{"@type":"Question","name":"Co dostaję na koniec?","acceptedAnswer":{"@type":"Answer","text":"Mapę obecnego systemu sprzedaży, diagnozę z dowodami, rejestr niespójności, priorytety, rekomendacje oraz plan działań na 90 dni. Raport jest Wasz i możecie wdrożyć go samodzielnie albo z innym partnerem."}},{"@type":"Question","name":"Czy po audycie muszę zamówić wdrożenie?","acceptedAnswer":{"@type":"Answer","text":"Nie. Audyt jest osobną usługą. Jeżeli zechcecie zlecić mi wdrożenie części rekomendacji, wycenię je po zakończeniu diagnozy."}}]},{"@type":"Person","@id":"https://www.zawlodzki.pl/o-mnie#person","name":"Grzegorz Zawłodzki","jobTitle":"Konsultant CRM i automatyzacji sprzedaży B2B","description":"Konsultant i trener. Wdraża systemy CRM (Pipedrive, HubSpot, Attio), Asanę oraz procesy sprzedaży wspierane przez AI. Pracował z ponad 50 firmami, od startupów po globalne marki jak IAB.","url":"https://www.zawlodzki.pl/o-mnie","image":{"@type":"ImageObject","url":"https://cdn.sanity.io/images/8u2zjhvn/production/d519a3e46c8eb9f05e98170375bcfaec6b8ac75b-240x448.webp?w=240&fit=max&auto=format","width":240,"height":448,"caption":"Grzegorz Zawłodzki"},"email":"grzesiek@zawlodzki.pl","telephone":"+48571088338","worksFor":{"@id":"https://www.zawlodzki.pl/#organization"},"knowsLanguage":["pl","en"],"knowsAbout":["Wdrożenia CRM","Pipedrive","HubSpot","Attio","Asana","AI w sprzedaży B2B","Agenty AI","Automatyzacja procesów biznesowych","n8n","Integracje API","Dashboardy sprzedażowe","Zarządzanie projektami"],"sameAs":["https://www.linkedin.com/in/zawlodzki/","https://x.com/zawlodzki","https://www.youtube.com/@GrzesiekZawlodzki","https://www.instagram.com/zawlodzki/","https://github.com/zawlodzki"]},{"@type":"Organization","@id":"https://www.zawlodzki.pl/#organization","name":"Wellbiz","legalName":"Wellbiz sp. z o.o.","alternateName":["zawlodzki.pl"],"description":"Wellbiz to firma doradcza z Krakowa, która wdraża systemy CRM (Pipedrive, HubSpot, Attio), Asanę, automatyzacje w n8n oraz procesy sprzedaży wspierane przez AI w firmach B2B. Prowadzi ją Grzegorz Zawłodzki, a serwis firmy działa pod adresem zawlodzki.pl.","url":"https://www.zawlodzki.pl","logo":{"@type":"ImageObject","url":"https://cdn.sanity.io/images/8u2zjhvn/production/99e95e3456f8f59119d96aa8125d3ee172095c66-215x82.svg?w=215&fit=max&auto=format","width":215,"height":82,"caption":"Wellbiz"},"foundingDate":"2025-02-26","vatID":"PL6793323800","taxID":"6793323800","identifier":[{"@type":"PropertyValue","propertyID":"KRS","value":"0001158341"},{"@type":"PropertyValue","propertyID":"REGON","value":"541006624"}],"address":{"@type":"PostalAddress","streetAddress":"ul. Lipowa 3d","postalCode":"30-702","addressLocality":"Kraków","addressCountry":"PL"},"areaServed":{"@type":"Country","name":"Polska"},"knowsAbout":["Wdrożenia CRM","Pipedrive","Asana","AI w sprzedaży B2B","Automatyzacja procesów biznesowych","n8n"],"founder":{"@id":"https://www.zawlodzki.pl/o-mnie#person"},"contactPoint":{"@type":"ContactPoint","email":"grzesiek@zawlodzki.pl","telephone":"+48571088338","contactType":"sales","availableLanguage":["pl","en"]},"sameAs":["https://www.linkedin.com/company/zawlodzki-pl/","https://rejestr.io/krs/1158341/wellbiz","https://aleo.com/pl/firma/wellbiz-spolka-z-ograniczona-odpowiedzialnoscia"]},{"@type":"WebSite","@id":"https://www.zawlodzki.pl/#website","url":"https://www.zawlodzki.pl","name":"Grzegorz Zawłodzki — wdrożenia CRM i automatyzacja sprzedaży B2B","alternateName":"zawlodzki.pl","inLanguage":["pl-PL","en"],"publisher":{"@id":"https://www.zawlodzki.pl/o-mnie#person"}}]}</script><link rel="icon" type="image/png" sizes="32x32" href="/favicon.png"><link rel="apple-touch-icon" href="/apple-touch-icon.png"><!-- Bing Webmaster Tools ownership, carried over from the Webflow head. --><meta name="msvalidate.01" content="C214B52BA1B7751A5EDD0564040D650F"><style>@l