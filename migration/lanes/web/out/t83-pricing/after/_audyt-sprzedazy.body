set="https://cdn.sanity.io/images/8u2zjhvn/production/19781b523858b732d164ff6a718a8c65041c338b-512x512.avif?w=160&amp;fit=max&amp;auto=format 160w, https://cdn.sanity.io/images/8u2zjhvn/production/19781b523858b732d164ff6a718a8c65041c338b-512x512.avif?w=320&amp;fit=max&amp;auto=format 320w, https://cdn.sanity.io/images/8u2zjhvn/production/19781b523858b732d164ff6a718a8c65041c338b-512x512.avif?w=480&amp;fit=max&amp;auto=format 480w, https://cdn.sanity.io/images/8u2zjhvn/production/19781b523858b732d164ff6a718a8c65041c338b-512x512.avif?w=512&amp;fit=max&amp;auto=format 512w" sizes="8rem" alt="iimarbella logo" width="512" height="512" loading="lazy" decoding="async" data-astro-cid-7hzkb424></li><li tabindex="0" data-astro-cid-7hzkb424><img src="https://cdn.sanity.io/images/8u2zjhvn/production/936866fe58f09b62ada4cdbf319176f5dcce9f15-261x98.webp?w=261&amp;fit=max&amp;auto=format" srcset="https://cdn.sanity.io/images/8u2zjhvn/production/936866fe58f09b62ada4cdbf319176f5dcce9f15-261x98.webp?w=160&amp;fit=max&amp;auto=format 160w, https://cdn.sanity.io/images/8u2zjhvn/production/936866fe58f09b62ada4cdbf319176f5dcce9f15-261x98.webp?w=261&amp;fit=max&amp;auto=format 261w" sizes="8rem" alt="vadim eyewear logo" width="261" height="98" loading="lazy" decoding="async" data-astro-cid-7hzkb424></li><li tabindex="0" data-astro-cid-7hzkb424><img src="https://cdn.sanity.io/images/8u2zjhvn/production/690df68b76dbc228fba092407207caedc24a07fb-261x54.svg?w=261&amp;fit=max&amp;auto=format" srcset="https://cdn.sanity.io/images/8u2zjhvn/production/690df68b76dbc228fba092407207caedc24a07fb-261x54.svg?w=160&amp;fit=max&amp;auto=format 160w, https://cdn.sanity.io/images/8u2zjhvn/production/690df68b76dbc228fba092407207caedc24a07fb-261x54.svg?w=261&amp;fit=max&amp;auto=format 261w" sizes="8rem" alt="pro science logo" width="261" height="54" loading="lazy" decoding="async" data-astro-cid-7hzkb424></li><li tabindex="0" data-astro-cid-7hzkb424><img src="https://cdn.sanity.io/images/8u2zjhvn/production/ef0e7944efc0b3f7652c57ac775c681ff67477ed-249x64.svg?w=249&amp;fit=max&amp;auto=format" srcset="https://cdn.sanity.io/images/8u2zjhvn/production/ef0e7944efc0b3f7652c57ac775c681ff67477ed-249x64.svg?w=160&amp;fit=max&amp;auto=format 160w, https://cdn.sanity.io/images/8u2zjhvn/production/ef0e7944efc0b3f7652c57ac775c681ff67477ed-249x64.svg?w=249&amp;fit=max&amp;auto=format 249w" sizes="8rem" alt="cash4car logo" width="249" height="64" loading="lazy" decoding="async" data-astro-cid-7hzkb424></li><li tabindex="0" class="difference" data-astro-cid-7hzkb424><img src="https://cdn.sanity.io/images/8u2zjhvn/production/f2d294031922c374c1697ba65ecc9d0d58fc67bd-411x103.svg?w=411&amp;fit=max&amp;auto=format" srcset="https://cdn.sanity.io/images/8u2zjhvn/production/f2d294031922c374c1697ba65ecc9d0d58fc67bd-411x103.svg?w=160&amp;fit=max&amp;auto=format 160w, https://cdn.sanity.io/images/8u2zjhvn/production/f2d294031922c374c1697ba65ecc9d0d58fc67bd-411x103.svg?w=320&amp;fit=max&amp;auto=format 320w, https://cdn.sanity.io/images/8u2zjhvn/production/f2d294031922c374c1697ba65ecc9d0d58fc67bd-411x103.svg?w=411&amp;fit=max&amp;auto=format 411w" sizes="8rem" alt="deky expo logo" width="411" height="103" loading="lazy" decoding="async" data-astro-cid-7hzkb424></li></ul></div></div></section><section class="content-grid section feature" data-astro-cid-7wj36s4i><div class="block-inner" data-astro-cid-7wj36s4i><div class="feature-layout has-media" data-astro-cid-yr23l7fg><div class="copy" data-astro-cid-yr23l7fg><h2 id="wynik-nie-dowozi-ale-kazda-osoba-wskazuje-inna-przyczyne" data-astro-cid-yr23l7fg="true">Wynik nie dowozi, ale każda osoba wskazuje inną przyczynę</h2><div class="pt prose flow" data-astro-cid-6amch4or><p data-astro-cid-6amch4or="true">Marketing mówi, że dostarcza leady. Handlowcy mówią, że leady są słabe. Manager chce większej aktywności, a właściciel nie wie, czy problem leży w strategii, ofercie, procesie czy w ludziach.<br>W takiej sytuacji poprawianie samego CRM-u, prowizji albo aktywności handlowców jest zgadywaniem. Najpierw trzeba sprawdzić cały system sprzedaży i zobaczyć, gdzie jego elementy sobie przeczą.<br>Audyt sprzedaży oddziela przyczyny od objawów i pokazuje, co zmienić najpierw.</p></div><a class="action text" href="/kontakt" data-astro-cid-j6ocf6pu><span data-astro-cid-j6ocf6pu>Porozmawiajmy o problemach w sprzedaży</span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" data-astro-cid-zgufigjl><path d="M4 12h16m-6-6 6 6-6 6" data-astro-cid-zgufigjl></path></svg></a></div><figure class="media" data-astro-cid-yr23l7fg><style>
