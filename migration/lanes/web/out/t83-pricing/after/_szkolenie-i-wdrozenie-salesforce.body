"sp-warn" aria-hidden="true"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 4l9 16H3z"></path><path d="M12 10v4"></path><path d="M12 17h.01"></path></svg></span></div></div><div class="sp-stat sp-stat--lic"><span class="sp-eyebrow">Licence</span><div class="sp-stat-row"><span class="sp-stat-num">&euro;1,000</span><span class="sp-stat-sub">/mo</span></div><i class="sp-tick"></i></div></div></div><div class="sp-deal" aria-hidden="true"><div class="sp-deal-top"><span class="sp-avatar">A</span><span class="sp-deal-name">Acme</span></div><div class="sp-deal-value">&euro;24,000</div><div class="sp-deal-foot"><span class="sp-tag">Open</span></div></div></div></div></div></div></div><script type="module" src="/_astro/ZwSfProblem.astro_astro_type_script_index_0_lang.DU09BcN9.js"></script></figure></div></div></section><section class="content-grid section content-section" data-astro-cid-7wj36s4i><div class="block-inner" data-astro-cid-7wj36s4i><div class="content-layout" data-astro-cid-7yq64bwo><header class="intro" data-astro-cid-7yq64bwo><h2 id="sprawdz-czy-wdrozenie-salesforce-pasuje-do-twojej-firmy" data-astro-cid-7yq64bwo>Sprawdź, czy wdrożenie Salesforce pasuje do Twojej firmy</h2><div class="pt prose flow" data-astro-cid-6amch4or></div></header><ul class="items checklist" data-astro-cid-7yq64bwo><li data-astro-cid-7yq64bwo><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" data-astro-cid-zgufigjl><path d="m5 12 4 4L19 6" data-astro-cid-zgufigjl></path></svg><div class="item-copy" data-astro-cid-7yq64bwo><h3 id="pipedrive-hubspot-albo-excel-przestaly-wystarczac-bo-potrzebujesz-wlasnych-obiektow-osobnego-procesu-dla-serwisu-albo-kilku-oddzialow-z-roznymi-uprawnieniami" class="type-heading-xs" data-astro-cid-7yq64bwo>Pipedrive, HubSpot albo Excel przestały wystarczać, bo potrzebujesz własnych obiektów, osobnego procesu dla serwisu albo kilku oddziałów z różnymi uprawnieniami.</h3></div></li><li data-astro-cid-7yq64bwo><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" data-astro-cid-zgufigjl><path d="m5 12 4 4L19 6" data-astro-cid-zgufigjl></path></svg><div class="item-copy" data-astro-cid-7yq64bwo><h3 id="macie-juz-salesforce-ale-handlowcy-go-omijaja-a-raporty-nie-nadaja-sie-do-decyzji" class="type-heading-xs" data-astro-cid-7yq64bwo>Macie już Salesforce, ale handlowcy go omijają, a raporty nie nadają się do decyzji.</h3></div></li><li data-astro-cid-7yq64bwo><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" data-astro-cid-zgufigjl><path d="m5 12 4 4L19 6" data-astro-cid-zgufigjl></path></svg><div class="item-copy" data-astro-cid-7yq64bwo><h3 id="po-wygranej-szansie-obsluga-klienta-dopytuje-o-rzeczy-ktore-sprzedaz-juz-ustalila" class="type-heading-xs" data-astro-cid-7yq64bwo>Po wygranej szansie obsługa klienta dopytuje o rzeczy, które sprzedaż już ustaliła.</h3></div></li><li data-astro-cid-7yq64bwo><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" data-astro-cid-zgufigjl><path d="m5 12 4 4L19 6" data-astro-cid-zgufigjl></path></svg><div class="item-copy" data-astro-cid-7yq64bwo><h3 id="chcesz-korzystac-z-agentforce-i-automatyzacji-ale-dane-w-crm-sie-do-tego-nie-nadaja" class="type-heading-xs" data-astro-cid-7yq64bwo>Chcesz korzystać z Agentforce i automatyzacji, ale dane w CRM się do tego nie nadają.</h3></div></li></ul></div></div></section><section class="content-grid section content-section" data-astro-cid-7wj36s4i><div class="block-inner" data-astro-cid-7wj36s4i><div class="content-layout" data-astro-cid-7yq64bwo><header class="intro" data-astro-cid-7yq64bwo><h2 id="od-procesu-do-zespolu-ktory-sam-administruje-salesforce" data-astro-cid-7yq64bwo>Od procesu do zespołu, który sam administruje Salesforce</h2><div class="pt prose flow" data-astro-cid-6amch4or><p data-astro-cid-6amch4or="true">Współpraca trwa 3 miesiące. Pierwszy idzie na proces, dane i konfigurację, kolejne dwa na warsztaty, treningi i zmianę nawyków pracy.</p></div></header></div></div></section><section class="content-grid section feature" data-astro-cid-7wj36s4i><div class="block-inner" data-astro-cid-7wj36s4i><div class="feature-layout has-media" data-astro-cid-yr23l7fg><div class="copy" data-astro-cid-yr23l7fg><p class="type-tagline" data-astro-cid-yr23l7fg>Krok 1</p><h2 id="proces-sprzedazy-i-wybor-pakietu" data-astro-cid-yr23l7fg="true">Proces sprzedaży i wybór pakietu</h2><div class="pt prose flow" data-astro-cid-6amch4or><p data-astro-cid-6amch4or="true">Zaczynam od tego, jak sprzedajecie dziś. Etapy lejka, kwalifikacja, dane potrzebne na każdym etapie. Na tej podstawie dobieramy pakiet Salesforce, zwykle Starter albo Pro Suite, zamiast kupować licencje na zapas.<br>Ten etap robię zawsze, niezależnie od tego, czy przechodzisz z Pipedrive&#39;a, HubSpota albo Excela, czy porządkujesz Salesforce, który już macie.</p></div></div><figure class="media" data-astro-cid-yr23l7fg><style>
[data-diagram="zw-crm-process"] {
    --zw-primary:#3A48CC; --zw-primary-10:#EBEDFA; --zw-primary-30:#8991E0;
    --zw-secondary:#0ACFFE; --zw-success:#52C41A; --zw-bg-soft:#F9FAFB;
    --zw-border:#DDE1E6; --zw-border-soft:#EDF0F3; --zw-heading:#0E0F11;
    --zw-text:#1E2024; --zw-muted:#838D95; --zw-card:#FFFFFF;
    --zw-font:'Satoshi Variable','Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,system-ui,sans-serif;
    --zw-serif:'Erode Variable','Fraunces','Source Serif 4',Georgia,serif;
    --zw-radius-card:10px; --zw-radius-lane:14px;
    --zw-shadow-rest:0 1px 3px rgba(0,0,0,.08);
    --zw-shadow-lift:1px 8px 22px rgba(14,15,17,.14);
    font-family:var(--zw-font); width:100%; max-width:440px; margin:0 auto;
    box-sizing:border-box; -webkit-font-smoothing:antialiased;
  }
  [data-diagram="zw-crm-process"] *, [data-diagram="zw-crm-process"] *::before, [data-diagram="zw-crm-process"] *::after { box-sizing:border-box; }
  [data-diagram="zw-crm-process"] .zw-stage { width:100%; overflow:hidden; }
  [data-diagram="zw-crm-process"] .zw-fit { width:400px; transform-origin:top left; }
  [data-diagram="zw-crm-process"] .zw-scene { position:relative; }
  [data-diagram="zw-crm-process"] .zw-confetti { position:absolute; top:0; left:0; width:0; height:0; z-index:9; pointer-events:none; }
  [data-diagram="zw-crm-process"] .zw-confetti i { position:absolute; width:8px; height:8px; border-radius:2px; will-change:transform,opacity; }

  /* =================== SCENE:STYLE start =================== */
  [data-diagram="zw-crm-process"] .cp-panel {
    position:relative; width:360px; height:220px; margin:6px auto;
    background:var(--zw-bg-soft); border:1px solid var(--zw-border);
    border-radius:var(--zw-radius-lane); overflow:hidden;
  }
  [data-diagram="zw-crm-process"] .cp-current, [data-diagram="zw-crm-process"] .cp-final { position:absolute; inset:0; }
  [data-diagram="zw-crm-process"] .cp-eyebrow {
    position:absolute; top:18px; left:20px; font-size:12px; font-weight:700;
    letter-spacing:.09em; text-transform:uppercase; color:var(--zw-muted);
  }
  [data-diagram="zw-crm-process"] .cp-card {
    position:absolute; top:68px; width:94px; height:102px; padding:13px;
    background:var(--zw-card); border:1px solid var(--zw-border);
    border-radius:var(--zw-radius-card); box-shadow:var(--zw-shadow-rest);
    opacity:0;
  }
  [data-diagram="zw-crm-process"] .cp-card--a { left:20px; transform:rotate(-3deg) translateY(7px); }
  [data-diagram="zw-crm-process"] .cp-card--b { left:133px; transform:rotate(2deg) translateY(-5px); }
  [data-diagram="zw-crm-process"] .cp-card--c { left:246px; transform:rotate(-1deg) translateY(5px); }
  [data-diagram="zw-crm-process"] .cp-card b, [data-diagram="zw-crm-process"] .cp-label {
    display:block; font-size:12px; font-weight:700; color:var(--zw-heading);
  }
  [data-diagram="zw-crm-process"] .cp-lane .cp-label { font-size:9px; letter-spacing:.01em; }
  [data-diagram="zw-crm-process"] .cp-card i, [data-diagram="zw-crm-process"] .cp-lane i {
    display:block; height:6px; margin-top:10px; border-radius:4px; background:var(--zw-border-soft);
  }
  [data-diagram="zw-crm-process"] .cp-card i:nth-of-type(1) { width:72%; }
  [data-diagram="zw-crm-process"] .cp-card i:nth-of-type(2) { width:48%; }
  [data-diagram="zw-crm-process"] .cp-card em {
    position:absolute; right:10px; bottom:9px; width:18px; height:18px;
    display:flex; align-items:center; justify-content:center; border-radius:50%;
    background:var(--zw-border-soft); color:var(--zw-muted); font-size:11px;
    font-style:normal; font-weight:700;
  }
  [data-diagram="zw-crm-process"] .cp-scan {
    position:absolute; top:52px; left:18px; width:2px; height:132px;
    background:var(--zw-secondary); box-shadow:0 0 0 5px rgba(10,207,254,.12);
    opacity:0; will-change:transform,opacity;
  }
  [data-diagram="zw-crm-process"] .cp-final { opacity:0; }
  [data-diagram="zw-crm-process"] .cp-lane {
    position:absolute; top:67px; width:92px; height:114px; padding:13px 11px;
    background:var(--zw-card); border:1px solid var(--zw-primary-30);
    border-radius:var(--zw-radius-card); box-shadow:var(--zw-shadow-rest);
    opacity:0;
  }
  [data-diagram="zw-crm-process"] .cp-lane:nth-of-type(1) { left:20px; }
  [data-diagram="zw-crm-process"] .cp-lane:nth-of-type(2) { left:134px; }
  [data-diagram="zw-crm-process"] .cp-lane:nth-of-type(3) { left:248px; }
  [data-diagram="zw-crm-process"] .cp-chip {
    position:absolute; top:10px; right:9px; min-width:20px; padding:2px 5px;
    border-radius:999px; background:var(--zw-primary-10); color:var(--zw-primary);
    font-size:10px; font-weight:700; text-align:center;
  }
  [data-diagram="zw-crm-process"] .cp-lane i { background:var(--zw-primary-10); }
  [data-diagram="zw-crm-process"] .cp-lane i:nth-of-type(1) { width:74%; margin-top:18px; }
  [data-diagram="zw-crm-process"] .cp-lane i:nth-of-type(2) { width:54%; }
  [data-diagram="zw-crm-process"] .cp-lane i:nth-of-type(3) { width:66%; }
  [data-diagram="zw-crm-process"] .cp-arrow {
    position:absolute; top:112px; color:var(--zw-primary-30); font-size:16px; font-weight:700;
    opacity:0;
  }
  [data-diagram="zw-crm-process"] .cp-arrow--1 { left:116px; }
  [data-diagram="zw-crm-process"] .cp-arrow--2 { left:230px; }
  [data-diagram="zw-crm-process"] .cp-ready {
    position:absolute; right:12px; bottom:12px; width:27px; height:27px;
    display:flex; align-items:center; justify-content:center; border-radius:50%;
    background:var(--zw-success); color:#fff; transform:scale(0);
  }
  [data-diagram="zw-crm-process"] .cp-ready svg { width:15px; height:15px; }
  [data-diagram="zw-crm-process"] .cp-ready path { fill:none; stroke:currentColor; stroke-width:2.6; stroke-linecap:round; stroke-linejoin:round; }
  /* ==================== SCENE:STYLE end ==================== */

  @media (prefers-reduced-motion:reduce) {
    [data-diagram="zw-crm-process"] .cp-current, [data-diagram="zw-crm-process"] .cp-card { opacity:0; }
    [data-diagram="zw-crm-process"] .cp-final, [data-diagram="zw-crm-process"] .cp-lane, [data-diagram="zw-crm-process"] .cp-arrow { opacity:1; }
    [data-diagram="zw-crm-process"] .cp-ready { transform:scale(1); }
  }
