  }
  [data-diagram="zw-crm-training"] .ct-cursor{
    position:absolute;right:-13px;bottom:-13px;width:28px;height:28px;display:flex;align-items:center;
    justify-content:center;border-radius:50%;background:var(--zw-primary);color:#fff;opacity:0
  }
  [data-diagram="zw-crm-training"] .ct-cursor svg{width:14px;height:14px}
  [data-diagram="zw-crm-training"] .ct-cursor path{fill:currentColor}
  [data-diagram="zw-crm-training"] .ct-coaching{
