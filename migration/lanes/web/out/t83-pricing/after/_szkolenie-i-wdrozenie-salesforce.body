sanity.io/images/8u2zjhvn/production/e8a979885ea0252c20586301257dc7ff6a18471e-200x200.avif?w=160&amp;fit=max&amp;auto=format 160w, https://cdn.sanity.io/images/8u2zjhvn/production/e8a979885ea0252c20586301257dc7ff6a18471e-200x200.avif?w=200&amp;fit=max&amp;auto=format 200w" sizes="8rem" alt="bosko agency logo" width="200" height="200" loading="lazy" decoding="async" data-astro-cid-7hzkb424></li><li tabindex="0" data-astro-cid-7hzkb424><img src="https://cdn.sanity.io/images/8u2zjhvn/production/db18643dd251151a0763458152ad2fe30515981c-128x54.svg?w=128&amp;fit=max&amp;auto=format" sizes="8rem" alt="costa broker logo" width="128" height="54" loading="lazy" decoding="async" data-astro-cid-7hzkb424></li><li tabindex="0" data-astro-cid-7hzkb424><img src="https://cdn.sanity.io/images/8u2zjhvn/production/d5b42bc8874b5f67e273514926ddc51bf1e4690a-207x35.svg?w=207&amp;fit=max&amp;auto=format" srcset="https://cdn.sanity.io/images/8u2zjhvn/production/d5b42bc8874b5f67e273514926ddc51bf1e4690a-207x35.svg?w=160&amp;fit=max&amp;auto=format 160w, https://cdn.sanity.io/images/8u2zjhvn/production/d5b42bc8874b5f67e273514926ddc51bf1e4690a-207x35.svg?w=207&amp;fit=max&amp;auto=format 207w" sizes="8rem" alt="optima home logo" width="207" height="35" loading="lazy" decoding="async" data-astro-cid-7hzkb424></li><li tabindex="0" data-astro-cid-7hzkb424><img src="https://cdn.sanity.io/images/8u2zjhvn/production/112507c3895b6af8a666c03f3b74f6b74fae0191-460x132.svg?w=460&amp;fit=max&amp;auto=format" srcset="https://cdn.sanity.io/images/8u2zjhvn/production/112507c3895b6af8a666c03f3b74f6b74fae0191-460x132.svg?w=160&amp;fit=max&amp;auto=format 160w, https://cdn.sanity.io/images/8u2zjhvn/production/112507c3895b6af8a666c03f3b74f6b74fae0191-460x132.svg?w=320&amp;fit=max&amp;auto=format 320w, https://cdn.sanity.io/images/8u2zjhvn/production/112507c3895b6af8a666c03f3b74f6b74fae0191-460x132.svg?w=460&amp;fit=max&amp;auto=format 460w" sizes="8rem" alt="Lex Capital logo" width="460" height="132" loading="lazy" decoding="async" data-astro-cid-7hzkb424></li><li tabindex="0" class="difference" data-astro-cid-7hzkb424><img src="https://cdn.sanity.io/images/8u2zjhvn/production/19781b523858b732d164ff6a718a8c65041c338b-512x512.avif?w=512&amp;fit=max&amp;auto=format" srcset="https://cdn.sanity.io/images/8u2zjhvn/production/19781b523858b732d164ff6a718a8c65041c338b-512x512.avif?w=160&amp;fit=max&amp;auto=format 160w, https://cdn.sanity.io/images/8u2zjhvn/production/19781b523858b732d164ff6a718a8c65041c338b-512x512.avif?w=320&amp;fit=max&amp;auto=format 320w, https://cdn.sanity.io/images/8u2zjhvn/production/19781b523858b732d164ff6a718a8c65041c338b-512x512.avif?w=480&amp;fit=max&amp;auto=format 480w, https://cdn.sanity.io/images/8u2zjhvn/production/19781b523858b732d164ff6a718a8c65041c338b-512x512.avif?w=512&amp;fit=max&amp;auto=format 512w" sizes="8rem" alt="iimarbella logo" width="512" height="512" loading="lazy" decoding="async" data-astro-cid-7hzkb424></li><li tabindex="0" data-astro-cid-7hzkb424><img src="https://cdn.sanity.io/images/8u2zjhvn/production/936866fe58f09b62ada4cdbf319176f5dcce9f15-261x98.webp?w=261&amp;fit=max&amp;auto=format" srcset="https://cdn.sanity.io/images/8u2zjhvn/production/936866fe58f09b62ada4cdbf319176f5dcce9f15-261x98.webp?w=160&amp;fit=max&amp;auto=format 160w, https://cdn.sanity.io/images/8u2zjhvn/production/936866fe58f09b62ada4cdbf319176f5dcce9f15-261x98.webp?w=261&amp;fit=max&amp;auto=format 261w" sizes="8rem" alt="vadim eyewear logo" width="261" height="98" loading="lazy" decoding="async" data-astro-cid-7hzkb424></li><li tabindex="0" data-astro-cid-7hzkb424><img src="https://cdn.sanity.io/images/8u2zjhvn/production/690df68b76dbc228fba092407207caedc24a07fb-261x54.svg?w=261&amp;fit=max&amp;auto=format" srcset="https://cdn.sanity.io/images/8u2zjhvn/production/690df68b76dbc228fba092407207caedc24a07fb-261x54.svg?w=160&amp;fit=max&amp;auto=format 160w, https://cdn.sanity.io/images/8u2zjhvn/production/690df68b76dbc228fba092407207caedc24a07fb-261x54.svg?w=261&amp;fit=max&amp;auto=format 261w" sizes="8rem" alt="pro science logo" width="261" height="54" loading="lazy" decoding="async" data-astro-cid-7hzkb424></li><li tabindex="0" data-astro-cid-7hzkb424><img src="https://cdn.sanity.io/images/8u2zjhvn/production/ef0e7944efc0b3f7652c57ac775c681ff67477ed-249x64.svg?w=249&amp;fit=max&amp;auto=format" srcset="https://cdn.sanity.io/images/8u2zjhvn/production/ef0e7944efc0b3f7652c57ac775c681ff67477ed-249x64.svg?w=160&amp;fit=max&amp;auto=format 160w, https://cdn.sanity.io/images/8u2zjhvn/production/ef0e7944efc0b3f7652c57ac775c681ff67477ed-249x64.svg?w=249&amp;fit=max&amp;auto=format 249w" sizes="8rem" alt="cash4car logo" width="249" height="64" loading="lazy" decoding="async" data-astro-cid-7hzkb424></li><li tabindex="0" class="difference" data-astro-cid-7hzkb424><img src="https://cdn.sanity.io/images/8u2zjhvn/production/f2d294031922c374c1697ba65ecc9d0d58fc67bd-411x103.svg?w=411&amp;fit=max&amp;auto=format" srcset="https://cdn.sanity.io/images/8u2zjhvn/production/f2d294031922c374c1697ba65ecc9d0d58fc67bd-411x103.svg?w=160&amp;fit=max&amp;auto=format 160w, https://cdn.sanity.io/images/8u2zjhvn/production/f2d294031922c374c1697ba65ecc9d0d58fc67bd-411x103.svg?w=320&amp;fit=max&amp;auto=format 320w, https://cdn.sanity.io/images/8u2zjhvn/production/f2d294031922c374c1697ba65ecc9d0d58fc67bd-411x103.svg?w=411&amp;fit=max&amp;auto=format 411w" sizes="8rem" alt="deky expo logo" width="411" height="103" loading="lazy" decoding="async" data-astro-cid-7hzkb424></li></ul></div></div></section><section class="content-grid section feature" data-astro-cid-7wj36s4i><div class="block-inner" data-astro-cid-7wj36s4i><div class="feature-layout has-media" data-astro-cid-yr23l7fg><div class="copy" data-astro-cid-yr23l7fg><h2 id="w-salesforce-zbudujesz-prawie-wszystko-problem-w-tym-ze-latwo-zbudowac-za-duzo" data-astro-cid-yr23l7fg="true">W Salesforce zbudujesz prawie wszystko. Problem w tym, że łatwo zbudować za dużo.</h2><div class="pt prose flow" data-astro-cid-6amch4or><p data-astro-cid-6amch4or="true">Firmy przechodzą na Salesforce, bo prosty CRM przestał wystarczać. Potrzebują własnych obiektów, osobnej obsługi klienta albo uprawnień dla kilku oddziałów.<br>Potem dostają system skrojony pod korporację, z dziesiątkami pól, ustawieniami po angielsku i raportami, których nikt nie otwiera. Handlowcy wracają do Excela, a licencja dalej kosztuje co miesiąc.<br>Dlatego nie sprzedaję konfiguracji konta. Buduję w Salesforce tylko to, czego potrzebuje Twój proces, i kończę wtedy, gdy zespół faktycznie w nim pracuje.</p></div><a class="action text" href="/kontakt" data-astro-cid-j6ocf6pu><span data-astro-cid-j6ocf6pu>Porozmawiajmy o waszym procesie</span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" data-astro-cid-zgufigjl><path d="M4 12h16m-6-6 6 6-6 6" data-astro-cid-zgufigjl></path></svg></a></div><figure class="media" data-astro-cid-yr23l7fg><style>
/* ---- Shared family layer: tokens + responsive shell (verbatim). ---- */
  [data-diagram="zw-sf-problem"] {
    --zw-primary:    #3A48CC;
    --zw-primary-10: #EBEDFA;
    --zw-primary-30: #8991E0;
    --zw-secondary:  #0ACFFE;
    --zw-success:    #52C41A;
    --zw-bg-soft:    #F9FAFB;
    --zw-border:     #DDE1E6;
    --zw-border-soft:#EDF0F3;
    --zw-heading:    #0E0F11;
    --zw-text:       #1E2024;
    --zw-muted:      #838D95;
    --zw-card:       #FFFFFF;
    --zw-font: 'Satoshi Variable','Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,system-ui,sans-serif;
    --zw-serif: 'Erode Variable','Fraunces','Source Serif 4',Georgia,serif;
    --zw-radius-card: 10px;
    --zw-radius-lane: 14px;
    --zw-shadow-rest: 0 1px 3px rgba(0,0,0,.08);
    --zw-shadow-lift: 1px 8px 22px rgba(14,15,17,.14);

    font-family: var(--zw-font);
    width: 100%;
    max-width: 920px;
    margin: 0 auto;
    box-sizing: border-box;
    -webkit-font-smoothing: antialiased;
  }
  [data-diagram="zw-sf-problem"] *, [data-diagram="zw-sf-problem"] *::before, [data-diagram="zw-sf-problem"] *::after { box-sizing: border-box; }

  [data-diagram="zw-sf-problem"] .zw-stage { width: 100%; overflow: hidden; }
  [data-diagram="zw-sf-problem"] .zw-fit   { width: 760px; transform-origin: top left; }
  [data-diagram="zw-sf-problem"] .zw-scene { position: relative; }

  /* =================== SCENE:STYLE start =================== */
  [data-diagram="zw-sf-problem"] .sp-board { position: relative; width: 760px; display: flex; gap: 24px; align-items: flex-start; }

  [data-diagram="zw-sf-problem"] .sp-eyebrow {
    font-size: 12px; font-weight: 700; letter-spacing: .07em;
    text-transform: uppercase; color: var(--zw-muted);
  }

  /* ---- The overbuilt record ---- */
  [data-diagram="zw-sf-problem"] .sp-rec {
    position: relative; flex: 0 0 440px;
    background: var(--zw-bg-soft);
    border: 1px solid var(--zw-border);
    border-radius: var(--zw-radius-lane);
    padding: 14px 16px 16px;
    overflow: hidden;
    opacity: 0; transform: translateY(14px);
  }
  [data-diagram="zw-sf-problem"] .sp-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px; }
  [data-diagram="zw-sf-problem"] .sp-chip {
    font-size: 12px; font-weight: 600; color: #636B75;
    background: var(--zw-border-soft); border-radius: 999px;
    padding: 2px 10px; transition: color .4s ease, background-color .4s ease;
  }
  [data-diagram="zw-sf-problem"] .sp-chip b { font-weight: 700; color: var(--zw-primary); transition: color .4s ease; }
  [data-diagram="zw-sf-problem"] .sp-chip--heavy { background: var(--zw-primary-10); }

  [data-diagram="zw-sf-problem"] .sp-tabs { display: flex; gap: 6px; margin-bottom: 12px; }
  [data-diagram="zw-sf-problem"] .sp-tab {
    font-size: 10px; font-weight: 700; letter-spacing: .05em; text-transform: uppercase;
    color: var(--zw-primary); background: var(--zw-primary-10);
    border-radius: 6px; padding: 4px 8px;
    opacity: 0; transform: scale(.8);
    transition: color .4s ease, background-color .4s ease;
  }

  [data-diagram="zw-sf-problem"] .sp-slot {
    height: 88px; border-radius: 8px;
    border: 1.5px dashed var(--zw-border);
    margin-bottom: 14px;
  }

  [data-diagram="zw-sf-problem"] .sp-fields { display: grid; grid-template-columns: 1fr 1fr; gap: 9px 14px; }
  [data-diagram="zw-sf-problem"] .sp-field { opacity: 0; transform: translateY(6px); transition: opacity .4s ease; }
  [data-diagram="zw-sf-problem"] .sp-field i { display: block; width: 42%; height: 6px; border-radius: 3px; background: #E3E6EA; margin-bottom: 5px; }
  [data-diagram="zw-sf-problem"] .sp-field:nth-child(3n+2) i { width: 58%; }
  [data-diagram="zw-sf-problem"] .sp-field:nth-child(4n+3) i { width: 34%; }
  [data-diagram="zw-sf-problem"] .sp-field span {
    display: block; height: 20px; border-radius: 6px;
    background: var(--zw-card); border: 1px solid var(--zw-border-soft);
  }
  [data-diagram="zw-sf-problem"] .sp-fade {
    position: absolute; left: 0; right: 0; bottom: 0; height: 46px;
    background: linear-gradient(to bottom, rgba(249,250,251,0), var(--zw-bg-soft));
    pointer-events: none;
  }
  /* the record after the seller leaves */
  [data-diagram="zw-sf-problem"] .sp-rec--idle .sp-field { opacity: .6 !important; }
  [data-diagram="zw-sf-problem"] .sp-rec--idle .sp-tab { color: var(--zw-muted); background: var(--zw-border-soft); }
  [data-diagram="zw-sf-problem"] .sp-rec--idle .sp-chip { background: var(--zw-border-soft); }
  [data-diagram="zw-sf-problem"] .sp-rec--idle .sp-chip b { color: var(--zw-muted); }

  /* ---- Right column: sheet + consequences ---- */
  [data-diagram="zw-sf-problem"] .sp-side { flex: 1 1 0; min-width: 0; display: flex; flex-direction: column; gap: 16px; }
  [data-diagram="zw-sf-problem"] .sp-sheet {
    background: var(--zw-card);
    border: 1.5px dashed var(--zw-border);
    border-radius: var(--zw-radius-lane);
    padding: 13px 14px 14px;
    opacity: 0; transform: translateY(14px);
  }
  [data-diagram="zw-sf-problem"] .sp-sheet-head { display: flex; align-items: center; gap: 7px; margin-bottom: 12px; }
  [data-diagram="zw-sf-problem"] .sp-ic { color: var(--zw-muted); display: flex; }
  [data-diagram="zw-sf-problem"] .sp-grid { display: grid; grid-template-columns: 1.4fr 1fr 1fr; gap: 6px; }
  [data-diagram="zw-sf-problem"] .sp-grid i { display: block; height: 14px; border-radius: 3px; background: var(--zw-bg-soft); border: 1px solid var(--zw-border-soft); }
  [data-diagram="zw-sf-problem"] .sp-land {
    height: 96px; margin: 8px 0; border-radius: 8px;
    border: 1.5px dashed var(--zw-border-soft);
    transition: border-color .4s ease, background-color .4s ease;
  }
  [data-diagram="zw-sf-problem"] .sp-land--eyeing { border-color: var(--zw-primary-30); background: var(--zw-primary-10); }

  [data-diagram="zw-sf-problem"] .sp-stats { display: flex; gap: 12px; }
  [data-diagram="zw-sf-problem"] .sp-stat {
    position: relative; flex: 1 1 0; min-width: 0;
    background: var(--zw-card);
    border: 1px solid var(--zw-border);
    border-radius: var(--zw-radius-card);
    box-shadow: var(--zw-shadow-rest);
    padding: 11px 12px 12px;
    opacity: 0; transform: translateY(10px);
  }
  [data-diagram="zw-sf-problem"] .sp-stat-row { display: flex; align-items: baseline; gap: 5px; margin-top: 6px; }
  [data-diagram="zw-sf-problem"] .sp-stat-num { font-size: 19px; font-weight: 700; color: var(--zw-heading); letter-spacing: -0.01em; line-height: 1.1; }
  [data-diagram="zw-sf-problem"] .sp-stat-sub { font-size: 11px; font-weight: 600; color: var(--zw-muted); }
  [data-diagram="zw-sf-problem"] .sp-warn { margin-left: auto; color: var(--zw-secondary); display: flex; align-self: center; }
  [data-diagram="zw-sf-problem"] .sp-tick {
    position: absolute; inset: -1px; border: 2px solid var(--zw-secondary);
    border-radius: var(--zw-radius-card); opacity: 0; pointer-events: none;
  }

  /* ---- The deal we follow ---- */
  [data-diagram="zw-sf-problem"] .sp-deal {
    position: absolute; top: 0; left: 0; z-index: 6;
    width: 208px;
    background: var(--zw-card);
    border: 1px solid var(--zw-border);
    border-radius: var(--zw-radius-card);
    padding: 12px 12px 12px 14px;
    box-shadow: var(--zw-shadow-rest);
    opacity: 0;
    overflow: hidden;
    will-change: transform, opacity;
  }
  [data-diagram="zw-sf-problem"] .sp-deal::before {
    content: ""; position: absolute; left: 0; top: 0; bottom: 0; width: 3px;
    background: var(--zw-primary);
    transition: background-color .4s ease;
  }
  [data-diagram="zw-sf-problem"] .sp-deal--off::before { background: var(--zw-border); }
  [data-diagram="zw-sf-problem"] .sp-deal-top { display: flex; align-items: center; gap: 8px; margin-bottom: 8px; }
  [data-diagram="zw-sf-problem"] .sp-avatar {
    flex: 0 0 auto; width: 22px; height: 22px; border-radius: 999px;
    background: var(--zw-primary-10); color: var(--zw-primary);
    font-size: 11px; font-weight: 700;
    display: flex; align-items: center; justify-content: center;
  }
  [data-diagram="zw-sf-problem"] .sp-deal-name { font-size: 13px; font-weight: 600; color: var(--zw-heading); }
  [data-diagram="zw-sf-problem"] .sp-deal-value { font-size: 19px; font-weight: 700; color: var(--zw-heading); letter-spacing: -0.01em; line-height: 1.1; }
  [data-diagram="zw-sf-problem"] .sp-deal-foot { margin-top: 10px; }
  [data-diagram="zw-sf-problem"] .sp-tag {
    display: inline-block; font-size: 10px; font-weight: 600;
    letter-spacing: .04em; text-transform: uppercase;
    color: var(--zw-primary); background: var(--zw-primary-10);
    border-radius: 6px; padding: 3px 8px;
    transition: color .4s ease, background-color .4s ease;
  }
  [data-diagram="zw-sf-problem"] .sp-deal--off .sp-tag { color: var(--zw-muted); background: var(--zw-border-soft); }
  /* ==================== SCENE:STYLE end ==================== */

  /* Accessibility: land on the resolved problem state, no motion. */
  @media (prefers-reduced-motion: reduce) {
    [data-diagram="zw-sf-problem"] .sp-rec,
    [data-diagram="zw-sf-problem"] .sp-sheet,
    [data-diagram="zw-sf-problem"] .sp-stat { opacity: 1; transform: none; }
    [data-diagram="zw-sf-problem"] .sp-tab { opacity: 1; transform: none; color: var(--zw-muted); background: var(--zw-border-soft); }
    [data-diagram="zw-sf-problem"] .sp-field { opacity: .6; transform: none; }
    [data-diagram="zw-sf-problem"] .sp-deal { opacity: 1; }
    [data-diagram="zw-sf-problem"] .sp-deal::before { background: var(--zw-border); }
    [data-diagram="zw-sf-problem"] .sp-deal .sp-tag { color: var(--zw-muted); background: var(--zw-border-soft); }
    [data-diagram="zw-sf-problem"] .sp-chip b { color: var(--zw-muted); }
  }
