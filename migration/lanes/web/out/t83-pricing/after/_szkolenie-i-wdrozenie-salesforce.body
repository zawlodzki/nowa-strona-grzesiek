    background:var(--zw-card);border:1px solid var(--zw-border);border-radius:var(--zw-radius-card);
    box-shadow:var(--zw-shadow-rest);opacity:0
  }
  [data-diagram="zw-crm-training"] .ct-eyebrow{display:block;margin-bottom:12px}
  [data-diagram="zw-crm-training"] .ct-person{display:flex;align-items:center;gap:8px;margin-bottom:12px;opacity:.45}
  [data-diagram="zw-crm-training"] .ct-person>i{
