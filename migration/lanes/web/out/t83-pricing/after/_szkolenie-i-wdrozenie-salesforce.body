    --zw-shadow-lift:1px 8px 22px rgba(14,15,17,.14);
    font-family:var(--zw-font);width:100%;max-width:440px;margin:0 auto;
    box-sizing:border-box;-webkit-font-smoothing:antialiased;
  }
  [data-diagram="zw-sf-setup"] *,[data-diagram="zw-sf-setup"] *::before,[data-diagram="zw-sf-setup"] *::after{box-sizing:border-box}
  [data-diagram="zw-sf-setup"] .zw-stage{width:100%;overflow:hidden}
