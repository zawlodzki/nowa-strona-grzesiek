  [data-diagram="zw-crm-training"] .zw-confetti i{position:absolute;width:8px;height:8px;border-radius:2px;will-change:transform,opacity}

  /* =================== SCENE:STYLE start =================== */
  [data-diagram="zw-crm-training"] .ct-panel{
