  [data-diagram="zw-sf-setup"] .zw-confetti{position:absolute;top:0;left:0;width:0;height:0;z-index:9;pointer-events:none}
  [data-diagram="zw-sf-setup"] .zw-confetti i{position:absolute;width:8px;height:8px;border-radius:2px;will-change:transform,opacity}

  /* =================== SCENE:STYLE start =================== */
  [data-diagram="zw-sf-setup"] .cs-panel{
    position:relative;width:360px;height:220px;margin:6px auto;
    background:var(--zw-bg-soft);border:1px solid var(--zw-border);
    border-radius:var(--zw-radius-lane);overflow:hidden;
  }
  [data-diagram="zw-sf-setup"] .cs-line{
    position:absolute;left:180px;top:109px;height:2px;background:var(--zw-primary-30);
    transform-origin:left center;z-index:1;opacity:.75;will-change:transform;
  }
  [data-diagram="zw-sf-setup"] .cs-line--1{width:124px;transform:rotate(-159deg) scaleX(0)}
  [data-diagram="zw-sf-setup"] .cs-line--2{width:124px;transform:rotate(-21deg) scaleX(0)}
  [data-diagram="zw-sf-setup"] .cs-line--3{width:115px;transform:rotate(0deg) scaleX(0)}
  [data-diagram="zw-sf-setup"] .cs-line--4{width:124px;transform:rotate(21deg) scaleX(0)}
  [data-diagram="zw-sf-setup"] .cs-line--5{width:124px;transform:rotate(159deg) scaleX(0)}
  [data-diagram="zw-sf-setup"] .cs-line--6{width:116px;transform:rotate(180deg) scaleX(0)}
  [data-diagram="zw-sf-setup"] .cs-node{
    position:absolute;width:88px;height:38px;padding:7px 9px;display:flex;align-items:center;gap:7px;
    background:var(--zw-card);border:1px solid var(--zw-border);border-radius:var(--zw-radius-card);
    box-shadow:var(--zw-shadow-rest);z-index:2;opacity:0;
  }
  [data-diagram="zw-sf-setup"] .cs-node--1{left:20px;top:31px}
  [data-diagram="zw-sf-setup"] .cs-node--2{right:20px;top:31px}
  [data-diagram="zw-sf-setup"] .cs-node--3{right:20px;top:90px}
  [data-diagram="zw-sf-setup"] .cs-node--4{right:20px;top:149px}
  [data-diagram="zw-sf-setup"] .cs-node--5{left:20px;top:149px}
  [data-diagram="zw-sf-setup"] .cs-node--6{left:20px;top:90px}
