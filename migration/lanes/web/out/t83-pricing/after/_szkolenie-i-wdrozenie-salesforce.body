    align-items:center;justify-content:center;gap:7px;background:var(--zw-card);
    border:1px solid var(--zw-border);border-radius:var(--zw-radius-card);box-shadow:var(--zw-shadow-rest);
    z-index:2;opacity:0
  }
  [data-diagram="zw-crm-handoff"] .ch-person--consultant{left:20px}
  [data-diagram="zw-crm-handoff"] .ch-person--admin{right:20px}
  [data-diagram="zw-crm-handoff"] .ch-avatar{
    width:34px;height:34px;display:flex;align-items:center;justify-content:center;border-radius:50%;
    background:var(--zw-border-soft);color:var(--zw-muted);font-size:10px;font-weight:800
  }
  [data-diagram="zw-crm-handoff"] .ch-person>b{font-size:10px;color:var(--zw-text)}
  [data-diagram="zw-crm-handoff"] .ch-person--admin.ch-person--owner{border-color:var(--zw-primary-30)}
  [data-diagram="zw-crm-handoff"] .ch-person--admin.ch-person--owner .ch-avatar{background:var(--zw-primary);color:#fff}
  [data-diagram="zw-crm-handoff"] .ch-owner{
    position:absolute;left:8px;right:8px;bottom:-12px;height:24px;display:flex;align-items:center;
    justify-content:center;border-radius:999px;background:var(--zw-success);color:#fff;
    font-size:9px;font-weight:800;font-style:normal;letter-spacing:.06em;text-transform:uppercase;
    transform:scale(0);z-index:3
  }
  [data-diagram="zw-crm-handoff"] .ch-ring{
    position:absolute;inset:-1px;border:2px solid var(--zw-success);border-radius:var(--zw-radius-card);
    opacity:0;pointer-events:none
  }
  [data-diagram="zw-crm-handoff"] .ch-system{
    position:absolute;left:126px;top:36px;width:108px;height:148px;padding:11px;
    background:var(--zw-card);border:1px solid var(--zw-border);border-radius:var(--zw-radius-card);
    box-shadow:var(--zw-shadow-lift);z-index:3;opacity:0
  }
  [data-diagram="zw-crm-handoff"] .ch-system-head{display:flex;align-items:center;gap:7px;margin-bottom:12px}
  [data-diagram="zw-crm-handoff"] .ch-logo{
    width:24px;height:24px;display:flex;align-items:center;justify-content:center;border-radius:7px;
    background:var(--zw-primary);color:#fff;font-size:11px;font-weight:800
  }
  [data-diagram="zw-crm-handoff"] .ch-system-head b{font-size:11px;color:var(--zw-heading)}
  [data-diagram="zw-crm-handoff"] .ch-check{
    margin-left:auto;width:19px;height:19px;display:flex;align-items:center;justify-content:center;
    border-radius:50%;background:var(--zw-success);color:#fff;transform:scale(0)
  }
  [data-diagram="zw-crm-handoff"] .ch-check svg{width:11px;height:11px}
  [data-diagram="zw-crm-handoff"] .ch-check path{fill:none;stroke:currentColor;stroke-width:2.7;stroke-linecap:round;stroke-linejoin:round}
  [data-diagram="zw-crm-handoff"] .ch-item{
    height:26px;display:flex;align-items:center;gap:7px;margin-bottom:7px;padding:0 7px;
    border-radius:6px;background:var(--zw-border-soft);opacity:0
  }
  [data-diagram="zw-crm-handoff"] .ch-item span{
    width:20px;height:16px;display:flex;align-items:center;justify-content:center;border-radius:4px;
    background:var(--zw-card);color:var(--zw-primary);font-size:8px;font-weight:800
  }
  [data-diagram="zw-crm-handoff"] .ch-item b{font-size:9px;color:var(--zw-text)}
  [data-diagram="zw-crm-handoff"] .ch-key{
    position:absolute;left:48px;top:94px;width:30px;height:30px;display:flex;align-items:center;
    justify-content:center;border-radius:50%;background:var(--zw-primary);color:#fff;
    box-shadow:var(--zw-shadow-lift);z-index:6;opacity:0;will-change:transform,opacity
  }
  [data-diagram="zw-crm-handoff"] .ch-key svg{width:16px;height:16px}
  [data-diagram="zw-crm-handoff"] .ch-key path{fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
