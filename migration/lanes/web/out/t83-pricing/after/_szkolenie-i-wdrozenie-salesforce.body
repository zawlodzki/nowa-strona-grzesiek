    align-items:center;justify-content:center;border-radius:50%;background:var(--zw-success);
    color:#fff;transform:scale(0);z-index:3;
  }
  [data-diagram="zw-sf-setup"] .cs-core-check svg{width:13px;height:13px}
  [data-diagram="zw-sf-setup"] .cs-core-check path{fill:none;stroke:currentColor;stroke-width:2.7;stroke-linecap:round;stroke-linejoin:round}
  [data-diagram="zw-sf-setup"] .cs-pulse{
