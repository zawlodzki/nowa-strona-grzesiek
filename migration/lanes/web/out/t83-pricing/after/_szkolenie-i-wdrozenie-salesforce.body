    </script><link rel="preconnect" href="https://consent.zawlodzki.com" crossorigin><script defer src="https://consent.zawlodzki.com/assets/cmp-v1.js?v=20261113-1"></script><link rel="preload" href="/_astro/Satoshi-Variable.Xrx0dYoJ.woff2" as="font" type="font/woff2" crossorigin><link rel="preload" href="/_astro/Erode-Variable.cMk1Q8rP.woff2" as="font" type="font/woff2" crossorigin><title>Wdrożenie Salesforce i szkolenie zespołu handlowego</title><meta name="description" content="Wdrożenie Salesforce z procesem sprzedaży, migracją danych i szkoleniem zespołu. Do 15 osób: 9 tys. zł netto/mies. przez 3 miesiące (27 tys. łącznie)."><link rel="canonical" href="https://www.zawlodzki.pl/szkolenie-i-wdrozenie-salesforce"><link rel="alternate" type="text/markdown" href="https://www.zawlodzki.pl/szkolenie-i-wdrozenie-salesforce.md"><meta property="og:type" content="website"><meta property="og:title" content="Wdrożenie Salesforce i szkolenie zespołu handlowego"><meta property="og:description" content="Wdrożenie Salesforce z procesem sprzedaży, migracją danych i szkoleniem zespołu. Do 15 osób: 9 tys. zł netto/mies. przez 3 miesiące (27 tys. łącznie)."><meta property="og:url" content="https://www.zawlodzki.pl/szkolenie-i-wdrozenie-salesforce"><meta property="og:site_name" content="zawlodzki.pl"><meta property="og:locale" content="pl_PL"><meta property="og:image" content="https://cdn.sanity.io/images/8u2zjhvn/production/eb437a42bdab0d00dd5421faedbb92568b5fa0c5-1200x630.png?w=1200&amp;fit=max&amp;auto=format"><meta property="og:image:width" content="1200"><meta property="og:image:height" content="630"><meta property="og:image:alt" content="Wdrożenie Salesforce i szkolenie zespołu handlowego"><meta name="twitter:card" content="summary_large_image"><meta name="twitter:title" content="Wdrożenie Salesforce i szkolenie zespołu handlowego"><meta name="twitter:description" content="Wdrożenie Salesforce z procesem sprzedaży, migracją danych i szkoleniem zespołu. Do 15 osób: 9 tys. zł netto/mies. przez 3 miesiące (27 tys. łącznie)."><meta name="twitter:image" content="https://cdn.sanity.io/images/8u2zjhvn/production/eb437a42bdab0d00dd5421faedbb92568b5fa0c5-1200x630.png?w=1200&amp;fit=max&amp;auto=format"><script type="application/ld+json">{"@context":"https://schema.org","@graph":[{"@type":"WebPage","@id":"https://www.zawlodzki.pl/szkolenie-i-wdrozenie-salesforce#webpage","url":"https://www.zawlodzki.pl/szkolenie-i-wdrozenie-salesforce","name":"Wdrożenie Salesforce dla firm, które wyrosły z prostego CRM","description":"Wdrożenie Salesforce z procesem sprzedaży, migracją danych i szkoleniem zespołu. Do 15 osób: 9 tys. zł netto/mies. przez 3 miesiące (27 tys. łącznie).","inLanguage":"pl-PL","isPartOf":{"@id":"https://www.zawlodzki.pl/#website"},"about":{"@id":"https://www.zawlodzki.pl/szkolenie-i-wdrozenie-salesforce#service"},"mainEntity":{"@id":"https://www.zawlodzki.pl/szkolenie-i-wdrozenie-salesforce#service"},"breadcrumb":{"@id":"https://www.zawlodzki.pl/szkolenie-i-wdrozenie-salesforce#breadcrumb"},"primaryImageOfPage":{"@type":"ImageObject","url":"https://cdn.sanity.io/images/8u2zjhvn/production/743f000b6306622a1a32bca730654ee937f8a7fe-800x800.avif?w=800&fit=max&auto=format","width":800,"height":800,"caption":"Grzegorz Zawłodzki"},"dateModified":"2026-11-12T12:17:29Z"},{"@type":"Service","@id":"https://www.zawlodzki.pl/szkolenie-i-wdrozenie-salesforce#service","name":"Wdrożenie Salesforce dla firm, które wyrosły z prostego CRM","description":"Wdrożenie Salesforce z procesem sprzedaży, migracją danych i szkoleniem zespołu. Do 15 osób: 9 tys. zł netto/mies. przez 3 miesiące (27 tys. łącznie).","url":"https://www.zawlodzki.pl/szkolenie-i-wdrozenie-salesforce","provider":{"@id":"https://www.zawlodzki.pl/#organization"},"areaServed":{"@type":"Country","name":"Polska"},"offers":[{"@type":"Offer","name":"Diagnoza CRM Salesforce","price":"4900","priceCurrency":"PLN"},{"@type":"Offer","name":"Wdrożenie do 15 osób","price":"9000","priceCurrency":"PLN"},{"@type":"Offer","name":"Wdrożenie powyżej 15 osób"}]},{"@type":"BreadcrumbList","@id":"https://www.zawlodzki.pl/szkolenie-i-wdrozenie-salesforce#breadcrumb","itemListElement":[{"@type":"ListItem","position":1,"name":"Strona główna","item":"https://www.zawlodzki.pl/"},{"@type":"ListItem","position":2,"name":"Wdrożenie Salesforce dla firm, które wyrosły z prostego CRM","item":"https://www.zawlodzki.pl/szkolenie-i-wdrozenie-salesforce"}]},{"@type":"FAQPage","@id":"https://www.zawlodzki.pl/szkolenie-i-wdrozenie-salesforce#faq","isPartOf":{"@id":"https://www.zawlodzki.pl/szkolenie-i-wdrozenie-salesforce#webpage"},"about":{"@id":"https://www.zawlodzki.pl/szkolenie-i-wdrozenie-salesforce#service"},"inLanguage":"pl-PL","mainEntity":[{"@type":"Question","name":"Czym różni się wdrożenie Salesforce od samej konfiguracji?","acceptedAnswer":{"@type":"Answer","text":"Konfiguracja ustawia aplikację. Wdrożenie zmienia sposób pracy zespołu i to jest różnica, za którą płacisz. W Salesforce ta różnica jest większa niż w prostszych CRM-ach, bo system pozwala zbudować prawie wszystko. Bez procesu na starcie łatwo skończyć z dziesiątkami pól i modułów, których nikt nie używa, a licencję płacisz za każdego użytkownika co miesiąc."}},{"@type":"Question","name":"Ile kosztuje wdrożenie Salesforce?","acceptedAnswer":{"@type":"Answer","text":"Wdrożenie dla zespołu do 15 osób kosztuje 9 000 zł netto miesięcznie przy współpracy na 3 miesiące, czyli 27 000 zł netto łącznie. Zakres ustalamy na starcie i nie zmienia się w trakcie, płacisz w trzech ratach. W cenie jest opracowanie procesu, migracja i czyszczenie danych, konfiguracja, warsztaty, treningi 1:1 z każdym handlowcem oraz przeszkolenie administratora. Większe zespoły, kilka oddziałów i integracje z ERP wyceniam indywidualnie. Licencję płacisz osobno, bezpośrednio Salesforce."}},{"@type":"Question","name":"Ile kosztuje szkolenie z Salesforce?","acceptedAnswer":{"@type":"Answer","text":"Szkolenia nie sprzedaję osobno, warsztaty i treningi 1:1 z handlowcami są częścią każdego wdrożenia. Jeśli już pracujecie w Salesforce i chcesz uporządkować system oraz doszkolić zespół, punktem startu jest diagnoza za 4 900 zł netto. Kończy się planem naprawy z wyceną, a część poprawek robimy od razu podczas warsztatów."}},{"@type":"Question","name":"Jak długo trwa wdrożenie Salesforce?","acceptedAnswer":{"@type":"Answer","text":"Współpraca trwa 3 miesiące. Pierwszy miesiąc to proces, dane i konfiguracja, kolejne dwa to warsztaty i treningi z zespołem. W firmie z działającym działem handlowym tempo dopasowujemy tak, żeby nie zaburzyć bieżącej sprzedaży. Wdrożenie w kilku działach albo oddziałach naraz planuję z dłuższym harmonogramem."}},{"@type":"Question","name":"Kogo trzeba zaangażować we wdrożenie Salesforce?","acceptedAnswer":{"@type":"Answer","text":"W każdym wdrożeniu konieczny jest lider, który zna proces sprzedaży w firmie. Ta osoba koordynuje warsztaty po Waszej stronie i zostaje przygotowana do administrowania Salesforce na co dzień. Potrzebna jest też dostępność dyrektora sprzedaży albo właściciela, który decyduje o kształcie procesu."}},{"@type":"Question","name":"Moja firma ma już Salesforce, ale zespół go nie używa. Co mogę zrobić?","acceptedAnswer":{"@type":"Answer","text":"Zacznij od diagnozy za 4 900 zł netto. Przechodzę przez proces, dane, pracę handlowców i raporty tak samo, jak przy własnych wdrożeniach. Dostajesz listę problemów z priorytetami i wycenę tego, co warto naprawić. Decydujesz, czy robimy to razem, czy Twój zespół samodzielnie."}},{"@type":"Question","name":"Salesforce czy Pipedrive, co wybrać w małej firmie?","acceptedAnswer":{"@type":"Answer","text":"Wdrażam oba systemy, więc nie muszę Cię przekonywać do żadnego. Pipedrive wystarcza, gdy sprzedajesz w jednym procesie, a CRM ma pokazywać lejek i pilnować kolejnych kroków. Salesforce ma sens, gdy potrzebujesz własnych obiektów, obsługi klienta w tym samym systemie, kilku oddziałów z różnymi uprawnieniami albo integracji z ERP. Licencja Pro Suite kosztuje prawie dwa razy tyle co Pipedrive Premium. Jeśli nie wiesz, po której stronie jest Twoja firma, napisz. E-mail znajdziesz w zakładce kontakt."}},{"@type":"Question","name":"Czy dostanę fakturę VAT?","acceptedAnswer":{"@type":"Answer","text":"Tak, oczywiście."}},{"@type":"Question","name":"Czy możemy podpisać umowę NDA?","acceptedAnswer":{"@type":"Answer","text":"Tak. Daj mi znać, że jest to konieczne, prześlę wzór. Umowę będziemy mogli podpisać elektronicznie."}},{"@type":"Question","name":"Czy Salesforce jest po polsku?","acceptedAnswer":{"@type":"Answer","text":"Częściowo. Ekrany, na których pracują handlowcy, są przetłumaczone na polski, ale ustawienia administracyjne i pomoc Salesforce są po angielsku. Pola dodane przy wdrożeniu nazywam po polsku, instrukcje dla zespołu też piszę po polsku. Na wszystkie Twoje pytania odpowiadam po polsku."}},{"@type":"Question","name":"Ile kosztuje licencja Salesforce i czy jest darmowa wersja?","acceptedAnswer":{"@type":"Answer","text":"Salesforce ma darmowy pakiet Free Suite dla maksymalnie dwóch użytkowników. Płatne pakiety dla małych firm to Starter Suite za 25 € i Pro Suite za 100 € za użytkownika miesięcznie według cennika europejskiego, przy czym Pro Suite kupisz tylko na rok. Jeśli chcesz sprawdzić, który pakiet wystarczy w Twojej firmie, napisz. E-mail znajdziesz w zakładce kontakt."}}]},{"@type":"Person","@id":"https://www.zawlodzki.pl/o-mnie#person","name":"Grzegorz Zawłodzki","jobTitle":"Konsultant CRM i automatyzacji sprzedaży B2B","description":"Konsultant i trener. Wdraża systemy CRM (Pipedrive, HubSpot, Attio), Asanę oraz procesy sprzedaży wspierane przez AI. Pracował z ponad 50 firmami, od startupów po globalne marki jak IAB.","url":"https://www.zawlodzki.pl/o-mnie","image":{"@type":"ImageObject","url":"https://cdn.sanity.io/images/8u2zjhvn/production/d519a3e46c8eb9f05e98170375bcfaec6b8ac75b-240x448.webp?w=240&fit=max&auto=format","width":240,"height":448,"caption":"Grzegorz Zawłodzki"},"email":"grzesiek@zawlodzki.pl","telephone":"+48571088338","worksFor":{"@id":"https://www.zawlodzki.pl/#organization"},"knowsLanguage":["pl","en"],"knowsAbout":["Wdrożenia CRM","Pipedrive","HubSpot","Attio","Asana","AI w sprzedaży B2B","Agenty AI","Automatyzacja procesów biznesowych","n8n","Integracje API","Dashboardy sprzedażowe","Zarządzanie projektami"],"sameAs":["https://www.linkedin.com/in/zawlodzki/","https://x.com/zawlodzki","https://www.youtube.com/@GrzesiekZawlodzki","https://www.instagram.com/zawlodzki/","https://github.com/zawlodzki"]},{"@type":"Organization","@id":"https://www.zawlodzki.pl/#organization","name":"Wellbiz","legalName":"Wellbiz sp. z o.o.","alternateName":["zawlodzki.pl"],"description":"Wellbiz to firma doradcza z Krakowa, która wdraża systemy CRM (Pipedrive, HubSpot, Attio), Asanę, automatyzacje w n8n oraz procesy sprzedaży wspierane przez AI w firmach B2B. Prowadzi ją Grzegorz Zawłodzki, a serwis firmy działa pod adresem zawlodzki.pl.","url":"https://www.zawlodzki.pl","logo":{"@type":"ImageObject","url":"https://cdn.sanity.io/images/8u2zjhvn/production/99e95e3456f8f59119d96aa8125d3ee172095c66-215x82.svg?w=215&fit=max&auto=format","width":215,"height":82,"caption":"Wellbiz"},"foundingDate":"2025-02-26","vatID":"PL6793323800","taxID":"6793323800","identifier":[{"@type":"PropertyValue","propertyID":"KRS","value":"0001158341"},{"@type":"PropertyValue","propertyID":"REGON","value":"541006624"}],"address":{"@type":"PostalAddress","streetAddress":"ul. Lipowa 3d","postalCode":"30-702","addressLocality":"Kraków","addressCountry":"PL"},"areaServed":{"@type":"Country","name":"Polska"},"knowsAbout":["Wdrożenia CRM","Pipedrive","Asana","AI w sprzedaży B2B","Automatyzacja procesów biznesowych","n8n"],"founder":{"@id":"https://www.zawlodzki.pl/o-mnie#person"},"contactPoint":{"@type":"ContactPoint","email":"grzesiek@zawlodzki.pl","telephone":"+48571088338","contactType":"sales","availableLanguage":["pl","en"]},"sameAs":["https://www.linkedin.com/company/zawlodzki-pl/","https://rejestr.io/krs/1158341/wellbiz","https://aleo.com/pl/firma/wellbiz-spolka-z-ograniczona-odpowiedzialnoscia"]},{"@type":"WebSite","@id":"https://www.zawlodzki.pl/#website","url":"https://www.zawlodzki.pl","name":"Grzegorz Zawłodzki — wdrożenia CRM i automatyzacja sprzedaży B2B","alternateName":"zawlodzki.pl","inLanguage":["pl-PL","en"],"publisher":{"@id":"https://www.zawlodzki.pl/o-mnie#person"}}]}</script><link rel="icon" type="image/png" sizes="32x32" href="/favicon.png"><link rel="apple-touch-icon" href="/apple-touch-icon.png"><!-- Bing Webmaster Tools ownership, carried over from the Webflow head. --><meta name="msvalidate.01" content="C214B52BA1B7751A5EDD0564040D650F"><style>@layer reset{*,:before,:after{box-sizing:border-box;min-width:0}:root{color-scheme:light;interpolate-size:allow-keywords;text-wrap:pretty;overflow-wrap:break-word;font-synthesis:none;-webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale;-webkit-text-size-adjust:100%;-webkit-tap-highlight-color:transparent}body{min-height:100svh;margin:0}h1,h2,h3,h4,h5,h6,p,figure,blockquote{margin:0}h1,h2,h3,h4{text-wrap:balance}img,svg,video{max-width:100%;height:auto;display:block}input,textarea,select{font-size:max(16px,1rem)}button,a,[role=button]{touch-action:manipulation}button,[role=button]{-webkit-user-select:none;user-select:none}}@layer base{body{background:var(--surface-page);color:var(--text-body);font-family:var(--typography-body-family);font-size:var(--typography-body-size);font-weight:var(--typography-body-weight);line-height:var(--typography-body-leading);letter-spacing:var(--typography-body-tracking)}:is(h1,h2,h3,h4,h5,h6){color:var(--text-heading)}h1,.type-display{font-family:var(--typography-display-family);font-size:var(--typography-display-size);font-weight:var(--typography-display-weight);line-height:var(--typography-display-leading);letter-spacing:var(--typography-display-tracking)}h2,.type-heading-l{font-family:var(--typography-heading-l-family);font-