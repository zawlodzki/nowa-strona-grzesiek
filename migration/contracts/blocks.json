{
  "_contract": "Block registry for the page builder. Owner: coordinator. Lane C turns each entry into a Sanity object type, lane D into an Astro component at src/components/blocks/<Name>.astro, lane S reads `jsonld`, lane M maps Webflow sections with `match`. Every live Webflow section must match exactly one entry (check: python3 -I migration/tools/check-contracts.py). Change requests go through lanes/<lane>/STATUS.md.",
  "layout": {
    "_note": "Rendered by the layout, not stored as page sections.",
    "match": [
      {"component": "Custom Code (must be on every page)"},
      {"component": "header zawlodzki"},
      {"component": "zawlodzki footer"},
      {"classes": "zaw-schema-slot"}
    ]
  },
  "blocks": [
    {
      "type": "hero",
      "component": "Hero",
      "purpose": "Page opening with H1",
      "fields": {"variant": "'default'|'badge'", "tagline": "string", "heading": "string (renders H1)", "body": "text", "image": "image", "badgeImage": "contentImage? (alt required when set)", "badgeSize": "'standard'|'wide'?", "badges": "string[]", "cta": "link?"},
      "jsonld": "none (WebPage.name comes from page.seo)",
      "match": [{"component": "hero zawlodzki"}, {"component": "Hero zawlodzki badge"}, {"classes": "Hero Section"}]
    },
    {
      "type": "logoStrip",
      "component": "LogoStrip",
      "purpose": "Client or tool logos",
      "fields": {"variant": "'clients'|'tools'", "tagline": "string?", "title": "string?", "intro": "text? (line under the title; for tools, the caption above the logos)", "logos": "reference<logo>[]"},
      "jsonld": "none",
      "match": [{"component": "zawlodzki loga wspolprace"}, {"component": "zawlodzki loga aplikacji"}, {"component": "zawlodzki narzędzia"}]
    },
    {
      "type": "feature",
      "component": "Feature",
      "purpose": "Tagline, heading, body with optional media. Covers Problem, Krok N, Moduł N, Tygodnie X-Y, Obszar N, Bonus N and home service anchors",
      "fields": {"tagline": "string?", "heading": "string", "body": "portableText", "bullets": "string[]?", "media": "{kind:'image', image} | {kind:'diagram', key: DiagramKey} | null", "mediaCaption": "string?", "mediaSide": "'left'|'right'", "layout": "'default'|'article'?", "anchorId": "slug?", "cta": "link?"},
      "jsonld": "none",
      "match": [{"classes": "Feature Section"}, {"component": "Feature / Left 1 / Text Only"}]
    },
    {
      "type": "contentSection",
      "component": "ContentSection",
      "purpose": "Tagline, heading and a list or grid of items. Covers Dla kogo, Jak pracuję, Efekty, Co dostajesz, Moje usługi, Granice, Zakres",
      "fields": {"tagline": "string?", "heading": "string?", "intro": "portableText?", "layout": "'list'|'cards'|'twoColumn'|'checklist'", "items": "{title, text?, icon?, link?}[]?", "media": "same as feature.media"},
      "jsonld": "none",
      "match": [{"classes": "Section"}, {"classes": "Cards Section"}, {"component": "Empty Section / Title Left"}, {"component": "Empty Section / Title Left Plus Tagline"}]
    },
    {
      "type": "pricing",
      "component": "Pricing",
      "purpose": "Price plans",
      "fields": {"tagline": "string?", "heading": "string", "plans": "{name, price?:number, currency:'PLN', unit:string, priceNote?, features?:string[], cta:link, highlighted:boolean}[]"},
      "jsonld": "Offer nodes with UnitPriceSpecification, attached to the page's #service or #course",
      "match": [{"classes": "Pricing Section"}]
    },
    {
      "type": "ctaBand",
      "component": "CtaBand",
      "purpose": "Single call to action",
      "fields": {"heading": "string?", "body": "text?", "cta": "link"},
      "jsonld": "none",
      "match": [{"component": "zawlodzki CTA"}, {"classes": "CTA Section"}]
    },
    {
      "type": "testimonials",
      "component": "Testimonials",
      "purpose": "Quotes or an image wall of recommendations",
      "fields": {"variant": "'quotes'|'imageWall'", "tagline": "string?", "heading": "string?", "items": "reference<testimonial>[]"},
      "jsonld": "none (no self-serving Review markup)",
      "match": [{"classes": "Testimonials Section"}]
    },
    {
      "type": "promoCard",
      "component": "PromoCard",
      "purpose": "Cross-link to another page, today always Sales Atlas System",
      "fields": {"title": "string", "points": "string[]", "target": "reference<page>"},
      "jsonld": "none",
      "match": [{"component": "Sales atlas system info"}]
    },
    {
      "type": "faq",
      "component": "Faq",
      "purpose": "Visible Q&A accordion",
      "fields": {"tagline": "string?", "heading": "string", "items": "{question:string, answer:portableText}[]", "emitSchema": "boolean, default true"},
      "jsonld": "FAQPage <url>#faq when emitSchema and the block is visible; at most one per page",
      "match": [{"classes": "FAQ Section"}]
    },
    {
      "type": "contactForm",
      "component": "ContactForm",
      "purpose": "Lead form posting to /api/form (Worker → n8n), with 32 attribution fields",
      "fields": {"variant": "'landing'|'full'|'channels'", "tagline": "string?", "heading": "string?", "intro": "text? (newlines kept)", "showDetails": "boolean", "calendar": "{heading, text?, link}? (full only)", "consultation": "{heading, body:text}? (full only)", "channels": "{tagline?, heading?, groups: {title, note?, items: {kind:'linkedin'|'github'|'x'|'youtube'|'instagram'|'email'|'phone'|'signal'|'whatsapp', label, href:https|mailto|tel}[]}[]}? (full or channels; replaces the person-based details column)", "formId": "'landing-contact'|'main-contact'? (required unless channels)", "copy": "{formHeading?, emailLabel?, emailPlaceholder?, requiredMarker?, phoneLabel?, phonePlaceholder?, messageLabel?, messagePlaceholder?, privacyNote?:text, privacyLink?:link, newsletterLabel?:text, submitLabel?, waitLabel?}? (empty field = code default; not for channels)"},
      "jsonld": "none (ContactPage comes from page type)",
      "match": [{"component": "kontakt zawlodzki"}, {"classes": "Contact Section"}, {"component": "Contact Section Details"}]
    },
    {
      "type": "newsletterSignup",
      "component": "NewsletterSignup",
      "purpose": "Newsletter form",
      "fields": {"body": "text?", "copy": "{heading?, headingAccent?, emailLabel?, emailPlaceholder?, submitLabel?, waitLabel?, legal?:text, legalLinks?:link[]}? (empty field = code default)"},
      "jsonld": "none",
      "match": [{"component": "newsletter zawlodzki"}]
    },
    {
      "type": "postList",
      "component": "PostList",
      "purpose": "Latest N posts of one kind, e.g. 'Ostatnie wpisy' on /newsletter and /o-mnie. The page query resolves the posts",
      "fields": {"tagline": "string?", "heading": "string?", "kind": "'blog'|'newsletter'", "limit": "number 1-12, default 3"},
      "jsonld": "none (no ItemList; the posts carry their own BlogPosting on their pages)",
      "match": [],
      "_note": "No match rule: on live the list is a w-dyn-list inside a blog-article section, which matches richText. The page importer (T20) splits that list off into a postList."
    },
    {
      "type": "richText",
      "component": "RichText",
      "purpose": "Long-form text on static pages (legal, about) using the same Portable Text as posts",
      "fields": {"body": "portableText"},
      "jsonld": "none",
      "match": [{"classes": "blog-article"}]
    },
{
  "type": "tabs",
  "component": "Tabs",
  "purpose": "Accessible vertical tabs preserving all pane links",
  "fields": {
    "heading": "string",
    "tagline": "string?",
    "intro": "portableText?",
    "items": "{title,summary?,positive?,negative?,tagline?,body:portableText}[]"
  },
  "jsonld": "none",
  "match": []
}
  ],
  "diagramKeys": {
    "_note": "Editors pick a diagram key from the web registry in apps/web/src/components/diagrams/registry.ts.",
    "keys": [
      "crm-funnel",
      "zw-ai-sales",
      "zw-asana",
      "zw-asana-ai",
      "zw-asana-handoff",
      "zw-asana-map",
      "zw-asana-problem",
      "zw-asana-process",
      "zw-asana-real-work",
      "zw-asana-template",
      "zw-asana-tpl",
      "zw-asana-training",
      "zw-asana-work",
      "zw-audit-gap-d1a",
      "zw-audit-gap-d2a",
      "zw-audit-gap-k1",
      "zw-audit-gap-k3",
      "zw-audit-observe-d1b",
      "zw-audit-observe-k2",
      "zw-audit-observe-k4",
      "zw-audit-observe-pre",
      "zw-audit-priority-a5",
      "zw-audit-priority-d2b",
      "zw-audit-priority-k5",
      "zw-auto-build",
      "zw-auto-golive",
      "zw-auto-handoff",
      "zw-auto-map",
      "zw-auto-problem",
      "zw-automation",
      "zw-course-next",
      "zw-crm-data",
      "zw-crm-handoff",
      "zw-crm-process",
      "zw-crm-setup",
      "zw-crm-training",
      "zw-manual-relay",
      "zw-pipedrive-problem",
      "zw-problem",
      "zw-sales-audit-data",
      "zw-sales-audit-motions",
      "zw-sales-audit-problem",
      "zw-sales-audit-process",
      "zw-sales-audit-strategy",
      "zw-sales-audit-team",
      "zw-sf-problem",
      "zw-sf-setup",
      "zw-step1",
      "zw-step2",
      "zw-step3",
      "zw-step4",
      "zw-step5"
    ]
  },
  "portableText": {
    "_note": "Shared by post.body and richText.body.",
    "styles": ["normal", "h2", "h3", "h4", "blockquote"],
    "marks": ["strong", "em", "code", "link", "internalLink"],
    "objects": {
      "image": "{asset, alt (required), caption?}",
      "table": "{rows: string[][], hasHeader: boolean}",
      "codeBlock": "{language, code}",
      "embed": "{kind:'youtube'|'loom'|'iframe', url, title}",
      "download": "{label, url (files.zawlodzki.com)}",
      "callout": "{tone:'info'|'warning', body}"
    }
  }
}
