# Applied by Workers static assets to asset responses. Worker-made responses (redirects, /api/form) are not covered.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Content-Security-Policy: frame-ancestors 'self'
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000

/
  Link: </blog/rss.xml>; rel="alternate"; type="application/rss+xml"

# Astro fingerprints these file names, so a changed file gets a new URL.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/robots.txt
  Content-Type: text/plain; charset=utf-8

/llms.txt
  Content-Type: text/plain; charset=utf-8
