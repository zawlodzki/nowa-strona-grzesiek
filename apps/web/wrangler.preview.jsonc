{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zawlodzki-web-preview",
  "main": "./src/preview/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "SANITY_DATASET": "production",
    "SANITY_STUDIO_URL": "https://zawlodzki.sanity.studio"
  },
  "routes": [
    {
      "pattern": "preview.zawlodzki.pl",
      "custom_domain": true
    }
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": false,
      "head_sampling_rate": 1
    }
  },
  "secrets": {
    "required": [
      "N8N_FORM_WEBHOOK",
      "TURNSTILE_SECRET_KEY",
      "SANITY_API_READ_TOKEN",
      "PREVIEW_AUTH_USER",
      "PREVIEW_AUTH_PASSWORD"
    ]
  }
}
