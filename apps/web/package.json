{
  "name": "web",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node ../../migration/tools/check-dist.mjs",
    "check": "astro check",
    "preview": "wrangler dev",
    "deploy": "pnpm deploy:staging",
    "astro": "astro",
    "preview:build": "astro build --config src/preview/astro.config.mjs",
    "preview:dev": "astro dev --config src/preview/astro.config.mjs",
    "preview:serve": "wrangler dev --config .wrangler/preview/server/wrangler.json",
    "preview:test": "node --experimental-strip-types --test src/preview/*.test.ts",
    "test": "node --test \"src/**/*.test.{ts,mjs}\"",
    "e2e": "playwright test",
    "e2e:axe-baseline": "AXE_RECORD=1 playwright test pages.spec.ts --grep axe --workers=1",
    "deploy:staging": "pnpm build && wrangler deploy --env staging",
    "deploy:production": "pnpm build && wrangler deploy --env production"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.2",
    "@sanity/client": "^8.10.1",
    "@sanity/preview-url-secret": "^4.1.5",
    "@sanity/visual-editing": "^6.1.3",
    "astro": "^7.4.1"
  },
  "private": true,
  "devDependencies": {
    "@astrojs/check": "^0.9.11",
    "@axe-core/playwright": "^4.14.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "^1.65.0",
    "typescript": "^6.0.3",
    "wrangler": "^4.151.2"
  }
}
