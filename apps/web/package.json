{
  "name": "web",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "check": "astro check",
    "preview": "wrangler dev",
    "deploy": "astro build && wrangler deploy",
    "astro": "astro",
    "preview:build": "astro build --config src/preview/astro.config.mjs",
    "preview:dev": "astro dev --config src/preview/astro.config.mjs",
    "preview:serve": "wrangler dev --config .wrangler/preview/server/wrangler.json",
    "preview:test": "node --experimental-strip-types --test src/preview/*.test.ts"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.2",
    "@sanity/client": "^8.10.1",
    "@sanity/preview-url-secret": "^4.1.5",
    "@sanity/visual-editing": "^6.1.3",
    "astro": "^7.4.1"
  },
  "private": true,
  "devDependencies": {
    "@astrojs/check": "^0.9.11",
    "typescript": "^6.0.3",
    "wrangler": "^4.151.2"
  }
}
