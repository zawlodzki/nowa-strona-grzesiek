---
// Ported from the Webflow embed #zw-crm-data (szkolenie-i-wdrozenie-pipedrive, szkolenie-i-wdrozenie-salesforce) by port/port-diagrams.mjs.
import './diagram.css';
/*
  Pipedrive implementation — step 2: data structure and migration
  Self-contained Webflow embed. Transparent, play-once, responsive.
  Scope: zw-crm-data
*/
---

<div class="dg" data-diagram="zw-crm-data" aria-hidden="true" style="--dg-w: 400; --dg-h: 220;">
  <div class="zw-stage dg-stage"><div class="zw-fit dg-fit"><div class="zw-scene">
    <div class="cd-panel">
      <span class="cd-eyebrow">Data migration</span>
      <div class="cd-source cd-source--sheet"><span class="cd-icon">X</span><b>Sheets</b></div>
      <div class="cd-source cd-source--legacy"><span class="cd-icon">C</span><b>Legacy</b></div>
      <div class="cd-filter">
        <svg viewBox="0 0 24 24"><path d="M4 6h16M7 12h10M10 18h4"/></svg>
        <span>Clean</span>
      </div>
      <div class="cd-target">
        <div class="cd-target-head"><span>CRM</span><span class="cd-check">
          <svg viewBox="0 0 24 24"><path d="M5 12.5l4.2 4.3L19 7"/></svg>
        </span></div>
        <div class="cd-field"><i></i><span>Name</span></div>
        <div class="cd-field"><i></i><span>Company</span></div>
        <div class="cd-field"><i></i><span>Value</span></div>
      </div>
      <span class="cd-path cd-path--a"></span><span class="cd-path cd-path--b"></span>
      <div class="cd-record cd-record--1"><i></i><i></i></div>
      <div class="cd-record cd-record--2"><i></i><i></i></div>
      <div class="cd-record cd-record--3"><i></i><i></i></div>
    </div>
  </div></div></div>
</div>

<style is:global>
[data-diagram="zw-crm-data"] {
    --zw-primary:#3A48CC; --zw-primary-10:#EBEDFA; --zw-primary-30:#8991E0;
    --zw-secondary:#0ACFFE; --zw-success:#52C41A; --zw-bg-soft:#F9FAFB;
    --zw-border:#DDE1E6; --zw-border-soft:#EDF0F3; --zw-heading:#0E0F11;
    --zw-text:#1E2024; --zw-muted:#838D95; --zw-card:#FFFFFF;
    --zw-font:'Satoshi Variable','Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,system-ui,sans-serif;
    --zw-serif:'Erode Variable','Fraunces','Source Serif 4',Georgia,serif;
    --zw-radius-card:10px; --zw-radius-lane:14px;
    --zw-shadow-rest:0 1px 3px rgba(0,0,0,.08);
    --zw-shadow-lift:1px 8px 22px rgba(14,15,17,.14);
    font-family:var(--zw-font); width:100%; max-width:440px; margin:0 auto;
    box-sizing:border-box; -webkit-font-smoothing:antialiased;
  }
  [data-diagram="zw-crm-data"] *, [data-diagram="zw-crm-data"] *::before, [data-diagram="zw-crm-data"] *::after { box-sizing:border-box; }
  [data-diagram="zw-crm-data"] .zw-stage { width:100%; overflow:hidden; }
  [data-diagram="zw-crm-data"] .zw-fit { width:400px; transform-origin:top left; }
  [data-diagram="zw-crm-data"] .zw-scene { position:relative; }
  [data-diagram="zw-crm-data"] .zw-confetti { position:absolute;top:0;left:0;width:0;height:0;z-index:9;pointer-events:none; }
  [data-diagram="zw-crm-data"] .zw-confetti i { position:absolute;width:8px;height:8px;border-radius:2px;will-change:transform,opacity; }

  /* =================== SCENE:STYLE start =================== */
  [data-diagram="zw-crm-data"] .cd-panel {
    position:relative; width:360px; height:220px; margin:6px auto;
    background:var(--zw-bg-soft); border:1px solid var(--zw-border);
    border-radius:var(--zw-radius-lane); overflow:hidden;
  }
  [data-diagram="zw-crm-data"] .cd-eyebrow {
    position:absolute; top:17px; left:20px; font-size:12px; font-weight:700;
    letter-spacing:.09em; text-transform:uppercase; color:var(--zw-muted); opacity:0;
  }
  [data-diagram="zw-crm-data"] .cd-source {
    position:absolute; left:20px; width:100px; height:50px; padding:10px;
    display:flex; align-items:center; gap:9px; background:var(--zw-card);
    border:1px solid var(--zw-border); border-radius:var(--zw-radius-card);
    box-shadow:var(--zw-shadow-rest); opacity:0;
  }
  [data-diagram="zw-crm-data"] .cd-source--sheet { top:58px; }
  [data-diagram="zw-crm-data"] .cd-source--legacy { top:119px; }
  [data-diagram="zw-crm-data"] .cd-icon {
    width:25px;height:25px;display:flex;align-items:center;justify-content:center;
    border-radius:7px;background:var(--zw-primary-10);color:var(--zw-primary);
    font-size:11px;font-weight:800;
  }
  [data-diagram="zw-crm-data"] .cd-source b { font-size:12px; color:var(--zw-text); }
  [data-diagram="zw-crm-data"] .cd-filter {
    position:absolute; left:145px; top:90px; width:64px; height:64px;
    display:flex; flex-direction:column; align-items:center; justify-content:center; gap:4px;
    background:var(--zw-card); border:1px solid var(--zw-primary-30);
    border-radius:50%; box-shadow:var(--zw-shadow-rest); z-index:3; opacity:0;
  }
  [data-diagram="zw-crm-data"] .cd-filter svg { width:21px; height:21px; }
  [data-diagram="zw-crm-data"] .cd-filter path { fill:none;stroke:var(--zw-primary);stroke-width:2;stroke-linecap:round; }
  [data-diagram="zw-crm-data"] .cd-filter span { font-size:9px;font-weight:700;text-transform:uppercase;letter-spacing:.07em;color:var(--zw-primary); }
  [data-diagram="zw-crm-data"] .cd-target {
    position:absolute; right:19px; top:54px; width:112px; height:130px; padding:12px;
    background:var(--zw-card); border:1px solid var(--zw-border);
    border-radius:var(--zw-radius-card); box-shadow:var(--zw-shadow-rest); opacity:0;
  }
  [data-diagram="zw-crm-data"] .cd-target-head { display:flex;align-items:center;justify-content:space-between;margin-bottom:11px; }
  [data-diagram="zw-crm-data"] .cd-target-head>span:first-child { font-size:12px;font-weight:800;letter-spacing:.07em;color:var(--zw-primary); }
  [data-diagram="zw-crm-data"] .cd-check {
    width:20px;height:20px;display:flex;align-items:center;justify-content:center;
    border-radius:50%;background:var(--zw-success);color:#fff;transform:scale(0);
  }
  [data-diagram="zw-crm-data"] .cd-check svg { width:12px;height:12px; }
  [data-diagram="zw-crm-data"] .cd-check path { fill:none;stroke:currentColor;stroke-width:2.7;stroke-linecap:round;stroke-linejoin:round; }
  [data-diagram="zw-crm-data"] .cd-field {
    display:flex;align-items:center;gap:7px;height:24px;margin-bottom:5px;padding:0 7px;
    border-radius:6px;background:var(--zw-border-soft);
  }
  [data-diagram="zw-crm-data"] .cd-field i { width:6px;height:6px;border-radius:50%;background:var(--zw-border); }
  [data-diagram="zw-crm-data"] .cd-field span { font-size:10px;font-weight:600;color:var(--zw-muted); }
  [data-diagram="zw-crm-data"] .cd-field--filled { background:var(--zw-primary-10); }
  [data-diagram="zw-crm-data"] .cd-field--filled i { background:var(--zw-primary); }
  [data-diagram="zw-crm-data"] .cd-field--filled span { color:var(--zw-primary); }
  [data-diagram="zw-crm-data"] .cd-path {
    position:absolute;top:121px;height:2px;background:var(--zw-border);transform-origin:left center;
  }
  [data-diagram="zw-crm-data"] .cd-path--a { left:120px;width:25px; }
  [data-diagram="zw-crm-data"] .cd-path--b { left:209px;width:20px; }
  [data-diagram="zw-crm-data"] .cd-record {
    position:absolute; left:45px; width:52px; height:22px; padding:6px 7px;
    background:var(--zw-card); border:1px solid var(--zw-primary-30);
    border-radius:6px; box-shadow:var(--zw-shadow-rest); z-index:5; opacity:0;
    will-change:transform,opacity;
  }
  [data-diagram="zw-crm-data"] .cd-record--1 { top:72px; }
  [data-diagram="zw-crm-data"] .cd-record--2 { top:93px; }
  [data-diagram="zw-crm-data"] .cd-record--3 { top:133px; }
  [data-diagram="zw-crm-data"] .cd-record i { display:block;height:3px;border-radius:3px;background:var(--zw-primary-30); }
  [data-diagram="zw-crm-data"] .cd-record i:first-child { width:34px;margin-bottom:4px; }
  [data-diagram="zw-crm-data"] .cd-record i:last-child { width:23px; }
  /* ==================== SCENE:STYLE end ==================== */

  @media (prefers-reduced-motion:reduce) {
    [data-diagram="zw-crm-data"] .cd-eyebrow, [data-diagram="zw-crm-data"] .cd-source, [data-diagram="zw-crm-data"] .cd-filter, [data-diagram="zw-crm-data"] .cd-target { opacity:1; }
    [data-diagram="zw-crm-data"] .cd-record { opacity:0; }
    [data-diagram="zw-crm-data"] .cd-field { background:var(--zw-primary-10); }
    [data-diagram="zw-crm-data"] .cd-field i { background:var(--zw-primary); }
    [data-diagram="zw-crm-data"] .cd-field span { color:var(--zw-primary); }
    [data-diagram="zw-crm-data"] .cd-check { transform:scale(1); }
  }
</style>

<script>
  // @ts-nocheck
  for (const root of document.querySelectorAll('[data-diagram="zw-crm-data"]')) {
(function(){
  if(!root||root.dataset.zwInit)return;root.dataset.zwInit='1';
  var DESIGN_W=400,stage=root.querySelector('.zw-stage'),fitEl=root.querySelector('.zw-fit'),scene=root.querySelector('.zw-scene');
  var reduce=window.matchMedia&&window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var EASE_MOVE='cubic-bezier(0.645, 0.045, 0.355, 1)',EASE_OUT='cubic-bezier(0.22, 1, 0.36, 1)',EASE_POP='cubic-bezier(0.34, 1.56, 0.64, 1)';
  function wait(ms){return new Promise(function(r){setTimeout(r,ms);});}
  function settled(a){return a.finished.catch(function(){});}
  function fit(){}
  function confetti(){}

  async function play(){
    fit();if(reduce)return;
    var eyebrow=scene.querySelector('.cd-eyebrow'),sources=Array.prototype.slice.call(scene.querySelectorAll('.cd-source')),filter=scene.querySelector('.cd-filter'),target=scene.querySelector('.cd-target');
    eyebrow.animate([{opacity:0},{opacity:1}],{duration:300,easing:EASE_OUT,fill:'forwards'});eyebrow.style.opacity=1;
    sources.forEach(function(el,i){el.animate([{opacity:0,transform:'translateX(-12px)'},{opacity:1,transform:'translateX(0)'}],{duration:420,delay:100+i*90,easing:EASE_OUT,fill:'forwards'});el.style.opacity=1;});
    filter.animate([{opacity:0,transform:'scale(.82)'},{opacity:1,transform:'scale(1)'}],{duration:420,delay:230,easing:EASE_OUT,fill:'forwards'});filter.style.opacity=1;
    target.animate([{opacity:0,transform:'translateX(12px)'},{opacity:1,transform:'translateX(0)'}],{duration:420,delay:320,easing:EASE_OUT,fill:'forwards'});target.style.opacity=1;
    await wait(860);
    var records=Array.prototype.slice.call(scene.querySelectorAll('.cd-record')),fields=Array.prototype.slice.call(scene.querySelectorAll('.cd-field'));
    for(var i=0;i<records.length;i++){
      var record=records[i],startX=0,startY=0,filterX=132-record.offsetLeft,filterY=111-record.offsetTop,targetX=238-record.offsetLeft,targetY=(94+i*29)-record.offsetTop;
      record.style.opacity=1;
      await settled(record.animate([
        {opacity:0,transform:'translate(0,0) scale(.9)'},
        {opacity:1,transform:'translate(0,0) scale(1)',offset:.16},
        {opacity:1,transform:'translate('+filterX+'px,'+filterY+'px) scale(.78)',offset:.53},
        {opacity:1,transform:'translate('+targetX+'px,'+targetY+'px) scale(.72)',offset:.86},
        {opacity:0,transform:'translate('+targetX+'px,'+targetY+'px) scale(.55)'}
      ],{duration:780,easing:EASE_MOVE,fill:'forwards'}));
      record.style.opacity=0;
      fields[i].classList.add('cd-field--filled');
      fields[i].animate([{transform:'scale(.96)'},{transform:'scale(1.04)'},{transform:'scale(1)'}],{duration:300,easing:EASE_OUT});
      filter.animate([{transform:'scale(1)'},{transform:'scale(1.08)'},{transform:'scale(1)'}],{duration:280,easing:EASE_OUT});
      await wait(110);
    }
    await wait(160);
    var check=scene.querySelector('.cd-check');
    check.animate([{transform:'scale(0)'},{transform:'scale(1)'}],{duration:380,easing:EASE_POP,fill:'forwards'});check.style.transform='scale(1)';
    target.animate([{transform:'scale(1)'},{transform:'scale(1.025)'},{transform:'scale(1)'}],{duration:420,easing:EASE_POP});
  }
  fit();if('ResizeObserver'in window)new ResizeObserver(fit).observe(stage);else window.addEventListener('resize',fit);
  function arm(){if(!('IntersectionObserver'in window)){play();return;}var io=new IntersectionObserver(function(entries){entries.forEach(function(e){if(e.isIntersecting){io.disconnect();requestAnimationFrame(function(){requestAnimationFrame(play);});}});},{threshold:.4});io.observe(root);}
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',arm);else arm();
})();
  }
</script>
