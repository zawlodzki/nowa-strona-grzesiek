---
// Rebuilt in the calm scene style by T97; port-diagrams.mjs no longer writes this file.
// Step 2, data and migration: rows from a spreadsheet and an old CRM are
// checked one by one. Duplicates are merged and gaps filled, so the record
// count drops to what is real. Also used on the Salesforce page.
// The markup is the end state. Rows and counts are placeholders.
import "./scene/scene.css";

const rows = [
  { name: "ACME Sp. z o.o.", status: "zaimportowany", kind: "ok", count: 1240 },
  {
    name: "acme sp. z o.o.",
    status: "duplikat, scalony",
    kind: "merged",
    count: 1020,
  },
  { name: "Nexa", status: "e-mail uzupełniony", kind: "ok", count: 1020 },
  { name: "nexa.pl", status: "duplikat, scalony", kind: "merged", count: 980 },
];
---

<div
  class="sc"
  data-diagram="zw-crm-data"
  data-scene="sequence"
  aria-hidden="true"
>
  <div class="sc-body">
    <div class="source">
      <span>Arkusz i poprzedni CRM</span>
      <span>Status</span>
    </div>
    <ul>
      {rows.map((row) => (
        <li class:list={["is-done", row.kind]} data-step data-value={row.count}>
          <span class="name">{row.name}</span>
          <span class="cell">
            <span class="pending">…</span>
            <span class="status">{row.status}</span>
          </span>
        </li>
      ))}
    </ul>
    <div class="sc-total">
      <span class="sc-total-label">Rekordy po czyszczeniu</span>
      <span
        class="sc-total-value"
        data-total
        data-start="1240"
        data-suffix={" z 1 240"}
      >
        980&nbsp;z&nbsp;1&nbsp;240
      </span>
    </div>
  </div>
</div>

<style>
  .source {
    display: flex;
    justify-content: space-between;
    padding-block-end: 0.5rem;
    color: var(--text-muted);
    font-size: 0.8125rem;
    border-block-end: 1px solid var(--text-heading);
  }

  li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.75rem;
    align-items: baseline;
    padding-block: 0.6rem;
    border-block-end: 1px solid var(--border-hairline);
  }

  .name {
    color: var(--text-heading);
    font-weight: var(--font-weight-medium);
  }

  .cell {
    display: grid;
    justify-items: end;
    text-align: end;
  }

  .cell > * {
    grid-area: 1 / 1;
  }

  .pending {
    color: var(--border-strong);
  }

  .status {
    color: var(--text-link);
    font-weight: var(--font-weight-medium);
  }

  .merged.is-done .name {
    color: var(--text-muted);
    text-decoration: line-through;
    text-decoration-color: var(--border-strong);
  }

  .merged .status {
    color: var(--text-muted);
  }

  li:not(.is-done) .status,
  .is-done .pending {
    opacity: 0;
  }

  li:not(.is-done) .status {
    transform: translateY(6px);
  }

  @media (prefers-reduced-motion: no-preference) {
    .status,
    .pending {
      transition:
        opacity 630ms cubic-bezier(0.25, 1, 0.5, 1),
        transform 630ms cubic-bezier(0.25, 1, 0.5, 1);
    }

    .name {
      transition: color 630ms ease;
    }
  }
</style>

<script>
  import "./sequence";
</script>
