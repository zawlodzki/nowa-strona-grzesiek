---
// Ported from the Webflow embed #zw-audit-priority-d2b (audyt-ai-sprzedaz) by port/port-diagrams.mjs.
import './diagram.css';
---

<div class="dg" data-diagram="zw-audit-priority-d2b" aria-hidden="true" style="--dg-w: 400; --dg-h: 220;">
<div class="zw-stage dg-stage">
<div class="zw-fit dg-fit">
<div class="zw-scene">
<div class="ap-panel">
<span class="ap-eyebrow">Report</span>
<div class="ap-find ap-find--1"><span class="ap-rank">01</span><i></i><i></i></div>
<div class="ap-find ap-find--2"><span class="ap-rank">02</span><i></i><i></i></div>
<div class="ap-find ap-find--3"><span class="ap-rank">03</span><i></i><i></i></div>
<div class="ap-find ap-find--4"><span class="ap-rank">04</span><i></i><i></i></div>
<span class="ap-done">
<svg viewBox="0 0 24 24"><path d="M5 12.5l4.2 4.3L19 7"/></svg>
</span>
</div>
</div>
</div>
</div>
</div>

<style is:global>
[data-diagram="zw-audit-priority-d2b"] {
--zw-primary:#3A48CC; --zw-primary-10:#EBEDFA; --zw-primary-30:#8991E0;
--zw-secondary:#0ACFFE; --zw-success:#52C41A; --zw-bg-soft:#F9FAFB;
--zw-border:#DDE1E6; --zw-border-soft:#EDF0F3; --zw-heading:#0E0F11;
--zw-text:#1E2024; --zw-muted:#838D95; --zw-card:#FFFFFF;
--zw-font:'Satoshi Variable','Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,system-ui,sans-serif;
--zw-serif:'Erode Variable','Fraunces','Source Serif 4',Georgia,serif;
--zw-radius-card:10px; --zw-radius-lane:14px;
--zw-shadow-rest:0 1px 3px rgba(0,0,0,.08);
--zw-shadow-lift:1px 8px 22px rgba(14,15,17,.14);
font-family:var(--zw-font); width:100%; max-width:440px; margin:0 auto;
box-sizing:border-box; -webkit-font-smoothing:antialiased;
}
[data-diagram="zw-audit-priority-d2b"] *, [data-diagram="zw-audit-priority-d2b"] *::before, [data-diagram="zw-audit-priority-d2b"] *::after { box-sizing:border-box; }
[data-diagram="zw-audit-priority-d2b"] .zw-stage { width:100%; overflow:hidden; }
[data-diagram="zw-audit-priority-d2b"] .zw-fit { width:400px; transform-origin:top left; }
[data-diagram="zw-audit-priority-d2b"] .zw-scene { position:relative; }
[data-diagram="zw-audit-priority-d2b"] .zw-confetti { position:absolute; top:0; left:0; width:0; height:0; z-index:9; pointer-events:none; }
[data-diagram="zw-audit-priority-d2b"] .zw-confetti i { position:absolute; width:8px; height:8px; border-radius:2px; will-change:transform,opacity; }
[data-diagram="zw-audit-priority-d2b"] .ap-panel {
position:relative; width:360px; height:220px; margin:6px auto;
background:var(--zw-bg-soft); border:1px solid var(--zw-border);
border-radius:var(--zw-radius-lane); overflow:hidden;
}
[data-diagram="zw-audit-priority-d2b"] .ap-eyebrow {
position:absolute; top:14px; left:20px; font-size:11px; font-weight:700;
letter-spacing:.09em; text-transform:uppercase; color:var(--zw-muted); opacity:0;
}
[data-diagram="zw-audit-priority-d2b"] .ap-find {
position:absolute; left:24px; width:312px; height:34px; padding:0 12px;
display:flex; align-items:center; gap:10px;
background:var(--zw-card); border:1px solid var(--zw-border-soft);
border-radius:8px; box-shadow:var(--zw-shadow-rest), inset 3px 0 0 var(--zw-border-soft);
opacity:0;
}
[data-diagram="zw-audit-priority-d2b"] .ap-find--1 { top:44px; }
[data-diagram="zw-audit-priority-d2b"] .ap-find--2 { top:86px; }
[data-diagram="zw-audit-priority-d2b"] .ap-find--3 { top:128px; }
[data-diagram="zw-audit-priority-d2b"] .ap-find--4 { top:170px; }
[data-diagram="zw-audit-priority-d2b"] .ap-rank {
flex:none; min-width:24px; padding:2px 5px; border-radius:999px; text-align:center;
background:var(--zw-border-soft); color:var(--zw-muted);
font-size:10px; font-weight:700;
}
[data-diagram="zw-audit-priority-d2b"] .ap-find i { height:6px; border-radius:4px; background:var(--zw-border-soft); }
[data-diagram="zw-audit-priority-d2b"] .ap-find i:nth-of-type(1) { flex:1; }
[data-diagram="zw-audit-priority-d2b"] .ap-find i:nth-of-type(2) { flex:none; width:38px; background:var(--zw-primary-10); }
[data-diagram="zw-audit-priority-d2b"] .ap-find--top { box-shadow:var(--zw-shadow-rest), inset 3px 0 0 var(--zw-primary); }
[data-diagram="zw-audit-priority-d2b"] .ap-find--top .ap-rank { background:var(--zw-primary-10); color:var(--zw-primary); }
[data-diagram="zw-audit-priority-d2b"] .ap-done {
position:absolute; right:14px; top:6px; width:26px; height:26px;
display:flex; align-items:center; justify-content:center; border-radius:50%;
background:var(--zw-success); color:#fff; transform:scale(0); transform-origin:center;
}
[data-diagram="zw-audit-priority-d2b"] .ap-done svg { width:15px; height:15px; }
[data-diagram="zw-audit-priority-d2b"] .ap-done path { fill:none; stroke:currentColor; stroke-width:2.6; stroke-linecap:round; stroke-linejoin:round; }
@media (prefers-reduced-motion:reduce) {
[data-diagram="zw-audit-priority-d2b"] .ap-eyebrow, [data-diagram="zw-audit-priority-d2b"] .ap-find { opacity:1; }
[data-diagram="zw-audit-priority-d2b"] .ap-find--1 { box-shadow:var(--zw-shadow-rest), inset 3px 0 0 var(--zw-primary); }
[data-diagram="zw-audit-priority-d2b"] .ap-find--1 .ap-rank { background:var(--zw-primary-10); color:var(--zw-primary); }
[data-diagram="zw-audit-priority-d2b"] .ap-done { transform:scale(1); }
}
</style>

<script>
  // @ts-nocheck
  for (const root of document.querySelectorAll('[data-diagram="zw-audit-priority-d2b"]')) {
(function(){
if(!root||root.dataset.zwInit)return; root.dataset.zwInit='1';
var DESIGN_W=400, stage=root.querySelector('.zw-stage'), fitEl=root.querySelector('.zw-fit'), scene=root.querySelector('.zw-scene');
var reduce=window.matchMedia&&window.matchMedia('(prefers-reduced-motion: reduce)').matches;
var EASE_MOVE='cubic-bezier(0.645, 0.045, 0.355, 1)';
var EASE_OUT='cubic-bezier(0.22, 1, 0.36, 1)';
var EASE_POP='cubic-bezier(0.34, 1.56, 0.64, 1)';
function wait(ms){return new Promise(function(r){setTimeout(r,ms);});}
function settled(a){return a.finished.catch(function(){});}
function fit(){}
function $$(sel){return Array.prototype.slice.call(scene.querySelectorAll(sel));}
function confetti(at){var box=document.createElement('div');box.className='zw-confetti';box.style.left=(at.offsetLeft+at.offsetWidth/2)+'px';box.style.top=(at.offsetTop+at.offsetHeight/2)+'px';scene.appendChild(box);var colors=['#3A48CC','#0ACFFE','#52C41A','#8991E0','#FFC53D'];for(var i=0;i<28;i++){var p=document.createElement('i');p.style.background=colors[i%colors.length];box.appendChild(p);var a=Math.PI*2*i/28,d=45+Math.random()*70;p.animate([{transform:'translate(0,0) rotate(0)',opacity:1},{transform:'translate('+(Math.cos(a)*d)+'px,'+(Math.sin(a)*d-30)+'px) rotate(420deg) scale(.4)',opacity:0}],{duration:800+Math.random()*350,easing:EASE_OUT,fill:'forwards'});}setTimeout(function(){box.remove();},1400);}
var SCATTER=[
'translate(38px,96px) rotate(-5deg)',
'translate(-26px,32px) rotate(4deg)',
'translate(30px,-38px) rotate(-3deg)',
'translate(-34px,-92px) rotate(5deg)'
];
async function play(){
fit(); if(reduce)return;
var eyebrow=scene.querySelector('.ap-eyebrow');
var finds=$$('.ap-find');
finds.forEach(function(f,i){
f.animate([{opacity:0,transform:SCATTER[i]+' scale(.94)'},{opacity:1,transform:SCATTER[i]}],
{duration:440,delay:i*100,easing:EASE_OUT,fill:'forwards'});
f.style.opacity=1; f.style.transform=SCATTER[i];
});
await wait(820);
eyebrow.animate([{opacity:0},{opacity:1}],{duration:320,easing:EASE_OUT,fill:'forwards'});
eyebrow.style.opacity=1;
await wait(240);
finds.forEach(function(f,i){
f.animate([{transform:SCATTER[i]},{transform:'translate(0,0) rotate(0)'}],
{duration:660,delay:i*90,easing:EASE_MOVE,fill:'forwards'});
f.style.transform='translate(0,0) rotate(0)';
});
await wait(1080);
var top=finds[0];
top.classList.add('ap-find--top');
top.animate([{transform:'translate(0,0) scale(1)'},{transform:'translate(0,0) scale(1.03)'},{transform:'translate(0,0) scale(1)'}],
{duration:460,easing:EASE_POP});
await wait(520);
var done=scene.querySelector('.ap-done');
done.animate([{transform:'scale(0)'},{transform:'scale(1)'}],
{duration:380,easing:EASE_POP,fill:'forwards'});
done.style.transform='scale(1)';
confetti(done);
}
fit(); if('ResizeObserver'in window)new ResizeObserver(fit).observe(stage);else window.addEventListener('resize',fit);
function arm(){if(!('IntersectionObserver'in window)){play();return;}var io=new IntersectionObserver(function(entries){entries.forEach(function(e){if(e.isIntersecting){io.disconnect();requestAnimationFrame(function(){requestAnimationFrame(play);});}});},{threshold:.4});io.observe(root);}
if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',arm);else arm();
})();
  }
</script>
