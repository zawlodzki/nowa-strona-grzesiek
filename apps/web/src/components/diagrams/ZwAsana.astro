---
// Ported from the Webflow embed #zw-asana (index) by port/port-diagrams.mjs.
import './diagram.css';
/*
  zawlodzki.pl — product animation SCAFFOLD
  Copy this file to marketing/assety/www animations/<scope>.html and
  build one product animation inside the SCENE regions. Everything
  OUTSIDE the SCENE markers is the shared family layer — keep it
  identical across animations so they read as siblings on the page.

  Before editing, replace zw-asana everywhere with a UNIQUE id for
  this animation, e.g. zw-crm, zw-automation, zw-ai-sales. The scope
  keeps each embed's CSS/JS from colliding when several sit on one page.
*/
---

<div class="dg" data-diagram="zw-asana" aria-hidden="true" style="--dg-w: 760; --dg-h: 320;">
  <div class="zw-stage dg-stage">
    <div class="zw-fit dg-fit">
      <div class="zw-scene">
        <div class="zw-flow">
          <svg class="zw-wires" viewBox="0 0 760 320" width="760" height="320" aria-hidden="true">
            <polygon class="zw-pyr" points="430,18 175,300 685,300"/>
            <line class="zw-tier-line" x1="379" y1="74.4"  x2="481" y2="74.4"/>
            <line class="zw-tier-line" x1="328" y1="130.8" x2="532" y2="130.8"/>
            <line class="zw-tier-line" x1="277" y1="187.2" x2="583" y2="187.2"/>
            <line class="zw-tier-line" x1="226" y1="243.6" x2="634" y2="243.6"/>

            <path class="zw-edge-dot" d="M260 272 L420 272"/>
            <path class="zw-edge-dot" d="M420 272 L560 272"/>
            <path class="zw-edge-dot" d="M560 272 L630 272"/>
            <path class="zw-edge-dot" d="M300 215 L450 215"/>
            <path class="zw-edge-dot" d="M450 215 L575 215"/>
            <path class="zw-edge-dot" d="M405 159 L510 159"/>
            <path class="zw-edge-dot" d="M375 102 L455 102"/>

            <path class="zw-edge-base" d="M420 272 L450 215"/>
            <path class="zw-edge-base" d="M450 215 L405 159"/>
            <path class="zw-edge-base" d="M405 159 L455 102"/>
            <path class="zw-edge-base" d="M455 102 L430 46"/>
            <path class="zw-edge-fill" data-edge="0" pathLength="1" d="M420 272 L450 215"/>
            <path class="zw-edge-fill" data-edge="1" pathLength="1" d="M450 215 L405 159"/>
            <path class="zw-edge-fill" data-edge="2" pathLength="1" d="M405 159 L455 102"/>
            <path class="zw-edge-fill" data-edge="3" pathLength="1" d="M455 102 L430 46"/>
          </svg>

          <span class="zw-plabel" style="top:37px;right:369px">Mission</span>
          <span class="zw-plabel" style="top:93px;right:420px">Goals</span>
          <span class="zw-plabel" style="top:150px;right:471px">Projects</span>
          <span class="zw-plabel" style="top:206px;right:522px">Tasks</span>
          <span class="zw-plabel" style="top:263px;right:574px">People</span>

          <span class="zw-dnode" style="left:249px;top:261px"></span>
          <span class="zw-dnode" style="left:549px;top:261px"></span>
          <span class="zw-dnode" style="left:619px;top:261px"></span>
          <span class="zw-dnode" style="left:289px;top:204px"></span>
          <span class="zw-dnode" style="left:564px;top:204px"></span>
          <span class="zw-dnode" style="left:499px;top:148px"></span>
          <span class="zw-dnode" style="left:364px;top:91px"></span>

          <div class="zw-node2" data-node="people" style="left:400px;top:252px">
            <svg viewBox="0 0 24 24" width="18" height="18"><circle cx="9" cy="8" r="3.1" fill="none" stroke="currentColor" stroke-width="1.7"/><path d="M3.6 19a5.4 5.4 0 0 1 10.8 0" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/><path d="M16 5.3a3 3 0 0 1 0 5.4M17.4 19a5.4 5.4 0 0 0-2.9-4.8" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
          </div>
          <div class="zw-node2" data-node="task" style="left:430px;top:195px">
            <svg viewBox="0 0 24 24" width="18" height="18"><rect x="4" y="4" width="16" height="16" rx="4" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M8 12l3 3 5-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </div>
          <div class="zw-node2" data-node="project" style="left:385px;top:139px">
            <svg viewBox="0 0 24 24" width="18" height="18"><path d="M12 3l8 4-8 4-8-4 8-4z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M4 12l8 4 8-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><path d="M4 17l8 4 8-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </div>
          <div class="zw-node2" data-node="goal" style="left:435px;top:82px">
            <svg viewBox="0 0 24 24" width="18" height="18"><path d="M6 21V4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><path d="M6 5h11l-2.4 3L17 11H6z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
          </div>
          <div class="zw-node2 zw-node2--goal" data-node="mission" style="left:410px;top:26px">
            <svg viewBox="0 0 24 24" width="18" height="18"><path d="M12 3.5l2.47 5.01 5.53.8-4 3.9.94 5.51L12 16.1l-4.94 2.6.94-5.51-4-3.9 5.53-.8L12 3.5z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/></svg>
          </div>

          <div class="zw-packet"><span class="zw-packet-dot"></span></div>
        </div>
      </div>
    </div>
  </div>
</div>

<style is:global>
/* ---- Shared family layer: tokens + responsive shell.
     Copy the :root block verbatim into every animation (same names, same
     values) so the whole set shares one palette, type, radius and shadow
     language. Only zw-asana changes per animation. ---- */
  [data-diagram="zw-asana"] {
    --zw-primary:    #3A48CC;   /* brand — CTA / accent / active state   */
    --zw-primary-10: #EBEDFA;   /* primary tint — soft fills             */
    --zw-primary-30: #8991E0;
    --zw-secondary:  #0ACFFE;   /* cyan accent — "active / in motion"    */
    --zw-secondary-10:#E7FAFF;  /* cyan tint — soft fills                */
    --zw-secondary-soft:rgba(10,207,254,.22); /* cyan halo / ring        */
    --zw-success:    #52C41A;   /* win / resolved                        */
    --zw-bg-soft:    #F9FAFB;   /* lane / track surface                  */
    --zw-border:     #DDE1E6;   /* base border                           */
    --zw-border-soft:#EDF0F3;
    --zw-heading:    #0E0F11;   /* headings / values                     */
    --zw-text:       #1E2024;
    --zw-muted:      #838D95;   /* eyebrow / metadata                    */
    --zw-card:       #FFFFFF;
    --zw-font: 'Satoshi Variable','Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,system-ui,sans-serif;
    --zw-serif: 'Erode Variable','Fraunces','Source Serif 4',Georgia,serif;
    --zw-radius-card: 10px;
    --zw-radius-lane: 14px;
    --zw-shadow-rest: 0 1px 3px rgba(0,0,0,.08);
    --zw-shadow-lift: 1px 8px 22px rgba(14,15,17,.14);

    font-family: var(--zw-font);
    width: 100%;
    max-width: 920px;
    margin: 0 auto;
    box-sizing: border-box;
    -webkit-font-smoothing: antialiased;
  }
  [data-diagram="zw-asana"] *, [data-diagram="zw-asana"] *::before, [data-diagram="zw-asana"] *::after { box-sizing: border-box; }

  /* The scale-to-fit shell: the scene is laid out at a fixed design width
     (DESIGN_W in JS) and scaled down to the container, so proportions stay
     identical from desktop to a 375px phone and cards never overflow. */
  [data-diagram="zw-asana"] .zw-stage { width: 100%; overflow: hidden; }
  [data-diagram="zw-asana"] .zw-fit   { width: 760px; transform-origin: top left; }
  [data-diagram="zw-asana"] .zw-scene { position: relative; }

  /* Confetti (created on demand by the shared confetti() helper) */
  [data-diagram="zw-asana"] .zw-confetti { position: absolute; top: 0; left: 0; width: 0; height: 0; z-index: 9; pointer-events: none; }
  [data-diagram="zw-asana"] .zw-confetti i { position: absolute; width: 8px; height: 8px; border-radius: 2px; will-change: transform, opacity; }

  /* =================== SCENE:STYLE start =================== */
  /* Work Graph pyramid: a triangle split into 5 tiers, with icon nodes joined by
     dotted links inside, in a fixed 760x320 design space. Same family tokens as
     the rest of the set; the structure is the Asana Work Graph, not bars. */
  [data-diagram="zw-asana"] .zw-flow {
    position: relative;
    width: 760px;
    height: 320px;
  }

  /* SVG layer: pyramid, tier lines, dotted graph, climb path */
  [data-diagram="zw-asana"] .zw-wires { position: absolute; top: 0; left: 0; z-index: 1; overflow: visible; opacity: 0; }
  [data-diagram="zw-asana"] .zw-pyr {
    fill: rgba(58,72,204,.045);        /* faint brand tint — reads on white or #F9FAFB */
    stroke: var(--zw-border); stroke-width: 1;
  }
  [data-diagram="zw-asana"] .zw-tier-line { stroke: var(--zw-border); stroke-width: 1; opacity: .7; }
  [data-diagram="zw-asana"] .zw-edge-dot {
    fill: none; stroke: var(--zw-border); stroke-width: 1.6; stroke-linecap: round;
    stroke-dasharray: 0.5 6;           /* dotted work-graph links */
  }
  [data-diagram="zw-asana"] .zw-edge-base {
    fill: none; stroke: var(--zw-border); stroke-width: 2.5; stroke-linecap: round;
  }
  [data-diagram="zw-asana"] .zw-edge-fill {            /* the climb, lit as the task rises */
    fill: none; stroke: var(--zw-primary); stroke-width: 2.5; stroke-linecap: round;
    stroke-dasharray: 1; stroke-dashoffset: 1;
  }

  /* left tier labels */
  [data-diagram="zw-asana"] .zw-plabel {
    position: absolute; white-space: nowrap; text-align: right;
    font-size: 13px; font-weight: 700; letter-spacing: .06em;
    text-transform: uppercase; color: var(--zw-muted);
    opacity: 0;                        /* revealed by play() */
  }

  /* decorative graph nodes (other work objects) */
  [data-diagram="zw-asana"] .zw-dnode {
    position: absolute; z-index: 2;
    width: 22px; height: 22px;
    border-radius: 999px;
    background: var(--zw-card);
    border: 1px solid var(--zw-border);
    opacity: 0;                        /* revealed by play() */
  }

  /* path nodes the task visits */
  [data-diagram="zw-asana"] .zw-node2 {
    position: absolute; z-index: 3;
    width: 40px; height: 40px;
    display: flex; align-items: center; justify-content: center;
    border-radius: 999px;
    background: var(--zw-card);
    border: 1px solid var(--zw-border);
    box-shadow: var(--zw-shadow-rest);
    color: var(--zw-muted);
    opacity: 0;                        /* revealed by play() */
    transition: border-color .35s ease, box-shadow .35s ease, color .35s ease;
  }
  [data-diagram="zw-asana"] .zw-node2--active {
    border-color: var(--zw-primary); color: var(--zw-primary);
    box-shadow: 0 0 0 3px var(--zw-primary-10);
  }
  [data-diagram="zw-asana"] .zw-node2--done {
    border-color: var(--zw-success); color: var(--zw-success);
    box-shadow: 0 0 0 3px rgba(82,196,26,.16);
  }

  /* packet = the task climbing the pyramid */
  [data-diagram="zw-asana"] .zw-packet {
    position: absolute; top: 0; left: 0;
    z-index: 6;
    opacity: 0;
    will-change: transform;
  }
  [data-diagram="zw-asana"] .zw-packet-dot {
    display: block;
    width: 14px; height: 14px;
    margin: -7px 0 0 -7px;             /* center on the travel point */
    border-radius: 999px;
    background: var(--zw-primary);
    box-shadow: 0 0 0 4px var(--zw-secondary-soft), var(--zw-shadow-lift);  /* cyan halo: work climbing */
  }
  /* ==================== SCENE:STYLE end ==================== */

  /* Accessibility: never move for users who asked not to.
     List every scene element that animates here so it lands resolved. */
  @media (prefers-reduced-motion: reduce) {
    [data-diagram="zw-asana"] .zw-plabel, [data-diagram="zw-asana"] .zw-dnode, [data-diagram="zw-asana"] .zw-node2 { opacity: 1; }
    [data-diagram="zw-asana"] .zw-wires { opacity: 1; }
    [data-diagram="zw-asana"] .zw-edge-fill { stroke-dashoffset: 0; }
  }
</style>

<script>
  // @ts-nocheck
  for (const root of document.querySelectorAll('[data-diagram="zw-asana"]')) {
(function () {
  if (!root || root.dataset.zwInit) return;   /* guard against double-init */
  root.dataset.zwInit = '1';

  var DESIGN_W = 760;   /* design-space width; the shell scales it to fit */

  var stage   = root.querySelector('.zw-stage');
  var fitEl   = root.querySelector('.zw-fit');
  var scene   = root.querySelector('.zw-scene');

  var reduce = window.matchMedia &&
               window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* Shared motion vocabulary — the same eases/feel for every animation.
     EASE_MOVE: on-screen travel (accelerate then brake, like a real object).
     EASE_OUT : entrances and settles (responsive, snaps then eases in). */
  var EASE_MOVE = 'cubic-bezier(0.645, 0.045, 0.355, 1)';
  var EASE_OUT  = 'cubic-bezier(0.22, 1, 0.36, 1)';
  var EASE_POP  = 'cubic-bezier(0.34, 1.56, 0.64, 1)'; /* tiny overshoot for wins */

  function wait(ms) { return new Promise(function (r) { setTimeout(r, ms); }); }
  function settled(anim) { return anim.finished.catch(function () {}); }

  /* Scale the fixed-width scene to its container and center it when there's
     room to spare, so the animation has the same visual weight in any column. */
  function fit(){}

  /* Shared celebration: a brand-colored confetti burst at a point inside the
     scene. Pass an element to burst from its center, or {x, y} in scene px. */
  function confetti(at) {
    var box = document.createElement('div');
    box.className = 'zw-confetti';
    var x, y;
    if (at && at.nodeType) { x = at.offsetLeft + at.offsetWidth / 2; y = at.offsetTop + at.offsetHeight / 2; }
    else { x = (at && at.x) || scene.offsetWidth / 2; y = (at && at.y) || scene.offsetHeight / 2; }
    box.style.left = x + 'px'; box.style.top = y + 'px';
    scene.appendChild(box);
    var colors = ['#3A48CC', '#0ACFFE', '#52C41A', '#8991E0', '#FFC53D'];
    for (var i = 0; i < 46; i++) {
      var p = document.createElement('i');
      p.style.background = colors[i % colors.length];
      if (i % 3 === 0) p.style.borderRadius = '50%';
      box.appendChild(p);
      var ang = (Math.PI * 2 * i) / 46 + (Math.random() - 0.5) * 0.5;
      var dist = 70 + Math.random() * 120;
      var dx = Math.cos(ang) * dist, dy = Math.sin(ang) * dist - 60;
      var rot = (Math.random() - 0.5) * 720;
      p.animate(
        [{ transform: 'translate(0,0) rotate(0) scale(1)', opacity: 1 },
         { transform: 'translate(' + dx + 'px,' + dy + 'px) rotate(' + rot + 'deg) scale(.4)', opacity: 0 }],
        { duration: 900 + Math.random() * 500, easing: 'cubic-bezier(0.18, 0.7, 0.3, 1)', fill: 'forwards' }
      );
    }
    setTimeout(function () { box.remove(); }, 1800);
  }

  /* =================== SCENE:LOGIC start ===================
     Build the choreography here. Compose with EASE_*, wait(), settled(),
     confetti() and the Web Animations API (el.animate). Measure positions
     live so they stay correct after fit(). Keep the rhythm consistent with
     the rest of the set: gentle entrance -> purposeful movement -> a clear,
     celebrated resolution. See references/motion-and-style.md. */
  async function play() {
    fit();

    var nodeEls = {};
    Array.prototype.slice.call(scene.querySelectorAll('.zw-node2'))
      .forEach(function (n) { nodeEls[n.dataset.node] = n; });
    var climb = ['people', 'task', 'project', 'goal', 'mission']; // base -> apex
    var wiresSvg = scene.querySelector('.zw-wires');
    var labels = Array.prototype.slice.call(scene.querySelectorAll('.zw-plabel'));
    var dnodes = Array.prototype.slice.call(scene.querySelectorAll('.zw-dnode'));
    var edges = {};
    Array.prototype.slice.call(scene.querySelectorAll('.zw-edge-fill'))
      .forEach(function (e) { edges[e.dataset.edge] = e; });
    var packet = scene.querySelector('.zw-packet');

    function center(name) {
      var n = nodeEls[name];
      return { x: n.offsetLeft + n.offsetWidth / 2, y: n.offsetTop + n.offsetHeight / 2 };
    }
    function activate(name) {
      var n = nodeEls[name];
      n.classList.add(n.classList.contains('zw-node2--goal') ? 'zw-node2--done' : 'zw-node2--active');
      n.animate([{ transform: 'scale(1)' }, { transform: 'scale(1.12)' }, { transform: 'scale(1)' }],
        { duration: 340, easing: EASE_OUT });
    }
    function drawEdge(idx, dur) {
      var e = edges[idx];
      e.animate([{ strokeDashoffset: 1 }, { strokeDashoffset: 0 }],
        { duration: dur, easing: EASE_MOVE, fill: 'forwards' });
      e.style.strokeDashoffset = '0';
    }
    function climbTo(name, dur) {
      var b = center(name);
      return settled(packet.animate(
        [{ transform: packet.style.transform }, { transform: 'translate(' + b.x + 'px,' + b.y + 'px)' }],
        { duration: dur, easing: EASE_MOVE, fill: 'forwards' }
      )).then(function () { packet.style.transform = 'translate(' + b.x + 'px,' + b.y + 'px)'; });
    }

    if (reduce) {                 /* resolved state, no motion */
      wiresSvg.style.opacity = 1;
      labels.forEach(function (l) { l.style.opacity = 1; });
      dnodes.forEach(function (d) { d.style.opacity = 1; });
      Object.keys(edges).forEach(function (k) { edges[k].style.strokeDashoffset = '0'; });
      climb.forEach(function (name) { nodeEls[name].style.opacity = 1; activate(name); });
      return;
    }

    var HOP = 560;

    // 1. The work graph appears: pyramid, labels, nodes (base -> apex)
    wiresSvg.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 420, easing: EASE_OUT, fill: 'forwards' });
    wiresSvg.style.opacity = 1;
    labels.forEach(function (l) {
      l.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 420, easing: EASE_OUT, fill: 'forwards' });
      l.style.opacity = 1;
    });
    dnodes.forEach(function (d) {
      d.animate([{ opacity: 0, transform: 'scale(0.6)' }, { opacity: 1, transform: 'scale(1)' }],
        { duration: 360, delay: 120, easing: EASE_OUT, fill: 'forwards' });
      d.style.opacity = 1;
    });
    climb.forEach(function (name, i) {
      nodeEls[name].animate([{ opacity: 0, transform: 'scale(0.7)' }, { opacity: 1, transform: 'scale(1)' }],
        { duration: 420, delay: i * 90, easing: EASE_OUT, fill: 'forwards' });
      nodeEls[name].style.opacity = 1;
    });
    await wait(720);

    // 2. It starts at the base: work begins with People
    var s0 = center('people');
    packet.style.transform = 'translate(' + s0.x + 'px,' + s0.y + 'px)';
    await settled(packet.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 240, easing: EASE_OUT, fill: 'forwards' }));
    packet.style.opacity = 1;
    activate('people');
    await wait(360);

    // 3. Climb the work graph, lighting each link as work rolls up
    for (var i = 1; i < climb.length; i++) {
      drawEdge(i - 1, HOP);
      await climbTo(climb[i], HOP);
      activate(climb[i]);
      if (i < climb.length - 1) await wait(280);
    }

    // 4. Mission accomplished at the apex: the node turns green and pops; the
    //    task merges in. (No confetti / ring-pulse — distinct from the others.)
    await wait(80);
    nodeEls['mission'].animate([{ transform: 'scale(1)' }, { transform: 'scale(1.18)' }, { transform: 'scale(1)' }],
      { duration: 480, easing: EASE_POP });
    packet.animate([{ opacity: 1 }, { opacity: 0 }], { duration: 320, easing: EASE_OUT, fill: 'forwards' });
    packet.style.opacity = 0;
  }
  /* ==================== SCENE:LOGIC end ==================== */

  /* Shared lifecycle: keep scaled, play exactly once on view, never reset. */
  fit();
  if ('ResizeObserver' in window) { new ResizeObserver(fit).observe(stage); }
  else { window.addEventListener('resize', fit); }

  function arm() {
    if (!('IntersectionObserver' in window)) { play(); return; }
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (e.isIntersecting) {
          io.disconnect();
          requestAnimationFrame(function () { requestAnimationFrame(play); });
        }
      });
    }, { threshold: 0.4 });
    io.observe(root);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', arm);
  } else {
    arm();
  }
})();
  }
</script>
