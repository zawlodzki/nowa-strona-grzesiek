---
// Rebuilt in the calm scene style by T96; port-diagrams.mjs no longer writes this file.
// The Asana hierarchy as an outline: a goal, a project under it and tasks that
// each have one owner and a due date. Tasks are ticked one by one and the work
// rolls up into the project's progress.
// The markup is the end state. Names, initials and dates are placeholders.
import "./scene/scene.css";

const tasks = [
  { title: "Import kontaktów", owner: "AK", date: "12 mar" },
  { title: "Szkolenie zespołu", owner: "TN", date: "19 mar" },
  { title: "Raport tygodniowy", owner: "OW", date: "26 mar" },
];
---

<div class="sc" data-diagram="zw-asana" aria-hidden="true">
  <div class="sc-body">
    <div class="level goal">
      <span class="kind">Cel</span>
      <span class="title">Pipeline pod kontrolą w Q1</span>
    </div>
    <div class="branch">
      <div class="level">
        <span class="kind">Projekt</span>
        <span class="title">Wdrożenie Pipedrive</span>
      </div>
      <span class="bar">
        <i></i>
      </span>
      <ol class="branch tasks">
        {tasks.map((task) => (
          <li class="task is-done">
            <span class="check" />
            <span class="task-title">{task.title}</span>
            <span class="owner">{task.owner}</span>
            <span class="date">{task.date}</span>
          </li>
        ))}
      </ol>
    </div>
    <div class="sc-total">
      <span class="sc-total-label">Postęp projektu</span>
      <span class="sc-total-value" data-total>
        100%
      </span>
    </div>
  </div>
</div>

<style>
  .level {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
    align-items: baseline;
    padding-block: 0.5rem;
  }

  .kind {
    min-inline-size: 4rem;
    color: var(--text-muted);
    font-size: 0.8125rem;
  }

  .title {
    color: var(--text-heading);
    font-weight: var(--font-weight-semibold);
  }

  .goal .title {
    font-family: var(--font-family-heading);
    font-size: 1.15em;
  }

  .branch {
    margin-inline-start: 0.5rem;
    padding-inline-start: 1.25rem;
    border-inline-start: 1px solid var(--border-default);
  }

  .bar {
    display: block;
    block-size: 3px;
    margin-block: 0.25rem 0.5rem;
    background: var(--surface-tint);
  }

  .bar i {
    display: block;
    block-size: 100%;
    background: var(--text-link);
    transform-origin: 0 50%;
  }

  .task {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto auto;
    gap: 0.75rem;
    align-items: center;
    padding-block: 0.55rem;
    border-block-end: 1px solid var(--border-hairline);
  }

  .task:last-child {
    border-block-end: 0;
  }

  .check {
    position: relative;
    inline-size: 1rem;
    block-size: 1rem;
    border: 1.5px solid var(--text-heading);
    border-radius: 50%;
  }

  .is-done .check {
    background: var(--text-link);
    border-color: var(--text-link);
  }

  .is-done .check::after {
    content: "";
    position: absolute;
    inset-block-start: 0.18rem;
    inset-inline-start: 0.3rem;
    inline-size: 0.25rem;
    block-size: 0.45rem;
    border: solid var(--surface-page);
    border-width: 0 1.5px 1.5px 0;
    transform: rotate(45deg);
  }

  .owner {
    display: grid;
    place-items: center;
    inline-size: 1.75rem;
    block-size: 1.75rem;
    color: var(--text-muted);
    font-size: 0.75rem;
    font-weight: var(--font-weight-medium);
    border: 1px solid var(--border-default);
    border-radius: 50%;
  }

  .date {
    min-inline-size: 3.25rem;
    color: var(--text-muted);
    text-align: end;
  }

  @container (inline-size < 26rem) {
    .date {
      display: none;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .check {
      transition:
        background-color 400ms ease,
        border-color 400ms ease;
    }
  }
</style>

<script>
  import { EASE_MOVE, stage } from "./scene/timeline";

  stage("zw-asana", (root, t) => {
    const tasks = [...root.querySelectorAll<HTMLElement>(".task")];
    const fill = root.querySelector<HTMLElement>(".bar i")!;
    const total = root.querySelector<HTMLElement>("[data-total]")!;

    return {
      rewind() {
        tasks.forEach((task) => task.classList.remove("is-done"));
        fill.style.transform = "scaleX(0)";
        total.textContent = "0%";
      },
      async play() {
        await t.wait(900);
        for (let i = 0; i < tasks.length; i++) {
          tasks[i].classList.add("is-done");
          await t.wait(500);
          const from = i / tasks.length;
          const to = (i + 1) / tasks.length;
          fill.style.transform = `scaleX(${to})`;
          await Promise.all([
            t.animate(
              fill,
              [
                { transform: `scaleX(${from})` },
                { transform: `scaleX(${to})` },
              ],
              900,
              EASE_MOVE,
            ),
            t.count(
              Math.round(from * 100),
              Math.round(to * 100),
              900,
              (value) => (total.textContent = `${value}%`),
            ),
          ]);
          await t.wait(600);
        }
        fill.style.transform = "";
      },
    };
  });
</script>
