---
// Rebuilt in the calm scene style by T99.
// Step 4, handover: each automation gets its documentation and passes to the
// client's trained owner, who can fix and extend it.
// The markup is the end state. The flows are placeholders.
import "./scene/scene.css";

const flows = [
  "Lead z formularza do CRM",
  "Potwierdzenie spotkania",
  "Folder klienta",
  "Przekazanie do realizacji",
];
---

<div
  class="sc"
  data-diagram="zw-auto-handoff"
  data-scene="sequence"
  aria-hidden="true"
>
  <div class="sc-body">
    <div class="head">
      <span>Przepływ</span>
      <span>Opis</span>
      <span>Kto utrzymuje</span>
    </div>
    <ul>
      {flows.map((flow, i) => (
        <li class="is-done" data-step data-value={i + 1}>
          <span class="flow">{flow}</span>
          <span class="doc">
            <span class="pending">…</span>
            <span class="done">gotowy</span>
          </span>
          <span class="cell">
            <span class="owner me">Grzegorz</span>
            <span class="owner you">Wasz admin</span>
          </span>
        </li>
      ))}
    </ul>
    <div class="sc-total">
      <span class="sc-total-label">Przepływy przekazane</span>
      <span
        class="sc-total-value"
        data-total
        data-suffix={`\u00a0z\u00a0${flows.length}`}
      >{`${flows.length}\u00a0z\u00a0${flows.length}`}</span>
    </div>
  </div>
</div>

<style>
  .head,
  li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 4.5rem 6.5rem;
    gap: 0.75rem;
    align-items: center;
  }

  .head {
    padding-block-end: 0.5rem;
    color: var(--text-muted);
    font-size: 0.8125rem;
    border-block-end: 1px solid var(--text-heading);
  }

  .head span:last-child {
    text-align: end;
  }

  li {
    padding-block: 0.55rem;
    border-block-end: 1px solid var(--border-hairline);
  }

  .flow {
    color: var(--text-heading);
  }

  .doc,
  .cell {
    display: grid;
  }

  .cell {
    justify-items: end;
  }

  :is(.doc, .cell) > * {
    grid-area: 1 / 1;
  }

  .pending {
    color: var(--border-strong);
  }

  .done {
    color: var(--text-link);
    font-size: 0.8125rem;
    font-weight: var(--font-weight-medium);
  }

  .owner {
    padding: 0.15rem 0.6rem;
    font-size: 0.8125rem;
    font-weight: var(--font-weight-medium);
    white-space: nowrap;
    border-radius: var(--radius-pill);
  }

  .me {
    color: var(--text-muted);
    border: 1px solid var(--border-default);
  }

  .you {
    color: var(--text-link);
    background: var(--surface-tint);
  }

  li:not(.is-done) :is(.done, .you),
  .is-done :is(.pending, .me) {
    opacity: 0;
  }

  li:not(.is-done) .you {
    transform: translateX(-0.5rem);
  }

  @container (inline-size < 30rem) {
    .head,
    li {
      grid-template-columns: minmax(0, 1fr) auto;
    }

    .doc,
    .head span:nth-child(2) {
      display: none;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .done,
    .pending {
      transition: opacity 630ms ease;
    }

    .owner {
      transition:
        opacity 630ms cubic-bezier(0.25, 1, 0.5, 1) 450ms,
        transform 630ms cubic-bezier(0.25, 1, 0.5, 1) 450ms;
    }
  }
</style>

<script>
  import "./sequence";
</script>
