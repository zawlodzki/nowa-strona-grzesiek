---
// Ported from the Webflow embed #zw-auto-handoff (automatyzacje-dla-pipedrive) by port/port-diagrams.mjs.
import './diagram.css';
/*
  Automations for Pipedrive — step 4: handover (docs + trained owner)
  Self-contained Webflow embed. Transparent, play-once, responsive.
  Scope: zw-auto-handoff
*/
---

<div class="dg" data-diagram="zw-auto-handoff" aria-hidden="true" style="--dg-w: 400; --dg-h: 220;">
  <div class="zw-stage dg-stage"><div class="zw-fit dg-fit"><div class="zw-scene">
    <div class="ah-panel">
      <span class="ah-eyebrow">Yours to keep</span>

      <div class="ah-docs">
        <span class="ah-doc ah-doc--3"></span>
        <span class="ah-doc ah-doc--2"></span>
        <div class="ah-doc ah-doc--1">
          <span class="ah-doc-row"><i></i><b>Runbook</b></span>
          <span class="ah-doc-row"><i></i><b>Diagram</b></span>
          <span class="ah-doc-row"><i></i><b>Access</b></span>
          <span class="ah-doc-check"><svg viewBox="0 0 24 24"><path d="M5 12.5l4.2 4.3L19 7"/></svg></span>
        </div>
      </div>

      <span class="ah-arrow">
        <svg viewBox="0 0 24 24"><path d="M4 12h13M12 6l6 6-6 6"/></svg>
      </span>

      <div class="ah-owner">
        <span class="ah-avatar">A</span>
        <b>Admin</b>
        <span class="ah-badge">Can edit</span>
        <i class="ah-ring"></i>
      </div>
    </div>
  </div></div></div>
</div>

<style is:global>
[data-diagram="zw-auto-handoff"] {
    --zw-primary:#3A48CC; --zw-primary-10:#EBEDFA; --zw-primary-30:#8991E0;
    --zw-secondary:#0ACFFE; --zw-success:#52C41A; --zw-bg-soft:#F9FAFB;
    --zw-border:#DDE1E6; --zw-border-soft:#EDF0F3; --zw-heading:#0E0F11;
    --zw-text:#1E2024; --zw-muted:#838D95; --zw-card:#FFFFFF;
    --zw-font:'Satoshi Variable','Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,system-ui,sans-serif;
    --zw-serif:'Erode Variable','Fraunces','Source Serif 4',Georgia,serif;
    --zw-radius-card:10px; --zw-radius-lane:14px;
    --zw-shadow-rest:0 1px 3px rgba(0,0,0,.08);
    --zw-shadow-lift:1px 8px 22px rgba(14,15,17,.14);
    font-family:var(--zw-font); width:100%; max-width:440px; margin:0 auto;
    box-sizing:border-box; -webkit-font-smoothing:antialiased;
  }
  [data-diagram="zw-auto-handoff"] *, [data-diagram="zw-auto-handoff"] *::before, [data-diagram="zw-auto-handoff"] *::after { box-sizing:border-box; }
  [data-diagram="zw-auto-handoff"] .zw-stage { width:100%; overflow:hidden; }
  [data-diagram="zw-auto-handoff"] .zw-fit { width:400px; transform-origin:top left; }
  [data-diagram="zw-auto-handoff"] .zw-scene { position:relative; }
  [data-diagram="zw-auto-handoff"] .zw-confetti { position:absolute; top:0; left:0; width:0; height:0; z-index:9; pointer-events:none; }
  [data-diagram="zw-auto-handoff"] .zw-confetti i { position:absolute; width:8px; height:8px; border-radius:2px; will-change:transform,opacity; }

  /* =================== SCENE:STYLE start =================== */
  [data-diagram="zw-auto-handoff"] .ah-panel {
    position:relative; width:360px; height:220px; margin:6px auto;
    background:var(--zw-bg-soft); border:1px solid var(--zw-border);
    border-radius:var(--zw-radius-lane); overflow:hidden;
  }
  [data-diagram="zw-auto-handoff"] .ah-eyebrow {
    position:absolute; top:18px; left:20px; font-size:12px; font-weight:700;
    letter-spacing:.09em; text-transform:uppercase; color:var(--zw-muted);
  }

  [data-diagram="zw-auto-handoff"] .ah-docs { position:absolute; left:34px; top:64px; width:130px; height:130px; }
  [data-diagram="zw-auto-handoff"] .ah-doc {
    position:absolute; width:126px; height:126px;
    background:var(--zw-card); border:1px solid var(--zw-border);
    border-radius:var(--zw-radius-card); box-shadow:var(--zw-shadow-rest);
  }
  [data-diagram="zw-auto-handoff"] .ah-doc--3 { left:12px; top:10px; transform:rotate(6deg); opacity:0; }
  [data-diagram="zw-auto-handoff"] .ah-doc--2 { left:6px; top:5px; transform:rotate(3deg); opacity:0; }
  [data-diagram="zw-auto-handoff"] .ah-doc--1 {
    left:0; top:0; padding:16px 14px; z-index:2; opacity:0;
    box-shadow:var(--zw-shadow-lift);
  }
  [data-diagram="zw-auto-handoff"] .ah-doc-row { display:flex; align-items:center; gap:9px; margin-bottom:12px; opacity:0; }
  [data-diagram="zw-auto-handoff"] .ah-doc-row i {
    flex:0 0 auto; width:18px; height:18px; border-radius:5px;
    background:var(--zw-primary-10); position:relative;
  }
  [data-diagram="zw-auto-handoff"] .ah-doc-row i::after {
    content:""; position:absolute; inset:5px; border-radius:2px; background:var(--zw-primary);
  }
  [data-diagram="zw-auto-handoff"] .ah-doc-row b { font-size:11px; font-weight:700; color:var(--zw-text); }
  [data-diagram="zw-auto-handoff"] .ah-doc-check {
    position:absolute; right:-9px; top:-9px; width:24px; height:24px; display:flex;
    align-items:center; justify-content:center; border-radius:50%; background:var(--zw-success);
    color:#fff; transform:scale(0); z-index:3;
  }
  [data-diagram="zw-auto-handoff"] .ah-doc-check svg { width:13px; height:13px; }
  [data-diagram="zw-auto-handoff"] .ah-doc-check path { fill:none; stroke:currentColor; stroke-width:2.7; stroke-linecap:round; stroke-linejoin:round; }

  [data-diagram="zw-auto-handoff"] .ah-arrow {
    position:absolute; left:170px; top:112px; width:26px; height:26px; color:var(--zw-primary-30);
    opacity:0; line-height:0;
  }
  [data-diagram="zw-auto-handoff"] .ah-arrow svg { width:26px; height:26px; fill:none; stroke:currentColor; stroke-width:2; stroke-linecap:round; stroke-linejoin:round; }

  [data-diagram="zw-auto-handoff"] .ah-owner {
    position:absolute; right:22px; top:70px; width:96px; height:104px;
    display:flex; flex-direction:column; align-items:center; justify-content:center; gap:8px;
    background:var(--zw-card); border:1px solid var(--zw-border);
    border-radius:var(--zw-radius-card); box-shadow:var(--zw-shadow-rest);
    opacity:0; transition:border-color .35s ease; z-index:2;
  }
  [data-diagram="zw-auto-handoff"] .ah-owner--set { border-color:var(--zw-primary-30); }
  [data-diagram="zw-auto-handoff"] .ah-avatar {
    width:38px; height:38px; display:flex; align-items:center; justify-content:center; border-radius:50%;
    background:var(--zw-border-soft); color:var(--zw-muted); font-size:12px; font-weight:800;
    transition:background-color .35s ease, color .35s ease;
  }
  [data-diagram="zw-auto-handoff"] .ah-owner--set .ah-avatar { background:var(--zw-primary); color:#fff; }
  [data-diagram="zw-auto-handoff"] .ah-owner > b { font-size:11px; font-weight:700; color:var(--zw-text); }
  [data-diagram="zw-auto-handoff"] .ah-badge {
    position:absolute; left:8px; right:8px; bottom:-12px; height:24px; display:flex;
    align-items:center; justify-content:center; border-radius:999px; background:var(--zw-success);
    color:#fff; font-size:9px; font-weight:800; letter-spacing:.05em; text-transform:uppercase;
    transform:scale(0); z-index:3;
  }
  [data-diagram="zw-auto-handoff"] .ah-ring {
    position:absolute; inset:-1px; border:2px solid var(--zw-success); border-radius:var(--zw-radius-card);
    opacity:0; pointer-events:none;
  }
  /* ==================== SCENE:STYLE end ==================== */

  @media (prefers-reduced-motion:reduce) {
    [data-diagram="zw-auto-handoff"] .ah-doc--3, [data-diagram="zw-auto-handoff"] .ah-doc--2, [data-diagram="zw-auto-handoff"] .ah-doc--1 { opacity:1; }
    [data-diagram="zw-auto-handoff"] .ah-doc-row { opacity:1; }
    [data-diagram="zw-auto-handoff"] .ah-doc-check { transform:scale(1); }
    [data-diagram="zw-auto-handoff"] .ah-arrow { opacity:1; }
    [data-diagram="zw-auto-handoff"] .ah-owner { opacity:1; border-color:var(--zw-primary-30); }
    [data-diagram="zw-auto-handoff"] .ah-owner .ah-avatar { background:var(--zw-primary); color:#fff; }
    [data-diagram="zw-auto-handoff"] .ah-badge { transform:scale(1); }
  }
</style>

<script>
  // @ts-nocheck
  for (const root of document.querySelectorAll('[data-diagram="zw-auto-handoff"]')) {
(function(){
  if(!root||root.dataset.zwInit)return; root.dataset.zwInit='1';
  var DESIGN_W=400, stage=root.querySelector('.zw-stage'), fitEl=root.querySelector('.zw-fit'), scene=root.querySelector('.zw-scene');
  var reduce=window.matchMedia&&window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var EASE_MOVE='cubic-bezier(0.645, 0.045, 0.355, 1)', EASE_OUT='cubic-bezier(0.22, 1, 0.36, 1)', EASE_POP='cubic-bezier(0.34, 1.56, 0.64, 1)';
  function wait(ms){return new Promise(function(r){setTimeout(r,ms);});}
  function settled(a){return a.finished.catch(function(){});}
  function fit(){}

  async function play(){
    fit(); if(reduce)return;
    var d3=scene.querySelector('.ah-doc--3'), d2=scene.querySelector('.ah-doc--2'), d1=scene.querySelector('.ah-doc--1');
    var rows=Array.prototype.slice.call(scene.querySelectorAll('.ah-doc-row'));

    // 1. Documentation stack fans in.
    [d3,d2,d1].forEach(function(d,i){
      var base = d===d3?'rotate(6deg)':(d===d2?'rotate(3deg)':'rotate(0deg)');
      d.animate([{opacity:0,transform:'translateY(12px) '+base},{opacity:1,transform:'translateY(0) '+base}],{duration:380,delay:i*110,easing:EASE_OUT,fill:'forwards'});
      d.style.opacity=1;
    });
    await wait(560);

    // 2. Its contents fill in line by line.
    for(var i=0;i<rows.length;i++){
      rows[i].animate([{opacity:0,transform:'translateX(-8px)'},{opacity:1,transform:'translateX(0)'}],{duration:320,easing:EASE_OUT,fill:'forwards'});
      rows[i].style.opacity=1;
      await wait(200);
    }
    var dc=scene.querySelector('.ah-doc-check');
    dc.animate([{transform:'scale(0)'},{transform:'scale(1)'}],{duration:360,easing:EASE_POP,fill:'forwards'}); dc.style.transform='scale(1)';
    await wait(360);

    // 3. Arrow reveals; ownership passes to the trained admin.
    var arrow=scene.querySelector('.ah-arrow'), owner=scene.querySelector('.ah-owner');
    arrow.animate([{opacity:0,transform:'translateX(-6px)'},{opacity:1,transform:'translateX(0)'}],{duration:320,easing:EASE_OUT,fill:'forwards'}); arrow.style.opacity=1;
    owner.animate([{opacity:0,transform:'translateY(12px)'},{opacity:1,transform:'translateY(0)'}],{duration:420,delay:120,easing:EASE_OUT,fill:'forwards'}); owner.style.opacity=1;
    await wait(640);

    // 4. Owner badge + calm ring.
    owner.classList.add('ah-owner--set');
    var badge=scene.querySelector('.ah-badge'), ring=scene.querySelector('.ah-ring');
    badge.animate([{transform:'scale(0)'},{transform:'scale(1)'}],{duration:380,easing:EASE_POP,fill:'forwards'}); badge.style.transform='scale(1)';
    await wait(80);
    ring.animate([{opacity:.7,transform:'scale(1)'},{opacity:0,transform:'scale(1.22)'}],{duration:820,easing:EASE_OUT,fill:'forwards'});
  }
  fit(); if('ResizeObserver'in window)new ResizeObserver(fit).observe(stage);else window.addEventListener('resize',fit);
  function arm(){if(!('IntersectionObserver'in window)){play();return;}var io=new IntersectionObserver(function(entries){entries.forEach(function(e){if(e.isIntersecting){io.disconnect();requestAnimationFrame(function(){requestAnimationFrame(play);});}});},{threshold:.4});io.observe(root);}
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',arm);else arm();
})();
  }
</script>
