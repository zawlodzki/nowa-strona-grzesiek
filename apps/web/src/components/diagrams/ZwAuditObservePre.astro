---
// Rebuilt in the calm scene style by T103; port-diagrams.mjs no longer writes this file.
// AI audit, before the start: the basic data collected through a survey, so
// the two weeks go to decisions. The items are placeholders.
import ListScene from "./ListScene.astro";

const items = [
  "Etapy sprzedaży",
  "Używane narzędzia",
  "Próbka raportów",
  "Lista powtarzalnych zadań",
];
---

<ListScene
  diagram="zw-audit-observe-pre"
  head={["Dane przed audytem", "Stan"]}
  rows={items.map((name) => ({ name, value: "otrzymane", counts: true }))}
  total={{ label: "Zebrane przed startem", of: items.length }}
/>
