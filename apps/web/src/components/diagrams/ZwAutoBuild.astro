---
// Rebuilt in the calm scene style by T99.
// Step 2, build and test: a test record runs through the flow on real data.
// Each link fills with Signal Cyan, the next step lights up and reports its
// check. Uses the shared step track from scene.css.
// The markup is the end state. Steps and counts are placeholders.
import "./scene/scene.css";

const steps = [
  { name: "Formularz", what: "nowy lead" },
  { name: "Dane firmy", what: "NIP i branża" },
  { name: "CRM", what: "osoba i szansa" },
  { name: "Zespół", what: "powiadomienie" },
];
const tests = 24;
const per = tests / (steps.length - 1);
---

<div
  class="sc"
  data-diagram="zw-auto-build"
  data-scene="sequence"
  aria-hidden="true"
>
  <div class="sc-body">
    <ol class="sc-track">
      {steps.map((step, i) => (
        <>
          <li class="sc-step">
            <span class="sc-ring" />
            <span class="sc-step-name">{step.name}</span>
            <span class="sc-step-what">{step.what}</span>
          </li>
          {i < steps.length - 1 && (
            <li class="sc-link is-done" data-step data-value={per * (i + 1)}>
              <span class="sc-link-fill" />
              <span class="sc-link-label">test OK</span>
            </li>
          )}
        </>
      ))}
    </ol>
    <div class="sc-total">
      <span class="sc-total-label">Rekordy testowe bez błędu</span>
      <span
        class="sc-total-value"
        data-total
        data-suffix={`\u00a0z\u00a0${tests}`}
      >{`${tests}\u00a0z\u00a0${tests}`}</span>
    </div>
  </div>
</div>

<style>
  .sc-step:first-child .sc-ring::after,
  .sc-link.is-done + .sc-step .sc-ring::after {
    opacity: 1;
  }

  .sc-ring::after {
    content: "";
    position: absolute;
    inset: 3px;
    background: var(--text-link);
    border-radius: 50%;
    opacity: 0;
  }

  .sc-link:not(.is-done) .sc-link-fill {
    transform: scaleX(0);
  }

  .sc-link:not(.is-done) .sc-link-label {
    opacity: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .sc-link-fill {
      transition: transform 900ms cubic-bezier(0.65, 0, 0.35, 1);
    }

    .sc-ring::after,
    .sc-link-label {
      transition: opacity 400ms ease 800ms;
    }
  }
</style>

<script>
  import "./sequence";
</script>
