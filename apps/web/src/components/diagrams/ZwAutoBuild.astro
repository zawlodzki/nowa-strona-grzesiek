---
// Ported from the Webflow embed #zw-auto-build (automatyzacje-dla-pipedrive) by port/port-diagrams.mjs.
import './diagram.css';
/*
  Automations for Pipedrive — step 2: build & test on real data
  Self-contained Webflow embed. Transparent, play-once, responsive.
  Scope: zw-auto-build
*/
---

<div class="dg" data-diagram="zw-auto-build" aria-hidden="true" style="--dg-w: 400; --dg-h: 220;">
  <div class="zw-stage dg-stage"><div class="zw-fit dg-fit"><div class="zw-scene">
    <div class="ab-panel">
      <span class="ab-eyebrow">Build &middot; test</span>

      <span class="ab-wire ab-wire--1"><span class="ab-flow"></span></span>
      <span class="ab-wire ab-wire--2"><span class="ab-flow"></span></span>

      <div class="ab-node ab-node--1">
        <span class="ab-ico">
          <svg viewBox="0 0 24 24"><path d="M13 3L4 14h6l-1 7 9-11h-6z"/></svg>
        </span>
        <b>Trigger</b>
      </div>
      <div class="ab-node ab-node--2">
        <span class="ab-ico">
          <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4"/></svg>
        </span>
        <b>Enrich</b>
      </div>
      <div class="ab-node ab-node--3">
        <span class="ab-ico">
          <svg viewBox="0 0 24 24"><path d="M4 7h16M4 12h16M4 17h10"/></svg>
        </span>
        <b>Sync</b>
      </div>

      <div class="ab-packet"><span></span><span></span></div>

      <span class="ab-pass">
        <span class="ab-pass-ico"><svg viewBox="0 0 24 24"><path d="M5 12.5l4.2 4.3L19 7"/></svg></span>
        <span class="ab-pass-txt">Test passed</span>
      </span>
    </div>
  </div></div></div>
</div>

<style is:global>
[data-diagram="zw-auto-build"] {
    --zw-primary:#3A48CC; --zw-primary-10:#EBEDFA; --zw-primary-30:#8991E0;
    --zw-secondary:#0ACFFE; --zw-success:#52C41A; --zw-bg-soft:#F9FAFB;
    --zw-border:#DDE1E6; --zw-border-soft:#EDF0F3; --zw-heading:#0E0F11;
    --zw-text:#1E2024; --zw-muted:#838D95; --zw-card:#FFFFFF;
    --zw-font:'Satoshi Variable','Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,system-ui,sans-serif;
    --zw-serif:'Erode Variable','Fraunces','Source Serif 4',Georgia,serif;
    --zw-radius-card:10px; --zw-radius-lane:14px;
    --zw-shadow-rest:0 1px 3px rgba(0,0,0,.08);
    --zw-shadow-lift:1px 8px 22px rgba(14,15,17,.14);
    font-family:var(--zw-font); width:100%; max-width:440px; margin:0 auto;
    box-sizing:border-box; -webkit-font-smoothing:antialiased;
  }
  [data-diagram="zw-auto-build"] *, [data-diagram="zw-auto-build"] *::before, [data-diagram="zw-auto-build"] *::after { box-sizing:border-box; }
  [data-diagram="zw-auto-build"] .zw-stage { width:100%; overflow:hidden; }
  [data-diagram="zw-auto-build"] .zw-fit { width:400px; transform-origin:top left; }
  [data-diagram="zw-auto-build"] .zw-scene { position:relative; }
  [data-diagram="zw-auto-build"] .zw-confetti { position:absolute; top:0; left:0; width:0; height:0; z-index:9; pointer-events:none; }
  [data-diagram="zw-auto-build"] .zw-confetti i { position:absolute; width:8px; height:8px; border-radius:2px; will-change:transform,opacity; }

  /* =================== SCENE:STYLE start =================== */
  [data-diagram="zw-auto-build"] .ab-panel {
    position:relative; width:360px; height:220px; margin:6px auto;
    background:var(--zw-bg-soft); border:1px solid var(--zw-border);
    border-radius:var(--zw-radius-lane); overflow:hidden;
  }
  [data-diagram="zw-auto-build"] .ab-eyebrow {
    position:absolute; top:18px; left:20px; font-size:12px; font-weight:700;
    letter-spacing:.09em; text-transform:uppercase; color:var(--zw-muted);
  }
  [data-diagram="zw-auto-build"] .ab-node {
    position:absolute; top:74px; width:92px; height:84px; padding:12px 8px;
    display:flex; flex-direction:column; align-items:center; justify-content:center; gap:9px;
    background:var(--zw-card); border:1px solid var(--zw-border);
    border-radius:var(--zw-radius-card); box-shadow:var(--zw-shadow-rest);
    z-index:2; opacity:0; transition:border-color .3s ease;
  }
  [data-diagram="zw-auto-build"] .ab-node--1 { left:20px; }
  [data-diagram="zw-auto-build"] .ab-node--2 { left:134px; }
  [data-diagram="zw-auto-build"] .ab-node--3 { left:248px; }
  [data-diagram="zw-auto-build"] .ab-ico { color:var(--zw-primary); line-height:0; transition:color .3s ease; }
  [data-diagram="zw-auto-build"] .ab-ico svg { width:23px; height:23px; fill:none; stroke:currentColor; stroke-width:1.7; stroke-linecap:round; stroke-linejoin:round; }
  [data-diagram="zw-auto-build"] .ab-node b { font-size:11px; font-weight:700; color:var(--zw-text); }
  [data-diagram="zw-auto-build"] .ab-node--ok { border-color:var(--zw-success); }
  [data-diagram="zw-auto-build"] .ab-node--ok .ab-ico { color:var(--zw-success); }

  [data-diagram="zw-auto-build"] .ab-wire {
    position:absolute; top:115px; height:3px; border-radius:3px;
    background:var(--zw-border); overflow:hidden; z-index:1;
    transform-origin:left center; transform:scaleX(0);
  }
  [data-diagram="zw-auto-build"] .ab-wire--1 { left:112px; width:22px; }
  [data-diagram="zw-auto-build"] .ab-wire--2 { left:226px; width:22px; }
  [data-diagram="zw-auto-build"] .ab-flow {
    position:absolute; inset:0; background:var(--zw-success);
    transform-origin:left center; transform:scaleX(0);
  }

  [data-diagram="zw-auto-build"] .ab-packet {
    position:absolute; top:99px; left:20px; width:34px; height:34px; z-index:5;
    display:flex; flex-direction:column; align-items:center; justify-content:center; gap:4px;
    background:var(--zw-card); border:1px solid var(--zw-primary-30);
    border-radius:8px; box-shadow:var(--zw-shadow-lift); opacity:0; will-change:transform,opacity;
  }
  [data-diagram="zw-auto-build"] .ab-packet span { display:block; height:4px; border-radius:3px; background:var(--zw-primary); }
  [data-diagram="zw-auto-build"] .ab-packet span:first-child { width:18px; }
  [data-diagram="zw-auto-build"] .ab-packet span:last-child { width:11px; background:var(--zw-primary-30); }

  [data-diagram="zw-auto-build"] .ab-pass {
    position:absolute; left:50%; bottom:16px; transform:translateX(-50%) translateY(8px);
    display:inline-flex; align-items:center; gap:7px; padding:6px 12px 6px 7px;
    border-radius:999px; background:var(--zw-card); border:1px solid var(--zw-success);
    box-shadow:var(--zw-shadow-rest); opacity:0; z-index:6;
  }
  [data-diagram="zw-auto-build"] .ab-pass-ico {
    width:19px; height:19px; display:flex; align-items:center; justify-content:center;
    border-radius:50%; background:var(--zw-success); color:#fff;
  }
  [data-diagram="zw-auto-build"] .ab-pass-ico svg { width:11px; height:11px; }
  [data-diagram="zw-auto-build"] .ab-pass-ico path { fill:none; stroke:currentColor; stroke-width:2.8; stroke-linecap:round; stroke-linejoin:round; }
  [data-diagram="zw-auto-build"] .ab-pass-txt { font-size:11px; font-weight:700; color:var(--zw-heading); letter-spacing:.01em; }
  /* ==================== SCENE:STYLE end ==================== */

  @media (prefers-reduced-motion:reduce) {
    [data-diagram="zw-auto-build"] .ab-node { opacity:1; border-color:var(--zw-success); }
    [data-diagram="zw-auto-build"] .ab-node .ab-ico { color:var(--zw-success); }
    [data-diagram="zw-auto-build"] .ab-wire { transform:scaleX(1); }
    [data-diagram="zw-auto-build"] .ab-flow { transform:scaleX(1); }
    [data-diagram="zw-auto-build"] .ab-packet { opacity:0; }
    [data-diagram="zw-auto-build"] .ab-pass { opacity:1; transform:translateX(-50%) translateY(0); }
  }
</style>

<script>
  // @ts-nocheck
  for (const root of document.querySelectorAll('[data-diagram="zw-auto-build"]')) {
(function(){
  if(!root||root.dataset.zwInit)return; root.dataset.zwInit='1';
  var DESIGN_W=400, stage=root.querySelector('.zw-stage'), fitEl=root.querySelector('.zw-fit'), scene=root.querySelector('.zw-scene');
  var reduce=window.matchMedia&&window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var EASE_MOVE='cubic-bezier(0.645, 0.045, 0.355, 1)', EASE_OUT='cubic-bezier(0.22, 1, 0.36, 1)', EASE_POP='cubic-bezier(0.34, 1.56, 0.64, 1)';
  function wait(ms){return new Promise(function(r){setTimeout(r,ms);});}
  function settled(a){return a.finished.catch(function(){});}
  function fit(){}

  async function play(){
    fit(); if(reduce)return;
    var nodes=Array.prototype.slice.call(scene.querySelectorAll('.ab-node'));
    var wires=Array.prototype.slice.call(scene.querySelectorAll('.ab-wire'));
    var flows=Array.prototype.slice.call(scene.querySelectorAll('.ab-flow'));
    var packet=scene.querySelector('.ab-packet');

    // 1. Build: nodes drop in, grey wires connect them.
    for(var i=0;i<nodes.length;i++){
      nodes[i].animate([{opacity:0,transform:'translateY(12px) scale(.94)'},{opacity:1,transform:'translateY(0) scale(1)'}],{duration:360,easing:EASE_OUT,fill:'forwards'});
      nodes[i].style.opacity=1;
      if(i<wires.length){
        await wait(120);
        wires[i].animate([{transform:'scaleX(0)'},{transform:'scaleX(1)'}],{duration:240,easing:EASE_MOVE,fill:'forwards'});
        wires[i].style.transform='scaleX(1)';
      }
      await wait(160);
    }
    await wait(360);

    // 2. Test run: a data packet enters and passes through each node, turning
    //    the path green as it clears.
    var xs=nodes.map(function(n){return n.offsetLeft + n.offsetWidth/2 - 17;}); // packet is 34 wide
    packet.style.transform='translateX(0)';
    await settled(packet.animate([{opacity:0,transform:'translateX(0) scale(.8)'},{opacity:1,transform:'translateX(0) scale(1)'}],{duration:260,easing:EASE_OUT,fill:'forwards'}));
    packet.style.opacity=1;
    nodes[0].classList.add('ab-node--ok');
    await wait(300);

    for(var j=1;j<nodes.length;j++){
      var from=xs[j-1], to=xs[j];
      // travel to next node
      await settled(packet.animate(
        [{transform:'translateX('+from+'px)'},
         {transform:'translateX('+((from+to)/2)+'px) translateY(-10px)',offset:.5},
         {transform:'translateX('+to+'px)'}],
        {duration:520,easing:EASE_MOVE,fill:'forwards'}));
      packet.style.transform='translateX('+to+'px)';
      // fill the wire green behind it, flip node to ok
      flows[j-1].animate([{transform:'scaleX(0)'},{transform:'scaleX(1)'}],{duration:300,easing:EASE_OUT,fill:'forwards'}); flows[j-1].style.transform='scaleX(1)';
      nodes[j].classList.add('ab-node--ok');
      await wait(360);
    }

    // 3. Packet lands; test-passed pill rises.
    await settled(packet.animate([{opacity:1,transform:'translateX('+xs[xs.length-1]+'px) scale(1)'},{opacity:0,transform:'translateX('+xs[xs.length-1]+'px) scale(.7)'}],{duration:280,easing:EASE_OUT,fill:'forwards'}));
    packet.style.opacity=0;
    var pass=scene.querySelector('.ab-pass');
    pass.animate([{opacity:0,transform:'translateX(-50%) translateY(8px)'},{opacity:1,transform:'translateX(-50%) translateY(0)'}],{duration:380,easing:EASE_POP,fill:'forwards'});
    pass.style.opacity=1; pass.style.transform='translateX(-50%) translateY(0)';
  }
  fit(); if('ResizeObserver'in window)new ResizeObserver(fit).observe(stage);else window.addEventListener('resize',fit);
  function arm(){if(!('IntersectionObserver'in window)){play();return;}var io=new IntersectionObserver(function(entries){entries.forEach(function(e){if(e.isIntersecting){io.disconnect();requestAnimationFrame(function(){requestAnimationFrame(play);});}});},{threshold:.4});io.observe(root);}
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',arm);else arm();
})();
  }
</script>
