---
// Ported from the Webflow embed #zw-step4 (program-ai-dla-zespolu-sprzedazy, wdrozenie-ai-w-sprzedazy-b2b) by port/port-diagrams.mjs.
import './diagram.css';
/*
  AI dla sprzedazy — landing step 4: "Uruchomienie agentow"
  Minimal stage illustration. Sits next to the step description.
  zawlodzki.pl · self-contained, no external dependencies.
*/
---

<div class="dg" data-diagram="zw-step4" aria-hidden="true" style="--dg-w: 400; --dg-h: 127.25;">
  <div class="zw-stage dg-stage">
    <div class="zw-fit dg-fit">
      <div class="zw-scene">
        <div class="s4-card">
          <span class="s4-bar"></span>
          <div class="s4-head">
            <span class="s4-title">Offer</span>
            <span class="s4-status">Draft</span>
            <span class="s4-check" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="13" height="13"><path d="M5 12.5l4.2 4.3L19 7" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
          </div>
          <div class="s4-lines">
            <div class="s4-line"><span style="width:100%"></span></div>
            <div class="s4-line"><span style="width:100%"></span></div>
            <div class="s4-line"><span style="width:58%"></span></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style is:global>
[data-diagram="zw-step4"] {
    --zw-primary:#3A48CC; --zw-primary-10:#EBEDFA; --zw-primary-30:#8991E0;
    --zw-secondary:#0ACFFE; --zw-success:#52C41A; --zw-bg-soft:#F9FAFB;
    --zw-border:#DDE1E6; --zw-border-soft:#EDF0F3; --zw-heading:#0E0F11;
    --zw-text:#1E2024; --zw-muted:#838D95; --zw-card:#FFFFFF;
    --zw-font:'Satoshi Variable','Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,system-ui,sans-serif;
    --zw-radius-card:10px;
    --zw-shadow-rest:0 1px 3px rgba(0,0,0,.08);
    font-family:var(--zw-font); width:100%; max-width:440px; margin:0 auto;
    box-sizing:border-box; -webkit-font-smoothing:antialiased;
  }
  [data-diagram="zw-step4"] *, [data-diagram="zw-step4"] *::before, [data-diagram="zw-step4"] *::after { box-sizing:border-box; }
  [data-diagram="zw-step4"] .zw-stage { width:100%; overflow:hidden; }
  [data-diagram="zw-step4"] .zw-fit { width:400px; transform-origin:top left; }
  [data-diagram="zw-step4"] .zw-scene { position:relative; }

  /* =================== SCENE:STYLE start =================== */
  [data-diagram="zw-step4"] .s4-card {
    position:relative; width:300px; margin:14px auto; overflow:hidden;
    background:var(--zw-card); border:1px solid var(--zw-border);
    border-radius:var(--zw-radius-card); box-shadow:var(--zw-shadow-rest);
    padding:16px 18px 18px; opacity:0; transition:border-color .4s ease;
  }
  [data-diagram="zw-step4"] .s4-bar {
    position:absolute; left:0; top:0; bottom:0; width:4px;
    background:var(--zw-primary); transition:background-color .4s ease;
  }
  [data-diagram="zw-step4"] .s4-head { display:flex; align-items:center; gap:10px; margin-bottom:16px; }
  [data-diagram="zw-step4"] .s4-title { font-size:15px; font-weight:700; color:var(--zw-heading); }
  [data-diagram="zw-step4"] .s4-status {
    font-size:11px; font-weight:700; letter-spacing:.05em; text-transform:uppercase;
    color:var(--zw-muted); background:var(--zw-border-soft); border-radius:6px;
    padding:3px 9px; transition:color .35s ease, background-color .35s ease;
  }
  [data-diagram="zw-step4"] .s4-status--ok { color:#fff; background:var(--zw-success); }
  [data-diagram="zw-step4"] .s4-check {
    margin-left:auto; width:22px; height:22px; border-radius:50%;
    background:var(--zw-success); color:#fff; display:flex; align-items:center;
    justify-content:center; transform:scale(0); transform-origin:center;
  }
  [data-diagram="zw-step4"] .s4-lines { display:flex; flex-direction:column; gap:11px; }
  [data-diagram="zw-step4"] .s4-line { height:9px; border-radius:5px; background:var(--zw-border-soft); overflow:hidden; }
  [data-diagram="zw-step4"] .s4-line span {
    display:block; height:100%; border-radius:5px; background:#C4CAD6;
    transform:scaleX(0); transform-origin:left center; will-change:transform;
  }
  /* ==================== SCENE:STYLE end ==================== */

  @media (prefers-reduced-motion: reduce) {
    [data-diagram="zw-step4"] .s4-card { opacity:1; border-color:rgba(82,196,26,.5); }
    [data-diagram="zw-step4"] .s4-bar { background:var(--zw-success); }
    [data-diagram="zw-step4"] .s4-status { color:#fff; background:var(--zw-success); }
    [data-diagram="zw-step4"] .s4-status::after { content:none; }
    [data-diagram="zw-step4"] .s4-check { transform:scale(1); }
    [data-diagram="zw-step4"] .s4-line span { transform:scaleX(1); }
  }
</style>

<script>
  // @ts-nocheck
  for (const root of document.querySelectorAll('[data-diagram="zw-step4"]')) {
(function () {
  if (!root || root.dataset.zwInit) return;
  root.dataset.zwInit = '1';

  var DESIGN_W = 400;
  var stage = root.querySelector('.zw-stage');
  var fitEl = root.querySelector('.zw-fit');
  var scene = root.querySelector('.zw-scene');
  var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  var EASE_OUT = 'cubic-bezier(0.22, 1, 0.36, 1)';
  var EASE_POP = 'cubic-bezier(0.34, 1.56, 0.64, 1)';
  function wait(ms){ return new Promise(function(r){ setTimeout(r, ms); }); }
  function settled(a){ return a.finished.catch(function(){}); }

  function fit(){}

  var card   = scene.querySelector('.s4-card');
  var bar    = scene.querySelector('.s4-bar');
  var status = scene.querySelector('.s4-status');
  var check  = scene.querySelector('.s4-check');
  var fills  = Array.prototype.slice.call(scene.querySelectorAll('.s4-line span'));

  async function play(){
    fit();
    if (reduce) {
      status.textContent = 'Approved';
      return;
    }

    // card enters
    await settled(card.animate(
      [{opacity:0, transform:'translateY(12px) scale(.97)'},{opacity:1, transform:'translateY(0) scale(1)'}],
      {duration:440, easing:EASE_OUT, fill:'forwards'}));
    card.style.opacity = 1;
    await wait(220);

    // AI writes the first version — lines fill in
    for (var i=0; i<fills.length; i++){
      fills[i].animate([{transform:'scaleX(0)'},{transform:'scaleX(1)'}],
        {duration:420, easing:EASE_OUT, fill:'forwards'});
      fills[i].style.transform = 'scaleX(1)';
      await wait(240);
    }

    // human approves
    await wait(240);
    status.textContent = 'Approved';
    status.classList.add('s4-status--ok');
    bar.style.background = 'var(--zw-success)';
    card.style.borderColor = 'rgba(82,196,26,.5)';
    check.animate([{transform:'scale(0)'},{transform:'scale(1)'}], {duration:360, easing:EASE_POP, fill:'forwards'});
    check.style.transform = 'scale(1)';
    card.animate([{transform:'scale(1)'},{transform:'scale(1.03)'},{transform:'scale(1)'}],
      {duration:400, easing:EASE_POP});
  }

  fit();
  if ('ResizeObserver' in window) { new ResizeObserver(fit).observe(stage); }
  else { window.addEventListener('resize', fit); }

  function arm(){
    if (!('IntersectionObserver' in window)) { play(); return; }
    var io = new IntersectionObserver(function(entries){
      entries.forEach(function(e){
        if (e.isIntersecting) { io.disconnect(); requestAnimationFrame(function(){ requestAnimationFrame(play); }); }
      });
    }, { threshold: 0.4 });
    io.observe(root);
  }
  if (document.readyState === 'loading') { document.addEventListener('DOMContentLoaded', arm); }
  else { arm(); }
})();
  }
</script>
