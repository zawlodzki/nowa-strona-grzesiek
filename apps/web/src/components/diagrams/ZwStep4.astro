---
// Rebuilt in the calm scene style by T105.
// Step 4 on the AI pages, the first agent: week by week, the share of the
// agent's actions that need no manual fix, drawn to scale out of 10, until
// it reaches the target of 9 in 10. The weekly figures are placeholders.
import "./scene/scene.css";

const target = 9;
const weeks = [6, 7, 8, 9];
---

<div
  class="sc"
  data-diagram="zw-step4"
  data-scene="sequence"
  aria-hidden="true"
>
  <div class="sc-body">
    <div class="head">
      <span>Pierwszy agent · działania bez poprawki</span>
      <span>na 10</span>
    </div>
    <ol>
      {weeks.map((value, i) => (
        <li
          class:list={["is-done", { hit: value >= target }]}
          data-step
          data-value={value}
        >
          <span class="name">Tydzień {i + 1}</span>
          <span class="value">{value} z 10</span>
          <span class="track">
            <span class="bar" style={`--v: ${value * 10}`} />
            <span class="goal" style={`--v: ${target * 10}`} />
          </span>
        </li>
      ))}
    </ol>
    <p class="note">Linia pionowa: cel, 9 z 10</p>
    <div class="sc-total">
      <span class="sc-total-label">Działania bez ręcznej poprawki</span>
      <span
        class="sc-total-value"
        data-total
        data-suffix={"\u00a0z\u00a010"}
      >{`${weeks[weeks.length - 1]}\u00a0z\u00a010`}</span>
    </div>
  </div>
</div>

<style>
  .head {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
    justify-content: space-between;
    padding-block-end: 0.5rem;
    color: var(--text-muted);
    font-size: 0.8125rem;
    border-block-end: 1px solid var(--text-heading);
  }

  li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.4rem 0.75rem;
    align-items: baseline;
    padding-block: 0.55rem;
    border-block-end: 1px solid var(--border-hairline);
  }

  .name {
    color: var(--text-heading);
  }

  .value {
    color: var(--text-muted);
    font-weight: var(--font-weight-semibold);
  }

  .hit .value {
    color: var(--text-link);
  }

  .track {
    position: relative;
    grid-column: 1 / -1;
    block-size: 8px;
    background: var(--surface-alt);
  }

  .bar {
    display: block;
    inline-size: calc(var(--v) * 1%);
    block-size: 100%;
    background: var(--color-primary-20);
    transform-origin: 0 50%;
  }

  .hit .bar {
    background: var(--text-link);
  }

  .goal {
    position: absolute;
    inset-block: -3px;
    inset-inline-start: calc(var(--v) * 1%);
    inline-size: 2px;
    background: var(--text-heading);
  }

  .note {
    margin: 0.5rem 0 0;
    color: var(--text-muted);
    font-size: 0.75rem;
  }

  li:not(.is-done) .bar {
    transform: scaleX(0);
  }

  li:not(.is-done) .value {
    opacity: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .bar {
      transition: transform 900ms cubic-bezier(0.65, 0, 0.35, 1);
    }

    .value {
      transition: opacity 630ms ease 300ms;
    }
  }
</style>

<script>
  import "./sequence";
</script>
