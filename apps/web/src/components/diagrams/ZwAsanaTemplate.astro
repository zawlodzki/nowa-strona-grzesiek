---
// Ported from the Webflow embed #zw-asana-template (szkolenie-i-wdrozenie-asana) by port/port-diagrams.mjs.
import './diagram.css';
/*
  <!-- Asana implementation — step 2: project template and responsibilities -->
*/
---

<div class="dg" data-diagram="zw-asana-template" aria-hidden="true" style="--dg-w: 400; --dg-h: 220;"><div class="zw-stage dg-stage"><div class="zw-fit dg-fit"><div class="zw-scene">
  <div class="as2-panel">
    <span class="as2-eyebrow">Loose tasks</span>
    <div class="as2-template">
      <div class="as2-head"><span class="as2-logo">A</span><b>Template</b><em class="as2-check">&#10003;</em></div>
      <div class="as2-row"><span></span><b>Brief</b><i>AK</i><em>D1</em></div>
      <div class="as2-row"><span></span><b>Production</b><i>MK</i><em>D3</em></div>
      <div class="as2-row"><span></span><b>Review</b><i>GZ</i><em>D5</em></div>
    </div>
    <div class="as2-task as2-task--1"><i></i><b>Brief</b></div>
    <div class="as2-task as2-task--2"><i></i><b>Production</b></div>
    <div class="as2-task as2-task--3"><i></i><b>Review</b></div>
  </div>
</div></div></div></div>

<style is:global>
[data-diagram="zw-asana-template"]{--zw-primary:#3A48CC;--zw-primary-10:#EBEDFA;--zw-primary-30:#8991E0;--zw-secondary:#0ACFFE;--zw-success:#52C41A;--zw-bg-soft:#F9FAFB;--zw-border:#DDE1E6;--zw-border-soft:#EDF0F3;--zw-heading:#0E0F11;--zw-text:#1E2024;--zw-muted:#838D95;--zw-card:#FFFFFF;--zw-font:'Satoshi Variable','Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,system-ui,sans-serif;--zw-serif:'Erode Variable','Fraunces','Source Serif 4',Georgia,serif;--zw-radius-card:10px;--zw-radius-lane:14px;--zw-shadow-rest:0 1px 3px rgba(0,0,0,.08);--zw-shadow-lift:1px 8px 22px rgba(14,15,17,.14);font-family:var(--zw-font);width:100%;max-width:440px;margin:0 auto;box-sizing:border-box;-webkit-font-smoothing:antialiased}
[data-diagram="zw-asana-template"] *,[data-diagram="zw-asana-template"] *::before,[data-diagram="zw-asana-template"] *::after{box-sizing:border-box}[data-diagram="zw-asana-template"] .zw-stage{width:100%;overflow:hidden}[data-diagram="zw-asana-template"] .zw-fit{width:400px;transform-origin:top left}[data-diagram="zw-asana-template"] .zw-scene{position:relative}
[data-diagram="zw-asana-template"] .as2-panel{position:relative;width:360px;height:220px;margin:6px auto;background:var(--zw-bg-soft);border:1px solid var(--zw-border);border-radius:var(--zw-radius-lane);overflow:hidden}
[data-diagram="zw-asana-template"] .as2-eyebrow{position:absolute;left:20px;top:23px;font-size:10px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;color:var(--zw-muted);opacity:0}
[data-diagram="zw-asana-template"] .as2-template{position:absolute;right:19px;top:28px;width:178px;height:164px;padding:12px;background:var(--zw-card);border:1px solid var(--zw-border);border-radius:var(--zw-radius-card);box-shadow:var(--zw-shadow-rest);opacity:0}
[data-diagram="zw-asana-template"] .as2-head{display:flex;align-items:center;gap:7px;margin-bottom:13px}[data-diagram="zw-asana-template"] .as2-logo{width:24px;height:24px;display:flex;align-items:center;justify-content:center;border-radius:7px;background:var(--zw-primary);color:#fff;font-size:10px;font-weight:800}
[data-diagram="zw-asana-template"] .as2-head>b{font-size:11px;color:var(--zw-heading)}[data-diagram="zw-asana-template"] .as2-check{margin-left:auto;width:20px;height:20px;display:flex;align-items:center;justify-content:center;border-radius:50%;background:var(--zw-success);color:#fff;font-size:11px;font-style:normal;transform:scale(0)}
[data-diagram="zw-asana-template"] .as2-row{height:30px;display:flex;align-items:center;gap:7px;margin-bottom:7px;padding:0 7px;border-radius:7px;background:var(--zw-border-soft);opacity:.45}
[data-diagram="zw-asana-template"] .as2-row>span{width:8px;height:8px;border:1px solid var(--zw-border);border-radius:3px}[data-diagram="zw-asana-template"] .as2-row>b{font-size:9px;color:var(--zw-text)}[data-diagram="zw-asana-template"] .as2-row>i{margin-left:auto;width:20px;height:20px;display:flex;align-items:center;justify-content:center;border-radius:50%;background:var(--zw-card);color:var(--zw-primary);font-size:7px;font-weight:800;font-style:normal}
[data-diagram="zw-asana-template"] .as2-row>em{font-size:7px;font-weight:800;font-style:normal;color:var(--zw-muted)}[data-diagram="zw-asana-template"] .as2-row--filled{opacity:1;background:var(--zw-primary-10)}[data-diagram="zw-asana-template"] .as2-row--filled>span{border-color:var(--zw-primary);background:var(--zw-primary)}
[data-diagram="zw-asana-template"] .as2-task{position:absolute;left:20px;width:126px;height:38px;padding:0 12px;display:flex;align-items:center;gap:9px;background:var(--zw-card);border:1px solid var(--zw-border);border-radius:var(--zw-radius-card);box-shadow:var(--zw-shadow-rest);opacity:0;z-index:4;will-change:transform,opacity}
[data-diagram="zw-asana-template"] .as2-task--1{top:56px}[data-diagram="zw-asana-template"] .as2-task--2{top:105px}[data-diagram="zw-asana-template"] .as2-task--3{top:154px}
[data-diagram="zw-asana-template"] .as2-task>i{width:10px;height:10px;border:1px solid var(--zw-primary-30);border-radius:3px}[data-diagram="zw-asana-template"] .as2-task>b{font-size:10px;color:var(--zw-text)}
@media(prefers-reduced-motion:reduce){[data-diagram="zw-asana-template"] .as2-eyebrow,[data-diagram="zw-asana-template"] .as2-template{opacity:1}[data-diagram="zw-asana-template"] .as2-task{opacity:0}[data-diagram="zw-asana-template"] .as2-row{opacity:1;background:var(--zw-primary-10)}[data-diagram="zw-asana-template"] .as2-row>span{border-color:var(--zw-primary);background:var(--zw-primary)}[data-diagram="zw-asana-template"] .as2-check{transform:scale(1)}}
</style>

<script>
  // @ts-nocheck
  for (const root of document.querySelectorAll('[data-diagram="zw-asana-template"]')) {
(function(){if(!root||root.dataset.zwInit)return;root.dataset.zwInit='1';var DESIGN_W=400,stage=root.querySelector('.zw-stage'),fitEl=root.querySelector('.zw-fit'),scene=root.querySelector('.zw-scene');var reduce=window.matchMedia&&window.matchMedia('(prefers-reduced-motion: reduce)').matches;var EASE_MOVE='cubic-bezier(0.645, 0.045, 0.355, 1)',EASE_OUT='cubic-bezier(0.22, 1, 0.36, 1)',EASE_POP='cubic-bezier(0.34, 1.56, 0.64, 1)';function wait(ms){return new Promise(function(r){setTimeout(r,ms)})}function settled(a){return a.finished.catch(function(){})}function fit(){}
async function play(){fit();if(reduce)return;var eyebrow=scene.querySelector('.as2-eyebrow'),template=scene.querySelector('.as2-template'),tasks=Array.prototype.slice.call(scene.querySelectorAll('.as2-task')),rows=Array.prototype.slice.call(scene.querySelectorAll('.as2-row'));eyebrow.animate([{opacity:0},{opacity:1}],{duration:300,easing:EASE_OUT,fill:'forwards'});eyebrow.style.opacity=1;template.animate([{opacity:0,transform:'translateX(12px)'},{opacity:1,transform:'translateX(0)'}],{duration:460,easing:EASE_OUT,fill:'forwards'});template.style.opacity=1;tasks.forEach(function(t,i){t.animate([{opacity:0,transform:'translateY(9px)'},{opacity:1,transform:'translateY(0)'}],{duration:420,delay:120+i*90,easing:EASE_OUT,fill:'forwards'});t.style.opacity=1});await wait(820);
for(var i=0;i<tasks.length;i++){var t=tasks[i],r=rows[i],dx=template.offsetLeft+r.offsetLeft-t.offsetLeft,dy=template.offsetTop+r.offsetTop-t.offsetTop;t.animate([{transform:'scale(1)',boxShadow:'var(--zw-shadow-rest)'},{transform:'scale(1.04)',boxShadow:'var(--zw-shadow-lift)'}],{duration:180,easing:EASE_OUT,fill:'forwards'});await wait(140);await settled(t.animate([{opacity:1,transform:'translate(0,0) scale(1.04)'},{opacity:1,transform:'translate('+(dx/2)+'px,'+(dy-14)+'px) scale(.9)',offset:.5},{opacity:0,transform:'translate('+dx+'px,'+dy+'px) scale(.72)'}],{duration:640,easing:EASE_MOVE,fill:'forwards'}));t.style.opacity=0;r.classList.add('as2-row--filled');r.animate([{transform:'scale(.96)'},{transform:'scale(1.035)'},{transform:'scale(1)'}],{duration:300,easing:EASE_OUT});await wait(260)}
var check=scene.querySelector('.as2-check');check.animate([{transform:'scale(0)'},{transform:'scale(1)'}],{duration:380,easing:EASE_POP,fill:'forwards'});check.style.transform='scale(1)'}
fit();if('ResizeObserver'in window)new ResizeObserver(fit).observe(stage);else window.addEventListener('resize',fit);function arm(){if(!('IntersectionObserver'in window)){play();return}var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){io.disconnect();requestAnimationFrame(function(){requestAnimationFrame(play)})}})},{threshold:.4});io.observe(root)}if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',arm);else arm()})();
  }
</script>
