---
// Rebuilt in the calm scene style by T103; port-diagrams.mjs no longer writes this file.
// The problem on the AI pages: most companies use AI, few see a business
// result. Two figures from McKinsey, State of AI 2025, drawn to scale, and
// the gap between them as the closing number. Used on the AI audit, course,
// programme and implementation pages.
import "./scene/scene.css";

const rows = [
  { name: "Regularnie używają AI", value: 88, loss: false },
  { name: "Widzą jakikolwiek wpływ na EBIT", value: 39, loss: true },
];
const gap = rows[0].value - rows[1].value;
---

<div
  class="sc"
  data-diagram="zw-problem"
  data-scene="sequence"
  aria-hidden="true"
>
  <div class="sc-body">
    <div class="head">
      <span>Organizacje</span>
      <span>Udział</span>
    </div>
    <ul>
      {rows.map((row, i) => (
        <li
          class:list={["is-done", { loss: row.loss }]}
          data-step
          data-value={i === rows.length - 1 ? gap : undefined}
        >
          <span class="name">{row.name}</span>
          <span class="value">{row.value}%</span>
          <span class="track">
            <span class="bar" style={`--v: ${row.value}`} />
          </span>
        </li>
      ))}
    </ul>
    <p class="source">Źródło: McKinsey, State of AI 2025</p>
    <div class="sc-total">
      <span class="sc-total-label">Różnica między użyciem a wynikiem</span>
      <span class="sc-total-value is-loss" data-total data-suffix=" p.p.">
        {gap} p.p.
      </span>
    </div>
  </div>
</div>

<style>
  .head {
    display: flex;
    justify-content: space-between;
    padding-block-end: 0.5rem;
    color: var(--text-muted);
    font-size: 0.8125rem;
    border-block-end: 1px solid var(--text-heading);
  }

  li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.5rem 0.75rem;
    align-items: baseline;
    padding-block: 0.8rem;
    border-block-end: 1px solid var(--border-hairline);
  }

  .name {
    color: var(--text-heading);
  }

  .value {
    color: var(--text-link);
    font-family: var(--font-family-heading);
    font-size: 1.35rem;
    font-weight: var(--font-weight-semibold);
    line-height: 1;
  }

  .loss .value {
    color: var(--text-error);
  }

  .track {
    grid-column: 1 / -1;
    block-size: 10px;
    background: var(--surface-alt);
  }

  .bar {
    display: block;
    inline-size: calc(var(--v) * 1%);
    block-size: 100%;
    background: var(--color-primary-20);
    transform-origin: 0 50%;
  }

  .loss .bar {
    background: var(--color-status-error);
  }

  .source {
    margin: 0.5rem 0 0;
    color: var(--text-muted);
    font-size: 0.75rem;
  }

  li:not(.is-done) .bar {
    transform: scaleX(0);
  }

  li:not(.is-done) .value {
    opacity: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .bar {
      transition: transform 900ms cubic-bezier(0.65, 0, 0.35, 1);
    }

    .value {
      transition: opacity 630ms ease 300ms;
    }
  }
</style>

<script>
  import "./sequence";
</script>
