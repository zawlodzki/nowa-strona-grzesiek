---
// Rebuilt in the calm scene style by T105.
// The next step after the course: the course is the cheapest way in, and its
// price is deducted if the buyer moves to the group programme or a dedicated
// implementation.
import ListScene from "./ListScene.astro";
---

<ListScene
  diagram="zw-course-next"
  head={["Forma współpracy", "Cena kursu"]}
  rows={[
    {
      name: "Kurs · pracujesz samodzielnie",
      value: "punkt startu",
      tone: "muted",
    },
    { name: "Program grupowy", value: "odliczona", pill: true, counts: true },
    {
      name: "Wdrożenie dedykowane",
      value: "odliczona",
      pill: true,
      counts: true,
    },
  ]}
  total={{ label: "Ścieżki z odliczeniem ceny kursu", of: 2 }}
/>
