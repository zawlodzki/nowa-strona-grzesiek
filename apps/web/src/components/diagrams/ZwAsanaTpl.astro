---
// Ported from the Webflow embed #zw-asana-tpl (audyt-procesow-asana) by port/port-diagrams.mjs.
import './diagram.css';
---

<div class="dg" data-diagram="zw-asana-tpl" aria-hidden="true" style="--dg-w: 400; --dg-h: 220;">
<div class="zw-stage dg-stage">
<div class="zw-fit dg-fit">
<div class="zw-scene">
<div class="at-panel">
<span class="at-eyebrow">Templates</span>
<div class="at-row at-r1">
<b>Onboarding</b>
<i style="width:78%"></i>
<span class="at-owners"><u></u><u></u></span>
<span class="at-mark at-mark--ok"><svg viewBox="0 0 24 24"><path d="M5 12.5l4.2 4.3L19 7"/></svg></span>
</div>
<div class="at-row at-r2">
<b>Campaign</b>
<i style="width:12%"></i>
<span class="at-owners"><u></u></span>
<span class="at-mark at-mark--stale">&mdash;</span>
</div>
<div class="at-row at-r3">
<b>Delivery</b>
<i style="width:64%"></i>
<span class="at-owners at-owners--none"><u class="at-ghost"></u></span>
<span class="at-mark at-mark--gap">?</span>
</div>
<div class="at-row at-r4">
<b>Retro</b>
<i style="width:8%"></i>
<span class="at-owners"><u></u></span>
<span class="at-mark at-mark--stale">&mdash;</span>
</div>
<span class="at-chip"><b>3</b> to fix</span>
</div>
</div>
</div>
</div>
</div>

<style is:global>
[data-diagram="zw-asana-tpl"] {
--zw-primary:#3A48CC; --zw-primary-10:#EBEDFA; --zw-primary-30:#8991E0;
--zw-secondary:#0ACFFE; --zw-success:#52C41A; --zw-bg-soft:#F9FAFB;
--zw-border:#DDE1E6; --zw-border-soft:#EDF0F3; --zw-heading:#0E0F11;
--zw-text:#1E2024; --zw-muted:#838D95; --zw-card:#FFFFFF;
--zw-font:'Satoshi Variable','Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,system-ui,sans-serif;
--zw-serif:'Erode Variable','Fraunces','Source Serif 4',Georgia,serif;
--zw-radius-card:10px; --zw-radius-lane:14px;
--zw-shadow-rest:0 1px 3px rgba(0,0,0,.08);
--zw-shadow-lift:1px 8px 22px rgba(14,15,17,.14);
font-family:var(--zw-font); width:100%; max-width:440px; margin:0 auto;
box-sizing:border-box; -webkit-font-smoothing:antialiased;
}
[data-diagram="zw-asana-tpl"] *, [data-diagram="zw-asana-tpl"] *::before, [data-diagram="zw-asana-tpl"] *::after { box-sizing:border-box; }
[data-diagram="zw-asana-tpl"] .zw-stage { width:100%; overflow:hidden; }
[data-diagram="zw-asana-tpl"] .zw-fit { width:400px; transform-origin:top left; }
[data-diagram="zw-asana-tpl"] .zw-scene { position:relative; }
[data-diagram="zw-asana-tpl"] .at-panel {
position:relative; width:360px; height:220px; margin:6px auto;
background:var(--zw-bg-soft); border:1px solid var(--zw-border);
border-radius:var(--zw-radius-lane); overflow:hidden;
}
[data-diagram="zw-asana-tpl"] .at-eyebrow {
position:absolute; left:20px; top:10px; font-size:11px; font-weight:700;
letter-spacing:.09em; text-transform:uppercase; color:var(--zw-muted); opacity:0;
}
[data-diagram="zw-asana-tpl"] .at-row {
position:absolute; left:20px; width:320px; height:38px; padding:0 12px;
display:flex; align-items:center; gap:10px;
background:var(--zw-card); border:1px solid var(--zw-border);
border-radius:var(--zw-radius-card); box-shadow:var(--zw-shadow-rest);
opacity:0;
}
[data-diagram="zw-asana-tpl"] .at-r1 { top:34px; }
[data-diagram="zw-asana-tpl"] .at-r2 { top:80px; }
[data-diagram="zw-asana-tpl"] .at-r3 { top:126px; }
[data-diagram="zw-asana-tpl"] .at-r4 { top:172px; }
[data-diagram="zw-asana-tpl"] .at-row b {
width:76px; flex:none; font-size:11px; font-weight:700; color:var(--zw-heading);
}
[data-diagram="zw-asana-tpl"] .at-row i {
display:block; height:5px; border-radius:4px; background:var(--zw-primary-10);
transform-origin:left center;
}
[data-diagram="zw-asana-tpl"] .at-owners { margin-left:auto; display:flex; gap:3px; flex:none; }
[data-diagram="zw-asana-tpl"] .at-owners u {
display:block; width:15px; height:15px; border-radius:50%;
background:var(--zw-primary-10); border:1px solid var(--zw-primary-30);
}
[data-diagram="zw-asana-tpl"] .at-owners u.at-ghost {
background:transparent; border:1px dashed var(--zw-border);
}
[data-diagram="zw-asana-tpl"] .at-mark {
flex:none; width:22px; height:22px; margin-left:4px;
display:flex; align-items:center; justify-content:center; border-radius:50%;
color:#fff; font-size:12px; font-weight:800; line-height:1;
transform:scale(0); transform-origin:center;
}
[data-diagram="zw-asana-tpl"] .at-mark--ok { background:var(--zw-success); box-shadow:0 0 0 4px rgba(82,196,26,.14); }
[data-diagram="zw-asana-tpl"] .at-mark--ok svg { width:12px; height:12px; }
[data-diagram="zw-asana-tpl"] .at-mark--ok path { fill:none; stroke:currentColor; stroke-width:2.8; stroke-linecap:round; stroke-linejoin:round; }
[data-diagram="zw-asana-tpl"] .at-mark--gap { background:var(--zw-secondary); box-shadow:0 0 0 4px rgba(10,207,254,.14); }
[data-diagram="zw-asana-tpl"] .at-mark--stale { background:var(--zw-border); color:var(--zw-muted); }
[data-diagram="zw-asana-tpl"] .at-row.is-stale { border-style:dashed; box-shadow:none; }
[data-diagram="zw-asana-tpl"] .at-row.is-stale b { color:var(--zw-muted); }
[data-diagram="zw-asana-tpl"] .at-row.is-stale i { background:var(--zw-border-soft); }
[data-diagram="zw-asana-tpl"] .at-scan {
position:absolute; left:14px; width:332px; height:38px; border-radius:12px;
background:rgba(58,72,204,.07); border:1px solid rgba(58,72,204,.18);
opacity:0; pointer-events:none;
}
[data-diagram="zw-asana-tpl"] .at-chip {
position:absolute; right:14px; top:6px; padding:3px 9px; border-radius:999px;
background:var(--zw-card); border:1px solid var(--zw-secondary);
color:var(--zw-text); font-size:10px; font-weight:700; line-height:1.4;
transform:scale(0); transform-origin:center;
}
[data-diagram="zw-asana-tpl"] .at-chip b { color:var(--zw-secondary); font-weight:800; }
@media (prefers-reduced-motion:reduce) {
[data-diagram="zw-asana-tpl"] .at-eyebrow, [data-diagram="zw-asana-tpl"] .at-row { opacity:1; }
[data-diagram="zw-asana-tpl"] .at-mark, [data-diagram="zw-asana-tpl"] .at-chip { transform:scale(1); }
[data-diagram="zw-asana-tpl"] .at-r2, [data-diagram="zw-asana-tpl"] .at-r4 { border-style:dashed; box-shadow:none; }
}
</style>

<script>
  // @ts-nocheck
  for (const root of document.querySelectorAll('[data-diagram="zw-asana-tpl"]')) {
(function(){
if(!root||root.dataset.zwInit)return; root.dataset.zwInit='1';
var DESIGN_W=400, stage=root.querySelector('.zw-stage'), fitEl=root.querySelector('.zw-fit'), scene=root.querySelector('.zw-scene');
var reduce=window.matchMedia&&window.matchMedia('(prefers-reduced-motion: reduce)').matches;
var EASE_MOVE='cubic-bezier(0.645, 0.045, 0.355, 1)';
var EASE_OUT='cubic-bezier(0.22, 1, 0.36, 1)';
var EASE_POP='cubic-bezier(0.34, 1.56, 0.64, 1)';
function wait(ms){return new Promise(function(r){setTimeout(r,ms);});}
function fit(){}
function $$(sel){return Array.prototype.slice.call(scene.querySelectorAll(sel));}
function riseIn(el,delay){
el.animate([{opacity:0,transform:'translateY(12px)'},{opacity:1,transform:'translateY(0)'}],
{duration:420,delay:delay||0,easing:EASE_OUT,fill:'forwards'});
el.style.opacity=1;
}
function popIn(el,delay){
el.animate([{transform:'scale(0)'},{transform:'scale(1)'}],
{duration:380,delay:delay||0,easing:EASE_POP,fill:'forwards'});
el.style.transform='scale(1)';
}
async function play(){
fit(); if(reduce)return;
var panel=scene.querySelector('.at-panel');
var rows=$$('.at-row');
riseIn(scene.querySelector('.at-eyebrow'));
rows.forEach(function(r,i){ riseIn(r,120+i*90); });
await wait(760);
var scan=document.createElement('span');
scan.className='at-scan';
panel.appendChild(scan);
for (var i=0;i<rows.length;i++){
var row=rows[i];
scan.style.top=(row.offsetTop)+'px';
scan.animate([{opacity:0},{opacity:1}],{duration:180,easing:EASE_OUT,fill:'forwards'});
scan.style.opacity=1;
await wait(260);
if (row.classList.contains('at-r2')||row.classList.contains('at-r4')) row.classList.add('is-stale');
popIn(row.querySelector('.at-mark'));
await wait(360);
}
scan.animate([{opacity:1},{opacity:0}],{duration:240,easing:EASE_OUT,fill:'forwards'});
scan.style.opacity=0;
await wait(300);
var chip=scene.querySelector('.at-chip');
popIn(chip);
await wait(420);
chip.animate([{transform:'scale(1)'},{transform:'scale(1.08)'},{transform:'scale(1)'}],
{duration:520,easing:EASE_POP});
}
fit(); if('ResizeObserver'in window)new ResizeObserver(fit).observe(stage);else window.addEventListener('resize',fit);
function arm(){if(!('IntersectionObserver'in window)){play();return;}var io=new IntersectionObserver(function(entries){entries.forEach(function(e){if(e.isIntersecting){io.disconnect();requestAnimationFrame(function(){requestAnimationFrame(play);});}});},{threshold:.4});io.observe(root);}
if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',arm);else arm();
})();
  }
</script>
