---
// Rebuilt in the calm scene style by T99; port-diagrams.mjs no longer writes this file.
// Step 1, the process map: each step from lead to delivery gets the hours it
// costs per week, drawn to scale, and a verdict. Steps that cost the most and
// need no judgement are automated; the offer stays with a person.
// The markup is the end state. Steps and hours are placeholders.
import "./scene/scene.css";

const max = 3;
const steps = [
  { name: "Lead z formularza do CRM", hours: 3, auto: true },
  { name: "Potwierdzenie spotkania", hours: 2, auto: true },
  { name: "Oferta", hours: 1.5, auto: false },
  { name: "Folder i dokumenty", hours: 1, auto: true },
  { name: "Przekazanie do realizacji", hours: 2.5, auto: true },
];
let picked = 0;
const rows = steps.map((step) => ({
  ...step,
  picked: (picked += step.auto ? 1 : 0),
}));
const hours = (h: number) => `${String(h).replace(".", ",")} h`;
---

<div
  class="sc"
  data-diagram="zw-auto-map"
  data-scene="sequence"
  aria-hidden="true"
>
  <div class="sc-body">
    <div class="head">
      <span>Od leada do realizacji</span>
      <span>Godziny tygodniowo</span>
    </div>
    <ul>
      {rows.map((row) => (
        <li class="is-done" data-step data-value={row.picked}>
          <span class="name">{row.name}</span>
          <span class:list={["verdict", row.auto ? "auto" : "manual"]}>
            {row.auto ? "automatyzujemy" : "zostaje ręcznie"}
          </span>
          <span class="track">
            <span class="bar" style={`--v: ${(row.hours / max) * 100}`} />
          </span>
          <span class="hours">{hours(row.hours)}</span>
        </li>
      ))}
    </ul>
    <div class="sc-total">
      <span class="sc-total-label">Wybrane automatyzacje</span>
      <span
        class="sc-total-value"
        data-total
        data-suffix={`\u00a0z\u00a0${steps.length}`}
      >{`${picked}\u00a0z\u00a0${steps.length}`}</span>
    </div>
  </div>
</div>

<style>
  .head {
    display: flex;
    justify-content: space-between;
    padding-block-end: 0.5rem;
    color: var(--text-muted);
    font-size: 0.8125rem;
    border-block-end: 1px solid var(--text-heading);
  }

  li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.35rem 0.75rem;
    align-items: center;
    padding-block: 0.55rem;
    border-block-end: 1px solid var(--border-hairline);
  }

  .name {
    color: var(--text-heading);
  }

  .verdict {
    padding: 0.1rem 0.55rem;
    font-size: 0.8125rem;
    font-weight: var(--font-weight-medium);
    white-space: nowrap;
    border-radius: var(--radius-pill);
  }

  .auto {
    color: var(--text-link);
    background: var(--surface-cyan-tint);
  }

  .manual {
    color: var(--text-muted);
    border: 1px solid var(--border-default);
  }

  .track {
    block-size: 6px;
    background: var(--surface-alt);
  }

  .bar {
    display: block;
    inline-size: calc(var(--v) * 1%);
    block-size: 100%;
    background: var(--color-primary-20);
    transform-origin: 0 50%;
  }

  .auto ~ .track .bar {
    background: var(--color-secondary-60);
  }

  .hours {
    color: var(--text-muted);
    font-size: 0.8125rem;
    text-align: end;
  }

  li:not(.is-done) .bar {
    transform: scaleX(0);
  }

  li:not(.is-done) :is(.verdict, .hours) {
    opacity: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .bar {
      transition: transform 900ms cubic-bezier(0.65, 0, 0.35, 1);
    }

    .verdict,
    .hours {
      transition: opacity 630ms ease 300ms;
    }
  }
</style>

<script>
  import "./sequence";
</script>
