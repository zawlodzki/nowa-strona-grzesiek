---
// Ported from the Webflow embed #zw-asana-real-work (szkolenie-i-wdrozenie-asana) by port/port-diagrams.mjs.
import './diagram.css';
/*
  <!-- Asana implementation — step 3: use the template on real projects -->
*/
---

<div class="dg" data-diagram="zw-asana-real-work" aria-hidden="true" style="--dg-w: 400; --dg-h: 220;"><div class="zw-stage dg-stage"><div class="zw-fit dg-fit"><div class="zw-scene">
  <div class="as3-panel">
    <div class="as3-template"><span>A</span><b>Template</b><em class="as3-count">0 projects</em></div>
    <span class="as3-line"></span>
    <div class="as3-project as3-project--1"><div><b>P-01</b><em>Live</em></div><i></i><i></i><i></i><span>Extra</span><strong>&#10003;</strong></div>
    <div class="as3-project as3-project--2"><div><b>P-02</b><em>Live</em></div><i></i><i></i><i></i><span>Extra</span><strong>&#10003;</strong></div>
    <div class="as3-project as3-project--3"><div><b>P-03</b><em>Live</em></div><i></i><i></i><i></i><span>Extra</span><strong>&#10003;</strong></div>
    <span class="as3-packet">A</span>
  </div>
</div></div></div></div>

<style is:global>
[data-diagram="zw-asana-real-work"]{--zw-primary:#3A48CC;--zw-primary-10:#EBEDFA;--zw-primary-30:#8991E0;--zw-secondary:#0ACFFE;--zw-success:#52C41A;--zw-bg-soft:#F9FAFB;--zw-border:#DDE1E6;--zw-border-soft:#EDF0F3;--zw-heading:#0E0F11;--zw-text:#1E2024;--zw-muted:#838D95;--zw-card:#FFFFFF;--zw-font:'Satoshi Variable','Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,system-ui,sans-serif;--zw-serif:'Erode Variable','Fraunces','Source Serif 4',Georgia,serif;--zw-radius-card:10px;--zw-radius-lane:14px;--zw-shadow-rest:0 1px 3px rgba(0,0,0,.08);--zw-shadow-lift:1px 8px 22px rgba(14,15,17,.14);font-family:var(--zw-font);width:100%;max-width:440px;margin:0 auto;box-sizing:border-box;-webkit-font-smoothing:antialiased}
[data-diagram="zw-asana-real-work"] *,[data-diagram="zw-asana-real-work"] *::before,[data-diagram="zw-asana-real-work"] *::after{box-sizing:border-box}[data-diagram="zw-asana-real-work"] .zw-stage{width:100%;overflow:hidden}[data-diagram="zw-asana-real-work"] .zw-fit{width:400px;transform-origin:top left}[data-diagram="zw-asana-real-work"] .zw-scene{position:relative}
[data-diagram="zw-asana-real-work"] .as3-panel{position:relative;width:360px;height:220px;margin:6px auto;background:var(--zw-bg-soft);border:1px solid var(--zw-border);border-radius:var(--zw-radius-lane);overflow:hidden}
[data-diagram="zw-asana-real-work"] .as3-template{position:absolute;left:108px;top:16px;width:144px;height:44px;padding:0 11px;display:flex;align-items:center;gap:8px;background:var(--zw-card);border:1px solid var(--zw-primary-30);border-radius:var(--zw-radius-card);box-shadow:var(--zw-shadow-rest);opacity:0;z-index:3}
[data-diagram="zw-asana-real-work"] .as3-template>span{width:23px;height:23px;display:flex;align-items:center;justify-content:center;border-radius:7px;background:var(--zw-primary);color:#fff;font-size:10px;font-weight:800}[data-diagram="zw-asana-real-work"] .as3-template>b{font-size:10px;color:var(--zw-heading)}
[data-diagram="zw-asana-real-work"] .as3-count{position:absolute;left:50%;bottom:-17px;transform:translateX(-50%);white-space:nowrap;padding:2px 7px;border-radius:999px;background:var(--zw-primary-10);color:var(--zw-primary);font-size:8px;font-weight:800;font-style:normal}
[data-diagram="zw-asana-real-work"] .as3-line{position:absolute;left:60px;right:60px;top:81px;height:2px;background:var(--zw-border);transform:scaleX(0);transform-origin:center}
[data-diagram="zw-asana-real-work"] .as3-project{position:absolute;top:100px;width:100px;height:101px;padding:10px;background:var(--zw-card);border:1px solid var(--zw-border);border-radius:var(--zw-radius-card);box-shadow:var(--zw-shadow-rest);opacity:0}
[data-diagram="zw-asana-real-work"] .as3-project--1{left:18px}[data-diagram="zw-asana-real-work"] .as3-project--2{left:130px}[data-diagram="zw-asana-real-work"] .as3-project--3{left:242px}
[data-diagram="zw-asana-real-work"] .as3-project>div{display:flex;align-items:center;justify-content:space-between;margin-bottom:9px}[data-diagram="zw-asana-real-work"] .as3-project>div b{font-size:10px;color:var(--zw-heading)}[data-diagram="zw-asana-real-work"] .as3-project>div em{font-size:7px;font-weight:800;font-style:normal;text-transform:uppercase;color:var(--zw-success)}
[data-diagram="zw-asana-real-work"] .as3-project>i{display:block;height:7px;margin-bottom:6px;border-radius:4px;background:var(--zw-primary-10);transform:scaleX(0);transform-origin:left}
[data-diagram="zw-asana-real-work"] .as3-project>i:nth-of-type(1){width:80%}[data-diagram="zw-asana-real-work"] .as3-project>i:nth-of-type(2){width:65%}[data-diagram="zw-asana-real-work"] .as3-project>i:nth-of-type(3){width:72%}
[data-diagram="zw-asana-real-work"] .as3-project>span{display:block;margin-top:4px;padding:3px 5px;border-radius:5px;background:var(--zw-border-soft);color:var(--zw-muted);font-size:7px;opacity:1}
[data-diagram="zw-asana-real-work"] .as3-project>strong{position:absolute;right:7px;bottom:7px;width:18px;height:18px;display:flex;align-items:center;justify-content:center;border-radius:50%;background:var(--zw-success);color:#fff;font-size:10px;transform:scale(0)}
[data-diagram="zw-asana-real-work"] .as3-packet{position:absolute;left:169px;top:48px;width:22px;height:22px;display:flex;align-items:center;justify-content:center;border-radius:7px;background:var(--zw-primary);color:#fff;font-size:9px;font-weight:800;box-shadow:var(--zw-shadow-lift);opacity:0;z-index:5;will-change:transform,opacity}
@media(prefers-reduced-motion:reduce){[data-diagram="zw-asana-real-work"] .as3-template,[data-diagram="zw-asana-real-work"] .as3-project{opacity:1}[data-diagram="zw-asana-real-work"] .as3-line{transform:scaleX(1)}[data-diagram="zw-asana-real-work"] .as3-project>i{transform:scaleX(1)}[data-diagram="zw-asana-real-work"] .as3-project>span{opacity:0}[data-diagram="zw-asana-real-work"] .as3-project>strong{transform:scale(1)}[data-diagram="zw-asana-real-work"] .as3-packet{opacity:0}}
</style>

<script>
  // @ts-nocheck
  for (const root of document.querySelectorAll('[data-diagram="zw-asana-real-work"]')) {
(function(){if(!root||root.dataset.zwInit)return;root.dataset.zwInit='1';var DESIGN_W=400,stage=root.querySelector('.zw-stage'),fitEl=root.querySelector('.zw-fit'),scene=root.querySelector('.zw-scene');var reduce=window.matchMedia&&window.matchMedia('(prefers-reduced-motion: reduce)').matches;var EASE_MOVE='cubic-bezier(0.645, 0.045, 0.355, 1)',EASE_OUT='cubic-bezier(0.22, 1, 0.36, 1)',EASE_POP='cubic-bezier(0.34, 1.56, 0.64, 1)';function wait(ms){return new Promise(function(r){setTimeout(r,ms)})}function settled(a){return a.finished.catch(function(){})}function fit(){}
async function play(){fit();var count=scene.querySelector('.as3-count');if(reduce){count.textContent='3 projects';return}var template=scene.querySelector('.as3-template'),line=scene.querySelector('.as3-line'),projects=Array.prototype.slice.call(scene.querySelectorAll('.as3-project')),packet=scene.querySelector('.as3-packet');template.animate([{opacity:0,transform:'translateY(-8px)'},{opacity:1,transform:'translateY(0)'}],{duration:460,easing:EASE_OUT,fill:'forwards'});template.style.opacity=1;line.animate([{transform:'scaleX(0)'},{transform:'scaleX(1)'}],{duration:520,delay:280,easing:EASE_OUT,fill:'forwards'});await wait(820);
for(var i=0;i<projects.length;i++){var p=projects[i],dx=p.offsetLeft+39-packet.offsetLeft,dy=p.offsetTop-42-packet.offsetTop;packet.style.opacity=1;await settled(packet.animate([{opacity:0,transform:'translate(0,0) scale(.8)'},{opacity:1,transform:'translate(0,0) scale(1)',offset:.2},{opacity:1,transform:'translate('+(dx/2)+'px,'+(dy-13)+'px)',offset:.55},{opacity:0,transform:'translate('+dx+'px,'+dy+'px) scale(.7)'}],{duration:680,easing:EASE_MOVE,fill:'forwards'}));packet.style.opacity=0;p.animate([{opacity:0,transform:'translateY(10px) scale(.94)'},{opacity:1,transform:'translateY(0) scale(1)'}],{duration:420,easing:EASE_OUT,fill:'forwards'});p.style.opacity=1;var bars=Array.prototype.slice.call(p.querySelectorAll('i'));bars.forEach(function(b,j){b.animate([{transform:'scaleX(0)'},{transform:'scaleX(1)'}],{duration:340,delay:j*90,easing:EASE_OUT,fill:'forwards'})});await wait(480);p.querySelector('span').animate([{opacity:1,transform:'scale(1)'},{opacity:0,transform:'scale(.75)'}],{duration:360,easing:EASE_OUT,fill:'forwards'});var check=p.querySelector('strong');check.animate([{transform:'scale(0)'},{transform:'scale(1)'}],{duration:360,easing:EASE_POP,fill:'forwards'});check.style.transform='scale(1)';count.textContent=(i+1)+' projects';await wait(360)}}
fit();if('ResizeObserver'in window)new ResizeObserver(fit).observe(stage);else window.addEventListener('resize',fit);function arm(){if(!('IntersectionObserver'in window)){play();return}var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){io.disconnect();requestAnimationFrame(function(){requestAnimationFrame(play)})}})},{threshold:.4});io.observe(root)}if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',arm);else arm()})();
  }
</script>
