---
// Rebuilt in the calm scene style by T100; port-diagrams.mjs no longer writes this file.
// Step 3, work on real projects: after a few weeks every part of the
// template is checked against how often the team uses it, drawn to scale.
// Unused parts are removed. The elements and shares are placeholders.
import ListScene from "./ListScene.astro";

const rows = [
  { name: "Sekcja „Brief”", used: 100 },
  { name: "Pole „Priorytet”", used: 85 },
  { name: "Pole „Kategoria”", used: 10 },
  { name: "Reguła „Przypomnienie”", used: 70 },
  { name: "Sekcja „Archiwum”", used: 5 },
  { name: "Pole „Budżet godzinowy”", used: 0 },
].map((e) => {
  const keep = e.used >= 50;
  return {
    name: `${e.name} · ${e.used}%`,
    value: keep ? "zostaje" : "usuwamy",
    tone: keep ? ("ok" as const) : ("muted" as const),
    pill: true,
    strike: !keep,
    bar: e.used,
    counts: !keep,
  };
});
---

<ListScene
  diagram="zw-asana-real-work"
  head={["Element szablonu · użycie po 4 tygodniach", "Decyzja"]}
  rows={rows}
  total={{ label: "Usunięte z szablonu", of: rows.length }}
/>
