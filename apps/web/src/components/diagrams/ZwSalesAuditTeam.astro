---
// Ported from the Webflow embed #zw-sales-audit-team (audyt-sprzedazy) by port/port-diagrams.mjs.
import './diagram.css';
---

<div class="dg" data-diagram="zw-sales-audit-team" aria-hidden="true" style="--dg-w: 400; --dg-h: 246;"><div class="zw-stage dg-stage"><div class="zw-fit dg-fit"><div class="zw-scene">
  <div class="sat-factor sat-f1"><span>Behavior</span><b>40</b></div><div class="sat-factor sat-f2"><span>Margin</span><b>35</b></div><div class="sat-factor sat-f3"><span>Fit</span><b>25</b></div>
  <div class="sat-plan"><span>Reward plan</span><div class="sat-bar"><i></i><i></i><i></i></div><b><svg viewBox="0 0 24 24"><path d="M5 12.5l4.2 4.3L19 7"/></svg></b></div>
  <div class="sat-reps"><div><i>A</i><span></span><em>Aligned</em></div><div><i>B</i><span></span><em>Aligned</em></div><div><i>C</i><span></span><em>Aligned</em></div></div><span class="sat-ring"></span>
</div></div></div></div>

<style is:global>
[data-diagram="zw-sales-audit-team"]{--zw-primary:#3A48CC;--zw-primary-10:#EBEDFA;--zw-primary-30:#8991E0;--zw-secondary:#0ACFFE;--zw-success:#52C41A;--zw-bg-soft:#F9FAFB;--zw-border:#DDE1E6;--zw-border-soft:#EDF0F3;--zw-heading:#0E0F11;--zw-text:#1E2024;--zw-muted:#838D95;--zw-card:#FFFFFF;--zw-font:'Satoshi Variable','Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,system-ui,sans-serif;--zw-serif:'Erode Variable','Fraunces','Source Serif 4',Georgia,serif;--zw-radius-card:10px;--zw-radius-lane:14px;--zw-shadow-rest:0 1px 3px rgba(0,0,0,.08);--zw-shadow-lift:1px 8px 22px rgba(14,15,17,.14);font-family:var(--zw-font);width:100%;max-width:440px;margin:0 auto;box-sizing:border-box;-webkit-font-smoothing:antialiased}
[data-diagram="zw-sales-audit-team"] *,[data-diagram="zw-sales-audit-team"] *::before,[data-diagram="zw-sales-audit-team"] *::after{box-sizing:border-box}[data-diagram="zw-sales-audit-team"] .zw-stage{width:100%;overflow:hidden}[data-diagram="zw-sales-audit-team"] .zw-fit{width:400px;transform-origin:top left}[data-diagram="zw-sales-audit-team"] .zw-scene{position:relative;width:400px;height:246px}
[data-diagram="zw-sales-audit-team"] .sat-factor{position:absolute;top:12px;width:104px;padding:11px 10px;background:var(--zw-card);border:1px solid var(--zw-border);border-radius:var(--zw-radius-card);box-shadow:var(--zw-shadow-rest);text-align:center;opacity:0}[data-diagram="zw-sales-audit-team"] .sat-f1{left:24px}[data-diagram="zw-sales-audit-team"] .sat-f2{left:148px}[data-diagram="zw-sales-audit-team"] .sat-f3{right:24px}
[data-diagram="zw-sales-audit-team"] .sat-factor span,[data-diagram="zw-sales-audit-team"] .sat-plan>span{display:block;color:var(--zw-muted);font-size:10px;font-weight:700;letter-spacing:.07em;text-transform:uppercase}[data-diagram="zw-sales-audit-team"] .sat-factor b{display:block;margin-top:3px;color:var(--zw-heading);font-size:19px}
[data-diagram="zw-sales-audit-team"] .sat-plan{position:absolute;left:92px;top:88px;width:216px;height:72px;padding:13px 14px;background:var(--zw-primary-10);border:1px solid var(--zw-primary-30);border-radius:var(--zw-radius-lane);box-shadow:var(--zw-shadow-lift);opacity:0}[data-diagram="zw-sales-audit-team"] .sat-plan .sat-bar{display:flex;height:8px;margin-top:12px;border-radius:8px;overflow:hidden;background:var(--zw-card)}[data-diagram="zw-sales-audit-team"] .sat-plan .sat-bar i:nth-child(1){width:40%;background:var(--zw-primary)}[data-diagram="zw-sales-audit-team"] .sat-plan .sat-bar i:nth-child(2){width:35%;background:var(--zw-primary-30)}[data-diagram="zw-sales-audit-team"] .sat-plan .sat-bar i:nth-child(3){width:25%;background:var(--zw-secondary)}
[data-diagram="zw-sales-audit-team"] .sat-plan b{position:absolute;right:12px;top:23px;width:24px;height:24px;border-radius:50%;background:var(--zw-success);color:#fff;display:flex;align-items:center;justify-content:center;transform:scale(0)}[data-diagram="zw-sales-audit-team"] .sat-plan svg{width:14px;height:14px}[data-diagram="zw-sales-audit-team"] .sat-plan path{fill:none;stroke:currentColor;stroke-width:2.7;stroke-linecap:round;stroke-linejoin:round}
[data-diagram="zw-sales-audit-team"] .sat-reps{position:absolute;left:48px;right:48px;bottom:8px;display:flex;gap:10px}[data-diagram="zw-sales-audit-team"] .sat-reps>div{flex:1;padding:9px 8px;background:var(--zw-bg-soft);border:1px solid var(--zw-border-soft);border-radius:var(--zw-radius-card);display:grid;grid-template-columns:20px 1fr;align-items:center;gap:7px;opacity:0}[data-diagram="zw-sales-audit-team"] .sat-reps i{width:20px;height:20px;border-radius:50%;background:var(--zw-primary-10);color:var(--zw-primary);display:flex;align-items:center;justify-content:center;font-style:normal;font-size:10px;font-weight:700}[data-diagram="zw-sales-audit-team"] .sat-reps span{height:6px;border-radius:4px;background:var(--zw-border)}[data-diagram="zw-sales-audit-team"] .sat-reps em{grid-column:1/3;color:var(--zw-success);font-size:9px;font-style:normal;font-weight:700;letter-spacing:.05em;text-transform:uppercase;opacity:0}
[data-diagram="zw-sales-audit-team"] .sat-ring{position:absolute;left:88px;top:84px;width:224px;height:80px;border:2px solid var(--zw-secondary);border-radius:16px;opacity:0}
@media(prefers-reduced-motion:reduce){[data-diagram="zw-sales-audit-team"] .sat-factor,[data-diagram="zw-sales-audit-team"] .sat-plan,[data-diagram="zw-sales-audit-team"] .sat-reps>div,[data-diagram="zw-sales-audit-team"] .sat-reps em{opacity:1}[data-diagram="zw-sales-audit-team"] .sat-plan b{transform:scale(1)}}
</style>

<script>
  // @ts-nocheck
  for (const root of document.querySelectorAll('[data-diagram="zw-sales-audit-team"]')) {
(function(){if(!root||root.dataset.zwInit)return;root.dataset.zwInit='1';var DESIGN_W=400,stage=root.querySelector('.zw-stage'),fitEl=root.querySelector('.zw-fit'),scene=root.querySelector('.zw-scene'),reduce=window.matchMedia&&window.matchMedia('(prefers-reduced-motion: reduce)').matches;var EASE_MOVE='cubic-bezier(0.645, 0.045, 0.355, 1)',EASE_OUT='cubic-bezier(0.22, 1, 0.36, 1)',EASE_POP='cubic-bezier(0.34, 1.56, 0.64, 1)';function wait(ms){return new Promise(function(r){setTimeout(r,ms)})}function fit(){}function rise(el,d){el.animate([{opacity:0,transform:'translateY(12px) scale(.96)'},{opacity:1,transform:'translateY(0) scale(1)'}],{duration:430,delay:d||0,easing:EASE_OUT,fill:'forwards'});el.style.opacity=1}async function play(){fit();if(reduce)return;var fs=Array.prototype.slice.call(scene.querySelectorAll('.sat-factor'));fs.forEach(function(f,i){rise(f,i*100)});await wait(700);var plan=scene.querySelector('.sat-plan');rise(plan);await wait(460);fs.forEach(function(f,i){f.animate([{transform:'translateY(0) scale(1)'},{transform:'translate('+(i===0?68:i===2?-68:0)+'px,46px) scale(.82)',opacity:.3}],{duration:620,delay:i*90,easing:EASE_MOVE,fill:'forwards'})});await wait(920);var reps=Array.prototype.slice.call(scene.querySelectorAll('.sat-reps>div'));reps.forEach(function(r,i){rise(r,i*100)});await wait(620);reps.forEach(function(r,i){setTimeout(function(){var e=r.querySelector('em');e.animate([{opacity:0,transform:'translateY(5px)'},{opacity:1,transform:'translateY(0)'}],{duration:320,easing:EASE_OUT,fill:'forwards'});e.style.opacity=1},i*130)});await wait(660);var check=plan.querySelector('b');check.animate([{transform:'scale(0)'},{transform:'scale(1)'}],{duration:360,easing:EASE_POP,fill:'forwards'});check.style.transform='scale(1)';var ring=scene.querySelector('.sat-ring');ring.animate([{opacity:.65,transform:'scale(.96)'},{opacity:0,transform:'scale(1.14)'}],{duration:760,easing:EASE_OUT,fill:'forwards'})}fit();if('ResizeObserver'in window)new ResizeObserver(fit).observe(stage);else window.addEventListener('resize',fit);function arm(){if(!('IntersectionObserver'in window)){play();return}var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){io.disconnect();requestAnimationFrame(function(){requestAnimationFrame(play)})}})},{threshold:.4});io.observe(root)}if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',arm);else arm()})();
  }
</script>
