---
// Rebuilt in the calm scene style by T100.
// The problem on both Asana pages: the tasks are in Asana, but the scope,
// deadline, status and files live in mail, heads and private drives, so the
// status is rebuilt at every meeting. It ends on the loss.
// The rows are placeholders.
import ListScene from "./ListScene.astro";
---

<ListScene
  diagram="zw-asana-problem"
  title="Projekt Acme"
  subtitle="Gdzie są ustalenia?"
  rows={[
    { name: "Zakres prac", value: "w mailu sprzedaży", tone: "loss" },
    { name: "Termin", value: "w głowie prowadzącego", tone: "loss" },
    { name: "Zadania", value: "w Asanie", counts: true },
    { name: "Status", value: "odtwarzany na odprawie", tone: "loss" },
    { name: "Pliki klienta", value: "na prywatnym dysku", tone: "loss" },
  ]}
  total={{ label: "Ustalenia zapisane w Asanie", of: 5, loss: true }}
/>
