---
// Rebuilt in the calm scene style by T102; port-diagrams.mjs no longer writes this file.
// CRM audit step 2, data and fields: how complete each field is, drawn to
// scale, and which fields are dead or missing.
// The fields and shares are placeholders.
import ListScene from "./ListScene.astro";

const fields = [
  { name: "Branża", filled: 90, verdict: "działa", tone: "ok" },
  { name: "Źródło leada", filled: 35, verdict: "uzupełnić", tone: "loss" },
  { name: "Wartość szansy", filled: 60, verdict: "niepełne", tone: "loss" },
  { name: "Pole „Stare ID”", filled: 0, verdict: "martwe", tone: "muted" },
  { name: "Data decyzji", filled: 0, verdict: "brakuje pola", tone: "loss" },
] as const;
---

<ListScene
  diagram="zw-audit-observe-k2"
  head={["Pole · wypełnienie", "Ocena"]}
  rows={fields.map((f) => ({
    name: `${f.name} · ${f.filled}%`,
    value: f.verdict,
    tone: f.tone,
    pill: true,
    strike: f.verdict === "martwe",
    bar: f.filled,
    counts: f.tone !== "ok",
  }))}
  total={{ label: "Pola do naprawy", of: fields.length, loss: true }}
/>
