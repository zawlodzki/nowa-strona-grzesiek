    { name: "Ofertowanie", value: "jeden standard" },
    {
      name: "Follow-up",
      value: "zależy od handlowca",
      tone: "loss",
      counts: true,
    },
    {
      name: "Przekazanie do realizacji",
      value: "mailem",
      tone: "loss",
      counts: true,
