---
// Ported from the Webflow embed #zw-sales-audit-process (audyt-sprzedazy) by port/port-diagrams.mjs.
import './diagram.css';
---

<div class="dg" data-diagram="zw-sales-audit-process" aria-hidden="true" style="--dg-w: 400; --dg-h: 226;"><div class="zw-stage dg-stage"><div class="zw-fit dg-fit"><div class="zw-scene">
  <div class="sap-track"></div>
  <div class="sap-step sap-s1"><i></i><span>Lead</span></div><div class="sap-step sap-s2"><i></i><span>Qualify</span></div><div class="sap-step sap-s3"><i></i><span>Proposal</span></div><div class="sap-step sap-s4"><i></i><span>Handoff</span></div>
  <div class="sap-deal"><span class="sap-avatar">A</span><strong>Acme</strong><em>&euro;24k</em><b><svg viewBox="0 0 24 24"><path d="M5 12.5l4.2 4.3L19 7"/></svg></b></div>
</div></div></div></div>

<style is:global>
[data-diagram="zw-sales-audit-process"]{--zw-primary:#3A48CC;--zw-primary-10:#EBEDFA;--zw-primary-30:#8991E0;--zw-secondary:#0ACFFE;--zw-success:#52C41A;--zw-bg-soft:#F9FAFB;--zw-border:#DDE1E6;--zw-border-soft:#EDF0F3;--zw-heading:#0E0F11;--zw-text:#1E2024;--zw-muted:#838D95;--zw-card:#FFFFFF;--zw-font:'Satoshi Variable','Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,system-ui,sans-serif;--zw-serif:'Erode Variable','Fraunces','Source Serif 4',Georgia,serif;--zw-radius-card:10px;--zw-radius-lane:14px;--zw-shadow-rest:0 1px 3px rgba(0,0,0,.08);--zw-shadow-lift:1px 8px 22px rgba(14,15,17,.14);font-family:var(--zw-font);width:100%;max-width:440px;margin:0 auto;box-sizing:border-box;-webkit-font-smoothing:antialiased}
[data-diagram="zw-sales-audit-process"] *,[data-diagram="zw-sales-audit-process"] *::before,[data-diagram="zw-sales-audit-process"] *::after{box-sizing:border-box}[data-diagram="zw-sales-audit-process"] .zw-stage{width:100%;overflow:hidden}[data-diagram="zw-sales-audit-process"] .zw-fit{width:400px;transform-origin:top left}[data-diagram="zw-sales-audit-process"] .zw-scene{position:relative;width:400px;height:226px;padding-top:18px}
[data-diagram="zw-sales-audit-process"] .sap-track{position:absolute;left:48px;right:48px;top:64px;height:3px;background:var(--zw-border-soft);border-radius:3px;transform:scaleX(0);transform-origin:left}
[data-diagram="zw-sales-audit-process"] .sap-step{position:absolute;top:45px;width:78px;text-align:center;opacity:0}[data-diagram="zw-sales-audit-process"] .sap-s1{left:10px}[data-diagram="zw-sales-audit-process"] .sap-s2{left:111px}[data-diagram="zw-sales-audit-process"] .sap-s3{left:212px}[data-diagram="zw-sales-audit-process"] .sap-s4{right:10px}
[data-diagram="zw-sales-audit-process"] .sap-step i{display:block;width:40px;height:40px;margin:0 auto 10px;border-radius:50%;background:var(--zw-card);border:2px solid var(--zw-border);box-shadow:var(--zw-shadow-rest);position:relative;z-index:2;transition:background-color .3s ease,border-color .3s ease}
[data-diagram="zw-sales-audit-process"] .sap-step i::after{content:'';position:absolute;left:11px;top:7px;width:12px;height:19px;border-right:3px solid #fff;border-bottom:3px solid #fff;transform:rotate(45deg) scale(0)}
[data-diagram="zw-sales-audit-process"] .sap-step span{color:var(--zw-muted);font-size:11px;font-weight:700;letter-spacing:.06em;text-transform:uppercase}[data-diagram="zw-sales-audit-process"] .sap-step.sap-done i{background:var(--zw-success)!important;border-color:var(--zw-success)!important}[data-diagram="zw-sales-audit-process"] .sap-step.sap-done i::after{transform:rotate(45deg) scale(1)!important}
[data-diagram="zw-sales-audit-process"] .sap-deal{position:absolute;left:12px;top:125px;width:122px;height:58px;padding:10px 11px;background:var(--zw-card);border:1px solid var(--zw-border);border-radius:var(--zw-radius-card);box-shadow:var(--zw-shadow-rest);display:grid;grid-template-columns:24px 1fr;grid-template-rows:20px 18px;column-gap:8px;opacity:0;will-change:transform,opacity}
[data-diagram="zw-sales-audit-process"] .sap-avatar{grid-row:1/3;width:24px;height:24px;border-radius:50%;display:flex;align-items:center;justify-content:center;background:var(--zw-primary-10);color:var(--zw-primary);font-size:11px;font-weight:700}[data-diagram="zw-sales-audit-process"] .sap-deal strong{color:var(--zw-heading);font-size:12px;line-height:20px}[data-diagram="zw-sales-audit-process"] .sap-deal em{color:var(--zw-muted);font-size:11px;font-style:normal}
[data-diagram="zw-sales-audit-process"] .sap-deal b{position:absolute;right:8px;top:18px;width:22px;height:22px;border-radius:50%;background:var(--zw-success);color:#fff;display:flex;align-items:center;justify-content:center;transform:scale(0)}[data-diagram="zw-sales-audit-process"] .sap-deal svg{width:13px;height:13px}[data-diagram="zw-sales-audit-process"] .sap-deal path{fill:none;stroke:currentColor;stroke-width:2.7;stroke-linecap:round;stroke-linejoin:round}
@media(prefers-reduced-motion:reduce){[data-diagram="zw-sales-audit-process"] .sap-track{transform:scaleX(1)}[data-diagram="zw-sales-audit-process"] .sap-step,[data-diagram="zw-sales-audit-process"] .sap-deal{opacity:1}[data-diagram="zw-sales-audit-process"] .sap-step i{background:var(--zw-success);border-color:var(--zw-success)}[data-diagram="zw-sales-audit-process"] .sap-step i::after{transform:rotate(45deg) scale(1)}[data-diagram="zw-sales-audit-process"] .sap-deal{transform:translateX(254px)}[data-diagram="zw-sales-audit-process"] .sap-deal b{transform:scale(1)}}
</style>

<script>
  // @ts-nocheck
  for (const root of document.querySelectorAll('[data-diagram="zw-sales-audit-process"]')) {
(function(){if(!root||root.dataset.zwInit)return;root.dataset.zwInit='1';var DESIGN_W=400,stage=root.querySelector('.zw-stage'),fitEl=root.querySelector('.zw-fit'),scene=root.querySelector('.zw-scene'),reduce=window.matchMedia&&window.matchMedia('(prefers-reduced-motion: reduce)').matches;var EASE_MOVE='cubic-bezier(0.645, 0.045, 0.355, 1)',EASE_OUT='cubic-bezier(0.22, 1, 0.36, 1)',EASE_POP='cubic-bezier(0.34, 1.56, 0.64, 1)';function wait(ms){return new Promise(function(r){setTimeout(r,ms)})}function settled(a){return a.finished.catch(function(){})}function fit(){}async function play(){fit();if(reduce)return;var track=scene.querySelector('.sap-track');track.animate([{transform:'scaleX(0)'},{transform:'scaleX(1)'}],{duration:640,easing:EASE_MOVE,fill:'forwards'});track.style.transform='scaleX(1)';var steps=Array.prototype.slice.call(scene.querySelectorAll('.sap-step'));steps.forEach(function(s,i){s.animate([{opacity:0,transform:'translateY(10px)'},{opacity:1,transform:'translateY(0)'}],{duration:420,delay:i*90,easing:EASE_OUT,fill:'forwards'});s.style.opacity=1});await wait(640);var deal=scene.querySelector('.sap-deal');deal.animate([{opacity:0,transform:'translateY(12px) scale(.96)'},{opacity:1,transform:'translateY(0) scale(1)'}],{duration:420,easing:EASE_OUT,fill:'forwards'});deal.style.opacity=1;await wait(520);for(var i=0;i<steps.length;i++){steps[i].classList.add('sap-done');steps[i].querySelector('i').animate([{transform:'scale(.82)'},{transform:'scale(1)'}],{duration:330,easing:EASE_POP});if(i<steps.length-1){var from=i*85,to=(i+1)*85;deal.animate([{transform:'translateX('+from+'px) scale(1)',boxShadow:'var(--zw-shadow-rest)'},{transform:'translateX('+(from+to)/2+'px) translateY(-12px) scale(1.04)',boxShadow:'var(--zw-shadow-lift)',offset:.5},{transform:'translateX('+to+'px) scale(1)',boxShadow:'var(--zw-shadow-rest)'}],{duration:640,easing:EASE_MOVE,fill:'forwards'});deal.style.transform='translateX('+to+'px)';await wait(720)}else{await wait(220)}}var check=deal.querySelector('b');check.animate([{transform:'scale(0)'},{transform:'scale(1)'}],{duration:360,easing:EASE_POP,fill:'forwards'});check.style.transform='scale(1)'}fit();if('ResizeObserver'in window)new ResizeObserver(fit).observe(stage);else window.addEventListener('resize',fit);function arm(){if(!('IntersectionObserver'in window)){play();return}var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){io.disconnect();requestAnimationFrame(function(){requestAnimationFrame(play)})}})},{threshold:.4});io.observe(root)}if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',arm);else arm()})();
  }
</script>
