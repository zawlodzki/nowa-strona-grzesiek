---
// Rebuilt in the calm scene style by T100; port-diagrams.mjs no longer writes this file.
// Step 1, choosing the first processes: repeatable processes with real
// value start first, not the whole company. Bars show how often each runs
// per month, drawn to scale. The processes and counts are placeholders.
import ListScene from "./ListScene.astro";

const max = 12;
const rows = [
  { name: "Wdrożenie klienta", runs: 12, start: true },
  { name: "Kampania marketingowa", runs: 8, start: true },
  { name: "Rekrutacja", runs: 3, start: false },
  { name: "Budżet roczny", runs: 1, start: false },
  { name: "Projekt jednorazowy", runs: 1, start: false },
].map((p) => ({
  name: `${p.name} · ${p.runs}`,
  value: p.start ? "na start" : "później",
  tone: p.start ? ("ok" as const) : ("muted" as const),
  pill: true,
  bar: (p.runs / max) * 100,
  counts: p.start,
}));
---

<ListScene
  diagram="zw-asana-process"
  head={["Proces · powtórzeń w miesiącu", "Decyzja"]}
  rows={rows}
  total={{ label: "Procesy na start", of: rows.length }}
/>
