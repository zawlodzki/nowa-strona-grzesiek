---
// Ported from the Webflow embed #zw-sales-audit-strategy (audyt-sprzedazy) by port/port-diagrams.mjs.
import './diagram.css';
---

<div class="dg" data-diagram="zw-sales-audit-strategy" aria-hidden="true" style="--dg-w: 400; --dg-h: 232;"><div class="zw-stage dg-stage"><div class="zw-fit dg-fit"><div class="zw-scene">
  <div class="sas-target"><span>Revenue target</span><b>2.4M</b></div><div class="sas-flow"></div>
  <div class="sas-metric sas-m1"><span>Win rate</span><b>20%</b></div><div class="sas-metric sas-m2"><span>Deals</span><b>100</b></div><div class="sas-metric sas-m3"><span>Leads</span><b>500</b></div>
  <div class="sas-plan"><span>Plan</span><i><svg viewBox="0 0 24 24"><path d="M5 12.5l4.2 4.3L19 7"/></svg></i></div>
</div></div></div></div>

<style is:global>
[data-diagram="zw-sales-audit-strategy"]{--zw-primary:#3A48CC;--zw-primary-10:#EBEDFA;--zw-primary-30:#8991E0;--zw-secondary:#0ACFFE;--zw-success:#52C41A;--zw-bg-soft:#F9FAFB;--zw-border:#DDE1E6;--zw-border-soft:#EDF0F3;--zw-heading:#0E0F11;--zw-text:#1E2024;--zw-muted:#838D95;--zw-card:#FFFFFF;--zw-font:'Satoshi Variable','Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,system-ui,sans-serif;--zw-serif:'Erode Variable','Fraunces','Source Serif 4',Georgia,serif;--zw-radius-card:10px;--zw-radius-lane:14px;--zw-shadow-rest:0 1px 3px rgba(0,0,0,.08);--zw-shadow-lift:1px 8px 22px rgba(14,15,17,.14);font-family:var(--zw-font);width:100%;max-width:440px;margin:0 auto;box-sizing:border-box;-webkit-font-smoothing:antialiased}
[data-diagram="zw-sales-audit-strategy"] *,[data-diagram="zw-sales-audit-strategy"] *::before,[data-diagram="zw-sales-audit-strategy"] *::after{box-sizing:border-box}[data-diagram="zw-sales-audit-strategy"] .zw-stage{width:100%;overflow:hidden}[data-diagram="zw-sales-audit-strategy"] .zw-fit{width:400px;transform-origin:top left}[data-diagram="zw-sales-audit-strategy"] .zw-scene{position:relative;width:400px;height:232px}
[data-diagram="zw-sales-audit-strategy"] .sas-target{position:absolute;left:110px;top:8px;width:180px;padding:14px 18px;background:var(--zw-card);border:1px solid var(--zw-primary-30);border-radius:var(--zw-radius-card);box-shadow:var(--zw-shadow-lift);opacity:0;text-align:center}
[data-diagram="zw-sales-audit-strategy"] span{display:block;color:var(--zw-muted);font-size:11px;font-weight:700;letter-spacing:.07em;text-transform:uppercase}[data-diagram="zw-sales-audit-strategy"] b{display:block;color:var(--zw-heading);font-family:var(--zw-serif);font-size:26px;line-height:1.1;margin-top:4px}
[data-diagram="zw-sales-audit-strategy"] .sas-flow{position:absolute;left:199px;top:78px;width:2px;height:42px;background:var(--zw-border);transform:scaleY(0);transform-origin:top}
[data-diagram="zw-sales-audit-strategy"] .sas-metric{position:absolute;top:122px;width:112px;padding:13px 12px;background:var(--zw-bg-soft);border:1px solid var(--zw-border);border-radius:var(--zw-radius-card);box-shadow:var(--zw-shadow-rest);opacity:0;text-align:center}
[data-diagram="zw-sales-audit-strategy"] .sas-m1{left:16px}[data-diagram="zw-sales-audit-strategy"] .sas-m2{left:144px}[data-diagram="zw-sales-audit-strategy"] .sas-m3{right:16px}[data-diagram="zw-sales-audit-strategy"] .sas-metric b{font-size:22px;font-family:var(--zw-font)}
[data-diagram="zw-sales-audit-strategy"] .sas-plan{position:absolute;left:142px;bottom:0;width:116px;height:34px;padding:8px 12px;border-radius:999px;background:var(--zw-primary-10);border:1px solid var(--zw-primary-30);opacity:0;display:flex;align-items:center;justify-content:center;gap:9px}
[data-diagram="zw-sales-audit-strategy"] .sas-plan span{color:var(--zw-primary)}[data-diagram="zw-sales-audit-strategy"] .sas-plan i{width:19px;height:19px;border-radius:50%;background:var(--zw-success);color:#fff;display:flex;align-items:center;justify-content:center;transform:scale(0)}[data-diagram="zw-sales-audit-strategy"] .sas-plan svg{width:12px;height:12px}[data-diagram="zw-sales-audit-strategy"] .sas-plan path{fill:none;stroke:currentColor;stroke-width:2.7;stroke-linecap:round;stroke-linejoin:round}
@media(prefers-reduced-motion:reduce){[data-diagram="zw-sales-audit-strategy"] .sas-target,[data-diagram="zw-sales-audit-strategy"] .sas-metric,[data-diagram="zw-sales-audit-strategy"] .sas-plan{opacity:1}[data-diagram="zw-sales-audit-strategy"] .sas-flow{transform:scaleY(1)}[data-diagram="zw-sales-audit-strategy"] .sas-plan i{transform:scale(1)}}
</style>

<script>
  // @ts-nocheck
  for (const root of document.querySelectorAll('[data-diagram="zw-sales-audit-strategy"]')) {
(function(){if(!root||root.dataset.zwInit)return;root.dataset.zwInit='1';var DESIGN_W=400,stage=root.querySelector('.zw-stage'),fitEl=root.querySelector('.zw-fit'),scene=root.querySelector('.zw-scene'),reduce=window.matchMedia&&window.matchMedia('(prefers-reduced-motion: reduce)').matches;var EASE_MOVE='cubic-bezier(0.645, 0.045, 0.355, 1)',EASE_OUT='cubic-bezier(0.22, 1, 0.36, 1)',EASE_POP='cubic-bezier(0.34, 1.56, 0.64, 1)';function wait(ms){return new Promise(function(r){setTimeout(r,ms)})}function fit(){}function rise(el,d){el.animate([{opacity:0,transform:'translateY(12px) scale(.96)'},{opacity:1,transform:'translateY(0) scale(1)'}],{duration:440,delay:d||0,easing:EASE_OUT,fill:'forwards'});el.style.opacity=1}async function play(){fit();if(reduce)return;rise(scene.querySelector('.sas-target'));await wait(560);var flow=scene.querySelector('.sas-flow');flow.animate([{transform:'scaleY(0)'},{transform:'scaleY(1)'}],{duration:420,easing:EASE_MOVE,fill:'forwards'});flow.style.transform='scaleY(1)';await wait(260);var ms=Array.prototype.slice.call(scene.querySelectorAll('.sas-metric'));ms.reverse().forEach(function(m,i){rise(m,i*120)});await wait(760);ms.forEach(function(m,i){setTimeout(function(){m.animate([{transform:'scale(1)'},{transform:'scale(1.05)'},{transform:'scale(1)'}],{duration:420,easing:EASE_POP})},i*170)});await wait(760);var plan=scene.querySelector('.sas-plan');rise(plan);await wait(320);var check=plan.querySelector('i');check.animate([{transform:'scale(0)'},{transform:'scale(1)'}],{duration:360,easing:EASE_POP,fill:'forwards'});check.style.transform='scale(1)'}fit();if('ResizeObserver'in window)new ResizeObserver(fit).observe(stage);else window.addEventListener('resize',fit);function arm(){if(!('IntersectionObserver'in window)){play();return}var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){io.disconnect();requestAnimationFrame(function(){requestAnimationFrame(play)})}})},{threshold:.4});io.observe(root)}if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',arm);else arm()})();
  }
</script>
