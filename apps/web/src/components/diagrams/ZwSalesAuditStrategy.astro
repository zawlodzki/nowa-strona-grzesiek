---
// Rebuilt in the calm scene style by T104.
// Sales audit area 1, strategy and target maths: the revenue target worked
// back line by line to the deals the plan needs, against what the team can
// actually handle. It ends on the shortfall. The figures are placeholders.
import "./scene/scene.css";

const lines = [
  { name: "Cel przychodu na rok", value: "2,4 mln zł" },
  { name: "Średnia wartość transakcji", value: "24 000 zł" },
  { name: "Potrzebne wygrane", value: "100" },
  { name: "Skuteczność zamykania", value: "20%" },
  { name: "Potrzebne szanse w lejku", value: "500" },
  { name: "Szans, które zespół obsłuży", value: "300", loss: true },
];
const shortfall = 200;
---

<div
  class="sc"
  data-diagram="zw-sales-audit-strategy"
  data-scene="sequence"
  aria-hidden="true"
>
  <div class="sc-body">
    <div class="head">
      <span>Matematyka celu</span>
      <span>Wartość</span>
    </div>
    <ol>
      {lines.map((line, i) => (
        <li
          class:list={["is-done", { loss: line.loss }]}
          data-step
          data-value={i === lines.length - 1 ? shortfall : undefined}
        >
          <span class="name">{line.name}</span>
          <span class="cell">
            <span class="pending">…</span>
            <span class="value">{line.value}</span>
          </span>
        </li>
      ))}
    </ol>
    <div class="sc-total">
      <span class="sc-total-label">Szans brakuje do planu</span>
      <span class="sc-total-value is-loss" data-total>
        {shortfall}
      </span>
    </div>
  </div>
</div>

<style>
  .head {
    display: flex;
    justify-content: space-between;
    padding-block-end: 0.5rem;
    color: var(--text-muted);
    font-size: 0.8125rem;
    border-block-end: 1px solid var(--text-heading);
  }

  li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.75rem;
    align-items: baseline;
    padding-block: 0.55rem;
    border-block-end: 1px solid var(--border-hairline);
  }

  li:nth-child(5) {
    border-block-end-color: var(--text-heading);
  }

  .name {
    color: var(--text-heading);
  }

  .cell {
    display: grid;
    justify-items: end;
  }

  .cell > * {
    grid-area: 1 / 1;
  }

  .pending {
    color: var(--border-strong);
  }

  .value {
    color: var(--text-link);
    font-weight: var(--font-weight-semibold);
    white-space: nowrap;
  }

  .loss .value {
    color: var(--text-error);
  }

  li:not(.is-done) .value,
  .is-done .pending {
    opacity: 0;
  }

  li:not(.is-done) .value {
    transform: translateY(6px);
  }

  @media (prefers-reduced-motion: no-preference) {
    .value,
    .pending {
      transition:
        opacity 630ms cubic-bezier(0.25, 1, 0.5, 1),
        transform 630ms cubic-bezier(0.25, 1, 0.5, 1);
    }
  }
</style>

<script>
  import "./sequence";
</script>
