---
// Ported from the Webflow embed #zw-sales-audit-data (audyt-sprzedazy) by port/port-diagrams.mjs.
import './diagram.css';
---

<div class="dg" data-diagram="zw-sales-audit-data" aria-hidden="true" style="--dg-w: 400; --dg-h: 240;"><div class="zw-stage dg-stage"><div class="zw-fit dg-fit"><div class="zw-scene">
  <div class="sad-record sad-r1"><i></i><span></span><span></span></div><div class="sad-record sad-r2"><i></i><span></span><span></span></div><div class="sad-record sad-r3"><i></i><span></span><span></span></div>
  <div class="sad-panel"><span class="sad-title">Forecast</span><div class="sad-bars"><i></i><i></i><i></i><i></i></div><div class="sad-metrics"><b>42%</b><b>31d</b><b>1.8M</b></div><em><svg viewBox="0 0 24 24"><path d="M5 12.5l4.2 4.3L19 7"/></svg></em></div><span class="sad-ring"></span>
</div></div></div></div>

<style is:global>
[data-diagram="zw-sales-audit-data"]{--zw-primary:#3A48CC;--zw-primary-10:#EBEDFA;--zw-primary-30:#8991E0;--zw-secondary:#0ACFFE;--zw-success:#52C41A;--zw-bg-soft:#F9FAFB;--zw-border:#DDE1E6;--zw-border-soft:#EDF0F3;--zw-heading:#0E0F11;--zw-text:#1E2024;--zw-muted:#838D95;--zw-card:#FFFFFF;--zw-font:'Satoshi Variable','Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,system-ui,sans-serif;--zw-serif:'Erode Variable','Fraunces','Source Serif 4',Georgia,serif;--zw-radius-card:10px;--zw-radius-lane:14px;--zw-shadow-rest:0 1px 3px rgba(0,0,0,.08);--zw-shadow-lift:1px 8px 22px rgba(14,15,17,.14);font-family:var(--zw-font);width:100%;max-width:440px;margin:0 auto;box-sizing:border-box;-webkit-font-smoothing:antialiased}
[data-diagram="zw-sales-audit-data"] *,[data-diagram="zw-sales-audit-data"] *::before,[data-diagram="zw-sales-audit-data"] *::after{box-sizing:border-box}[data-diagram="zw-sales-audit-data"] .zw-stage{width:100%;overflow:hidden}[data-diagram="zw-sales-audit-data"] .zw-fit{width:400px;transform-origin:top left}[data-diagram="zw-sales-audit-data"] .zw-scene{position:relative;width:400px;height:240px}
[data-diagram="zw-sales-audit-data"] .sad-record{position:absolute;width:112px;height:58px;padding:11px;background:var(--zw-card);border:1px dashed var(--zw-border);border-radius:var(--zw-radius-card);box-shadow:var(--zw-shadow-rest);opacity:0;z-index:1}[data-diagram="zw-sales-audit-data"] .sad-r1{left:8px;top:20px;transform:rotate(-5deg)}[data-diagram="zw-sales-audit-data"] .sad-r2{right:8px;top:24px;transform:rotate(5deg)}[data-diagram="zw-sales-audit-data"] .sad-r3{left:16px;bottom:20px;transform:rotate(4deg)}
[data-diagram="zw-sales-audit-data"] .sad-record i{float:left;width:18px;height:18px;border-radius:50%;margin-right:8px;background:var(--zw-primary-10)}[data-diagram="zw-sales-audit-data"] .sad-record span{display:block;height:6px;border-radius:4px;background:var(--zw-border-soft);margin:2px 0 7px}[data-diagram="zw-sales-audit-data"] .sad-record span:last-child{width:52%}
[data-diagram="zw-sales-audit-data"] .sad-panel{position:absolute;left:114px;top:48px;width:220px;height:160px;padding:16px;background:var(--zw-bg-soft);border:1px solid var(--zw-border);border-radius:var(--zw-radius-lane);box-shadow:var(--zw-shadow-lift);opacity:0;z-index:3}
[data-diagram="zw-sales-audit-data"] .sad-title{color:var(--zw-muted);font-size:11px;font-weight:700;letter-spacing:.08em;text-transform:uppercase}[data-diagram="zw-sales-audit-data"] .sad-bars{height:66px;display:flex;align-items:flex-end;gap:10px;padding:10px 6px 0}[data-diagram="zw-sales-audit-data"] .sad-bars i{flex:1;border-radius:5px 5px 2px 2px;background:var(--zw-primary-10);transform:scaleY(0);transform-origin:bottom}[data-diagram="zw-sales-audit-data"] .sad-bars i:nth-child(1){height:34%}[data-diagram="zw-sales-audit-data"] .sad-bars i:nth-child(2){height:58%}[data-diagram="zw-sales-audit-data"] .sad-bars i:nth-child(3){height:76%;background:var(--zw-primary-30)}[data-diagram="zw-sales-audit-data"] .sad-bars i:nth-child(4){height:100%;background:var(--zw-primary)}
[data-diagram="zw-sales-audit-data"] .sad-metrics{display:flex;gap:6px;margin-top:12px}[data-diagram="zw-sales-audit-data"] .sad-metrics b{flex:1;padding:7px 4px;text-align:center;border-radius:8px;background:var(--zw-card);border:1px solid var(--zw-border-soft);color:var(--zw-heading);font-size:12px}[data-diagram="zw-sales-audit-data"] .sad-panel em{position:absolute;right:12px;top:10px;width:24px;height:24px;border-radius:50%;background:var(--zw-success);color:#fff;display:flex;align-items:center;justify-content:center;transform:scale(0)}[data-diagram="zw-sales-audit-data"] .sad-panel svg{width:14px;height:14px}[data-diagram="zw-sales-audit-data"] .sad-panel path{fill:none;stroke:currentColor;stroke-width:2.7;stroke-linecap:round;stroke-linejoin:round}
[data-diagram="zw-sales-audit-data"] .sad-ring{position:absolute;left:110px;top:44px;width:228px;height:168px;border:2px solid var(--zw-secondary);border-radius:18px;opacity:0;z-index:2}
@media(prefers-reduced-motion:reduce){[data-diagram="zw-sales-audit-data"] .sad-record{opacity:.3}[data-diagram="zw-sales-audit-data"] .sad-panel{opacity:1}[data-diagram="zw-sales-audit-data"] .sad-bars i{transform:scaleY(1)}[data-diagram="zw-sales-audit-data"] .sad-panel em{transform:scale(1)}}
</style>

<script>
  // @ts-nocheck
  for (const root of document.querySelectorAll('[data-diagram="zw-sales-audit-data"]')) {
(function(){if(!root||root.dataset.zwInit)return;root.dataset.zwInit='1';var DESIGN_W=400,stage=root.querySelector('.zw-stage'),fitEl=root.querySelector('.zw-fit'),scene=root.querySelector('.zw-scene'),reduce=window.matchMedia&&window.matchMedia('(prefers-reduced-motion: reduce)').matches;var EASE_MOVE='cubic-bezier(0.645, 0.045, 0.355, 1)',EASE_OUT='cubic-bezier(0.22, 1, 0.36, 1)',EASE_POP='cubic-bezier(0.34, 1.56, 0.64, 1)';function wait(ms){return new Promise(function(r){setTimeout(r,ms)})}function fit(){}async function play(){fit();if(reduce)return;var rs=Array.prototype.slice.call(scene.querySelectorAll('.sad-record'));rs.forEach(function(r,i){r.animate([{opacity:0,transform:'translateY(12px) rotate('+(i===0?-5:i===1?5:4)+'deg)'},{opacity:1,transform:'translateY(0) rotate('+(i===0?-5:i===1?5:4)+'deg)'}],{duration:430,delay:i*100,easing:EASE_OUT,fill:'forwards'});r.style.opacity=1});await wait(720);var panel=scene.querySelector('.sad-panel');panel.animate([{opacity:0,transform:'scale(.92)'},{opacity:1,transform:'scale(1)'}],{duration:460,easing:EASE_POP,fill:'forwards'});panel.style.opacity=1;await wait(360);rs.forEach(function(r,i){r.animate([{opacity:1,transform:getComputedStyle(r).transform},{opacity:.3,transform:'translate('+(i===1?-90:90)+'px,'+(i===2?-70:50)+'px) scale(.75)'}],{duration:680,delay:i*90,easing:EASE_MOVE,fill:'forwards'})});await wait(900);var bars=Array.prototype.slice.call(scene.querySelectorAll('.sad-bars i'));bars.forEach(function(b,i){b.animate([{transform:'scaleY(0)'},{transform:'scaleY(1)'}],{duration:460,delay:i*100,easing:EASE_OUT,fill:'forwards'});b.style.transform='scaleY(1)'});await wait(760);var check=panel.querySelector('em');check.animate([{transform:'scale(0)'},{transform:'scale(1)'}],{duration:360,easing:EASE_POP,fill:'forwards'});check.style.transform='scale(1)';var ring=scene.querySelector('.sad-ring');ring.animate([{opacity:.65,transform:'scale(.96)'},{opacity:0,transform:'scale(1.1)'}],{duration:760,easing:EASE_OUT,fill:'forwards'})}fit();if('ResizeObserver'in window)new ResizeObserver(fit).observe(stage);else window.addEventListener('resize',fit);function arm(){if(!('IntersectionObserver'in window)){play();return}var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){io.disconnect();requestAnimationFrame(function(){requestAnimationFrame(play)})}})},{threshold:.4});io.observe(root)}if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',arm);else arm()})();
  }
</script>
