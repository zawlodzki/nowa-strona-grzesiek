---
// Rebuilt in the calm scene style by T96; port-diagrams.mjs no longer writes this file.
// The answer to zw-manual-relay: the same track, but the systems are connected,
// so one lead passes from the form to a booked meeting in seconds, with no copying.
// The markup is the end state. The steps and times are placeholders.
import "./scene/scene.css";

const steps = [
  { name: "Formularz", what: "nowy lead" },
  { name: "CRM", what: "szansa założona" },
  { name: "E-mail", what: "potwierdzenie" },
  { name: "Kalendarz", what: "spotkanie" },
];
const links = [
  { time: "1 s", total: "1 s" },
  { time: "2 s", total: "3 s" },
  { time: "4 s", total: "7 s" },
];
---

<div class="sc" data-diagram="zw-automation" aria-hidden="true">
  <div class="sc-body">
    <ol class="sc-track">
      {steps.map((step, i) => (
        <>
          <li class="sc-step">
            <span class="sc-ring is-here" />
            <span class="sc-step-name">{step.name}</span>
            <span class="sc-step-what">{step.what}</span>
          </li>
          {links[i] && (
            <li class="sc-link" data-total={links[i].total}>
              <span class="sc-link-fill" />
              <span class="sc-link-label">{links[i].time}</span>
            </li>
          )}
        </>
      ))}
    </ol>
    <div class="sc-total">
      <span class="sc-total-label">Od formularza do spotkania</span>
      <span class="sc-total-value" data-total>
        {links[links.length - 1].total}
      </span>
    </div>
  </div>
</div>

<script>
  import { EASE_MOVE, stage } from "./scene/timeline";

  stage("zw-automation", (root, t) => {
    const rings = [...root.querySelectorAll<HTMLElement>(".sc-ring")];
    const links = [...root.querySelectorAll<HTMLElement>(".sc-link")];
    const fills = links.map((link) =>
      link.querySelector<HTMLElement>(".sc-link-fill")!,
    );
    const labels = links.map((link) =>
      link.querySelector<HTMLElement>(".sc-link-label")!,
    );
    const total = root.querySelector<HTMLElement>(".sc-total [data-total]")!;

    return {
      rewind() {
        rings.forEach((ring, i) => ring.classList.toggle("is-here", i === 0));
        fills.forEach((fill) => (fill.style.transform = "scaleX(0)"));
        labels.forEach((label) => label.classList.add("sc-pending"));
        total.textContent = "0 s";
      },
      async play() {
        await t.wait(900);
        for (let i = 0; i < links.length; i++) {
          fills[i].style.transform = "";
          await t.animate(
            fills[i],
            [{ transform: "scaleX(0)" }, { transform: "scaleX(1)" }],
            900,
            EASE_MOVE,
          );
          rings[i + 1].classList.add("is-here");
          total.textContent = links[i].dataset.total ?? "";
          await t.enter(labels[i]);
          await t.wait(300);
        }
      },
    };
  });
</script>
