---
// Rebuilt in the calm scene style by T101.
// Audit step 1, the map of real processes: each step of how the team really
// runs a project is checked against what is in Asana. Gaps are findings.
// The steps are placeholders.
import ListScene from "./ListScene.astro";
---

<ListScene
  diagram="zw-asana-map"
  head={["Jak naprawdę pracujecie", "Co jest w Asanie"]}
  rows={[
    { name: "Nowe zlecenie od klienta", value: "formularz" },
    { name: "Ustalenie zakresu", value: "brak", tone: "loss", counts: true },
    { name: "Realizacja", value: "zadania w projekcie" },
    {
      name: "Akceptacja klienta",
      value: "w mailu",
      tone: "loss",
      counts: true,
    },
    {
      name: "Przekazanie do rozliczenia",
      value: "brak",
      tone: "loss",
      counts: true,
    },
  ]}
  total={{ label: "Rozbieżności z realnym procesem", loss: true }}
/>
