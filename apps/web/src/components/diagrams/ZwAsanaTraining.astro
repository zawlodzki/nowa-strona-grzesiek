---
// Rebuilt in the calm scene style by T100.
// Step 4, training on how to organise work: each old habit is struck
// through and replaced with the Asana one. The habits are placeholders.
import ListScene from "./ListScene.astro";
---

<ListScene
  diagram="zw-asana-training"
  head={["Nawyk", "Przed → po"]}
  rows={[
    {
      name: "Prośby o pracę",
      from: "mail",
      value: "skrzynka Asany",
      counts: true,
    },
    { name: "Plan dnia", from: "notatki", value: "Moje zadania", counts: true },
    {
      name: "Ustalenia",
      from: "komunikator",
      value: "komentarz w zadaniu",
      counts: true,
    },
    { name: "Drobne sprawy", from: "Asana", value: "poza Asaną", counts: true },
  ]}
  total={{ label: "Nowe nawyki w zespole", of: 4 }}
/>
