---
// Ported from the Webflow embed #zw-asana-training (szkolenie-i-wdrozenie-asana) by port/port-diagrams.mjs.
import './diagram.css';
/*
  <!-- Asana implementation — step 4: train the team on its real work -->
*/
---

<div class="dg" data-diagram="zw-asana-training" aria-hidden="true" style="--dg-w: 400; --dg-h: 220;"><div class="zw-stage dg-stage"><div class="zw-fit dg-fit"><div class="zw-scene">
  <div class="as4-panel">
    <span class="as4-eyebrow">Daily work</span>
    <div class="as4-source as4-source--1"><span>E</span><b>Email</b></div>
    <div class="as4-source as4-source--2"><span>T</span><b>Tasks</b></div>
    <div class="as4-source as4-source--3"><span>C</span><b>Chat</b></div>
    <div class="as4-source as4-source--4"><span>N</span><b>Noise</b></div>
    <div class="as4-workspace">
      <div class="as4-head"><span>A</span><b>Work habits</b><em class="as4-check">&#10003;</em></div>
      <div class="as4-row"><i>1</i><b>Inbox</b><span></span></div>
      <div class="as4-row"><i>2</i><b>My tasks</b><span></span></div>
      <div class="as4-row"><i>3</i><b>Task chat</b><span></span></div>
      <div class="as4-row as4-row--exclude"><i>&times;</i><b>Not here</b><span></span></div>
    </div>
  </div>
</div></div></div></div>

<style is:global>
[data-diagram="zw-asana-training"]{--zw-primary:#3A48CC;--zw-primary-10:#EBEDFA;--zw-primary-30:#8991E0;--zw-secondary:#0ACFFE;--zw-success:#52C41A;--zw-bg-soft:#F9FAFB;--zw-border:#DDE1E6;--zw-border-soft:#EDF0F3;--zw-heading:#0E0F11;--zw-text:#1E2024;--zw-muted:#838D95;--zw-card:#FFFFFF;--zw-font:'Satoshi Variable','Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,system-ui,sans-serif;--zw-serif:'Erode Variable','Fraunces','Source Serif 4',Georgia,serif;--zw-radius-card:10px;--zw-radius-lane:14px;--zw-shadow-rest:0 1px 3px rgba(0,0,0,.08);--zw-shadow-lift:1px 8px 22px rgba(14,15,17,.14);font-family:var(--zw-font);width:100%;max-width:440px;margin:0 auto;box-sizing:border-box;-webkit-font-smoothing:antialiased}
[data-diagram="zw-asana-training"] *,[data-diagram="zw-asana-training"] *::before,[data-diagram="zw-asana-training"] *::after{box-sizing:border-box}[data-diagram="zw-asana-training"] .zw-stage{width:100%;overflow:hidden}[data-diagram="zw-asana-training"] .zw-fit{width:400px;transform-origin:top left}[data-diagram="zw-asana-training"] .zw-scene{position:relative}
[data-diagram="zw-asana-training"] .as4-panel{position:relative;width:360px;height:220px;margin:6px auto;background:var(--zw-bg-soft);border:1px solid var(--zw-border);border-radius:var(--zw-radius-lane);overflow:hidden}
[data-diagram="zw-asana-training"] .as4-eyebrow{position:absolute;left:20px;top:18px;font-size:10px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;color:var(--zw-muted);opacity:0}
[data-diagram="zw-asana-training"] .as4-source{position:absolute;left:20px;width:106px;height:34px;padding:0 10px;display:flex;align-items:center;gap:8px;background:var(--zw-card);border:1px solid var(--zw-border);border-radius:var(--zw-radius-card);box-shadow:var(--zw-shadow-rest);opacity:0;z-index:4;will-change:transform,opacity}
[data-diagram="zw-asana-training"] .as4-source--1{top:43px}[data-diagram="zw-asana-training"] .as4-source--2{top:84px}[data-diagram="zw-asana-training"] .as4-source--3{top:125px}[data-diagram="zw-asana-training"] .as4-source--4{top:166px}
[data-diagram="zw-asana-training"] .as4-source>span{width:20px;height:20px;display:flex;align-items:center;justify-content:center;border-radius:6px;background:var(--zw-primary-10);color:var(--zw-primary);font-size:8px;font-weight:800}[data-diagram="zw-asana-training"] .as4-source>b{font-size:10px;color:var(--zw-text)}
[data-diagram="zw-asana-training"] .as4-workspace{position:absolute;right:18px;top:18px;width:194px;height:184px;padding:12px;background:var(--zw-card);border:1px solid var(--zw-border);border-radius:var(--zw-radius-card);box-shadow:var(--zw-shadow-rest);opacity:0}
[data-diagram="zw-asana-training"] .as4-head{height:27px;display:flex;align-items:center;gap:8px;margin-bottom:9px}[data-diagram="zw-asana-training"] .as4-head>span{width:24px;height:24px;display:flex;align-items:center;justify-content:center;border-radius:7px;background:var(--zw-primary);color:#fff;font-size:10px;font-weight:800}
[data-diagram="zw-asana-training"] .as4-head>b{font-size:11px;color:var(--zw-heading)}[data-diagram="zw-asana-training"] .as4-check{margin-left:auto;width:20px;height:20px;display:flex;align-items:center;justify-content:center;border-radius:50%;background:var(--zw-success);color:#fff;font-size:11px;font-style:normal;transform:scale(0)}
[data-diagram="zw-asana-training"] .as4-row{height:29px;display:flex;align-items:center;gap:8px;margin-bottom:6px;padding:0 8px;border-radius:7px;background:var(--zw-border-soft);opacity:.42}
[data-diagram="zw-asana-training"] .as4-row>i{width:18px;height:18px;display:flex;align-items:center;justify-content:center;border-radius:5px;background:var(--zw-card);color:var(--zw-primary);font-size:8px;font-weight:800;font-style:normal}[data-diagram="zw-asana-training"] .as4-row>b{font-size:9px;color:var(--zw-text)}[data-diagram="zw-asana-training"] .as4-row>span{margin-left:auto;width:8px;height:8px;border-radius:50%;background:var(--zw-border)}
[data-diagram="zw-asana-training"] .as4-row--on{opacity:1;background:var(--zw-primary-10)}[data-diagram="zw-asana-training"] .as4-row--on>span{background:var(--zw-success)}
[data-diagram="zw-asana-training"] .as4-row--exclude.as4-row--on{background:var(--zw-bg-soft);opacity:.65}[data-diagram="zw-asana-training"] .as4-row--exclude.as4-row--on>i{color:var(--zw-muted)}[data-diagram="zw-asana-training"] .as4-row--exclude.as4-row--on>span{background:var(--zw-muted)}
@media(prefers-reduced-motion:reduce){[data-diagram="zw-asana-training"] .as4-eyebrow,[data-diagram="zw-asana-training"] .as4-workspace{opacity:1}[data-diagram="zw-asana-training"] .as4-source{opacity:0}[data-diagram="zw-asana-training"] .as4-row{opacity:1;background:var(--zw-primary-10)}[data-diagram="zw-asana-training"] .as4-row>span{background:var(--zw-success)}[data-diagram="zw-asana-training"] .as4-row--exclude{background:var(--zw-bg-soft);opacity:.65}[data-diagram="zw-asana-training"] .as4-row--exclude>span{background:var(--zw-muted)}[data-diagram="zw-asana-training"] .as4-check{transform:scale(1)}}
</style>

<script>
  // @ts-nocheck
  for (const root of document.querySelectorAll('[data-diagram="zw-asana-training"]')) {
(function(){if(!root||root.dataset.zwInit)return;root.dataset.zwInit='1';var DESIGN_W=400,stage=root.querySelector('.zw-stage'),fitEl=root.querySelector('.zw-fit'),scene=root.querySelector('.zw-scene');var reduce=window.matchMedia&&window.matchMedia('(prefers-reduced-motion: reduce)').matches;var EASE_MOVE='cubic-bezier(0.645, 0.045, 0.355, 1)',EASE_OUT='cubic-bezier(0.22, 1, 0.36, 1)',EASE_POP='cubic-bezier(0.34, 1.56, 0.64, 1)';function wait(ms){return new Promise(function(r){setTimeout(r,ms)})}function settled(a){return a.finished.catch(function(){})}function fit(){}
async function play(){fit();if(reduce)return;var eyebrow=scene.querySelector('.as4-eyebrow'),workspace=scene.querySelector('.as4-workspace'),sources=Array.prototype.slice.call(scene.querySelectorAll('.as4-source')),rows=Array.prototype.slice.call(scene.querySelectorAll('.as4-row'));eyebrow.animate([{opacity:0},{opacity:1}],{duration:300,easing:EASE_OUT,fill:'forwards'});eyebrow.style.opacity=1;workspace.animate([{opacity:0,transform:'translateX(12px)'},{opacity:1,transform:'translateX(0)'}],{duration:460,easing:EASE_OUT,fill:'forwards'});workspace.style.opacity=1;sources.forEach(function(s,i){s.animate([{opacity:0,transform:'translateX(-10px)'},{opacity:1,transform:'translateX(0)'}],{duration:420,delay:100+i*90,easing:EASE_OUT,fill:'forwards'});s.style.opacity=1});await wait(820);
for(var i=0;i<sources.length;i++){var src=sources[i],row=rows[i],dx=workspace.offsetLeft+row.offsetLeft-src.offsetLeft,dy=workspace.offsetTop+row.offsetTop-src.offsetTop;src.animate([{transform:'scale(1)',boxShadow:'var(--zw-shadow-rest)'},{transform:'scale(1.04)',boxShadow:'var(--zw-shadow-lift)'}],{duration:160,easing:EASE_OUT,fill:'forwards'});await wait(120);await settled(src.animate([{opacity:1,transform:'translate(0,0) scale(1.04)'},{opacity:1,transform:'translate('+(dx/2)+'px,'+(dy-12)+'px) scale(.9)',offset:.52},{opacity:0,transform:'translate('+dx+'px,'+dy+'px) scale(.7)'}],{duration:620,easing:EASE_MOVE,fill:'forwards'}));src.style.opacity=0;row.classList.add('as4-row--on');row.animate([{transform:'scale(.97)'},{transform:'scale(1.03)'},{transform:'scale(1)'}],{duration:300,easing:EASE_OUT});await wait(240)}
var check=scene.querySelector('.as4-check');check.animate([{transform:'scale(0)'},{transform:'scale(1)'}],{duration:380,easing:EASE_POP,fill:'forwards'});check.style.transform='scale(1)'}
fit();if('ResizeObserver'in window)new ResizeObserver(fit).observe(stage);else window.addEventListener('resize',fit);function arm(){if(!('IntersectionObserver'in window)){play();return}var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){io.disconnect();requestAnimationFrame(function(){requestAnimationFrame(play)})}})},{threshold:.4});io.observe(root)}if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',arm);else arm()})();
  }
</script>
