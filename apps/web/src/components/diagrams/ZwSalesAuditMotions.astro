---
// Ported from the Webflow embed #zw-sales-audit-motions (audyt-sprzedazy) by port/port-diagrams.mjs.
import './diagram.css';
---

<div class="dg" data-diagram="zw-sales-audit-motions" aria-hidden="true" style="--dg-w: 400; --dg-h: 238;"><div class="zw-stage dg-stage"><div class="zw-fit dg-fit"><div class="zw-scene">
  <svg class="sam-lines" viewBox="0 0 400 238"><path d="M200 119L84 55M200 119L316 55M200 119L84 183M200 119L316 183"/></svg>
  <div class="sam-motion sam-m1">Inbound</div><div class="sam-motion sam-m2">Outbound</div><div class="sam-motion sam-m3">Partner</div><div class="sam-motion sam-m4">Referral</div>
  <div class="sam-core"><span>ICP</span><b>Fit</b><i><svg viewBox="0 0 24 24"><path d="M5 12.5l4.2 4.3L19 7"/></svg></i></div><span class="sam-ring"></span>
</div></div></div></div>

<style is:global>
[data-diagram="zw-sales-audit-motions"]{--zw-primary:#3A48CC;--zw-primary-10:#EBEDFA;--zw-primary-30:#8991E0;--zw-secondary:#0ACFFE;--zw-success:#52C41A;--zw-bg-soft:#F9FAFB;--zw-border:#DDE1E6;--zw-border-soft:#EDF0F3;--zw-heading:#0E0F11;--zw-text:#1E2024;--zw-muted:#838D95;--zw-card:#FFFFFF;--zw-font:'Satoshi Variable','Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,system-ui,sans-serif;--zw-serif:'Erode Variable','Fraunces','Source Serif 4',Georgia,serif;--zw-radius-card:10px;--zw-radius-lane:14px;--zw-shadow-rest:0 1px 3px rgba(0,0,0,.08);--zw-shadow-lift:1px 8px 22px rgba(14,15,17,.14);font-family:var(--zw-font);width:100%;max-width:440px;margin:0 auto;box-sizing:border-box;-webkit-font-smoothing:antialiased}
[data-diagram="zw-sales-audit-motions"] *,[data-diagram="zw-sales-audit-motions"] *::before,[data-diagram="zw-sales-audit-motions"] *::after{box-sizing:border-box}[data-diagram="zw-sales-audit-motions"] .zw-stage{width:100%;overflow:hidden}[data-diagram="zw-sales-audit-motions"] .zw-fit{width:400px;transform-origin:top left}[data-diagram="zw-sales-audit-motions"] .zw-scene{position:relative;width:400px;height:238px}
[data-diagram="zw-sales-audit-motions"] .sam-lines{position:absolute;inset:0;width:400px;height:238px;color:var(--zw-border);opacity:0}[data-diagram="zw-sales-audit-motions"] .sam-lines path{fill:none;stroke:currentColor;stroke-width:2;stroke-dasharray:5 7;stroke-linecap:round}
[data-diagram="zw-sales-audit-motions"] .sam-motion{position:absolute;width:112px;padding:13px 10px;text-align:center;background:var(--zw-card);border:1px solid var(--zw-border);border-radius:var(--zw-radius-card);box-shadow:var(--zw-shadow-rest);color:var(--zw-muted);font-size:11px;font-weight:700;letter-spacing:.07em;text-transform:uppercase;opacity:0;will-change:transform,opacity}
[data-diagram="zw-sales-audit-motions"] .sam-m1{left:28px;top:35px}[data-diagram="zw-sales-audit-motions"] .sam-m2{right:28px;top:35px}[data-diagram="zw-sales-audit-motions"] .sam-m3{left:28px;bottom:35px}[data-diagram="zw-sales-audit-motions"] .sam-m4{right:28px;bottom:35px}
[data-diagram="zw-sales-audit-motions"] .sam-core{position:absolute;left:146px;top:80px;width:108px;height:78px;padding:13px;background:var(--zw-primary-10);border:1px solid var(--zw-primary-30);border-radius:50%;text-align:center;opacity:0;z-index:2}
[data-diagram="zw-sales-audit-motions"] .sam-core span{display:block;color:var(--zw-primary);font-size:11px;font-weight:700;letter-spacing:.08em;text-transform:uppercase}[data-diagram="zw-sales-audit-motions"] .sam-core b{display:block;color:var(--zw-heading);font-family:var(--zw-serif);font-size:24px;line-height:1.1}[data-diagram="zw-sales-audit-motions"] .sam-core i{position:absolute;right:-2px;bottom:2px;width:24px;height:24px;border-radius:50%;background:var(--zw-success);color:#fff;display:flex;align-items:center;justify-content:center;transform:scale(0)}[data-diagram="zw-sales-audit-motions"] .sam-core svg{width:14px;height:14px}[data-diagram="zw-sales-audit-motions"] .sam-core path{fill:none;stroke:currentColor;stroke-width:2.7;stroke-linecap:round;stroke-linejoin:round}
[data-diagram="zw-sales-audit-motions"] .sam-ring{position:absolute;left:142px;top:76px;width:116px;height:86px;border:2px solid var(--zw-secondary);border-radius:50%;opacity:0}
@media(prefers-reduced-motion:reduce){[data-diagram="zw-sales-audit-motions"] .sam-lines,[data-diagram="zw-sales-audit-motions"] .sam-motion,[data-diagram="zw-sales-audit-motions"] .sam-core{opacity:1}[data-diagram="zw-sales-audit-motions"] .sam-core i{transform:scale(1)}}
</style>

<script>
  // @ts-nocheck
  for (const root of document.querySelectorAll('[data-diagram="zw-sales-audit-motions"]')) {
(function(){if(!root||root.dataset.zwInit)return;root.dataset.zwInit='1';var DESIGN_W=400,stage=root.querySelector('.zw-stage'),fitEl=root.querySelector('.zw-fit'),scene=root.querySelector('.zw-scene'),reduce=window.matchMedia&&window.matchMedia('(prefers-reduced-motion: reduce)').matches;var EASE_MOVE='cubic-bezier(0.645, 0.045, 0.355, 1)',EASE_OUT='cubic-bezier(0.22, 1, 0.36, 1)',EASE_POP='cubic-bezier(0.34, 1.56, 0.64, 1)';function wait(ms){return new Promise(function(r){setTimeout(r,ms)})}function fit(){}async function play(){fit();if(reduce)return;var motions=Array.prototype.slice.call(scene.querySelectorAll('.sam-motion')),starts=['translate(-30px,-18px) rotate(-6deg)','translate(32px,-20px) rotate(5deg)','translate(-26px,24px) rotate(5deg)','translate(30px,20px) rotate(-6deg)'];motions.forEach(function(m,i){m.animate([{opacity:0,transform:starts[i]+' scale(.94)'},{opacity:1,transform:'translate(0,0) rotate(0) scale(1)'}],{duration:560,delay:i*110,easing:EASE_MOVE,fill:'forwards'});m.style.opacity=1});await wait(900);var lines=scene.querySelector('.sam-lines');lines.animate([{opacity:0},{opacity:1}],{duration:420,easing:EASE_OUT,fill:'forwards'});lines.style.opacity=1;await wait(360);var core=scene.querySelector('.sam-core');core.animate([{opacity:0,transform:'scale(.8)'},{opacity:1,transform:'scale(1)'}],{duration:440,easing:EASE_POP,fill:'forwards'});core.style.opacity=1;await wait(430);motions.forEach(function(m,i){setTimeout(function(){m.animate([{transform:'scale(1)'},{transform:'scale(1.04)'},{transform:'scale(1)'}],{duration:360,easing:EASE_POP})},i*130)});await wait(720);var check=core.querySelector('i');check.animate([{transform:'scale(0)'},{transform:'scale(1)'}],{duration:340,easing:EASE_POP,fill:'forwards'});check.style.transform='scale(1)';var ring=scene.querySelector('.sam-ring');ring.animate([{opacity:.7,transform:'scale(.95)'},{opacity:0,transform:'scale(1.2)'}],{duration:760,easing:EASE_OUT,fill:'forwards'})}fit();if('ResizeObserver'in window)new ResizeObserver(fit).observe(stage);else window.addEventListener('resize',fit);function arm(){if(!('IntersectionObserver'in window)){play();return}var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){io.disconnect();requestAnimationFrame(function(){requestAnimationFrame(play)})}})},{threshold:.4});io.observe(root)}if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',arm);else arm()})();
  }
</script>
