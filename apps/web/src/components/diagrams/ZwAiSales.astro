---
// Rebuilt in the calm scene style by T92; port-diagrams.mjs no longer writes this file.
// An AI agent's work log: finished morning tasks, then a request and the offer
// it produces. One cyan progress line stands for the agent working.
// The markup is the end state. Times, names and the amount are placeholders.
import "./scene/scene.css";

const done = [
  { time: "08:02", text: "Sprawdził 12 nowych leadów" },
  { time: "08:10", text: "Przygotował 4 follow-upy" },
  { time: "08:14", text: "Uporządkował rekordy w CRM" },
];
---

<div class="sc" data-diagram="zw-ai-sales" aria-hidden="true">
  <div class="sc-body">
    <ol class="rows">
      {done.map((row) => (
        <li data-row>
          <span class="time">{row.time}</span>
          <span>{row.text}</span>
          <span class="tag">agent</span>
        </li>
      ))}
      <li data-row class="ask">
        <span class="time">09:30</span>
        <span>„Przygotuj ofertę dla Acme”</span>
        <span class="who">Ty</span>
        <span class="bar">
          <i></i>
        </span>
      </li>
      <li data-row class="result">
        <span class="time">09:32</span>
        <span>Oferta dla Acme gotowa</span>
        <span>24&nbsp;000&nbsp;€</span>
      </li>
    </ol>
    <div class="sc-total" data-total>
      <span class="sc-total-label">Od prośby do oferty</span>
      <span class="sc-total-value">2 min</span>
    </div>
  </div>
</div>

<style>
  li {
    display: grid;
    grid-template-columns: 3.2rem minmax(0, 1fr) auto;
    gap: 0.75rem;
    align-items: baseline;
    padding-block: 0.6rem;
    border-block-end: 1px solid var(--border-hairline);
  }

  .time {
    color: var(--text-muted);
  }

  .tag {
    padding: 0.1rem 0.55rem;
    color: var(--text-link);
    font-size: 0.8125rem;
    font-weight: var(--font-weight-medium);
    background: var(--surface-cyan-tint);
    border-radius: var(--radius-pill);
  }

  .who {
    color: var(--text-muted);
    font-size: 0.8125rem;
  }

  .ask {
    position: relative;
    color: var(--text-heading);
    font-weight: var(--font-weight-medium);
    border-block-end-color: transparent;
  }

  .bar {
    position: absolute;
    inset-inline: 0;
    inset-block-end: -1px;
    block-size: 3px;
    background: var(--surface-cyan-tint);
  }

  .bar i {
    display: block;
    block-size: 100%;
    background: var(--color-secondary-60);
    transform-origin: 0 50%;
  }

  .result {
    color: var(--text-link);
    font-weight: var(--font-weight-semibold);
    border-block-end: 0;
  }
</style>

<script>
  import { EASE_MOVE, stage } from "./scene/timeline";

  stage("zw-ai-sales", (root, t) => {
    const rows = [...root.querySelectorAll<HTMLElement>("[data-row]")];
    const fill = root.querySelector<HTMLElement>(".bar i")!;
    const total = root.querySelector<HTMLElement>("[data-total]")!;

    return {
      rewind() {
        rows.forEach((row) => row.classList.add("sc-pending"));
        total.classList.add("sc-pending");
        fill.style.transform = "scaleX(0)";
      },
      async play() {
        await t.wait(540);
        for (const row of rows.slice(0, 3)) {
          void t.enter(row);
          await t.wait(400);
        }
        await t.wait(1260);
        await t.enter(rows[3]);
        await t.wait(360);
        fill.style.transform = "";
        await t.animate(
          fill,
          [{ transform: "scaleX(0)" }, { transform: "scaleX(1)" }],
          2340,
          EASE_MOVE,
        );
        void t.enter(rows[4]);
        await t.wait(450);
        await t.enter(total);
      },
    };
  });
</script>
