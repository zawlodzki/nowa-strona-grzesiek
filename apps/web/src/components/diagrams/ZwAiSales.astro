---
// Ported from the Webflow embed #zw-ai-sales (index) by port/port-diagrams.mjs.
import './diagram.css';
/*
  zawlodzki.pl — product animation: AI in sales (agent chat)
  Self-contained Webflow Embed. No external dependencies.
  Transparent background — inherits the section bg.
  Plays once when scrolled into view. Honors prefers-reduced-motion.

  v2 — review fixes applied:
  • Checkmarks grow from scale(0.4)+opacity instead of scale(0)
  (nothing appears from nothing) — see .zw-check / .zw-done-check
  and the pop() helper.
  • Typing dots use a custom soft in-out curve (EASE_SOFT) instead
  of the built-in 'ease-in-out' string, matching the file's
  easing vocabulary.
*/
---

<div class="dg" data-diagram="zw-ai-sales" aria-hidden="true" style="--dg-w: 760; --dg-h: 458.05;">
  <div class="zw-stage dg-stage">
    <div class="zw-fit dg-fit">
      <div class="zw-scene">
        <div class="zw-chat">

          <div class="zw-chat-head">
            <span class="zw-avatar">
              <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                <path d="M12 4 L13.5 10.5 L20 12 L13.5 13.5 L12 20 L10.5 13.5 L4 12 L10.5 10.5 Z" fill="currentColor"/>
              </svg>
            </span>
            <span class="zw-head-meta">
              <span class="zw-head-name">Sales Agent</span>
              <span class="zw-head-status"><i class="zw-dot"></i>Online</span>
            </span>
          </div>

          <div class="zw-chat-body">

            <div class="zw-msg zw-msg--agent" data-msg="brief">
              <div class="zw-bubble zw-bubble--agent">
                <span class="zw-eyebrow">Done today</span>
                <ul class="zw-tasks">
                  <li class="zw-task">
                    <span class="zw-check"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5 l4 4 l9 -10" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
                    <span class="zw-task-label">Researched 12 leads</span>
                  </li>
                  <li class="zw-task">
                    <span class="zw-check"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5 l4 4 l9 -10" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
                    <span class="zw-task-label">Drafted 4 follow-ups</span>
                  </li>
                  <li class="zw-task">
                    <span class="zw-check"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5 l4 4 l9 -10" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
                    <span class="zw-task-label">Cleaned CRM</span>
                  </li>
                </ul>
              </div>
            </div>

            <div class="zw-msg zw-msg--user" data-msg="user">
              <div class="zw-bubble zw-bubble--user">Draft offer for Acme</div>
            </div>

            <div class="zw-msg zw-msg--agent" data-msg="reply">
              <div class="zw-bubble zw-bubble--agent zw-reply">
                <div class="zw-typing" data-typing><i></i><i></i><i></i></div>
                <div class="zw-done" data-done>
                  <span class="zw-done-check"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5 l4 4 l9 -10" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
                  <span class="zw-done-meta">
                    <span class="zw-done-title">Offer ready</span>
                    <span class="zw-done-sub">Acme &middot; &euro;24,000</span>
                  </span>
                </div>
              </div>
            </div>

          </div>

          <div class="zw-chat-input">
            <span class="zw-input-ph">Ask your agent&hellip;</span>
            <span class="zw-send">
              <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M12 19 V6 M6 12 l6 -6 l6 6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
          </div>

        </div>
      </div>
    </div>
  </div>
</div>

<style is:global>
/* ---- Shared family layer: tokens + responsive shell (identical across the set). ---- */
  [data-diagram="zw-ai-sales"] {
    --zw-primary:    #3A48CC;
    --zw-primary-10: #EBEDFA;
    --zw-primary-30: #8991E0;
    --zw-secondary:  #0ACFFE;   /* cyan accent — "active / in motion" */
    --zw-secondary-10:#E7FAFF;
    --zw-secondary-soft:rgba(10,207,254,.22);
    --zw-success:    #52C41A;
    --zw-bg-soft:    #F9FAFB;
    --zw-border:     #DDE1E6;
    --zw-border-soft:#EDF0F3;
    --zw-heading:    #0E0F11;
    --zw-text:       #1E2024;
    --zw-muted:      #838D95;
    --zw-card:       #FFFFFF;
    --zw-font: 'Satoshi Variable','Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,system-ui,sans-serif;
    --zw-serif: 'Erode Variable','Fraunces','Source Serif 4',Georgia,serif;
    --zw-radius-card: 10px;
    --zw-radius-lane: 14px;
    --zw-shadow-rest: 0 1px 3px rgba(0,0,0,.08);
    --zw-shadow-lift: 1px 8px 22px rgba(14,15,17,.14);

    font-family: var(--zw-font);
    width: 100%;
    max-width: 920px;
    margin: 0 auto;
    box-sizing: border-box;
    -webkit-font-smoothing: antialiased;
  }
  [data-diagram="zw-ai-sales"] *, [data-diagram="zw-ai-sales"] *::before, [data-diagram="zw-ai-sales"] *::after { box-sizing: border-box; }

  [data-diagram="zw-ai-sales"] .zw-stage { width: 100%; overflow: hidden; }
  [data-diagram="zw-ai-sales"] .zw-fit   { width: 760px; transform-origin: top left; }
  [data-diagram="zw-ai-sales"] .zw-scene { position: relative; }

  /* Confetti (shared confetti() helper) */
  [data-diagram="zw-ai-sales"] .zw-confetti { position: absolute; top: 0; left: 0; width: 0; height: 0; z-index: 9; pointer-events: none; }
  [data-diagram="zw-ai-sales"] .zw-confetti i { position: absolute; width: 8px; height: 8px; border-radius: 2px; will-change: transform, opacity; }

  /* =================== SCENE:STYLE start =================== */
  [data-diagram="zw-ai-sales"] .zw-chat {
    width: 462px;
    margin: 20px auto;
    background: var(--zw-card);
    border: 1px solid var(--zw-border);
    border-radius: 16px;
    box-shadow: var(--zw-shadow-rest);
    overflow: hidden;
    opacity: 0;                       /* revealed by play() */
    will-change: transform, opacity;
  }

  /* Header */
  [data-diagram="zw-ai-sales"] .zw-chat-head {
    display: flex; align-items: center; gap: 11px;
    padding: 14px 18px;
    border-bottom: 1px solid var(--zw-border-soft);
  }
  [data-diagram="zw-ai-sales"] .zw-avatar {
    width: 34px; height: 34px; border-radius: 50%;
    background: var(--zw-primary); color: #fff;
    display: flex; align-items: center; justify-content: center;
    flex: 0 0 auto;
  }
  [data-diagram="zw-ai-sales"] .zw-head-meta { display: flex; flex-direction: column; gap: 2px; }
  [data-diagram="zw-ai-sales"] .zw-head-name { font-size: 14px; font-weight: 700; color: var(--zw-heading); }
  [data-diagram="zw-ai-sales"] .zw-head-status { display: flex; align-items: center; gap: 6px; font-size: 11.5px; color: var(--zw-muted); }
  [data-diagram="zw-ai-sales"] .zw-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--zw-success); }

  /* Body / messages */
  [data-diagram="zw-ai-sales"] .zw-chat-body {
    padding: 18px;
    display: flex; flex-direction: column; gap: 14px;
    background: var(--zw-bg-soft);
  }
  [data-diagram="zw-ai-sales"] .zw-msg { display: flex; opacity: 0; }
  [data-diagram="zw-ai-sales"] .zw-msg--agent { justify-content: flex-start; }
  [data-diagram="zw-ai-sales"] .zw-msg--user  { justify-content: flex-end; }
  [data-diagram="zw-ai-sales"] .zw-bubble {
    max-width: 82%;
    padding: 12px 14px;
    border-radius: 14px;
    font-size: 13.5px; line-height: 1.4;
  }
  [data-diagram="zw-ai-sales"] .zw-bubble--agent {
    background: var(--zw-card);
    border: 1px solid var(--zw-border);
    border-bottom-left-radius: 5px;
    color: var(--zw-text);
    transition: border-color .3s ease, background-color .3s ease;
  }
  [data-diagram="zw-ai-sales"] .zw-bubble--user {
    background: var(--zw-primary);
    color: #fff; font-weight: 600;
    border-bottom-right-radius: 5px;
  }

  /* Briefing: eyebrow + completed-task rows */
  [data-diagram="zw-ai-sales"] .zw-eyebrow {
    display: block; font-size: 11px; font-weight: 700; letter-spacing: .07em;
    text-transform: uppercase; color: var(--zw-muted); margin-bottom: 11px;
  }
  [data-diagram="zw-ai-sales"] .zw-tasks { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px; }
  [data-diagram="zw-ai-sales"] .zw-task { display: flex; align-items: center; gap: 9px; }
  [data-diagram="zw-ai-sales"] .zw-task-label { font-size: 13px; color: var(--zw-text); }
  [data-diagram="zw-ai-sales"] .zw-check {
    width: 19px; height: 19px; border-radius: 50%;
    background: var(--zw-success); color: #fff;
    display: flex; align-items: center; justify-content: center;
    flex: 0 0 auto; transform: scale(0.4); opacity: 0;  /* grows from a visible seed */
  }
  [data-diagram="zw-ai-sales"] .zw-check svg { width: 12px; height: 12px; }

  /* Reply slot: typing overlay + completion confirmation share the bubble box */
  [data-diagram="zw-ai-sales"] .zw-reply { position: relative; }
  [data-diagram="zw-ai-sales"] .zw-typing {
    position: absolute; inset: 0;
    display: flex; align-items: center; gap: 5px;
    padding: 0 14px;
  }
  [data-diagram="zw-ai-sales"] .zw-typing i { width: 7px; height: 7px; border-radius: 50%; background: var(--zw-secondary); }  /* cyan: agent working */
  [data-diagram="zw-ai-sales"] .zw-done { display: flex; align-items: center; gap: 11px; opacity: 0; }
  [data-diagram="zw-ai-sales"] .zw-done-check {
    width: 30px; height: 30px; border-radius: 50%;
    background: var(--zw-success); color: #fff;
    display: flex; align-items: center; justify-content: center;
    flex: 0 0 auto; transform: scale(0.4); opacity: 0;  /* grows from a visible seed */
  }
  [data-diagram="zw-ai-sales"] .zw-done-check svg { width: 18px; height: 18px; }
  [data-diagram="zw-ai-sales"] .zw-done-meta { display: flex; flex-direction: column; gap: 2px; }
  [data-diagram="zw-ai-sales"] .zw-done-title { font-size: 14px; font-weight: 700; color: var(--zw-heading); }
  [data-diagram="zw-ai-sales"] .zw-done-sub { font-size: 12px; color: var(--zw-muted); }
  [data-diagram="zw-ai-sales"] .zw-bubble--win {
    border-color: var(--zw-success);
    background: rgba(82, 196, 26, .07);
  }

  /* Faux input bar (reads as a chat window; non-interactive) */
  [data-diagram="zw-ai-sales"] .zw-chat-input {
    display: flex; align-items: center; gap: 10px;
    padding: 12px 14px;
    border-top: 1px solid var(--zw-border-soft);
    background: var(--zw-card);
  }
  [data-diagram="zw-ai-sales"] .zw-input-ph {
    flex: 1; font-size: 13px; color: var(--zw-muted);
    background: var(--zw-bg-soft); border: 1px solid var(--zw-border-soft);
    border-radius: 9px; padding: 9px 12px;
  }
  [data-diagram="zw-ai-sales"] .zw-send {
    width: 34px; height: 34px; border-radius: 9px;
    background: var(--zw-primary); color: #fff;
    display: flex; align-items: center; justify-content: center; flex: 0 0 auto;
  }
  /* ==================== SCENE:STYLE end ==================== */

  /* Accessibility: resolved end state, no motion. */
  @media (prefers-reduced-motion: reduce) {
    [data-diagram="zw-ai-sales"] .zw-chat { opacity: 1; }
    [data-diagram="zw-ai-sales"] .zw-msg { opacity: 1; }
    [data-diagram="zw-ai-sales"] .zw-check { transform: scale(1); opacity: 1; }
    [data-diagram="zw-ai-sales"] .zw-typing { display: none; }
    [data-diagram="zw-ai-sales"] .zw-done { opacity: 1; }
    [data-diagram="zw-ai-sales"] .zw-done-check { transform: scale(1); opacity: 1; }
    [data-diagram="zw-ai-sales"] .zw-reply { border-color: var(--zw-success); background: rgba(82, 196, 26, .07); }
  }
</style>

<script>
  // @ts-nocheck
  for (const root of document.querySelectorAll('[data-diagram="zw-ai-sales"]')) {
(function () {
  if (!root || root.dataset.zwInit) return;
  root.dataset.zwInit = '1';

  var DESIGN_W = 760;

  var stage = root.querySelector('.zw-stage');
  var fitEl = root.querySelector('.zw-fit');
  var scene = root.querySelector('.zw-scene');

  var reduce = window.matchMedia &&
               window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  var EASE_MOVE = 'cubic-bezier(0.645, 0.045, 0.355, 1)';
  var EASE_OUT  = 'cubic-bezier(0.22, 1, 0.36, 1)';
  var EASE_POP  = 'cubic-bezier(0.34, 1.56, 0.64, 1)';
  var EASE_SOFT = 'cubic-bezier(0.45, 0, 0.55, 1)'; /* gentle sine in-out — idle loops */

  function wait(ms) { return new Promise(function (r) { setTimeout(r, ms); }); }
  function settled(anim) { return anim.finished.catch(function () {}); }

  function fit(){}

  function confetti(at) {
    var box = document.createElement('div');
    box.className = 'zw-confetti';
    var x, y;
    if (at && at.nodeType) { x = at.offsetLeft + at.offsetWidth / 2; y = at.offsetTop + at.offsetHeight / 2; }
    else { x = (at && at.x) || scene.offsetWidth / 2; y = (at && at.y) || scene.offsetHeight / 2; }
    box.style.left = x + 'px'; box.style.top = y + 'px';
    scene.appendChild(box);
    var colors = ['#3A48CC', '#0ACFFE', '#52C41A', '#8991E0', '#FFC53D'];
    for (var i = 0; i < 46; i++) {
      var p = document.createElement('i');
      p.style.background = colors[i % colors.length];
      if (i % 3 === 0) p.style.borderRadius = '50%';
      box.appendChild(p);
      var ang = (Math.PI * 2 * i) / 46 + (Math.random() - 0.5) * 0.5;
      var dist = 70 + Math.random() * 120;
      var dx = Math.cos(ang) * dist, dy = Math.sin(ang) * dist - 60;
      var rot = (Math.random() - 0.5) * 720;
      p.animate(
        [{ transform: 'translate(0,0) rotate(0) scale(1)', opacity: 1 },
         { transform: 'translate(' + dx + 'px,' + dy + 'px) rotate(' + rot + 'deg) scale(.4)', opacity: 0 }],
        { duration: 900 + Math.random() * 500, easing: 'cubic-bezier(0.18, 0.7, 0.3, 1)', fill: 'forwards' }
      );
    }
    setTimeout(function () { box.remove(); }, 1800);
  }

  /* =================== SCENE:LOGIC start =================== */
  /* Position of a nested element in scene (design) coords — offsetLeft/Top
     are relative to the offsetParent, so walk the chain up to .zw-scene. */
  function posIn(el) {
    var x = 0, y = 0;
    while (el && el !== scene) { x += el.offsetLeft; y += el.offsetTop; el = el.offsetParent; }
    return { x: x, y: y };
  }

  function reveal(m, dir) {
    var dx = dir === 'right' ? 14 : -14;
    m.animate(
      [{ opacity: 0, transform: 'translate(' + dx + 'px,6px)' },
       { opacity: 1, transform: 'translate(0,0)' }],
      { duration: 420, easing: EASE_OUT, fill: 'forwards' });
    m.style.opacity = 1;
  }

  /* Pop in from a visible seed (scale 0.4) + opacity — not from nothing. */
  function pop(el, peak) {
    el.animate(
      [{ transform: 'scale(0.4)', opacity: 0 },
       { transform: 'scale(' + (peak || 1.15) + ')', opacity: 1 },
       { transform: 'scale(1)', opacity: 1 }],
      { duration: 400, easing: EASE_POP, fill: 'forwards' });
    el.style.transform = 'scale(1)';
    el.style.opacity = 1;
  }

  async function play() {
    fit();

    var chat     = scene.querySelector('.zw-chat');
    var msgBrief = scene.querySelector('[data-msg="brief"]');
    var msgUser  = scene.querySelector('[data-msg="user"]');
    var msgReply = scene.querySelector('[data-msg="reply"]');
    var checks   = scene.querySelectorAll('.zw-check');
    var typing   = scene.querySelector('[data-typing]');
    var done     = scene.querySelector('[data-done]');
    var doneCheck= scene.querySelector('.zw-done-check');
    var replyBubble = msgReply.querySelector('.zw-bubble');

    if (reduce) {
      chat.style.opacity = 1;
      [msgBrief, msgUser, msgReply].forEach(function (m) { m.style.opacity = 1; });
      Array.prototype.forEach.call(checks, function (c) { c.style.transform = 'scale(1)'; c.style.opacity = 1; });
      typing.style.display = 'none';
      done.style.opacity = 1;
      doneCheck.style.transform = 'scale(1)';
      doneCheck.style.opacity = 1;
      replyBubble.classList.add('zw-bubble--win');
      return;
    }

    // window entrance
    await settled(chat.animate(
      [{ opacity: 0, transform: 'translateY(16px) scale(.98)' },
       { opacity: 1, transform: 'translateY(0) scale(1)' }],
      { duration: 460, easing: EASE_OUT, fill: 'forwards' }));
    chat.style.opacity = 1;

    await wait(150);

    // agent proactively reports completed work
    reveal(msgBrief, 'left');
    await wait(360);
    for (var i = 0; i < checks.length; i++) {
      pop(checks[i]);
      await wait(150);
    }

    await wait(560);

    // user assigns a task
    reveal(msgUser, 'right');
    await wait(580);

    // agent reply slot: typing first
    reveal(msgReply, 'left');
    var dots = typing.querySelectorAll('i');
    Array.prototype.forEach.call(dots, function (d, idx) {
      d.animate(
        [{ transform: 'translateY(0)', opacity: .5 },
         { transform: 'translateY(-5px)', opacity: 1 },
         { transform: 'translateY(0)', opacity: .5 }],
        { duration: 760, delay: idx * 120, iterations: 2, easing: EASE_SOFT });
    });
    await wait(1520);

    // crossfade typing -> completion confirmation
    await settled(typing.animate([{ opacity: 1 }, { opacity: 0 }],
      { duration: 200, easing: EASE_OUT, fill: 'forwards' }));
    typing.style.opacity = 0;
    done.animate(
      [{ opacity: 0, transform: 'translateY(4px)' }, { opacity: 1, transform: 'translateY(0)' }],
      { duration: 300, easing: EASE_OUT, fill: 'forwards' });
    done.style.opacity = 1;
    replyBubble.classList.add('zw-bubble--win');

    await wait(120);
    pop(doneCheck, 1.18);
    var c = posIn(doneCheck);
    confetti({ x: c.x + doneCheck.offsetWidth / 2, y: c.y + doneCheck.offsetHeight / 2 });
  }
  /* ==================== SCENE:LOGIC end ==================== */

  fit();
  if ('ResizeObserver' in window) { new ResizeObserver(fit).observe(stage); }
  else { window.addEventListener('resize', fit); }

  function arm() {
    if (!('IntersectionObserver' in window)) { play(); return; }
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (e.isIntersecting) {
          io.disconnect();
          requestAnimationFrame(function () { requestAnimationFrame(play); });
        }
      });
    }, { threshold: 0.4 });
    io.observe(root);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', arm);
  } else {
    arm();
  }
})();
  }
</script>
