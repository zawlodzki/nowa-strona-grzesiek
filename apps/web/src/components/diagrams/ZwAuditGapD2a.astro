---
// Rebuilt in the calm scene style by T103.
// AI audit step 3, scoring the use cases: each idea gets a score for value,
// data, effort and risk, drawn to scale. The best few start; the rest wait.
// The use cases and scores are placeholders.
import ListScene from "./ListScene.astro";

const cases = [
  { name: "Szkic oferty z danych CRM", score: 85 },
  { name: "Brief przed spotkaniem", score: 80 },
  { name: "Follow-up po spotkaniu", score: 70 },
  { name: "Prognoza sprzedaży", score: 40 },
  { name: "Chatbot na stronie", score: 20 },
];
---

<ListScene
  diagram="zw-audit-gap-d2a"
  head={["Przypadek użycia · ocena", "Decyzja"]}
  rows={cases.map((c) => {
    const start = c.score >= 60;
    return {
      name: `${c.name} · ${c.score}`,
      value: start ? "na start" : "nie teraz",
      tone: start ? "ok" : "muted",
      pill: true,
      bar: c.score,
      counts: start,
    };
  })}
  total={{ label: "Procesy na start", of: cases.length }}
/>
