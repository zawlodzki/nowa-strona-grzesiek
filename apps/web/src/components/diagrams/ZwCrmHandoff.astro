---
// Ported from the Webflow embed #zw-crm-handoff (szkolenie-i-wdrozenie-pipedrive, szkolenie-i-wdrozenie-salesforce) by port/port-diagrams.mjs.
import './diagram.css';
/*
  Pipedrive implementation — step 5: system handoff
  Self-contained Webflow embed. Transparent, play-once, responsive.
  Scope: zw-crm-handoff
*/
---

<div class="dg" data-diagram="zw-crm-handoff" aria-hidden="true" style="--dg-w: 400; --dg-h: 220;">
  <div class="zw-stage dg-stage"><div class="zw-fit dg-fit"><div class="zw-scene">
    <div class="ch-panel">
      <span class="ch-line"></span>
      <div class="ch-person ch-person--consultant">
        <span class="ch-avatar">GZ</span><b>Consultant</b>
      </div>
      <div class="ch-system">
        <div class="ch-system-head"><span class="ch-logo">P</span><b>System</b>
          <span class="ch-check"><svg viewBox="0 0 24 24"><path d="M5 12.5l4.2 4.3L19 7"/></svg></span>
        </div>
        <div class="ch-item"><span>01</span><b>Setup</b></div>
        <div class="ch-item"><span>02</span><b>Guides</b></div>
        <div class="ch-item"><span>03</span><b>Roadmap</b></div>
      </div>
      <div class="ch-person ch-person--admin">
        <span class="ch-avatar">A</span><b>Admin</b><em class="ch-owner">Owner</em>
        <i class="ch-ring"></i>
      </div>
      <span class="ch-key">
        <svg viewBox="0 0 24 24"><path d="M14 8a5 5 0 1 1-2.1 4.1L21 3m-4 4 2 2m-5 1 2 2"/></svg>
      </span>
    </div>
  </div></div></div>
</div>

<style is:global>
[data-diagram="zw-crm-handoff"] {
    --zw-primary:#3A48CC;--zw-primary-10:#EBEDFA;--zw-primary-30:#8991E0;
    --zw-secondary:#0ACFFE;--zw-success:#52C41A;--zw-bg-soft:#F9FAFB;
    --zw-border:#DDE1E6;--zw-border-soft:#EDF0F3;--zw-heading:#0E0F11;
    --zw-text:#1E2024;--zw-muted:#838D95;--zw-card:#FFFFFF;
    --zw-font:'Satoshi Variable','Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,system-ui,sans-serif;
    --zw-serif:'Erode Variable','Fraunces','Source Serif 4',Georgia,serif;
    --zw-radius-card:10px;--zw-radius-lane:14px;
    --zw-shadow-rest:0 1px 3px rgba(0,0,0,.08);
    --zw-shadow-lift:1px 8px 22px rgba(14,15,17,.14);
    font-family:var(--zw-font);width:100%;max-width:440px;margin:0 auto;box-sizing:border-box;-webkit-font-smoothing:antialiased;
  }
  [data-diagram="zw-crm-handoff"] *,[data-diagram="zw-crm-handoff"] *::before,[data-diagram="zw-crm-handoff"] *::after{box-sizing:border-box}
  [data-diagram="zw-crm-handoff"] .zw-stage{width:100%;overflow:hidden}
  [data-diagram="zw-crm-handoff"] .zw-fit{width:400px;transform-origin:top left}
  [data-diagram="zw-crm-handoff"] .zw-scene{position:relative}
  [data-diagram="zw-crm-handoff"] .zw-confetti{position:absolute;top:0;left:0;width:0;height:0;z-index:9;pointer-events:none}
  [data-diagram="zw-crm-handoff"] .zw-confetti i{position:absolute;width:8px;height:8px;border-radius:2px;will-change:transform,opacity}

  /* =================== SCENE:STYLE start =================== */
  [data-diagram="zw-crm-handoff"] .ch-panel{
    position:relative;width:360px;height:220px;margin:6px auto;background:var(--zw-bg-soft);
    border:1px solid var(--zw-border);border-radius:var(--zw-radius-lane);overflow:hidden
  }
  [data-diagram="zw-crm-handoff"] .ch-line{
    position:absolute;left:60px;top:108px;width:240px;height:2px;background:var(--zw-primary-30);
    transform-origin:left center;transform:scaleX(0);opacity:.8
  }
  [data-diagram="zw-crm-handoff"] .ch-person{
    position:absolute;top:68px;width:76px;height:82px;display:flex;flex-direction:column;
    align-items:center;justify-content:center;gap:7px;background:var(--zw-card);
    border:1px solid var(--zw-border);border-radius:var(--zw-radius-card);box-shadow:var(--zw-shadow-rest);
    z-index:2;opacity:0
  }
  [data-diagram="zw-crm-handoff"] .ch-person--consultant{left:20px}
  [data-diagram="zw-crm-handoff"] .ch-person--admin{right:20px}
  [data-diagram="zw-crm-handoff"] .ch-avatar{
    width:34px;height:34px;display:flex;align-items:center;justify-content:center;border-radius:50%;
    background:var(--zw-border-soft);color:var(--zw-muted);font-size:10px;font-weight:800
  }
  [data-diagram="zw-crm-handoff"] .ch-person>b{font-size:10px;color:var(--zw-text)}
  [data-diagram="zw-crm-handoff"] .ch-person--admin.ch-person--owner{border-color:var(--zw-primary-30)}
  [data-diagram="zw-crm-handoff"] .ch-person--admin.ch-person--owner .ch-avatar{background:var(--zw-primary);color:#fff}
  [data-diagram="zw-crm-handoff"] .ch-owner{
    position:absolute;left:8px;right:8px;bottom:-12px;height:24px;display:flex;align-items:center;
    justify-content:center;border-radius:999px;background:var(--zw-success);color:#fff;
    font-size:9px;font-weight:800;font-style:normal;letter-spacing:.06em;text-transform:uppercase;
    transform:scale(0);z-index:3
  }
  [data-diagram="zw-crm-handoff"] .ch-ring{
    position:absolute;inset:-1px;border:2px solid var(--zw-success);border-radius:var(--zw-radius-card);
    opacity:0;pointer-events:none
  }
  [data-diagram="zw-crm-handoff"] .ch-system{
    position:absolute;left:126px;top:36px;width:108px;height:148px;padding:11px;
    background:var(--zw-card);border:1px solid var(--zw-border);border-radius:var(--zw-radius-card);
    box-shadow:var(--zw-shadow-lift);z-index:3;opacity:0
  }
  [data-diagram="zw-crm-handoff"] .ch-system-head{display:flex;align-items:center;gap:7px;margin-bottom:12px}
  [data-diagram="zw-crm-handoff"] .ch-logo{
    width:24px;height:24px;display:flex;align-items:center;justify-content:center;border-radius:7px;
    background:var(--zw-primary);color:#fff;font-size:11px;font-weight:800
  }
  [data-diagram="zw-crm-handoff"] .ch-system-head b{font-size:11px;color:var(--zw-heading)}
  [data-diagram="zw-crm-handoff"] .ch-check{
    margin-left:auto;width:19px;height:19px;display:flex;align-items:center;justify-content:center;
    border-radius:50%;background:var(--zw-success);color:#fff;transform:scale(0)
  }
  [data-diagram="zw-crm-handoff"] .ch-check svg{width:11px;height:11px}
  [data-diagram="zw-crm-handoff"] .ch-check path{fill:none;stroke:currentColor;stroke-width:2.7;stroke-linecap:round;stroke-linejoin:round}
  [data-diagram="zw-crm-handoff"] .ch-item{
    height:26px;display:flex;align-items:center;gap:7px;margin-bottom:7px;padding:0 7px;
    border-radius:6px;background:var(--zw-border-soft);opacity:0
  }
  [data-diagram="zw-crm-handoff"] .ch-item span{
    width:20px;height:16px;display:flex;align-items:center;justify-content:center;border-radius:4px;
    background:var(--zw-card);color:var(--zw-primary);font-size:8px;font-weight:800
  }
  [data-diagram="zw-crm-handoff"] .ch-item b{font-size:9px;color:var(--zw-text)}
  [data-diagram="zw-crm-handoff"] .ch-key{
    position:absolute;left:48px;top:94px;width:30px;height:30px;display:flex;align-items:center;
    justify-content:center;border-radius:50%;background:var(--zw-primary);color:#fff;
    box-shadow:var(--zw-shadow-lift);z-index:6;opacity:0;will-change:transform,opacity
  }
  [data-diagram="zw-crm-handoff"] .ch-key svg{width:16px;height:16px}
  [data-diagram="zw-crm-handoff"] .ch-key path{fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
  /* ==================== SCENE:STYLE end ==================== */

  @media(prefers-reduced-motion:reduce){
    [data-diagram="zw-crm-handoff"] .ch-person,[data-diagram="zw-crm-handoff"] .ch-system,[data-diagram="zw-crm-handoff"] .ch-item,[data-diagram="zw-crm-handoff"] .ch-key{opacity:1}
    [data-diagram="zw-crm-handoff"] .ch-line{transform:scaleX(1)}
    [data-diagram="zw-crm-handoff"] .ch-key{transform:translateX(239px)}
    [data-diagram="zw-crm-handoff"] .ch-person--admin{border-color:var(--zw-primary-30)}
    [data-diagram="zw-crm-handoff"] .ch-person--admin .ch-avatar{background:var(--zw-primary);color:#fff}
    [data-diagram="zw-crm-handoff"] .ch-owner,[data-diagram="zw-crm-handoff"] .ch-check{transform:scale(1)}
  }
</style>

<script>
  // @ts-nocheck
  for (const root of document.querySelectorAll('[data-diagram="zw-crm-handoff"]')) {
(function(){
  if(!root||root.dataset.zwInit)return;root.dataset.zwInit='1';
  var DESIGN_W=400,stage=root.querySelector('.zw-stage'),fitEl=root.querySelector('.zw-fit'),scene=root.querySelector('.zw-scene');
  var reduce=window.matchMedia&&window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var EASE_MOVE='cubic-bezier(0.645, 0.045, 0.355, 1)',EASE_OUT='cubic-bezier(0.22, 1, 0.36, 1)',EASE_POP='cubic-bezier(0.34, 1.56, 0.64, 1)';
  function wait(ms){return new Promise(function(r){setTimeout(r,ms);});}
  function settled(a){return a.finished.catch(function(){});}
  function fit(){}
  function confetti(){}

  async function play(){
    fit();if(reduce)return;
    var people=Array.prototype.slice.call(scene.querySelectorAll('.ch-person')),system=scene.querySelector('.ch-system'),items=Array.prototype.slice.call(scene.querySelectorAll('.ch-item'));
    people.forEach(function(el,i){el.animate([{opacity:0,transform:'translateY(12px)'},{opacity:1,transform:'translateY(0)'}],{duration:440,delay:i*100,easing:EASE_OUT,fill:'forwards'});el.style.opacity=1;});
    system.animate([{opacity:0,transform:'scale(.9)'},{opacity:1,transform:'scale(1)'}],{duration:460,delay:180,easing:EASE_OUT,fill:'forwards'});system.style.opacity=1;
    await wait(720);
    items.forEach(function(item,i){item.animate([{opacity:0,transform:'translateX(-8px)'},{opacity:1,transform:'translateX(0)'}],{duration:360,delay:i*120,easing:EASE_OUT,fill:'forwards'});item.style.opacity=1;});
    await wait(780);
    var line=scene.querySelector('.ch-line'),key=scene.querySelector('.ch-key');
    line.animate([{transform:'scaleX(0)'},{transform:'scaleX(1)'}],{duration:640,easing:EASE_MOVE,fill:'forwards'});
    key.style.opacity=1;
    await settled(key.animate([
      {opacity:0,transform:'translate(0,0) scale(.88)'},
      {opacity:1,transform:'translate(0,0) scale(1.04)',offset:.18},
      {opacity:1,transform:'translate(120px,-24px) scale(1.04)',offset:.52},
      {opacity:1,transform:'translate(239px,0) scale(1)'}
    ],{duration:1180,easing:EASE_MOVE,fill:'forwards'}));
    key.style.transform='translateX(239px)';
    await wait(240);
    var admin=scene.querySelector('.ch-person--admin'),owner=scene.querySelector('.ch-owner'),check=scene.querySelector('.ch-check'),ring=scene.querySelector('.ch-ring');
    admin.classList.add('ch-person--owner');
    owner.animate([{transform:'scale(0)'},{transform:'scale(1)'}],{duration:380,easing:EASE_POP,fill:'forwards'});owner.style.transform='scale(1)';
    check.animate([{transform:'scale(0)'},{transform:'scale(1)'}],{duration:380,delay:100,easing:EASE_POP,fill:'forwards'});check.style.transform='scale(1)';
    ring.animate([{opacity:.7,transform:'scale(1)'},{opacity:0,transform:'scale(1.28)'}],{duration:800,easing:EASE_OUT,fill:'forwards'});
    scene.querySelector('.ch-person--consultant').animate([{opacity:1},{opacity:.5}],{duration:420,easing:EASE_OUT,fill:'forwards'});
  }
  fit();if('ResizeObserver'in window)new ResizeObserver(fit).observe(stage);else window.addEventListener('resize',fit);
  function arm(){if(!('IntersectionObserver'in window)){play();return;}var io=new IntersectionObserver(function(entries){entries.forEach(function(e){if(e.isIntersecting){io.disconnect();requestAnimationFrame(function(){requestAnimationFrame(play);});}});},{threshold:.4});io.observe(root)}
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',arm);else arm();
})();
  }
</script>
