---
// Rebuilt in the calm scene style by T97.
// Step 5, handing over the system: each responsibility moves from me to the
// client's own administrator. Also used on the Salesforce page.
// The markup is the end state. The list is a placeholder.
import "./scene/scene.css";

const duties = [
  "Uprawnienia administratora",
  "Instrukcje dla zespołu",
  "Zmiany w lejku i polach",
  "Plan rozwoju systemu",
];
---

<div
  class="sc"
  data-diagram="zw-crm-handoff"
  data-scene="sequence"
  aria-hidden="true"
>
  <div class="sc-body">
    <div class="columns">
      <span>Odpowiedzialność</span>
      <span>Kto prowadzi</span>
    </div>
    <ul>
      {duties.map((duty, i) => (
        <li class="is-done" data-step data-value={i + 1}>
          <span class="duty">{duty}</span>
          <span class="cell">
            <span class="owner me">Grzegorz</span>
            <span class="owner you">Wasz admin</span>
          </span>
        </li>
      ))}
    </ul>
    <div class="sc-total">
      <span class="sc-total-label">Po Waszej stronie</span>
      <span class="sc-total-value" data-total data-suffix={" z 4"}>
        4&nbsp;z&nbsp;4
      </span>
    </div>
  </div>
</div>

<style>
  .columns {
    display: flex;
    justify-content: space-between;
    padding-block-end: 0.5rem;
    color: var(--text-muted);
    font-size: 0.8125rem;
    border-block-end: 1px solid var(--text-heading);
  }

  li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.75rem;
    align-items: center;
    padding-block: 0.55rem;
    border-block-end: 1px solid var(--border-hairline);
  }

  .duty {
    color: var(--text-heading);
  }

  .cell {
    display: grid;
    justify-items: end;
  }

  .cell > * {
    grid-area: 1 / 1;
  }

  .owner {
    padding: 0.15rem 0.6rem;
    font-size: 0.8125rem;
    font-weight: var(--font-weight-medium);
    white-space: nowrap;
    border-radius: var(--radius-pill);
  }

  .me {
    color: var(--text-muted);
    border: 1px solid var(--border-default);
  }

  .you {
    color: var(--text-link);
    background: var(--surface-tint);
  }

  li:not(.is-done) .you,
  .is-done .me {
    opacity: 0;
  }

  li:not(.is-done) .you {
    transform: translateX(-0.5rem);
  }

  @media (prefers-reduced-motion: no-preference) {
    .owner {
      transition:
        opacity 630ms cubic-bezier(0.25, 1, 0.5, 1),
        transform 630ms cubic-bezier(0.25, 1, 0.5, 1);
    }
  }
</style>

<script>
  import "./sequence";
</script>
