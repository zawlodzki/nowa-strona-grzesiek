---
// Rebuilt in the calm scene style by T99; port-diagrams.mjs no longer writes this file.
// The problem: for one won deal the salesperson retypes the same data into
// every downstream chore, and the minutes add up. It ends on the loss.
// The markup is the end state. Chores and minutes are placeholders.
import "./scene/scene.css";

const chores = [
  { name: "Uzupełnienie CRM", minutes: 8 },
  { name: "Folder klienta", minutes: 5 },
  { name: "Potwierdzenie mailem", minutes: 6 },
  { name: "Przypomnienie o follow-upie", minutes: 4 },
  { name: "Projekt dla realizacji", minutes: 9 },
  { name: "Dane do faktury", minutes: 7 },
];
let total = 0;
const rows = chores.map((chore) => ({
  ...chore,
  total: (total += chore.minutes),
}));
---

<div
  class="sc"
  data-diagram="zw-auto-problem"
  data-scene="sequence"
  aria-hidden="true"
>
  <div class="sc-body">
    <div class="head">
      <span>Jedna wygrana szansa, ręcznie</span>
      <span>Czas</span>
    </div>
    <ul>
      {rows.map((row) => (
        <li class="is-done" data-step data-value={row.total}>
          <span class="name">{row.name}</span>
          <span class="cell">
            <span class="pending">…</span>
            <span class="minutes">+{row.minutes} min</span>
          </span>
        </li>
      ))}
    </ul>
    <div class="sc-total">
      <span class="sc-total-label">Przepisywanie na jedną szansę</span>
      <span class="sc-total-value is-loss" data-total data-suffix=" min">
        {total} min
      </span>
    </div>
  </div>
</div>

<style>
  .head {
    display: flex;
    justify-content: space-between;
    padding-block-end: 0.5rem;
    color: var(--text-muted);
    font-size: 0.8125rem;
    border-block-end: 1px solid var(--text-heading);
  }

  li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.75rem;
    align-items: baseline;
    padding-block: 0.55rem;
    border-block-end: 1px solid var(--border-hairline);
  }

  .name {
    color: var(--text-heading);
  }

  .cell {
    display: grid;
    justify-items: end;
  }

  .cell > * {
    grid-area: 1 / 1;
  }

  .pending {
    color: var(--border-strong);
  }

  .minutes {
    color: var(--text-error);
    font-weight: var(--font-weight-semibold);
    white-space: nowrap;
  }

  li:not(.is-done) .minutes,
  .is-done .pending {
    opacity: 0;
  }

  li:not(.is-done) .minutes {
    transform: translateY(6px);
  }

  @media (prefers-reduced-motion: no-preference) {
    .minutes,
    .pending {
      transition:
        opacity 630ms cubic-bezier(0.25, 1, 0.5, 1),
        transform 630ms cubic-bezier(0.25, 1, 0.5, 1);
    }
  }
</style>

<script>
  import "./sequence";
</script>
