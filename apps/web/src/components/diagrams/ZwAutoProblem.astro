---
// Ported from the Webflow embed #zw-auto-problem (automatyzacje-dla-pipedrive) by port/port-diagrams.mjs.
import './diagram.css';
/*
  PROBLEM — "Reps re-type data instead of selling"
  zawlodzki.pl · self-contained, no external dependencies.

  Metaphor: ONE won deal, and a rep who has to hand-key the same record
  into every downstream chore (CRM, folder, confirmation, follow-up,
  project). A cursor hops down the list; each chore stamps a "+Xm" delay
  while a manual-entry meter climbs and the "Sell" bar stays locked. It
  ends on friction, not a win: a big weekly cost and a typo — no confetti.
  The solution animations (steps 1-4) celebrate; this one agitates.
*/
---

<div class="dg" data-diagram="zw-auto-problem" aria-hidden="true" style="--dg-w: 720; --dg-h: 373;">
  <div class="zw-stage dg-stage">
    <div class="zw-fit dg-fit">
      <div class="zw-scene">
        <div class="ap-board">
          <div class="ap-top">
            <span class="ap-meter">
              <span class="ap-meter-label">Manual entry</span>
              <span class="ap-meter-val">0m</span>
            </span>
            <span class="ap-week">&asymp; 5h / week</span>
          </div>

          <div class="ap-body">
            <div class="ap-rep">
              <div class="ap-rep-head">
                <span class="ap-avatar">
                  <svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="3.4"/><path d="M5.6 19.4a6.4 6.4 0 0 1 12.8 0"/></svg>
                </span>
                <b>Rep</b>
              </div>
              <div class="ap-deal">
                <span class="ap-deal-bar"></span>
                <span class="ap-deal-name">Acme</span>
                <span class="ap-deal-val">&euro;24,000</span>
                <span class="ap-deal-tag">New deal</span>
              </div>
              <div class="ap-sell">
                <span class="ap-lock">
                  <svg viewBox="0 0 24 24"><rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg>
                </span>
                <b>Sell</b>
                <span class="ap-sell-note">Waiting</span>
              </div>
            </div>

            <div class="ap-list">
              <span class="ap-list-eyebrow">One deal, by hand</span>
              <div class="ap-chore" data-min="8"><span class="ap-chore-ico">
                <svg viewBox="0 0 24 24"><rect x="3.5" y="4" width="4" height="16" rx="1"/><rect x="10" y="4" width="4" height="11" rx="1"/><rect x="16.5" y="4" width="4" height="13" rx="1"/></svg>
              </span><b>CRM</b><span class="ap-state"><span class="ap-spin"></span></span></div>
              <div class="ap-chore" data-min="5"><span class="ap-chore-ico">
                <svg viewBox="0 0 24 24"><path d="M3.6 6.5A1.5 1.5 0 0 1 5 5h4l2 2.4h7A1.5 1.5 0 0 1 20.5 9v8A1.5 1.5 0 0 1 19 18.5H5A1.5 1.5 0 0 1 3.5 17z"/></svg>
              </span><b>Folder</b><span class="ap-state"><span class="ap-spin"></span></span></div>
              <div class="ap-chore" data-min="6"><span class="ap-chore-ico">
                <svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3.6 7l8.4 6 8.4-6"/></svg>
              </span><b>Confirm</b><span class="ap-state"><span class="ap-spin"></span></span></div>
              <div class="ap-chore" data-min="7"><span class="ap-chore-ico">
                <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="8"/><path d="M12 8v4l3 2"/></svg>
              </span><b>Follow-up</b><span class="ap-state"><span class="ap-spin"></span></span></div>
              <div class="ap-chore" data-min="9"><span class="ap-chore-ico">
                <svg viewBox="0 0 24 24"><path d="M4 6h6l1.6 2H20v10H4z"/></svg>
              </span><b>Project</b><span class="ap-state"><span class="ap-spin"></span></span></div>

              <span class="ap-cursor">
                <svg viewBox="0 0 24 24"><path d="M5 3l14 8-6 1.6L9.5 19z"/></svg>
              </span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style is:global>
/* ---- Shared family layer: tokens + responsive shell (verbatim). ---- */
  [data-diagram="zw-auto-problem"] {
    --zw-primary:    #3A48CC;
    --zw-primary-10: #EBEDFA;
    --zw-primary-30: #8991E0;
    --zw-secondary:  #0ACFFE;
    --zw-success:    #52C41A;
    --zw-bg-soft:    #F9FAFB;
    --zw-border:     #DDE1E6;
    --zw-border-soft:#EDF0F3;
    --zw-heading:    #0E0F11;
    --zw-text:       #1E2024;
    --zw-muted:      #838D95;
    --zw-card:       #FFFFFF;
    --zw-font: 'Satoshi Variable','Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,system-ui,sans-serif;
    --zw-serif: 'Erode Variable','Fraunces','Source Serif 4',Georgia,serif;
    --zw-radius-card: 10px;
    --zw-radius-lane: 14px;
    --zw-shadow-rest: 0 1px 3px rgba(0,0,0,.08);
    --zw-shadow-lift: 1px 8px 22px rgba(14,15,17,.14);
    /* warm accent — the one sanctioned off-brand hue; here it carries
       "delay / friction / manual cost" on this problem-section scene. */
    --zw-warn:    #B8860B;
    --zw-warn-10: rgba(255,197,61,.18);
    --zw-error:   #D0463B;
    --zw-error-10:rgba(208,70,59,.12);

    font-family: var(--zw-font);
    width: 100%;
    max-width: 920px;
    margin: 0 auto;
    box-sizing: border-box;
    -webkit-font-smoothing: antialiased;
  }
  [data-diagram="zw-auto-problem"] *, [data-diagram="zw-auto-problem"] *::before, [data-diagram="zw-auto-problem"] *::after { box-sizing: border-box; }

  [data-diagram="zw-auto-problem"] .zw-stage { width: 100%; overflow: hidden; }
  [data-diagram="zw-auto-problem"] .zw-fit   { width: 720px; transform-origin: top left; }
  [data-diagram="zw-auto-problem"] .zw-scene { position: relative; }

  [data-diagram="zw-auto-problem"] .zw-confetti { position: absolute; top: 0; left: 0; width: 0; height: 0; z-index: 9; pointer-events: none; }
  [data-diagram="zw-auto-problem"] .zw-confetti i { position: absolute; width: 8px; height: 8px; border-radius: 2px; will-change: transform, opacity; }

  /* =================== SCENE:STYLE start =================== */
  [data-diagram="zw-auto-problem"] .ap-board { position: relative; padding: 6px 0 10px; }

  /* ---- Top: manual-entry meter + weekly cost ---- */
  [data-diagram="zw-auto-problem"] .ap-top {
    display: flex; align-items: center; justify-content: center; gap: 12px;
    margin-bottom: 20px;
  }
  [data-diagram="zw-auto-problem"] .ap-meter {
    display: inline-flex; align-items: center; gap: 10px;
    padding: 7px 14px; border-radius: 999px;
    background: var(--zw-card); border: 1px solid var(--zw-border);
    box-shadow: var(--zw-shadow-rest);
  }
  [data-diagram="zw-auto-problem"] .ap-meter-label {
    font-size: 11px; font-weight: 700; letter-spacing: .07em; text-transform: uppercase;
    color: var(--zw-muted);
  }
  [data-diagram="zw-auto-problem"] .ap-meter-val {
    min-width: 44px; text-align: center;
    font-size: 16px; font-weight: 800; color: var(--zw-warn);
    font-variant-numeric: tabular-nums;
  }
  [data-diagram="zw-auto-problem"] .ap-week {
    display: inline-flex; align-items: center;
    padding: 6px 12px; border-radius: 999px;
    background: var(--zw-warn-10); color: var(--zw-warn);
    font-size: 12px; font-weight: 800; letter-spacing: .02em; white-space: nowrap;
    opacity: 0; transform: scale(.9);
  }

  [data-diagram="zw-auto-problem"] .ap-body { position: relative; display: flex; gap: 30px; align-items: flex-start; }

  /* ---- Left: the rep ---- */
  [data-diagram="zw-auto-problem"] .ap-rep { flex: 0 0 226px; width: 226px; }
  [data-diagram="zw-auto-problem"] .ap-rep-head {
    display: flex; align-items: center; gap: 10px; margin-bottom: 12px;
    opacity: 0; transform: translateY(12px);
  }
  [data-diagram="zw-auto-problem"] .ap-avatar {
    width: 40px; height: 40px; border-radius: 50%;
    background: var(--zw-primary-10); color: var(--zw-primary);
    display: flex; align-items: center; justify-content: center; box-shadow: var(--zw-shadow-rest);
  }
  [data-diagram="zw-auto-problem"] .ap-avatar svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  [data-diagram="zw-auto-problem"] .ap-rep-head b { font-size: 13px; font-weight: 800; color: var(--zw-heading); }

  [data-diagram="zw-auto-problem"] .ap-deal {
    position: relative; background: var(--zw-card); border: 1px solid var(--zw-border);
    border-radius: var(--zw-radius-card); box-shadow: var(--zw-shadow-rest);
    padding: 13px 14px 13px 16px; margin-bottom: 14px; overflow: hidden;
    opacity: 0; transform: translateY(12px);
  }
  [data-diagram="zw-auto-problem"] .ap-deal-bar { position: absolute; left: 0; top: 0; bottom: 0; width: 3px; background: var(--zw-primary); }
  [data-diagram="zw-auto-problem"] .ap-deal-name { display: block; font-size: 13px; font-weight: 700; color: var(--zw-heading); }
  [data-diagram="zw-auto-problem"] .ap-deal-val { display: block; font-size: 18px; font-weight: 800; color: var(--zw-heading); letter-spacing: -.01em; margin-top: 2px; }
  [data-diagram="zw-auto-problem"] .ap-deal-tag {
    display: inline-block; margin-top: 10px; padding: 3px 8px; border-radius: 6px;
    background: var(--zw-primary-10); color: var(--zw-primary);
    font-size: 10px; font-weight: 700; letter-spacing: .04em; text-transform: uppercase;
  }

  [data-diagram="zw-auto-problem"] .ap-sell {
    display: flex; align-items: center; gap: 9px;
    padding: 12px 14px; border-radius: var(--zw-radius-card);
    background: var(--zw-bg-soft); border: 1px dashed var(--zw-border);
    opacity: 0; transform: translateY(12px);
  }
  [data-diagram="zw-auto-problem"] .ap-sell .ap-lock { color: var(--zw-muted); line-height: 0; }
  [data-diagram="zw-auto-problem"] .ap-sell .ap-lock svg { width: 17px; height: 17px; fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
  [data-diagram="zw-auto-problem"] .ap-sell b { font-size: 13px; font-weight: 800; color: var(--zw-muted); }
  [data-diagram="zw-auto-problem"] .ap-sell-note { margin-left: auto; font-size: 10px; font-weight: 700; letter-spacing: .05em; text-transform: uppercase; color: var(--zw-muted); }

  /* ---- Right: the manual worklist ---- */
  [data-diagram="zw-auto-problem"] .ap-list { position: relative; flex: 1 1 auto; }
  [data-diagram="zw-auto-problem"] .ap-list-eyebrow {
    display: block; margin-bottom: 12px;
    font-size: 12px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--zw-muted);
  }
  [data-diagram="zw-auto-problem"] .ap-chore {
    display: flex; align-items: center; gap: 12px;
    height: 44px; padding: 0 12px 0 12px; margin-bottom: 8px;
    background: var(--zw-card); border: 1px solid var(--zw-border);
    border-radius: var(--zw-radius-card); box-shadow: var(--zw-shadow-rest);
    opacity: 0; transform: translateY(10px);
    transition: border-color .35s ease;
  }
  [data-diagram="zw-auto-problem"] .ap-chore--active { border-color: var(--zw-warn); }
  [data-diagram="zw-auto-problem"] .ap-chore-ico {
    flex: 0 0 auto; width: 26px; height: 26px; border-radius: 7px;
    background: var(--zw-border-soft); color: var(--zw-muted);
    display: flex; align-items: center; justify-content: center; line-height: 0;
    transition: background-color .35s ease, color .35s ease;
  }
  [data-diagram="zw-auto-problem"] .ap-chore-ico svg { width: 15px; height: 15px; fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
  [data-diagram="zw-auto-problem"] .ap-chore > b { font-size: 12px; font-weight: 700; color: var(--zw-text); }

  [data-diagram="zw-auto-problem"] .ap-state { margin-left: auto; display: flex; align-items: center; }
  [data-diagram="zw-auto-problem"] .ap-spin {
    width: 15px; height: 15px; border-radius: 50%;
    border: 2px solid var(--zw-border); border-top-color: var(--zw-warn);
    opacity: 0; will-change: transform;
  }
  [data-diagram="zw-auto-problem"] .ap-tick {
    display: inline-flex; align-items: center;
    padding: 3px 8px; border-radius: 999px;
    background: var(--zw-warn-10); color: var(--zw-warn);
    font-size: 11px; font-weight: 800; white-space: nowrap;
    transform: scale(.85); opacity: 0;
    font-variant-numeric: tabular-nums;
  }
  [data-diagram="zw-auto-problem"] .ap-flag {
    margin-left: 8px; display: inline-flex; align-items: center;
    padding: 3px 8px; border-radius: 999px;
    background: var(--zw-error-10); color: var(--zw-error);
    font-size: 10px; font-weight: 800; letter-spacing: .04em; text-transform: uppercase; white-space: nowrap;
    transform: scale(.85); opacity: 0;
  }

  /* The hand cursor mover */
  [data-diagram="zw-auto-problem"] .ap-cursor {
    position: absolute; left: 0; top: 0; z-index: 6;
    width: 26px; height: 26px; color: var(--zw-heading);
    filter: drop-shadow(0 2px 4px rgba(14,15,17,.28));
    opacity: 0; will-change: transform;
  }
  [data-diagram="zw-auto-problem"] .ap-cursor svg { width: 26px; height: 26px; fill: #fff; stroke: var(--zw-heading); stroke-width: 1.6; stroke-linejoin: round; }
  /* ==================== SCENE:STYLE end ==================== */

  /* Accessibility: land on the resolved friction frame, no motion. */
  @media (prefers-reduced-motion: reduce) {
    [data-diagram="zw-auto-problem"] .ap-rep-head, [data-diagram="zw-auto-problem"] .ap-deal, [data-diagram="zw-auto-problem"] .ap-sell { opacity: 1; transform: none; }
    [data-diagram="zw-auto-problem"] .ap-chore { opacity: 1; transform: none; border-color: var(--zw-warn); }
    [data-diagram="zw-auto-problem"] .ap-chore-ico { background: var(--zw-warn-10); color: var(--zw-warn); }
    [data-diagram="zw-auto-problem"] .ap-spin { display: none; }
    [data-diagram="zw-auto-problem"] .ap-tick { opacity: 1; transform: none; }
    [data-diagram="zw-auto-problem"] .ap-flag { opacity: 1; transform: none; }
    [data-diagram="zw-auto-problem"] .ap-meter-val { }
    [data-diagram="zw-auto-problem"] .ap-week { opacity: 1; transform: none; }
    [data-diagram="zw-auto-problem"] .ap-cursor { display: none; }
  }
</style>

<script>
  // @ts-nocheck
  for (const root of document.querySelectorAll('[data-diagram="zw-auto-problem"]')) {
(function () {
  if (!root || root.dataset.zwInit) return;
  root.dataset.zwInit = '1';

  var DESIGN_W = 720;

  var stage = root.querySelector('.zw-stage');
  var fitEl = root.querySelector('.zw-fit');
  var scene = root.querySelector('.zw-scene');

  var body    = root.querySelector('.ap-body');
  var repHead = root.querySelector('.ap-rep-head');
  var deal    = root.querySelector('.ap-deal');
  var sell    = root.querySelector('.ap-sell');
  var chores  = Array.prototype.slice.call(root.querySelectorAll('.ap-chore'));
  var cursor  = root.querySelector('.ap-cursor');
  var meterVal= root.querySelector('.ap-meter-val');
  var week    = root.querySelector('.ap-week');

  var reduce = window.matchMedia &&
               window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  var EASE_MOVE = 'cubic-bezier(0.645, 0.045, 0.355, 1)';
  var EASE_OUT  = 'cubic-bezier(0.22, 1, 0.36, 1)';
  var EASE_POP  = 'cubic-bezier(0.34, 1.56, 0.64, 1)';

  function wait(ms) { return new Promise(function (r) { setTimeout(r, ms); }); }
  function settled(anim) { return anim.finished.catch(function () {}); }

  function fit(){}

  function confetti() {} /* friction ending — kept for family parity, unused */

  /* =================== SCENE:LOGIC start =================== */
  var mins = 0;
  function fmt(m) {
    if (m < 60) return m + 'm';
    var h = Math.floor(m / 60), r = m % 60;
    return h + 'h' + (r ? ' ' + r + 'm' : '');
  }
  function bumpMeter(add) {
    var from = mins, to = mins + add, t0 = null, dur = 420;
    mins = to;
    function step(ts) {
      if (t0 == null) t0 = ts;
      var k = Math.min(1, (ts - t0) / dur);
      meterVal.textContent = fmt(Math.round(from + (to - from) * k));
      if (k < 1) requestAnimationFrame(step);
    }
    requestAnimationFrame(step);
  }

  /* Cursor position: hover just left of a chore's state chip (body-space). */
  function cursorTo(chore) {
    var state = chore.querySelector('.ap-state');
    var x = state.offsetLeft + chore.parentElement.offsetLeft - 4;
    var y = chore.offsetTop + chore.parentElement.offsetTop + chore.offsetHeight / 2 - 6;
    return { x: x, y: y };
  }
  function setCursor(p) { cursor.style.transform = 'translate(' + p.x + 'px,' + p.y + 'px)'; }

  function showSpin(chore) {
    var sp = chore.querySelector('.ap-spin');
    sp.style.opacity = 1;
    return sp.animate([{ transform: 'rotate(0deg)' }, { transform: 'rotate(360deg)' }],
      { duration: 900, iterations: Infinity, easing: 'linear' });
  }
  function stampTick(chore, m, flag) {
    var state = chore.querySelector('.ap-state');
    state.innerHTML = '';
    var tick = document.createElement('span');
    tick.className = 'ap-tick';
    tick.textContent = '+' + m + 'm';
    state.appendChild(tick);
    tick.animate([{ opacity: 0, transform: 'scale(.85)' }, { opacity: 1, transform: 'scale(1)' }],
      { duration: 320, easing: EASE_POP, fill: 'forwards' });
    tick.style.opacity = 1; tick.style.transform = 'scale(1)';
    if (flag) {
      var f = document.createElement('span');
      f.className = 'ap-flag';
      f.textContent = 'Typo';
      state.appendChild(f);
      f.animate([{ opacity: 0, transform: 'scale(.85)' }, { opacity: 1, transform: 'scale(1)' }],
        { duration: 320, delay: 140, easing: EASE_POP, fill: 'forwards' });
      f.style.opacity = 1; f.style.transform = 'scale(1)';
    }
  }

  function showFinal() {
    fit();
    repHead.style.opacity = 1; repHead.style.transform = 'none';
    deal.style.opacity = 1; deal.style.transform = 'none';
    sell.style.opacity = 1; sell.style.transform = 'none';
    var total = 0;
    chores.forEach(function (c, i) {
      c.style.opacity = 1; c.style.transform = 'none';
      c.classList.add('ap-chore--active');
      c.querySelector('.ap-chore-ico').style.background = 'var(--zw-warn-10)';
      c.querySelector('.ap-chore-ico').style.color = 'var(--zw-warn)';
      var m = parseInt(c.dataset.min, 10); total += m;
      stampTick(c, m, i === 2);
    });
    meterVal.textContent = fmt(total);
    week.style.opacity = 1; week.style.transform = 'scale(1)';
  }

  async function play() {
    fit();
    if (reduce) { showFinal(); return; }

    // 1. Rep + the one deal appear.
    repHead.animate([{ opacity: 0, transform: 'translateY(12px)' }, { opacity: 1, transform: 'translateY(0)' }],
      { duration: 420, easing: EASE_OUT, fill: 'forwards' });
    repHead.style.opacity = 1; repHead.style.transform = 'none';
    deal.animate([{ opacity: 0, transform: 'translateY(12px)' }, { opacity: 1, transform: 'translateY(0)' }],
      { duration: 440, delay: 130, easing: EASE_OUT, fill: 'forwards' });
    deal.style.opacity = 1; deal.style.transform = 'none';
    sell.animate([{ opacity: 0, transform: 'translateY(12px)' }, { opacity: 1, transform: 'translateY(0)' }],
      { duration: 440, delay: 260, easing: EASE_OUT, fill: 'forwards' });
    sell.style.opacity = 1; sell.style.transform = 'none';

    // 2. The worklist rises.
    chores.forEach(function (c, i) {
      c.animate([{ opacity: 0, transform: 'translateY(10px)' }, { opacity: 1, transform: 'translateY(0)' }],
        { duration: 360, delay: 380 + i * 80, easing: EASE_OUT, fill: 'forwards' });
      c.style.opacity = 1; c.style.transform = 'none';
    });
    await wait(1000);

    // 3. Cursor lands on the first chore.
    var p0 = cursorTo(chores[0]);
    setCursor(p0);
    await settled(cursor.animate([{ opacity: 0, transform: 'translate(' + p0.x + 'px,' + (p0.y - 10) + 'px)' },
                                  { opacity: 1, transform: 'translate(' + p0.x + 'px,' + p0.y + 'px)' }],
      { duration: 320, easing: EASE_OUT, fill: 'forwards' }));
    cursor.style.opacity = 1;

    // 4. Hand-key each chore, one by one: spin, click, stamp a +Xm delay,
    //    climb the meter. Slow and repetitive on purpose.
    for (var i = 0; i < chores.length; i++) {
      var chore = chores[i];
      var p = cursorTo(chore);

      if (i > 0) {
        await settled(cursor.animate(
          [{ transform: 'translate(' + prev.x + 'px,' + prev.y + 'px)' },
           { transform: 'translate(' + ((prev.x + p.x) / 2) + 'px,' + (Math.min(prev.y, p.y) - 12) + 'px)', offset: .5 },
           { transform: 'translate(' + p.x + 'px,' + p.y + 'px)' }],
          { duration: 460, easing: EASE_MOVE, fill: 'forwards' }));
        setCursor(p);
      }
      var prev = p;

      chore.classList.add('ap-chore--active');
      chore.querySelector('.ap-chore-ico').animate(
        [{ background: 'var(--zw-border-soft)' }, { background: 'var(--zw-warn-10)' }],
        { duration: 300, easing: EASE_OUT, fill: 'forwards' });
      chore.querySelector('.ap-chore-ico').style.background = 'var(--zw-warn-10)';
      chore.querySelector('.ap-chore-ico').style.color = 'var(--zw-warn)';

      var spin = showSpin(chore);
      // click press
      cursor.animate([{ transform: 'translate(' + p.x + 'px,' + p.y + 'px) scale(1)' },
                      { transform: 'translate(' + p.x + 'px,' + (p.y + 3) + 'px) scale(.9)' },
                      { transform: 'translate(' + p.x + 'px,' + p.y + 'px) scale(1)' }],
        { duration: 260, easing: EASE_OUT });
      await wait(640);

      spin.cancel();
      var m = parseInt(chore.dataset.min, 10);
      stampTick(chore, m, i === 2);   // the confirmation email got a typo
      bumpMeter(m);
      await wait(360);
    }

    // 5. Friction beat (no win): the weekly cost lands, the meter jolts,
    //    "Sell" stays locked and waiting.
    await wait(200);
    week.animate([{ opacity: 0, transform: 'scale(.9)' }, { opacity: 1, transform: 'scale(1)' }],
      { duration: 380, easing: EASE_POP, fill: 'forwards' });
    week.style.opacity = 1; week.style.transform = 'scale(1)';
    root.querySelector('.ap-meter').animate(
      [{ transform: 'translateX(0)' }, { transform: 'translateX(-4px)' }, { transform: 'translateX(4px)' }, { transform: 'translateX(0)' }],
      { duration: 320, easing: EASE_OUT });
    sell.animate([{ transform: 'scale(1)' }, { transform: 'scale(1.02)' }, { transform: 'scale(1)' }],
      { duration: 420, delay: 160, easing: EASE_OUT });
  }
  /* ==================== SCENE:LOGIC end ==================== */

  fit();
  if ('ResizeObserver' in window) { new ResizeObserver(fit).observe(stage); }
  else { window.addEventListener('resize', fit); }

  function arm() {
    if (!('IntersectionObserver' in window)) { play(); return; }
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (e.isIntersecting) {
          io.disconnect();
          requestAnimationFrame(function () { requestAnimationFrame(play); });
        }
      });
    }, { threshold: 0.4 });
    io.observe(root);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', arm);
  } else {
    arm();
  }
})();
  }
</script>
