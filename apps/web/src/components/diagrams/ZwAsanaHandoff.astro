---
// Rebuilt in the calm scene style by T100.
// Step 5, handover to a leader: each responsibility passes from me to the
// team's own leader. The list is a placeholder.
import ListScene from "./ListScene.astro";

const duties = [
  "Administracja",
  "Dokumentacja",
  "Wzorzec onboardingu",
  "Rozwój systemu",
];
---

<ListScene
  diagram="zw-asana-handoff"
  head={["Odpowiedzialność", "Kto prowadzi"]}
  rows={duties.map((name) => ({
    name,
    from: "Grzegorz",
    value: "lider zespołu",
    pill: true,
    counts: true,
  }))}
  total={{ label: "Po stronie lidera", of: duties.length }}
/>
