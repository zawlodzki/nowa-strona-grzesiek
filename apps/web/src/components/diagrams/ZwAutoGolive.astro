---
// Rebuilt in the calm scene style by T99.
// Step 3, going live with the team: each task lands either in the
// "automatically" column or with a person, so everyone knows what is theirs.
// The markup is the end state. The tasks are placeholders.
import "./scene/scene.css";

const tasks = [
  { name: "Lead trafia do CRM", auto: true },
  { name: "Pierwszy telefon do klienta", auto: false },
  { name: "Potwierdzenie spotkania", auto: true },
  { name: "Oferta i negocjacje", auto: false },
  { name: "Przekazanie do realizacji", auto: true },
];
---

<div
  class="sc"
  data-diagram="zw-auto-golive"
  data-scene="sequence"
  aria-hidden="true"
>
  <div class="sc-body">
    <div class="lanes">
      <span class="lane-head auto">Automatycznie</span>
      <span class="lane-head team">Zespół</span>
      {tasks.map((task, i) => (
        <span
          class:list={["task", "is-done", task.auto ? "auto" : "team"]}
          style={`grid-row: ${i + 2}`}
          data-step
          data-value={i + 1}
        >
          {task.name}
        </span>
      ))}
    </div>
    <div class="sc-total">
      <span class="sc-total-label">Zadania z jasnym właścicielem</span>
      <span
        class="sc-total-value"
        data-total
        data-suffix={`\u00a0z\u00a0${tasks.length}`}
      >{`${tasks.length}\u00a0z\u00a0${tasks.length}`}</span>
    </div>
  </div>
</div>

<style>
  .lanes {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: clamp(0.75rem, 4cqi, 2rem);
  }

  .lane-head {
    grid-row: 1;
    padding-block-end: 0.5rem;
    font-size: 0.8125rem;
    font-weight: var(--font-weight-semibold);
    border-block-end: 2px solid var(--text-heading);
  }

  .lane-head.auto {
    color: var(--text-link);
    border-color: var(--color-secondary-60);
  }

  .lane-head.team {
    color: var(--text-heading);
  }

  .auto {
    grid-column: 1;
  }

  .team {
    grid-column: 2;
  }

  .task {
    padding-block: 0.55rem;
    color: var(--text-heading);
    border-block-end: 1px solid var(--border-hairline);
  }

  .task.auto {
    color: var(--text-link);
  }

  .task:not(.is-done) {
    opacity: 0;
    transform: translateY(6px);
  }

  @media (prefers-reduced-motion: no-preference) {
    .task {
      transition:
        opacity 630ms cubic-bezier(0.25, 1, 0.5, 1),
        transform 630ms cubic-bezier(0.25, 1, 0.5, 1);
    }
  }
</style>

<script>
  import "./sequence";
</script>
