---
// Ported from the Webflow embed #zw-auto-golive (automatyzacje-dla-pipedrive) by port/port-diagrams.mjs.
import './diagram.css';
/*
  Automations for Pipedrive — step 3: go live with the team
  (what runs itself vs. what stays with people)
  Self-contained Webflow embed. Transparent, play-once, responsive.
  Scope: zw-auto-golive
*/
---

<div class="dg" data-diagram="zw-auto-golive" aria-hidden="true" style="--dg-w: 400; --dg-h: 220;">
  <div class="zw-stage dg-stage"><div class="zw-fit dg-fit"><div class="zw-scene">
    <div class="ag-panel">
      <div class="ag-switch">
        <span class="ag-switch-txt">Live</span>
        <span class="ag-switch-track"><span class="ag-switch-knob"></span></span>
      </div>

      <div class="ag-lane ag-lane--auto">
        <span class="ag-lane-head">
          <span class="ag-lane-ico"><svg viewBox="0 0 24 24"><path d="M13 3L4 14h6l-1 7 9-11h-6z"/></svg></span>
          <b>Auto</b>
        </span>
        <span class="ag-row"><i></i><i></i><span class="ag-run"></span></span>
        <span class="ag-row"><i></i><i></i><span class="ag-run"></span></span>
      </div>

      <div class="ag-lane ag-lane--team">
        <span class="ag-lane-head">
          <span class="ag-lane-ico ag-lane-ico--team"><svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="3.4"/><path d="M5.6 19.4a6.4 6.4 0 0 1 12.8 0"/></svg></span>
          <b>Team</b>
        </span>
        <span class="ag-row"><i></i><i></i><span class="ag-hand">You</span></span>
        <span class="ag-row"><i></i><i></i><span class="ag-hand">You</span></span>
      </div>

      <span class="ag-live">
        <span class="ag-live-dot"></span>Live
        <i class="ag-live-ring"></i>
      </span>
    </div>
  </div></div></div>
</div>

<style is:global>
[data-diagram="zw-auto-golive"] {
    --zw-primary:#3A48CC; --zw-primary-10:#EBEDFA; --zw-primary-30:#8991E0;
    --zw-secondary:#0ACFFE; --zw-success:#52C41A; --zw-bg-soft:#F9FAFB;
    --zw-border:#DDE1E6; --zw-border-soft:#EDF0F3; --zw-heading:#0E0F11;
    --zw-text:#1E2024; --zw-muted:#838D95; --zw-card:#FFFFFF;
    --zw-font:'Satoshi Variable','Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,system-ui,sans-serif;
    --zw-serif:'Erode Variable','Fraunces','Source Serif 4',Georgia,serif;
    --zw-radius-card:10px; --zw-radius-lane:14px;
    --zw-shadow-rest:0 1px 3px rgba(0,0,0,.08);
    --zw-shadow-lift:1px 8px 22px rgba(14,15,17,.14);
    font-family:var(--zw-font); width:100%; max-width:440px; margin:0 auto;
    box-sizing:border-box; -webkit-font-smoothing:antialiased;
  }
  [data-diagram="zw-auto-golive"] *, [data-diagram="zw-auto-golive"] *::before, [data-diagram="zw-auto-golive"] *::after { box-sizing:border-box; }
  [data-diagram="zw-auto-golive"] .zw-stage { width:100%; overflow:hidden; }
  [data-diagram="zw-auto-golive"] .zw-fit { width:400px; transform-origin:top left; }
  [data-diagram="zw-auto-golive"] .zw-scene { position:relative; }
  [data-diagram="zw-auto-golive"] .zw-confetti { position:absolute; top:0; left:0; width:0; height:0; z-index:9; pointer-events:none; }
  [data-diagram="zw-auto-golive"] .zw-confetti i { position:absolute; width:8px; height:8px; border-radius:2px; will-change:transform,opacity; }

  /* =================== SCENE:STYLE start =================== */
  [data-diagram="zw-auto-golive"] .ag-panel {
    position:relative; width:360px; height:220px; margin:6px auto;
    background:var(--zw-bg-soft); border:1px solid var(--zw-border);
    border-radius:var(--zw-radius-lane); overflow:hidden;
  }
  [data-diagram="zw-auto-golive"] .ag-switch {
    position:absolute; top:17px; left:20px; display:flex; align-items:center; gap:9px; z-index:2;
  }
  [data-diagram="zw-auto-golive"] .ag-switch-txt {
    font-size:12px; font-weight:700; letter-spacing:.09em; text-transform:uppercase; color:var(--zw-muted);
    transition:color .35s ease;
  }
  [data-diagram="zw-auto-golive"] .ag-switch--on .ag-switch-txt { color:var(--zw-success); }
  [data-diagram="zw-auto-golive"] .ag-switch-track {
    position:relative; width:40px; height:22px; border-radius:999px;
    background:var(--zw-border); transition:background-color .35s ease;
  }
  [data-diagram="zw-auto-golive"] .ag-switch--on .ag-switch-track { background:var(--zw-success); }
  [data-diagram="zw-auto-golive"] .ag-switch-knob {
    position:absolute; top:3px; left:3px; width:16px; height:16px; border-radius:50%;
    background:#fff; box-shadow:var(--zw-shadow-rest); transition:transform .35s cubic-bezier(0.34,1.56,0.64,1);
  }
  [data-diagram="zw-auto-golive"] .ag-switch--on .ag-switch-knob { transform:translateX(18px); }

  [data-diagram="zw-auto-golive"] .ag-lane {
    position:absolute; top:56px; width:158px; height:110px; padding:12px;
    background:var(--zw-card); border:1px solid var(--zw-border);
    border-radius:var(--zw-radius-card); box-shadow:var(--zw-shadow-rest);
    z-index:1; opacity:0;
  }
  [data-diagram="zw-auto-golive"] .ag-lane--auto { left:20px; }
  [data-diagram="zw-auto-golive"] .ag-lane--team { left:182px; }
  [data-diagram="zw-auto-golive"] .ag-lane--live { border-color:var(--zw-primary-30); }
  [data-diagram="zw-auto-golive"] .ag-lane-head { display:flex; align-items:center; gap:8px; margin-bottom:12px; }
  [data-diagram="zw-auto-golive"] .ag-lane-ico {
    width:24px; height:24px; display:flex; align-items:center; justify-content:center; border-radius:7px;
    background:var(--zw-primary-10); color:var(--zw-primary); line-height:0;
  }
  [data-diagram="zw-auto-golive"] .ag-lane-ico svg { width:14px; height:14px; fill:none; stroke:currentColor; stroke-width:1.9; stroke-linecap:round; stroke-linejoin:round; }
  [data-diagram="zw-auto-golive"] .ag-lane-ico--team { background:var(--zw-border-soft); color:var(--zw-muted); }
  [data-diagram="zw-auto-golive"] .ag-lane-head b { font-size:11px; font-weight:800; letter-spacing:.05em; text-transform:uppercase; color:var(--zw-text); }
  [data-diagram="zw-auto-golive"] .ag-row { display:flex; align-items:center; gap:6px; margin-bottom:9px; }
  [data-diagram="zw-auto-golive"] .ag-row i { display:block; height:7px; border-radius:4px; background:var(--zw-border-soft); }
  [data-diagram="zw-auto-golive"] .ag-row i:first-child { width:44px; }
  [data-diagram="zw-auto-golive"] .ag-row i:nth-child(2) { width:26px; }
  [data-diagram="zw-auto-golive"] .ag-run {
    margin-left:auto; width:14px; height:14px; border-radius:50%;
    border:2px solid var(--zw-border); border-top-color:var(--zw-primary);
    opacity:0; will-change:transform;
  }
  [data-diagram="zw-auto-golive"] .ag-hand {
    margin-left:auto; padding:1px 7px; border-radius:999px; background:var(--zw-border-soft);
    color:var(--zw-muted); font-size:8px; font-weight:800; letter-spacing:.05em; text-transform:uppercase;
  }
  [data-diagram="zw-auto-golive"] .ag-live {
    position:absolute; left:50%; bottom:14px; transform:translateX(-50%) translateY(8px);
    display:inline-flex; align-items:center; gap:6px; padding:5px 12px;
    border-radius:999px; background:var(--zw-card); border:1px solid var(--zw-success);
    box-shadow:var(--zw-shadow-rest); color:var(--zw-success);
    font-size:11px; font-weight:800; letter-spacing:.06em; text-transform:uppercase;
    opacity:0; z-index:5;
  }
  [data-diagram="zw-auto-golive"] .ag-live-dot { width:8px; height:8px; border-radius:50%; background:var(--zw-success); }
  [data-diagram="zw-auto-golive"] .ag-live-ring {
    position:absolute; inset:-1px; border:2px solid var(--zw-success); border-radius:999px;
    opacity:0; pointer-events:none;
  }
  /* ==================== SCENE:STYLE end ==================== */

  @media (prefers-reduced-motion:reduce) {
    [data-diagram="zw-auto-golive"] .ag-switch { }
    [data-diagram="zw-auto-golive"] .ag-switch-txt { color:var(--zw-success); }
    [data-diagram="zw-auto-golive"] .ag-switch-track { background:var(--zw-success); }
    [data-diagram="zw-auto-golive"] .ag-switch-knob { transform:translateX(18px); }
    [data-diagram="zw-auto-golive"] .ag-lane { opacity:1; }
    [data-diagram="zw-auto-golive"] .ag-lane--auto { border-color:var(--zw-primary-30); }
    [data-diagram="zw-auto-golive"] .ag-lane--auto .ag-run { opacity:1; }
    [data-diagram="zw-auto-golive"] .ag-live { opacity:1; transform:translateX(-50%) translateY(0); }
  }
</style>

<script>
  // @ts-nocheck
  for (const root of document.querySelectorAll('[data-diagram="zw-auto-golive"]')) {
(function(){
  if(!root||root.dataset.zwInit)return; root.dataset.zwInit='1';
  var DESIGN_W=400, stage=root.querySelector('.zw-stage'), fitEl=root.querySelector('.zw-fit'), scene=root.querySelector('.zw-scene');
  var reduce=window.matchMedia&&window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var EASE_MOVE='cubic-bezier(0.645, 0.045, 0.355, 1)', EASE_OUT='cubic-bezier(0.22, 1, 0.36, 1)', EASE_POP='cubic-bezier(0.34, 1.56, 0.64, 1)';
  function wait(ms){return new Promise(function(r){setTimeout(r,ms);});}
  function settled(a){return a.finished.catch(function(){});}
  function fit(){}

  function spin(el){
    el.animate([{transform:'rotate(0deg)'},{transform:'rotate(360deg)'}],{duration:1100,iterations:Infinity,easing:'linear'});
  }

  async function play(){
    fit(); if(reduce)return;
    var lanes=Array.prototype.slice.call(scene.querySelectorAll('.ag-lane'));
    var sw=scene.querySelector('.ag-switch');
    var autoLane=scene.querySelector('.ag-lane--auto');
    var runs=Array.prototype.slice.call(autoLane.querySelectorAll('.ag-run'));

    // 1. Two lanes rise: Auto and Team.
    lanes.forEach(function(l,i){
      l.animate([{opacity:0,transform:'translateY(12px)'},{opacity:1,transform:'translateY(0)'}],{duration:440,delay:i*120,easing:EASE_OUT,fill:'forwards'});
      l.style.opacity=1;
    });
    await wait(760);

    // 2. Flip the switch to Live.
    sw.classList.add('ag-switch--on');
    await wait(520);

    // 3. Auto lane starts running by itself; team lane keeps its people.
    autoLane.classList.add('ag-lane--live');
    runs.forEach(function(r,i){
      setTimeout(function(){ r.style.opacity=1; spin(r); }, i*160);
    });
    await wait(720);

    // 4. Live pill + calm ring pulse.
    var live=scene.querySelector('.ag-live'), ring=scene.querySelector('.ag-live-ring');
    live.animate([{opacity:0,transform:'translateX(-50%) translateY(8px)'},{opacity:1,transform:'translateX(-50%) translateY(0)'}],{duration:380,easing:EASE_POP,fill:'forwards'});
    live.style.opacity=1; live.style.transform='translateX(-50%) translateY(0)';
    await wait(120);
    ring.animate([{opacity:.7,transform:'scale(1)'},{opacity:0,transform:'scale(1.25)'}],{duration:820,easing:EASE_OUT,fill:'forwards'});
  }
  fit(); if('ResizeObserver'in window)new ResizeObserver(fit).observe(stage);else window.addEventListener('resize',fit);
  function arm(){if(!('IntersectionObserver'in window)){play();return;}var io=new IntersectionObserver(function(entries){entries.forEach(function(e){if(e.isIntersecting){io.disconnect();requestAnimationFrame(function(){requestAnimationFrame(play);});}});},{threshold:.4});io.observe(root);}
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',arm);else arm();
})();
  }
</script>
