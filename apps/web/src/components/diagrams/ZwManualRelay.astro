---
// Rebuilt in the calm scene style by T92; port-diagrams.mjs no longer writes this file.
// The apps are not connected, so the salesperson carries one enquiry across
// every gap and each hand-off adds waiting time. It ends on the loss, not a win.
// The markup is the end state. The times are placeholders.
import "./scene/scene.css";

const apps = [
  { name: "E-mail", what: "zapytanie klienta" },
  { name: "Cennik", what: "wycena" },
  { name: "CRM", what: "wpis szansy" },
  { name: "AI", what: "szkic oferty" },
];
const gaps = [
  { wait: "+2 h", sum: "2 h" },
  { wait: "+1 dzień", sum: "1 dzień 2 h" },
  { wait: "+3 h", sum: "1 dzień 5 h" },
];
const last = apps.length - 1;
---

<div class="sc" data-diagram="zw-manual-relay" aria-hidden="true">
  <div class="sc-body">
    <ol class="track">
      {apps.map((app, i) => (
        <>
          <li class="app">
            <span class:list={["ring", { "is-here": i === last }]} />
            <span class="name">{app.name}</span>
            <span class="what">{app.what}</span>
          </li>
          {gaps[i] && (
            <li class="gap is-slow" data-sum={gaps[i].sum}>
              <span class="wait">{gaps[i].wait}</span>
            </li>
          )}
        </>
      ))}
    </ol>
    <span class="carrier"></span>
    <div class="sc-total">
      <span class="sc-total-label">Czekanie przy jednej ofercie</span>
      <span class="sc-total-value is-loss" data-total>
        {gaps[gaps.length - 1].sum}
      </span>
    </div>
  </div>
</div>

<style>
  .track {
    display: flex;
    align-items: flex-start;
    isolation: isolate;
  }

  .app {
    display: grid;
    flex: none;
    gap: 0.6rem;
    justify-items: center;
    inline-size: clamp(3.25rem, 17cqi, 7rem);
    text-align: center;
  }

  .ring {
    position: relative;
    inline-size: 1.125rem;
    block-size: 1.125rem;
    margin-block-start: 1.9rem;
    background: var(--surface-page);
    border: 1.5px solid var(--text-heading);
    border-radius: 50%;
  }

  .ring.is-here::after {
    content: "";
    position: absolute;
    inset: 3px;
    background: var(--text-link);
    border-radius: 50%;
  }

  .name {
    color: var(--text-heading);
    font-weight: var(--font-weight-semibold);
  }

  .what {
    color: var(--text-muted);
    font-size: 0.8125rem;
    text-wrap: balance;
  }

  .gap {
    position: relative;
    flex: 1;
    min-inline-size: 1.5rem;
    block-size: 3.1rem;
  }

  .gap::after {
    content: "";
    position: absolute;
    z-index: -1;
    inset-inline: -1.6rem;
    inset-block-start: calc(1.9rem + 0.5625rem);
    border-block-start: 1.5px dashed var(--border-default);
  }

  .gap.is-slow::after {
    border-color: var(--color-status-error);
  }

  .wait {
    position: absolute;
    inset-inline: -2rem;
    inset-block-start: 0;
    color: var(--text-error);
    font-weight: var(--font-weight-semibold);
    text-align: center;
    white-space: nowrap;
  }

  .carrier {
    position: absolute;
    inset-block-start: 0;
    inset-inline-start: 0;
    inline-size: 0.625rem;
    block-size: 0.625rem;
    pointer-events: none;
    visibility: hidden;
    background: var(--text-link);
    border-radius: 50%;
  }

  @container (inline-size < 30rem) {
    .what {
      display: none;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .gap::after {
      transition: border-color 630ms ease;
    }
  }
</style>

<script>
  import { DURATION, EASE_MOVE, offset, stage } from "./scene/timeline";

  stage("zw-manual-relay", (root, t) => {
    const body = root.querySelector<HTMLElement>(".sc-body")!;
    const rings = [...root.querySelectorAll<HTMLElement>(".ring")];
    const gaps = [...root.querySelectorAll<HTMLElement>(".gap")];
    const waits = gaps.map((gap) => gap.querySelector<HTMLElement>(".wait")!);
    const carrier = root.querySelector<HTMLElement>(".carrier")!;
    const total = root.querySelector<HTMLElement>("[data-total]")!;

    const centre = (ring: HTMLElement) => {
      const box = offset(ring, body);
      const size = carrier.offsetWidth;
      return `translate(${box.x + (box.w - size) / 2}px, ${box.y + (box.h - size) / 2}px)`;
    };
    const mark = (at: number) =>
      rings.forEach((ring, i) => ring.classList.toggle("is-here", i === at));

    return {
      rewind() {
        mark(0);
        gaps.forEach((gap) => gap.classList.remove("is-slow"));
        waits.forEach((wait) => wait.classList.add("sc-pending"));
        total.textContent = "0 h";
      },
      async play() {
        for (let i = 0; i < gaps.length; i++) {
          await t.wait(680);
          gaps[i].classList.add("is-slow");
          total.textContent = gaps[i].dataset.sum ?? "";
          await t.enter(waits[i]);
          await t.wait(580);
          const from = centre(rings[i]);
          const to = centre(rings[i + 1]);
          mark(-1);
          carrier.style.visibility = "visible";
          await t.animate(
            carrier,
            [{ transform: from }, { transform: to }],
            DURATION.travel + 140,
            EASE_MOVE,
          );
          carrier.style.visibility = "";
          mark(i + 1);
        }
      },
    };
  });
</script>
