---
// Ported from the Webflow embed #zw-manual-relay (index) by port/port-diagrams.mjs.
import './diagram.css';
/*
  PROBLEM — "Apps don't cooperate, so the salesperson is the integration"
  zawlodzki.pl · self-contained, no external dependencies.

  Metaphor: four disconnected apps (Email, Pricebook, CRM, AI) with
  BROKEN dashed connectors between them. A human (the salesperson) is
  the only link — carrying one piece of work across every gap by hand,
  each hop slowed by a delay tick. It ends on friction, not a win:
  work piles up on the person and the links stay broken. No confetti —
  this is the agitation section; the solution animations celebrate.
*/
---

<div class="dg" data-diagram="zw-manual-relay" aria-hidden="true" style="--dg-w: 760; --dg-h: 258;">
  <div class="zw-stage dg-stage">
    <div class="zw-fit dg-fit">
      <div class="zw-scene">
        <div class="mr-board">
          <div class="mr-apps">
            <div class="mr-app" data-app="0">
              <span class="mr-tick"><span class="mr-tick-ico">
                <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/></svg>
              </span><span class="mr-tick-txt">&plus;2h</span></span>
              <span class="mr-app-icon">
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3.6 7l8.4 6 8.4-6"/></svg>
              </span>
              <span class="mr-app-label">Email</span>
            </div>

            <div class="mr-gap"><span class="mr-break">
              <svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M7 7l10 10M17 7L7 17"/></svg>
            </span></div>

            <div class="mr-app" data-app="1">
              <span class="mr-tick"><span class="mr-tick-ico">
                <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/></svg>
              </span><span class="mr-tick-txt">&plus;1d</span></span>
              <span class="mr-app-icon">
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M20.6 13.4l-7.2 7.2a2 2 0 0 1-2.8 0L3.8 13.6V4H13z"/><circle cx="7.7" cy="7.7" r="1.3"/></svg>
              </span>
              <span class="mr-app-label">Pricebook</span>
            </div>

            <div class="mr-gap"><span class="mr-break">
              <svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M7 7l10 10M17 7L7 17"/></svg>
            </span></div>

            <div class="mr-app" data-app="2">
              <span class="mr-tick"><span class="mr-tick-ico">
                <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/></svg>
              </span><span class="mr-tick-txt">&plus;4h</span></span>
              <span class="mr-app-icon">
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3.2" y="4" width="4.6" height="16" rx="1.2"/><rect x="9.7" y="4" width="4.6" height="11" rx="1.2"/><rect x="16.2" y="4" width="4.6" height="13" rx="1.2"/></svg>
              </span>
              <span class="mr-app-label">CRM</span>
            </div>

            <div class="mr-gap"><span class="mr-break">
              <svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M7 7l10 10M17 7L7 17"/></svg>
            </span></div>

            <div class="mr-app" data-app="3">
              <span class="mr-tick"><span class="mr-tick-ico">
                <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/></svg>
              </span><span class="mr-tick-txt">&plus;2h</span></span>
              <span class="mr-app-icon">
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3.2l1.7 4.9 4.9 1.7-4.9 1.7L12 16.4l-1.7-4.9L5.4 9.8l4.9-1.7z"/><path d="M18.6 15.4l.6 1.8 1.8.6-1.8.6-.6 1.8-.6-1.8-1.8-.6 1.8-.6z"/></svg>
              </span>
              <span class="mr-app-label">AI</span>
            </div>
          </div>

          <div class="mr-worker">
            <span class="mr-avatar">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="3.4"/><path d="M5.6 19.4a6.4 6.4 0 0 1 12.8 0"/></svg>
            </span>
            <span class="mr-carry">
              <span class="mr-stack-card"></span>
              <span class="mr-stack-card"></span>
              <span class="mr-stack-card"></span>
              <span class="mr-packet">
                <span class="mr-packet-line"></span>
                <span class="mr-packet-line"></span>
              </span>
            </span>
            <span class="mr-manual-tag">Manual</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style is:global>
/* ---- Shared family layer: tokens + responsive shell (verbatim). ---- */
  [data-diagram="zw-manual-relay"] {
    --zw-primary:    #3A48CC;   /* brand — CTA / accent / active state   */
    --zw-primary-10: #EBEDFA;   /* primary tint — soft fills             */
    --zw-primary-30: #8991E0;
    --zw-secondary:  #0ACFFE;   /* cyan accent                           */
    --zw-success:    #52C41A;   /* win / resolved                        */
    --zw-bg-soft:    #F9FAFB;   /* lane / track surface                  */
    --zw-border:     #DDE1E6;   /* base border                           */
    --zw-border-soft:#EDF0F3;
    --zw-heading:    #0E0F11;   /* headings / values                     */
    --zw-text:       #1E2024;
    --zw-muted:      #838D95;   /* eyebrow / metadata                    */
    --zw-card:       #FFFFFF;
    --zw-font: 'Satoshi Variable','Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,system-ui,sans-serif;
    --zw-serif: 'Erode Variable','Fraunces','Source Serif 4',Georgia,serif;
    --zw-radius-card: 10px;
    --zw-radius-lane: 14px;
    --zw-shadow-rest: 0 1px 3px rgba(0,0,0,.08);
    --zw-shadow-lift: 1px 8px 22px rgba(14,15,17,.14);
    /* warm accent — the one sanctioned off-brand hue (confetti's #FFC53D);
       here it carries "delay / friction" on this problem-section scene. */
    --zw-warn:       #B8860B;
    --zw-warn-10:    rgba(255,197,61,.18);

    font-family: var(--zw-font);
    width: 100%;
    max-width: 920px;
    margin: 0 auto;
    box-sizing: border-box;
    -webkit-font-smoothing: antialiased;
  }
  [data-diagram="zw-manual-relay"] *, [data-diagram="zw-manual-relay"] *::before, [data-diagram="zw-manual-relay"] *::after { box-sizing: border-box; }

  [data-diagram="zw-manual-relay"] .zw-stage { width: 100%; overflow: hidden; }
  [data-diagram="zw-manual-relay"] .zw-fit   { width: 760px; transform-origin: top left; }
  [data-diagram="zw-manual-relay"] .zw-scene { position: relative; }

  /* Confetti (shared helper — unused by this scene, kept for family parity) */
  [data-diagram="zw-manual-relay"] .zw-confetti { position: absolute; top: 0; left: 0; width: 0; height: 0; z-index: 9; pointer-events: none; }
  [data-diagram="zw-manual-relay"] .zw-confetti i { position: absolute; width: 8px; height: 8px; border-radius: 2px; will-change: transform, opacity; }

  /* =================== SCENE:STYLE start =================== */
  /* Reserve headroom for delay ticks (top) and the worker/backlog (bottom). */
  [data-diagram="zw-manual-relay"] .mr-board { position: relative; padding: 46px 0 120px; }

  /* ---- The disconnected app row ---- */
  [data-diagram="zw-manual-relay"] .mr-apps {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0;
  }
  [data-diagram="zw-manual-relay"] .mr-app {
    position: relative;
    flex: 0 0 auto;
    width: 150px;
    min-height: 92px;
    background: var(--zw-bg-soft);
    border: 1px solid var(--zw-border);
    border-radius: var(--zw-radius-lane);
    padding: 16px 14px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    opacity: 0;                       /* revealed on play */
    transform: translateY(14px);
    transition: background-color .35s ease, border-color .35s ease;
  }
  [data-diagram="zw-manual-relay"] .mr-app--active {
    background: var(--zw-primary-10);
    border-color: var(--zw-primary-30);
  }
  [data-diagram="zw-manual-relay"] .mr-app-icon { color: var(--zw-primary); line-height: 0; }
  [data-diagram="zw-manual-relay"] .mr-app-label {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: .06em;
    text-transform: uppercase;
    color: var(--zw-muted);
  }

  /* ---- Delay tick above an app ---- */
  [data-diagram="zw-manual-relay"] .mr-tick {
    position: absolute;
    top: -28px;
    left: 50%;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 3px 8px 3px 6px;
    border-radius: 999px;
    background: var(--zw-warn-10);
    color: var(--zw-warn);
    font-size: 11px;
    font-weight: 700;
    white-space: nowrap;
    opacity: 0;
    transform: translateX(-50%) translateY(6px) scale(.9);
    will-change: transform, opacity;
  }
  [data-diagram="zw-manual-relay"] .mr-tick-ico { line-height: 0; }

  /* ---- Broken connector between two apps ---- */
  [data-diagram="zw-manual-relay"] .mr-gap {
    flex: 0 0 auto;
    width: 46px;
    height: 26px;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;                       /* revealed on play */
  }
  [data-diagram="zw-manual-relay"] .mr-gap::before {
    content: "";
    position: absolute;
    left: 2px; right: 2px;
    top: 50%;
    border-top: 2px dashed var(--zw-border);
    transition: border-color .35s ease;
  }
  [data-diagram="zw-manual-relay"] .mr-break {
    position: relative;
    z-index: 1;
    width: 20px; height: 20px;
    border-radius: 50%;
    background: var(--zw-card);
    border: 1.5px solid var(--zw-border);
    color: var(--zw-muted);
    display: flex; align-items: center; justify-content: center;
    transition: border-color .35s ease, color .35s ease;
    will-change: transform;
  }
  [data-diagram="zw-manual-relay"] .mr-gap--broken::before { border-top-color: var(--zw-warn); }
  [data-diagram="zw-manual-relay"] .mr-gap--broken .mr-break { border-color: var(--zw-warn); color: var(--zw-warn); }

  /* ---- The human carrier (mover) ---- */
  [data-diagram="zw-manual-relay"] .mr-worker {
    position: absolute;
    top: 0; left: 0;
    width: 150px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    opacity: 0;
    will-change: transform;
  }
  [data-diagram="zw-manual-relay"] .mr-avatar {
    flex: 0 0 auto;
    width: 40px; height: 40px;
    border-radius: 50%;
    background: var(--zw-primary-10);
    color: var(--zw-primary);
    display: flex; align-items: center; justify-content: center;
    box-shadow: var(--zw-shadow-rest);
  }
  [data-diagram="zw-manual-relay"] .mr-carry {
    position: relative;
    width: 90px; height: 46px;
    will-change: transform;
  }
  [data-diagram="zw-manual-relay"] .mr-packet {
    position: absolute;
    inset: 0;
    z-index: 4;
    background: var(--zw-card);
    border: 1px solid var(--zw-border);
    border-radius: var(--zw-radius-card);
    box-shadow: var(--zw-shadow-rest);
    padding: 12px 12px 12px 14px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 7px;
    overflow: hidden;
  }
  [data-diagram="zw-manual-relay"] .mr-packet::before {
    content: "";
    position: absolute;
    left: 0; top: 0; bottom: 0;
    width: 3px;
    background: var(--zw-primary);
  }
  [data-diagram="zw-manual-relay"] .mr-packet-line { display: block; height: 7px; border-radius: 4px; background: #EAEDF1; }
  [data-diagram="zw-manual-relay"] .mr-packet-line:first-child { width: 66%; }
  [data-diagram="zw-manual-relay"] .mr-packet-line:last-child  { width: 40%; background: #F0F2F5; }

  /* Backlog fan — pending work stacking up on the human at the end */
  [data-diagram="zw-manual-relay"] .mr-stack-card {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: var(--zw-card);
    border: 1px solid var(--zw-border-soft);
    border-radius: var(--zw-radius-card);
    box-shadow: var(--zw-shadow-rest);
    opacity: 0;
    transform-origin: 60% 100%;
    will-change: transform, opacity;
  }

  /* "Manual" tag that drops in on the friction beat */
  [data-diagram="zw-manual-relay"] .mr-manual-tag {
    position: absolute;
    top: -26px;
    left: 50%;
    transform: translateX(-50%) translateY(8px);
    padding: 3px 9px;
    border-radius: 6px;
    background: var(--zw-warn-10);
    color: var(--zw-warn);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
    white-space: nowrap;
    opacity: 0;
    will-change: transform, opacity;
  }
  /* ==================== SCENE:STYLE end ==================== */

  /* Accessibility: land on the resolved friction frame, no motion.
     Every animated scene element is listed here. */
  @media (prefers-reduced-motion: reduce) {
    [data-diagram="zw-manual-relay"] .mr-app { opacity: 1; transform: none; transition: none; }
    [data-diagram="zw-manual-relay"] .mr-gap { opacity: 1; }
    [data-diagram="zw-manual-relay"] .mr-gap::before, [data-diagram="zw-manual-relay"] .mr-break { transition: none; }
    [data-diagram="zw-manual-relay"] .mr-tick,
    [data-diagram="zw-manual-relay"] .mr-worker,
    [data-diagram="zw-manual-relay"] .mr-carry,
    [data-diagram="zw-manual-relay"] .mr-stack-card,
    [data-diagram="zw-manual-relay"] .mr-manual-tag { transition: none; }
  }
</style>

<script>
  // @ts-nocheck
  for (const root of document.querySelectorAll('[data-diagram="zw-manual-relay"]')) {
(function () {
  if (!root || root.dataset.zwInit) return;   /* guard against double-init */
  root.dataset.zwInit = '1';

  var DESIGN_W = 760;   /* design-space width; the shell scales it to fit */

  var stage   = root.querySelector('.zw-stage');
  var fitEl   = root.querySelector('.zw-fit');
  var scene   = root.querySelector('.zw-scene');

  var board   = root.querySelector('.mr-board');
  var appsRow = root.querySelector('.mr-apps');
  var apps    = Array.prototype.slice.call(root.querySelectorAll('.mr-app'));
  var gaps    = Array.prototype.slice.call(root.querySelectorAll('.mr-gap'));
  var worker  = root.querySelector('.mr-worker');
  var carry   = root.querySelector('.mr-carry');
  var stacks  = Array.prototype.slice.call(root.querySelectorAll('.mr-stack-card'));
  var manualTag = root.querySelector('.mr-manual-tag');

  var WORKER_W = 150;   /* .mr-worker fixed width — half is the carry offset */

  var reduce = window.matchMedia &&
               window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* Shared motion vocabulary — same eases/feel for every animation. */
  var EASE_MOVE = 'cubic-bezier(0.645, 0.045, 0.355, 1)';
  var EASE_OUT  = 'cubic-bezier(0.22, 1, 0.36, 1)';
  var EASE_POP  = 'cubic-bezier(0.34, 1.56, 0.64, 1)';

  function wait(ms) { return new Promise(function (r) { setTimeout(r, ms); }); }
  function settled(anim) { return anim.finished.catch(function () {}); }

  /* Scale the fixed-width scene to its container and center it. */
  function fit(){}

  /* Confetti — shared helper, unused here (friction ending). Kept for parity. */
  function confetti(at) {
    var box = document.createElement('div');
    box.className = 'zw-confetti';
    var x, y;
    if (at && at.nodeType) { x = at.offsetLeft + at.offsetWidth / 2; y = at.offsetTop + at.offsetHeight / 2; }
    else { x = (at && at.x) || scene.offsetWidth / 2; y = (at && at.y) || scene.offsetHeight / 2; }
    box.style.left = x + 'px'; box.style.top = y + 'px';
    scene.appendChild(box);
    var colors = ['#3A48CC', '#0ACFFE', '#52C41A', '#8991E0', '#FFC53D'];
    for (var i = 0; i < 46; i++) {
      var p = document.createElement('i');
      p.style.background = colors[i % colors.length];
      if (i % 3 === 0) p.style.borderRadius = '50%';
      box.appendChild(p);
      var ang = (Math.PI * 2 * i) / 46 + (Math.random() - 0.5) * 0.5;
      var dist = 70 + Math.random() * 120;
      var dx = Math.cos(ang) * dist, dy = Math.sin(ang) * dist - 60;
      var rot = (Math.random() - 0.5) * 720;
      p.animate(
        [{ transform: 'translate(0,0) rotate(0) scale(1)', opacity: 1 },
         { transform: 'translate(' + dx + 'px,' + dy + 'px) rotate(' + rot + 'deg) scale(.4)', opacity: 0 }],
        { duration: 900 + Math.random() * 500, easing: 'cubic-bezier(0.18, 0.7, 0.3, 1)', fill: 'forwards' }
      );
    }
    setTimeout(function () { box.remove(); }, 1800);
  }

  /* =================== SCENE:LOGIC start =================== */
  /* Measure app centres and the worker track in board-space (post-fit). */
  function centers() { return apps.map(function (a) { return a.offsetLeft + a.offsetWidth / 2; }); }
  function workerY()  { return appsRow.offsetTop + appsRow.offsetHeight + 30; }
  function workerT(cx, y) { return 'translate(' + (cx - WORKER_W / 2) + 'px,' + y + 'px)'; }
  function setWorker(cx, y) { worker.style.transform = workerT(cx, y); }

  function highlightApp(i, on) { apps[i].classList.toggle('mr-app--active', on); }

  function popTick(i) {
    var tick = apps[i].querySelector('.mr-tick');
    tick.animate(
      [{ opacity: 0, transform: 'translateX(-50%) translateY(6px) scale(.9)' },
       { opacity: 1, transform: 'translateX(-50%) translateY(0) scale(1)' }],
      { duration: 340, easing: EASE_POP, fill: 'forwards' }
    );
    tick.style.opacity = 1;
  }

  function breakGap(g) {
    g.classList.add('mr-gap--broken');
    g.querySelector('.mr-break').animate(
      [{ transform: 'scale(1)' }, { transform: 'scale(1.35)' }, { transform: 'scale(1)' }],
      { duration: 520, easing: EASE_POP }
    );
  }

  /* Backlog fan — pending work piling to the lower-right of the carried card
     (clear of the avatar), so it reads as a growing manual queue. */
  var STACK_TO = [
    'translate(14px,10px) rotate(7deg)',
    'translate(27px,20px) rotate(13deg)',
    'translate(40px,30px) rotate(19deg)'
  ];
  function revealStack(i) {
    stacks[i].animate(
      [{ opacity: 0, transform: 'translate(0,0) rotate(0)' },
       { opacity: .96, transform: STACK_TO[i] }],
      { duration: 300, easing: EASE_OUT, fill: 'forwards' }
    );
    stacks[i].style.opacity = .96;
    stacks[i].style.transform = STACK_TO[i];
  }

  function dropManualTag() {
    manualTag.animate(
      [{ opacity: 0, transform: 'translateX(-50%) translateY(8px)' },
       { opacity: 1, transform: 'translateX(-50%) translateY(0)' }],
      { duration: 320, easing: EASE_OUT, fill: 'forwards' }
    );
    manualTag.style.opacity = 1;
  }

  /* Resolved friction frame (reduced-motion / fallback): every app touched
     (all delays showing), links broken, the human stuck in the middle with a
     pile of manual work. */
  function showFinal() {
    fit();
    apps.forEach(function (a) {
      a.style.opacity = 1; a.style.transform = 'none';
      var t = a.querySelector('.mr-tick');
      t.style.opacity = 1; t.style.transform = 'translateX(-50%) translateY(0) scale(1)';
    });
    gaps.forEach(function (g) { g.style.opacity = 1; g.classList.add('mr-gap--broken'); });
    setWorker(board.clientWidth / 2, workerY());
    worker.style.opacity = 1;
    stacks.forEach(function (s, i) { s.style.opacity = .96; s.style.transform = STACK_TO[i]; });
    manualTag.style.opacity = 1;
    manualTag.style.transform = 'translateX(-50%) translateY(0)';
  }

  async function play() {
    fit();
    if (reduce) { showFinal(); return; }

    // 1. Apps rise in, left to right; broken connectors fade in between them.
    apps.forEach(function (a, i) {
      a.animate(
        [{ opacity: 0, transform: 'translateY(14px)' }, { opacity: 1, transform: 'translateY(0)' }],
        { duration: 460, delay: i * 90, easing: EASE_OUT, fill: 'forwards' }
      );
    });
    gaps.forEach(function (g, i) {
      g.animate([{ opacity: 0 }, { opacity: 1 }],
        { duration: 340, delay: 220 + i * 90, easing: EASE_OUT, fill: 'forwards' });
      g.style.opacity = 1;
    });
    await wait(760);

    var cx = centers(), wy = workerY();

    // 2. The human appears at the first app, already holding the work.
    setWorker(cx[0], wy);
    highlightApp(0, true);
    await settled(worker.animate([{ opacity: 0 }, { opacity: 1 }],
      { duration: 320, easing: EASE_OUT, fill: 'forwards' }));
    worker.style.opacity = 1;
    await settled(carry.animate([{ transform: 'scale(.94)' }, { transform: 'scale(1)' }],
      { duration: 300, easing: EASE_OUT, fill: 'forwards' }));
    carry.style.transform = 'scale(1)';
    popTick(0);
    await wait(560);
    highlightApp(0, false);

    // 3. Carry the same work across every broken gap, by hand, one hop at a
    //    time — the lift -> travel -> settle move, deliberately slow.
    for (var i = 1; i < apps.length; i++) {
      highlightApp(i, true);

      // lift
      carry.animate(
        [{ transform: 'scale(1)', boxShadow: 'var(--zw-shadow-rest)' },
         { transform: 'scale(1.05)', boxShadow: 'var(--zw-shadow-lift)' }],
        { duration: 180, easing: EASE_OUT, fill: 'forwards' }
      );
      carry.style.transform = 'scale(1.05)';
      await wait(150);

      // travel with a gentle upward arc
      await settled(worker.animate(
        [{ transform: workerT(cx[i - 1], wy) },
         { transform: workerT((cx[i - 1] + cx[i]) / 2, wy - 18), offset: 0.5 },
         { transform: workerT(cx[i], wy) }],
        { duration: 720, easing: EASE_MOVE, fill: 'forwards' }
      ));
      setWorker(cx[i], wy);

      // settle
      carry.animate(
        [{ transform: 'scale(1.05)', boxShadow: 'var(--zw-shadow-lift)' },
         { transform: 'scale(1)', boxShadow: 'var(--zw-shadow-rest)' }],
        { duration: 220, easing: EASE_OUT, fill: 'forwards' }
      );
      carry.style.transform = 'scale(1)';
      popTick(i);
      await wait(150);
      highlightApp(i, false);
      await wait(470);
    }

    // 4. The human trudges back to the middle, still holding everything —
    //    the work never left their hands.
    var midX = board.clientWidth / 2;
    await wait(220);
    await settled(worker.animate(
      [{ transform: workerT(cx[apps.length - 1], wy) },
       { transform: workerT((cx[apps.length - 1] + midX) / 2, wy - 14), offset: 0.5 },
       { transform: workerT(midX, wy) }],
      { duration: 680, easing: EASE_MOVE, fill: 'forwards' }
    ));
    setWorker(midX, wy);

    // 5. Friction beat (no win): the manual backlog piles up, "Manual" tag
    //    drops, every link pulses broken.
    await wait(180);
    for (var s = 0; s < stacks.length; s++) {
      revealStack(s);
      await wait(140);
    }
    await wait(120);
    dropManualTag();
    gaps.forEach(function (g, i) { setTimeout(function () { breakGap(g); }, i * 100); });
  }
  /* ==================== SCENE:LOGIC end ==================== */

  /* Shared lifecycle: keep scaled, play exactly once on view, never reset. */
  fit();
  if ('ResizeObserver' in window) { new ResizeObserver(fit).observe(stage); }
  else { window.addEventListener('resize', fit); }

  function arm() {
    if (!('IntersectionObserver' in window)) { play(); return; }
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (e.isIntersecting) {
          io.disconnect();
          requestAnimationFrame(function () { requestAnimationFrame(play); });
        }
      });
    }, { threshold: 0.4 });
    io.observe(root);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', arm);
  } else {
    arm();
  }
})();
  }
</script>
