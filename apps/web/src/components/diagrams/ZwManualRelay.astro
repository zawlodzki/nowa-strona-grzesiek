---
// Rebuilt in the calm scene style by T92; port-diagrams.mjs no longer writes this file.
// The apps are not connected, so the salesperson carries one enquiry across
// every gap and each hand-off adds waiting time. It ends on the loss, not a win.
// The markup is the end state. The times are placeholders.
import "./scene/scene.css";

const apps = [
  { name: "E-mail", what: "zapytanie klienta" },
  { name: "Cennik", what: "wycena" },
  { name: "CRM", what: "wpis szansy" },
  { name: "AI", what: "szkic oferty" },
];
const gaps = [
  { wait: "+2 h", sum: "2 h" },
  { wait: "+1 dzień", sum: "1 dzień 2 h" },
  { wait: "+3 h", sum: "1 dzień 5 h" },
];
const last = apps.length - 1;
---

<div class="sc" data-diagram="zw-manual-relay" aria-hidden="true">
  <div class="sc-body">
    <ol class="sc-track">
      {apps.map((app, i) => (
        <>
          <li class="sc-step">
            <span class:list={["sc-ring", { "is-here": i === last }]} />
            <span class="sc-step-name">{app.name}</span>
            <span class="sc-step-what">{app.what}</span>
          </li>
          {gaps[i] && (
            <li class="sc-link is-slow" data-sum={gaps[i].sum}>
              <span class="sc-link-label">{gaps[i].wait}</span>
            </li>
          )}
        </>
      ))}
    </ol>
    <span class="carrier"></span>
    <div class="sc-total">
      <span class="sc-total-label">Czekanie przy jednej ofercie</span>
      <span class="sc-total-value is-loss" data-total>
        {gaps[gaps.length - 1].sum}
      </span>
    </div>
  </div>
</div>

<style>
  .sc-link {
    --sc-link-style: dashed;
  }

  .sc-link.is-slow {
    --sc-link-color: var(--color-status-error);
  }

  .sc-link-label {
    color: var(--text-error);
  }

  @media (prefers-reduced-motion: no-preference) {
    .sc-link::after {
      transition: border-color 630ms ease;
    }
  }

  .carrier {
    position: absolute;
    inset-block-start: 0;
    inset-inline-start: 0;
    inline-size: 0.625rem;
    block-size: 0.625rem;
    pointer-events: none;
    visibility: hidden;
    background: var(--text-link);
    border-radius: 50%;
  }
</style>

<script>
  import { DURATION, EASE_MOVE, offset, stage } from "./scene/timeline";

  stage("zw-manual-relay", (root, t) => {
    const body = root.querySelector<HTMLElement>(".sc-body")!;
    const rings = [...root.querySelectorAll<HTMLElement>(".sc-ring")];
    const gaps = [...root.querySelectorAll<HTMLElement>(".sc-link")];
    const waits = gaps.map((gap) =>
      gap.querySelector<HTMLElement>(".sc-link-label")!,
    );
    const carrier = root.querySelector<HTMLElement>(".carrier")!;
    const total = root.querySelector<HTMLElement>("[data-total]")!;

    const centre = (ring: HTMLElement) => {
      const box = offset(ring, body);
      const size = carrier.offsetWidth;
      return `translate(${box.x + (box.w - size) / 2}px, ${box.y + (box.h - size) / 2}px)`;
    };
    const mark = (at: number) =>
      rings.forEach((ring, i) => ring.classList.toggle("is-here", i === at));

    return {
      rewind() {
        mark(0);
        gaps.forEach((gap) => gap.classList.remove("is-slow"));
        waits.forEach((wait) => wait.classList.add("sc-pending"));
        total.textContent = "0 h";
      },
      async play() {
        for (let i = 0; i < gaps.length; i++) {
          await t.wait(680);
          gaps[i].classList.add("is-slow");
          total.textContent = gaps[i].dataset.sum ?? "";
          await t.enter(waits[i]);
          await t.wait(580);
          const from = centre(rings[i]);
          const to = centre(rings[i + 1]);
          mark(-1);
          carrier.style.visibility = "visible";
          await t.animate(
            carrier,
            [{ transform: from }, { transform: to }],
            DURATION.travel + 140,
            EASE_MOVE,
          );
          carrier.style.visibility = "";
          mark(i + 1);
        }
      },
    };
  });
</script>
