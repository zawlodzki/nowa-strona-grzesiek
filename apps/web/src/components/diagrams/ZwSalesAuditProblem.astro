---
// Ported from the Webflow embed #zw-sales-audit-problem (audyt-sprzedazy) by port/port-diagrams.mjs.
import './diagram.css';
---

<div class="dg" data-diagram="zw-sales-audit-problem" aria-hidden="true" style="--dg-w: 400; --dg-h: 246;">
  <div class="zw-stage dg-stage"><div class="zw-fit dg-fit"><div class="zw-scene">
    <svg class="sap-lines" viewBox="0 0 400 246"><path d="M200 123L76 56M200 123L324 56M200 123L52 180M200 123L200 210M200 123L348 180"/></svg>
    <div class="sap-card sap-c1">Strategy</div><div class="sap-card sap-c2">Offer</div>
    <div class="sap-card sap-c3">Process</div><div class="sap-card sap-c4">Team</div><div class="sap-card sap-c5">CRM</div>
    <div class="sap-core"><span>Root cause</span><b>01</b><i><svg viewBox="0 0 24 24"><path d="M5 12.5l4.2 4.3L19 7"/></svg></i></div>
    <span class="sap-ring"></span>
  </div></div></div>
</div>

<style is:global>
[data-diagram="zw-sales-audit-problem"]{--zw-primary:#3A48CC;--zw-primary-10:#EBEDFA;--zw-primary-30:#8991E0;--zw-secondary:#0ACFFE;--zw-success:#52C41A;--zw-bg-soft:#F9FAFB;--zw-border:#DDE1E6;--zw-border-soft:#EDF0F3;--zw-heading:#0E0F11;--zw-text:#1E2024;--zw-muted:#838D95;--zw-card:#FFFFFF;--zw-font:'Satoshi Variable','Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,system-ui,sans-serif;--zw-serif:'Erode Variable','Fraunces','Source Serif 4',Georgia,serif;--zw-radius-card:10px;--zw-radius-lane:14px;--zw-shadow-rest:0 1px 3px rgba(0,0,0,.08);--zw-shadow-lift:1px 8px 22px rgba(14,15,17,.14);font-family:var(--zw-font);width:100%;max-width:440px;margin:0 auto;box-sizing:border-box;-webkit-font-smoothing:antialiased}
[data-diagram="zw-sales-audit-problem"] *,[data-diagram="zw-sales-audit-problem"] *::before,[data-diagram="zw-sales-audit-problem"] *::after{box-sizing:border-box}
[data-diagram="zw-sales-audit-problem"] .zw-stage{width:100%;overflow:hidden}[data-diagram="zw-sales-audit-problem"] .zw-fit{width:400px;transform-origin:top left}[data-diagram="zw-sales-audit-problem"] .zw-scene{position:relative;width:400px;height:246px}
[data-diagram="zw-sales-audit-problem"] .sap-lines{position:absolute;inset:0;width:400px;height:246px;opacity:0;color:var(--zw-border)}
[data-diagram="zw-sales-audit-problem"] .sap-lines path{fill:none;stroke:currentColor;stroke-width:2;stroke-dasharray:5 7;stroke-linecap:round}
[data-diagram="zw-sales-audit-problem"] .sap-card{position:absolute;width:112px;padding:12px 10px;text-align:center;background:var(--zw-card);border:1px solid var(--zw-border);border-radius:var(--zw-radius-card);box-shadow:var(--zw-shadow-rest);color:var(--zw-muted);font-size:11px;font-weight:700;letter-spacing:.07em;text-transform:uppercase;opacity:0}
[data-diagram="zw-sales-audit-problem"] .sap-c1{left:20px;top:30px}[data-diagram="zw-sales-audit-problem"] .sap-c2{right:20px;top:30px}[data-diagram="zw-sales-audit-problem"] .sap-c3{left:0;top:158px}[data-diagram="zw-sales-audit-problem"] .sap-c4{left:144px;top:196px}[data-diagram="zw-sales-audit-problem"] .sap-c5{right:0;top:158px}
[data-diagram="zw-sales-audit-problem"] .sap-core{position:absolute;left:139px;top:88px;width:122px;height:70px;padding:13px 14px;background:var(--zw-card);border:1px solid var(--zw-primary-30);border-radius:var(--zw-radius-card);box-shadow:var(--zw-shadow-lift);opacity:0;z-index:2}
[data-diagram="zw-sales-audit-problem"] .sap-core span{display:block;color:var(--zw-primary);font-size:11px;font-weight:700;letter-spacing:.07em;text-transform:uppercase}[data-diagram="zw-sales-audit-problem"] .sap-core b{display:block;margin-top:4px;color:var(--zw-heading);font-family:var(--zw-serif);font-size:24px;line-height:1}
[data-diagram="zw-sales-audit-problem"] .sap-core i{position:absolute;right:10px;top:23px;width:24px;height:24px;border-radius:50%;display:flex;align-items:center;justify-content:center;background:var(--zw-success);color:#fff;transform:scale(0)}[data-diagram="zw-sales-audit-problem"] .sap-core svg{width:14px;height:14px}[data-diagram="zw-sales-audit-problem"] .sap-core path{fill:none;stroke:currentColor;stroke-width:2.6;stroke-linecap:round;stroke-linejoin:round}
[data-diagram="zw-sales-audit-problem"] .sap-ring{position:absolute;left:137px;top:86px;width:126px;height:74px;border:2px solid var(--zw-secondary);border-radius:14px;opacity:0;z-index:1}
@media(prefers-reduced-motion:reduce){[data-diagram="zw-sales-audit-problem"] .sap-card{opacity:.55}[data-diagram="zw-sales-audit-problem"] .sap-lines,[data-diagram="zw-sales-audit-problem"] .sap-core{opacity:1}[data-diagram="zw-sales-audit-problem"] .sap-core i{transform:scale(1)}}
</style>

<script>
  // @ts-nocheck
  for (const root of document.querySelectorAll('[data-diagram="zw-sales-audit-problem"]')) {
(function(){if(!root||root.dataset.zwInit)return;root.dataset.zwInit='1';var DESIGN_W=400,stage=root.querySelector('.zw-stage'),fitEl=root.querySelector('.zw-fit'),scene=root.querySelector('.zw-scene'),reduce=window.matchMedia&&window.matchMedia('(prefers-reduced-motion: reduce)').matches;var EASE_MOVE='cubic-bezier(0.645, 0.045, 0.355, 1)',EASE_OUT='cubic-bezier(0.22, 1, 0.36, 1)',EASE_POP='cubic-bezier(0.34, 1.56, 0.64, 1)';function wait(ms){return new Promise(function(r){setTimeout(r,ms)})}function fit(){}async function play(){fit();if(reduce)return;var cards=Array.prototype.slice.call(scene.querySelectorAll('.sap-card'));cards.forEach(function(c,i){c.animate([{opacity:0,transform:'translateY(12px) scale(.96)'},{opacity:1,transform:'translateY(0) scale(1)'}],{duration:420,delay:i*90,easing:EASE_OUT,fill:'forwards'});c.style.opacity=1});await wait(760);for(var i=0;i<cards.length;i++){await wait(170);cards[i].animate([{transform:'scale(1)'},{transform:'scale(1.05)'},{transform:'scale(1)'}],{duration:360,easing:EASE_POP})}var lines=scene.querySelector('.sap-lines');lines.animate([{opacity:0},{opacity:1}],{duration:460,easing:EASE_OUT,fill:'forwards'});lines.style.opacity=1;await wait(480);cards.forEach(function(c){c.animate([{opacity:1,transform:'scale(1)'},{opacity:.55,transform:'scale(.94)'}],{duration:460,easing:EASE_MOVE,fill:'forwards'})});var core=scene.querySelector('.sap-core');core.animate([{opacity:0,transform:'scale(.86)'},{opacity:1,transform:'scale(1)'}],{duration:460,easing:EASE_POP,fill:'forwards'});core.style.opacity=1;await wait(420);var check=core.querySelector('i');check.animate([{transform:'scale(0)'},{transform:'scale(1)'}],{duration:360,easing:EASE_POP,fill:'forwards'});check.style.transform='scale(1)';var ring=scene.querySelector('.sap-ring');ring.animate([{opacity:.65,transform:'scale(.96)'},{opacity:0,transform:'scale(1.18)'}],{duration:720,easing:EASE_OUT,fill:'forwards'})}fit();if('ResizeObserver'in window)new ResizeObserver(fit).observe(stage);else window.addEventListener('resize',fit);function arm(){if(!('IntersectionObserver'in window)){play();return}var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){io.disconnect();requestAnimationFrame(function(){requestAnimationFrame(play)})}})},{threshold:.4});io.observe(root)}if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',arm);else arm()})();
  }
</script>
