---
// Rebuilt in the calm scene style by T97; port-diagrams.mjs no longer writes this file.
// Step 1, the sales process: the pipeline stages in one row, and under each
// the data a deal must have before it moves on. Stages light up left to right.
// Also used on the Salesforce page, so it names no CRM vendor.
// The markup is the end state. Stages and fields are placeholders.
import "./scene/scene.css";

const stages = [
  { name: "Lead", fields: ["źródło", "kontakt"] },
  { name: "Kwali­fikacja", fields: ["budżet", "decydent"] },
  { name: "Oferta", fields: ["wartość", "termin"] },
  { name: "Wygrana", fields: ["umowa", "start"] },
];
---

<div
  class="sc"
  data-diagram="zw-crm-process"
  data-scene="sequence"
  aria-hidden="true"
>
  <div class="sc-body">
    <ol class="cols">
      {stages.map((stage, i) => (
        <li class="col is-done" data-step data-value={i + 1}>
          <span class="head">
            <span class="index">{String(i + 1).padStart(2, "0")}</span>
            <span class="name">{stage.name}</span>
          </span>
          <span class="need">wymagane</span>
          <ul>
            {stage.fields.map((field) => (
              <li>{field}</li>
            ))}
          </ul>
        </li>
      ))}
    </ol>
    <div class="sc-total">
      <span class="sc-total-label">Etapy z wymaganymi danymi</span>
      <span class="sc-total-value" data-total data-suffix={" z 4"}>
        4&nbsp;z&nbsp;4
      </span>
    </div>
  </div>
</div>

<style>
  .cols {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    column-gap: clamp(0.5rem, 3cqi, 1.5rem);
  }

  .head {
    position: relative;
    display: grid;
    gap: 0.1rem;
    padding-block-end: 0.5rem;
    border-block-end: 1px solid var(--border-default);
  }

  .head::after {
    content: "";
    position: absolute;
    inset-inline: 0;
    inset-block-end: -1px;
    block-size: 2px;
    background: var(--text-link);
    transform-origin: 0 50%;
  }

  .index {
    color: var(--text-muted);
    font-size: 0.8125rem;
  }

  .name {
    color: var(--text-heading);
    font-weight: var(--font-weight-semibold);
    hyphens: manual;
  }

  .need {
    display: block;
    margin-block: 0.6rem 0.2rem;
    color: var(--text-muted);
    font-size: 0.75rem;
  }

  .col ul {
    display: grid;
    gap: 0.2rem;
  }

  .col li {
    color: var(--text-link);
    font-weight: var(--font-weight-medium);
  }

  .col:not(.is-done) .head::after {
    transform: scaleX(0);
  }

  .col:not(.is-done) :is(.need, ul) {
    opacity: 0;
    transform: translateY(6px);
  }

  @media (prefers-reduced-motion: no-preference) {
    .head::after {
      transition: transform 900ms cubic-bezier(0.65, 0, 0.35, 1);
    }

    .need,
    .col ul {
      transition:
        opacity 630ms cubic-bezier(0.25, 1, 0.5, 1),
        transform 630ms cubic-bezier(0.25, 1, 0.5, 1);
    }

    .col ul {
      transition-delay: 150ms;
    }
  }
</style>

<script>
  import "./sequence";
</script>
