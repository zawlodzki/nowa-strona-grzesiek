---
// Rebuilt in the calm scene style by T92; port-diagrams.mjs no longer writes this file.
// One deal moves through the pipeline into "Wygrana" and the won value counts up.
// The markup is the end state. Company names and the amount are placeholders.
import "./scene/scene.css";

const stages = [
  { name: "Lead", deals: ["Borg", "Nexa", "Volta"] },
  { name: "Kwali\u00adfikacja", deals: ["Helio", "Orto", "Tera"] },
  { name: "Oferta", deals: ["Juno", "Kado"] },
  { name: "Wygrana", deals: [] },
];
const last = stages.length - 1;
---

<div class="sc" data-diagram="crm-funnel" aria-hidden="true">
  <div class="sc-body">
    <div class="cols">
      {stages.map((stage, i) => (
        <div
          class:list={["col", { "is-on": i === last, "is-won": i === last }]}
        >
          <div class="head">
            <span class="name">{stage.name}</span>
            <span class="count">
              {stage.deals.length + (i === last ? 1 : 0)}
            </span>
          </div>
          <ul>
            {stage.deals.map((deal) => (
              <li>{deal}</li>
            ))}
            <li class:list={["slot", { "is-here": i === last }]}>
              <span class="deal">Acme</span>
            </li>
          </ul>
        </div>
      ))}
    </div>
    <span class="ghost">
      <span class="deal">Acme</span>
    </span>
    <div class="sc-total">
      <span class="sc-total-label">Wartość wygranych</span>
      <span class="sc-total-value" data-total>
        24&nbsp;000&nbsp;€
      </span>
    </div>
  </div>
</div>

<style>
  .cols {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    column-gap: clamp(0.75rem, 3cqi, 1.5rem);
  }

  @container (inline-size < 30rem) {
    .cols {
      column-gap: 0.5rem;
    }

    .head {
      flex-direction: column;
      align-items: flex-start;
    }

    .name {
      overflow: visible;
      white-space: normal;
      hyphens: manual;
    }
  }

  .head {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.5rem;
    align-items: baseline;
    justify-content: space-between;
    padding-block-end: 0.5rem;
    color: var(--text-muted);
    font-weight: var(--font-weight-medium);
    border-block-end: 1px solid var(--border-default);
  }

  .head::after {
    content: "";
    position: absolute;
    inset-inline: 0;
    inset-block-end: -1px;
    block-size: 2px;
    background: var(--text-heading);
    transform: scaleX(0);
    transform-origin: 0 50%;
  }

  .name {
    min-inline-size: 0;
    overflow: clip;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .is-on .head {
    color: var(--text-heading);
  }

  .is-on .head::after {
    transform: none;
  }

  .is-won .head {
    color: var(--text-link);
  }

  .is-won .head::after {
    background: var(--text-link);
  }

  li {
    display: flex;
    align-items: center;
    block-size: 2.1rem;
    white-space: nowrap;
    border-block-end: 1px solid var(--border-hairline);
  }

  .deal {
    display: flex;
    gap: 0.45rem;
    align-items: center;
    color: var(--text-link);
    font-weight: var(--font-weight-semibold);
  }

  .deal::before {
    content: "";
    flex: none;
    inline-size: 0.5rem;
    block-size: 0.5rem;
    background: currentColor;
    border-radius: 50%;
  }

  .slot .deal {
    visibility: hidden;
  }

  .slot.is-here .deal {
    visibility: visible;
  }

  .ghost {
    position: absolute;
    inset-block-start: 0;
    inset-inline-start: 0;
    display: flex;
    align-items: center;
    block-size: 2.1rem;
    pointer-events: none;
    visibility: hidden;
  }

  @media (prefers-reduced-motion: no-preference) {
    .head::after {
      transition: transform 720ms cubic-bezier(0.25, 1, 0.5, 1);
    }

    .head {
      transition: color 720ms ease;
    }
  }
</style>

<script>
  import { DURATION, EASE_MOVE, euro, offset, stage } from "./scene/timeline";

  stage("crm-funnel", (root, t) => {
    const body = root.querySelector<HTMLElement>(".sc-body")!;
    const cols = [...root.querySelectorAll<HTMLElement>(".col")];
    const slots = cols.map((col) => col.querySelector<HTMLElement>(".slot")!);
    const counts = cols.map((col) => col.querySelector<HTMLElement>(".count")!);
    const ghost = root.querySelector<HTMLElement>(".ghost")!;
    const total = root.querySelector<HTMLElement>("[data-total]")!;
    const base = counts.map(
      (count, i) => Number(count.textContent) - (i === cols.length - 1 ? 1 : 0),
    );

    const place = (at: number) => {
      slots.forEach((slot, i) => slot.classList.toggle("is-here", i === at));
      counts.forEach(
        (count, i) =>
          (count.textContent = String(base[i] + (i === at ? 1 : 0))),
      );
    };

    return {
      rewind() {
        cols.forEach((col, i) => {
          col.classList.toggle("is-on", i === 0);
          col.classList.remove("is-won");
        });
        place(0);
        total.textContent = euro(0);
      },
      async play() {
        await t.wait(1260);
        for (let i = 1; i < cols.length; i++) {
          const from = offset(slots[i - 1], body);
          const to = offset(slots[i], body);
          cols[i].classList.add("is-on");
          slots[i - 1].classList.remove("is-here");
          counts[i - 1].textContent = String(base[i - 1]);
          ghost.style.visibility = "visible";
          await t.animate(
            ghost,
            [
              { transform: `translate(${from.x}px, ${from.y}px)` },
              { transform: `translate(${to.x}px, ${to.y}px)` },
            ],
            DURATION.travel,
            EASE_MOVE,
          );
          ghost.style.visibility = "";
          cols[i - 1].classList.remove("is-on");
          place(i);
          if (i < cols.length - 1) await t.wait(860);
        }
        cols[cols.length - 1].classList.add("is-won");
        await t.count(
          0,
          24000,
          DURATION.count,
          (value) => (total.textContent = euro(value)),
        );
      },
    };
  });
</script>
