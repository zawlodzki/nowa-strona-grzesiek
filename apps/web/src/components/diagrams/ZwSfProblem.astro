---
// Rebuilt in the calm scene style by T98.
// The problem on the Salesforce page: it is easy to build too much. Module
// after module lands on the deal record and the field count swells, until
// the team goes back to a spreadsheet. It ends on the loss, not a win.
// Bars are drawn to scale against the final field count.
// The markup is the end state. Modules and counts are placeholders.
import "./scene/scene.css";

const max = 140;
const modules = [
  { name: "Szansa sprzedaży", fields: 12 },
  { name: "+ Obsługa klienta", fields: 50 },
  { name: "+ Marketing", fields: 84 },
  { name: "+ Wycena (CPQ)", fields: 140 },
];
const outcomes = [
  "Raporty, których nikt nie otwiera",
  "Handlowcy wracają do Excela",
];
---

<div
  class="sc"
  data-diagram="zw-sf-problem"
  data-scene="sequence"
  aria-hidden="true"
>
  <div class="sc-body">
    <div class="head">
      <span>Karta szansy</span>
      <span>Pól na karcie</span>
    </div>
    <ul>
      {modules.map((module) => (
        <li
          class:list={[
            "module",
            "is-done",
            { "is-max": module.fields === max },
          ]}
          data-step
          data-value={module.fields}
        >
          <span class="name">{module.name}</span>
          <span class="count">{module.fields}</span>
          <span class="track">
            <span class="bar" style={`--v: ${(module.fields / max) * 100}`} />
          </span>
        </li>
      ))}
      {outcomes.map((text) => (
        <li class="outcome is-done" data-step>
          {text}
        </li>
      ))}
    </ul>
    <div class="sc-total">
      <span class="sc-total-label">Pól na karcie szansy</span>
      <span class="sc-total-value is-loss" data-total>
        {max}
      </span>
    </div>
  </div>
</div>

<style>
  .head {
    display: flex;
    justify-content: space-between;
    padding-block-end: 0.5rem;
    color: var(--text-muted);
    font-size: 0.8125rem;
    border-block-end: 1px solid var(--text-heading);
  }

  .module {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.35rem 0.75rem;
    align-items: baseline;
    padding-block: 0.55rem;
    border-block-end: 1px solid var(--border-hairline);
  }

  .name {
    color: var(--text-heading);
  }

  .count {
    color: var(--text-muted);
  }

  .track {
    grid-column: 1 / -1;
    block-size: 6px;
    background: var(--surface-alt);
  }

  .bar {
    display: block;
    inline-size: calc(var(--v) * 1%);
    block-size: 100%;
    background: var(--color-primary-20);
    transform-origin: 0 50%;
  }

  .is-max .bar {
    background: var(--color-status-error);
  }

  .outcome {
    padding-block: 0.55rem;
    color: var(--text-error);
    font-weight: var(--font-weight-semibold);
    border-block-end: 1px solid var(--border-hairline);
  }

  .module:not(.is-done) :is(.name, .count) {
    opacity: 0;
  }

  .module:not(.is-done) .bar {
    transform: scaleX(0);
  }

  .outcome:not(.is-done) {
    opacity: 0;
    transform: translateY(6px);
  }

  @media (prefers-reduced-motion: no-preference) {
    .bar {
      transition: transform 900ms cubic-bezier(0.65, 0, 0.35, 1);
    }

    .name,
    .count,
    .outcome {
      transition:
        opacity 630ms cubic-bezier(0.25, 1, 0.5, 1),
        transform 630ms cubic-bezier(0.25, 1, 0.5, 1);
    }
  }
</style>

<script>
  import "./sequence";
</script>
