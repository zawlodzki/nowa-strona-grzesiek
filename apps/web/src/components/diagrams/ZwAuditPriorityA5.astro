---
// Rebuilt in the calm scene style by T101; port-diagrams.mjs no longer writes this file.
// Audit step 5, the report: findings ranked by priority, drawn to scale.
// Each is either fixed during the workshops or quoted as separate work.
// The findings are placeholders.
import ListScene from "./ListScene.astro";

const weight = { wysoki: 100, średni: 60, niski: 30 } as const;
const findings = [
  { name: "Brak ustaleń zakresu", priority: "wysoki", now: true },
  { name: "Raport dla managera", priority: "wysoki", now: true },
  { name: "Porzucone szablony", priority: "średni", now: true },
  { name: "Integracja z CRM", priority: "średni", now: false },
  { name: "Widok portfolio", priority: "niski", now: false },
] as const;
---

<ListScene
  diagram="zw-audit-priority-a5"
  head={["Problem · priorytet", "Co dalej"]}
  rows={findings.map((f) => ({
    name: `${f.name} · ${f.priority}`,
    value: f.now ? "naprawiam na warsztacie" : "osobny projekt z wyceną",
    tone: f.now ? "ok" : "muted",
    pill: true,
    bar: weight[f.priority],
    counts: f.now,
  }))}
  total={{ label: "Naprawione od ręki", of: findings.length }}
/>
