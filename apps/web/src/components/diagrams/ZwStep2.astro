---
// Rebuilt in the calm scene style by T105; port-diagrams.mjs no longer writes this file.
// Step 2 on the AI pages: the company context gathered in one place, so AI
// writes like an experienced salesperson of this company, not like everyone.
// The items are placeholders.
import ListScene from "./ListScene.astro";

const items = [
  "Oferta",
  "Cennik",
  "Profil klienta",
  "Typowe obiekcje",
  "Ton komunikacji",
];
---

<ListScene
  diagram="zw-step2"
  head={["Kontekst firmy", "Stan"]}
  rows={items.map((name) => ({ name, value: "zebrany", counts: true }))}
  total={{ label: "Kontekst gotowy dla AI", of: items.length }}
/>
