---
// Rebuilt in the calm scene style by T97.
// The problem: a deal card in the CRM is only partly filled in, because the
// rest lives in e-mails, notes and the salesperson's head. It ends on the loss.
// Also used on /audyt-crm-pipedrive, so it names no CRM vendor.
// The markup is the end state. Names and values are placeholders.
import "./scene/scene.css";

const fields = [
  { label: "Etap", value: "Oferta", value_: 20 },
  { label: "Wartość", missing: "w mailu", value_: 20 },
  { label: "Osoba decyzyjna", value: "Anna Nowak", value_: 40 },
  { label: "Następny krok", missing: "w notatce", value_: 40 },
  { label: "Termin decyzji", missing: "w głowie handlowca", value_: 40 },
];
---

<div
  class="sc"
  data-diagram="zw-pipedrive-problem"
  data-scene="sequence"
  aria-hidden="true"
>
  <div class="sc-body">
    <div class="head">
      <span class="deal">Acme</span>
      <span class="kind">Karta szansy w CRM</span>
    </div>
    <ul>
      {fields.map((field) => (
        <li class="is-done" data-step data-value={field.value_}>
          <span class="label">{field.label}</span>
          <span class="cell">
            <span class="pending">…</span>
            {field.value ? (
              <span class="value">{field.value}</span>
            ) : (
              <span class="value missing">
                brak <span class="where">{field.missing}</span>
              </span>
            )}
          </span>
        </li>
      ))}
    </ul>
    <div class="sc-total">
      <span class="sc-total-label">Kompletność karty</span>
      <span class="sc-total-value is-loss" data-total data-suffix="%">
        40%
      </span>
    </div>
  </div>
</div>

<style>
  .head {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
    align-items: baseline;
    padding-block-end: 0.75rem;
    border-block-end: 1px solid var(--text-heading);
  }

  .deal {
    color: var(--text-heading);
    font-family: var(--font-family-heading);
    font-size: 1.25em;
    font-weight: var(--font-weight-semibold);
  }

  .kind {
    color: var(--text-muted);
    font-size: 0.8125rem;
  }

  li {
    display: grid;
    grid-template-columns: minmax(0, 9rem) minmax(0, 1fr);
    gap: 0.75rem;
    align-items: baseline;
    padding-block: 0.6rem;
    border-block-end: 1px solid var(--border-hairline);
  }

  .label {
    color: var(--text-muted);
  }

  .cell {
    display: grid;
  }

  .cell > * {
    grid-area: 1 / 1;
  }

  .pending {
    color: var(--border-strong);
  }

  .value {
    color: var(--text-heading);
    font-weight: var(--font-weight-semibold);
  }

  .missing {
    color: var(--text-error);
  }

  .where {
    color: var(--text-muted);
    font-weight: var(--font-weight-regular);
  }

  li:not(.is-done) .value,
  .is-done .pending {
    opacity: 0;
  }

  li:not(.is-done) .value {
    transform: translateY(6px);
  }

  @container (inline-size < 26rem) {
    li {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.15rem;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .value,
    .pending {
      transition:
        opacity 630ms cubic-bezier(0.25, 1, 0.5, 1),
        transform 630ms cubic-bezier(0.25, 1, 0.5, 1);
    }
  }
</style>

<script>
  import "./sequence";
</script>
