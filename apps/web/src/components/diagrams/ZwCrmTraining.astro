---
// Rebuilt in the calm scene style by T97; port-diagrams.mjs no longer writes this file.
// Step 4, workshops and 1:1 training: the share of salespeople who use the
// CRM every week rises after the workshop and the 1:1 sessions.
// Bars are drawn to scale against a 0–100% axis. Also used on the Salesforce page.
// The markup is the end state. The figures are placeholders.
import "./scene/scene.css";

const weeks = [
  { value: 25, note: "warsztat" },
  { value: 40 },
  { value: 55, note: "1:1" },
  { value: 70, note: "1:1" },
  { value: 85 },
  { value: 92 },
];
---

<div
  class="sc"
  data-diagram="zw-crm-training"
  data-scene="sequence"
  aria-hidden="true"
>
  <div class="sc-body">
    <div class="chart">
      <span class="axis">100%</span>
      <ol class="bars">
        {weeks.map((week, i) => (
          <li class="is-done" data-step data-value={week.value}>
            <span class="plot">
              <span class="bar" style={`--v: ${week.value}`} />
            </span>
            <span class="week">tydz. {i + 1}</span>
            <span class="note">{week.note ?? ""}</span>
          </li>
        ))}
      </ol>
    </div>
    <div class="sc-total">
      <span class="sc-total-label">Handlowcy aktywni w CRM co tydzień</span>
      <span class="sc-total-value" data-total data-suffix="%">
        92%
      </span>
    </div>
  </div>
</div>

<style>
  .chart {
    position: relative;
    padding-block-start: 1.25rem;
  }

  .axis {
    position: absolute;
    inset-block-start: 0;
    inset-inline-start: 0;
    color: var(--text-muted);
    font-size: 0.75rem;
  }

  .bars {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    column-gap: clamp(0.4rem, 3cqi, 1.25rem);
  }

  li {
    display: grid;
    gap: 0.35rem;
    justify-items: center;
  }

  .plot {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    inline-size: 100%;
    block-size: 7.5rem;
    border-block: 1px solid var(--border-hairline);
    border-block-end-color: var(--text-heading);
  }

  .bar {
    inline-size: min(100%, 2.25rem);
    block-size: calc(var(--v) * 1%);
    background: var(--text-link);
    transform-origin: 50% 100%;
  }

  li:not(:last-child) .bar {
    background: var(--color-primary-20);
  }

  .week {
    color: var(--text-muted);
    font-size: 0.75rem;
    white-space: nowrap;
  }

  .note {
    min-block-size: 1.2em;
    color: var(--text-link);
    font-size: 0.75rem;
    font-weight: var(--font-weight-medium);
  }

  li:not(.is-done) .bar {
    transform: scaleY(0);
  }

  li:not(.is-done) .note {
    opacity: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .bar {
      transition: transform 900ms cubic-bezier(0.65, 0, 0.35, 1);
    }

    .note {
      transition: opacity 630ms ease;
    }
  }
</style>

<script>
  import "./sequence";
</script>
