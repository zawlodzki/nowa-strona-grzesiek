---
// Rebuilt in the calm scene style by T105.
// Step 1 on the AI pages: the team's repetitive work with the hours it costs
// per week, drawn to scale. The biggest, most repeatable pieces go to AI.
// Used on the programme, implementation and course pages.
// The tasks and hours are placeholders.
import ListScene from "./ListScene.astro";

const max = 6;
const work = [
  { name: "Oferty", hours: 6, ai: true },
  { name: "Follow-upy", hours: 4, ai: true },
  { name: "Briefy przed spotkaniem", hours: 3, ai: true },
  { name: "Raporty", hours: 2, ai: false },
  { name: "Prognozy", hours: 1, ai: false },
];
---

<ListScene
  diagram="zw-step1"
  head={["Powtarzalna praca · godziny tygodniowo", "Kto robi"]}
  rows={work.map((w) => ({
    name: `${w.name} · ${w.hours} h`,
    value: w.ai ? "AI" : "na razie zespół",
    tone: w.ai ? "ok" : "muted",
    pill: true,
    bar: (w.hours / max) * 100,
    counts: w.ai,
  }))}
  total={{ label: "Procesy dla AI", of: work.length }}
/>
