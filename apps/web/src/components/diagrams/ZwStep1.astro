---
// Ported from the Webflow embed #zw-step1 (kurs-ai-w-sprzedazy, program-ai-dla-zespolu-sprzedazy, wdrozenie-ai-w-sprzedazy-b2b) by port/port-diagrams.mjs.
import './diagram.css';
/*
  AI dla sprzedazy — landing step 1: "Dopasowanie procesow"
  Minimal stage illustration. Sits next to the step description.
  zawlodzki.pl · self-contained, no external dependencies.
*/
---

<div class="dg" data-diagram="zw-step1" aria-hidden="true" style="--dg-w: 400; --dg-h: 273.75;">
  <div class="zw-stage dg-stage">
    <div class="zw-fit dg-fit">
      <div class="zw-scene">
        <div class="s1-panel">
          <span class="s1-eyebrow">Repetitive work</span>
          <div class="s1-row s1-row--pickable">
            <span class="s1-bar"></span>
            <span class="s1-name">Offers</span>
            <span class="s1-tag" aria-hidden="true">AI</span>
          </div>
          <div class="s1-row"><span class="s1-bar"></span><span class="s1-name">Follow-ups</span></div>
          <div class="s1-row"><span class="s1-bar"></span><span class="s1-name">Briefs</span></div>
          <div class="s1-row"><span class="s1-bar"></span><span class="s1-name">Reports</span></div>
        </div>
      </div>
    </div>
  </div>
</div>

<style is:global>
[data-diagram="zw-step1"] {
    --zw-primary:#3A48CC; --zw-primary-10:#EBEDFA; --zw-primary-30:#8991E0;
    --zw-secondary:#0ACFFE; --zw-success:#52C41A; --zw-bg-soft:#F9FAFB;
    --zw-border:#DDE1E6; --zw-border-soft:#EDF0F3; --zw-heading:#0E0F11;
    --zw-text:#1E2024; --zw-muted:#838D95; --zw-card:#FFFFFF;
    --zw-font:'Satoshi Variable','Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,system-ui,sans-serif;
    --zw-radius-card:10px; --zw-radius-lane:14px;
    --zw-shadow-rest:0 1px 3px rgba(0,0,0,.08);
    font-family:var(--zw-font); width:100%; max-width:440px; margin:0 auto;
    box-sizing:border-box; -webkit-font-smoothing:antialiased;
  }
  [data-diagram="zw-step1"] *, [data-diagram="zw-step1"] *::before, [data-diagram="zw-step1"] *::after { box-sizing:border-box; }
  [data-diagram="zw-step1"] .zw-stage { width:100%; overflow:hidden; }
  [data-diagram="zw-step1"] .zw-fit { width:400px; transform-origin:top left; }
  [data-diagram="zw-step1"] .zw-scene { position:relative; }

  /* =================== SCENE:STYLE start =================== */
  [data-diagram="zw-step1"] .s1-panel { width:360px; margin:6px auto; }
  [data-diagram="zw-step1"] .s1-eyebrow {
    display:block; font-size:12px; font-weight:700; letter-spacing:.09em;
    text-transform:uppercase; color:var(--zw-muted); margin:0 2px 12px; opacity:0;
  }
  [data-diagram="zw-step1"] .s1-row {
    display:flex; align-items:center; gap:12px;
    background:var(--zw-card); border:1px solid var(--zw-border);
    border-radius:var(--zw-radius-card); box-shadow:var(--zw-shadow-rest);
    padding:13px 14px 13px 0; margin-bottom:10px; overflow:hidden;
    opacity:0; transition:background-color .35s ease, border-color .35s ease;
  }
  [data-diagram="zw-step1"] .s1-bar {
    flex:0 0 auto; width:4px; align-self:stretch; border-radius:4px 0 0 4px;
    background:var(--zw-border); transition:background-color .35s ease;
  }
  [data-diagram="zw-step1"] .s1-name {
    font-size:14px; font-weight:600; color:var(--zw-text);
    transition:color .35s ease;
  }
  [data-diagram="zw-step1"] .s1-tag {
    margin-left:auto; font-size:11px; font-weight:700; letter-spacing:.05em;
    color:#fff; background:var(--zw-primary); border-radius:6px; padding:3px 8px;
    transform:scale(0); transform-origin:center;
  }
  [data-diagram="zw-step1"] .s1-scan { background:var(--zw-primary-10); }
  [data-diagram="zw-step1"] .s1-pick { border-color:var(--zw-primary-30); }
  [data-diagram="zw-step1"] .s1-pick .s1-bar { background:var(--zw-primary); }
  [data-diagram="zw-step1"] .s1-pick .s1-name { color:var(--zw-heading); }
  /* ==================== SCENE:STYLE end ==================== */

  @media (prefers-reduced-motion: reduce) {
    [data-diagram="zw-step1"] .s1-eyebrow { opacity:1; }
    [data-diagram="zw-step1"] .s1-row { opacity:1; transition:none; }
    [data-diagram="zw-step1"] .s1-row--pickable { border-color:var(--zw-primary-30); }
    [data-diagram="zw-step1"] .s1-row--pickable .s1-bar { background:var(--zw-primary); }
    [data-diagram="zw-step1"] .s1-row--pickable .s1-name { color:var(--zw-heading); }
    [data-diagram="zw-step1"] .s1-tag { transform:scale(1); }
  }
</style>

<script>
  // @ts-nocheck
  for (const root of document.querySelectorAll('[data-diagram="zw-step1"]')) {
(function () {
  if (!root || root.dataset.zwInit) return;
  root.dataset.zwInit = '1';

  var DESIGN_W = 400;
  var stage = root.querySelector('.zw-stage');
  var fitEl = root.querySelector('.zw-fit');
  var scene = root.querySelector('.zw-scene');
  var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  var EASE_OUT = 'cubic-bezier(0.22, 1, 0.36, 1)';
  var EASE_POP = 'cubic-bezier(0.34, 1.56, 0.64, 1)';
  function wait(ms){ return new Promise(function(r){ setTimeout(r, ms); }); }
  function settled(a){ return a.finished.catch(function(){}); }

  function fit(){}

  var eyebrow = scene.querySelector('.s1-eyebrow');
  var rows = Array.prototype.slice.call(scene.querySelectorAll('.s1-row'));

  async function play(){
    fit();
    if (reduce) { return; }

    eyebrow.animate([{opacity:0},{opacity:1}], {duration:300, easing:EASE_OUT, fill:'forwards'});
    eyebrow.style.opacity = 1;
    rows.forEach(function(r,i){
      r.animate([{opacity:0, transform:'translateY(10px)'},{opacity:1, transform:'translateY(0)'}],
        {duration:420, delay:140 + i*90, easing:EASE_OUT, fill:'forwards'});
    });
    await wait(140 + rows.length*90 + 340);

    // scan the list top to bottom
    for (var i=0; i<rows.length; i++){
      rows[i].classList.add('s1-scan');
      await wait(150);
      rows[i].classList.remove('s1-scan');
    }
    await wait(180);

    // pick the first row for AI
    var pick = rows[0];
    pick.classList.add('s1-pick');
    var tag = pick.querySelector('.s1-tag');
    tag.animate([{transform:'scale(0)'},{transform:'scale(1)'}], {duration:360, easing:EASE_POP, fill:'forwards'});
    tag.style.transform = 'scale(1)';
  }

  fit();
  if ('ResizeObserver' in window) { new ResizeObserver(fit).observe(stage); }
  else { window.addEventListener('resize', fit); }

  function arm(){
    if (!('IntersectionObserver' in window)) { play(); return; }
    var io = new IntersectionObserver(function(entries){
      entries.forEach(function(e){
        if (e.isIntersecting) { io.disconnect(); requestAnimationFrame(function(){ requestAnimationFrame(play); }); }
      });
    }, { threshold: 0.4 });
    io.observe(root);
  }
  if (document.readyState === 'loading') { document.addEventListener('DOMContentLoaded', arm); }
  else { arm(); }
})();
  }
</script>
