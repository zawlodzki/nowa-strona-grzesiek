---
import { chromeView } from './settings.ts';
import { footerGroups, SOCIAL_LINKS } from './footer-groups';
import LogoMark from './LogoMark.astro';
import SalesAtlasBadge from './SalesAtlasBadge.astro';

interface Props { language: 'pl' | 'en'; pathname: string; }
const { language, pathname } = Astro.props;
const chrome = await chromeView(language, pathname);
const grouped = chrome.kind === 'ready' ? footerGroups([...chrome.footer.before, ...chrome.footer.after]) : undefined;
---
{chrome.kind === 'empty' && <footer></footer>}
{chrome.kind === 'ready' && grouped && (
  <footer class="site-footer content-grid">
    <div class="footer-inner">
      <div class="brand-row">
        <a class="brand" href={chrome.home} aria-label={chrome.logoLabel}><LogoMark /></a>
        <a class="atlas-link" href="/sales-atlas-system" aria-label="Sales Atlas System"><SalesAtlasBadge /></a>
      </div>
      <nav class="columns" aria-label={chrome.footerLabel}>
        {grouped.columns.filter((group) => group.links.length).map((group) => (
          <div class="column">
            <h2 class="column-title type-body-s">{group.title}</h2>
            <ul>{group.links.map((link) => <li><a class="footer-link" href={link.href}>{link.label}</a></li>)}</ul>
          </div>
        ))}
      </nav>
      <div class="partner-row">
        <img class="partner" src="/brand/pipedrive-authorized-partner.avif" width="160" height="64" alt="Pipedrive Authorized Partner" loading="lazy" />
        <ul class="socials" aria-label="Media społecznościowe">{SOCIAL_LINKS.map((link) => (
          <li><a class="social-link" href={link.href} aria-label={link.label}><img src={`/brand/${link.asset}`} width="24" height="24" alt="" loading="lazy" /></a></li>
        ))}</ul>
      </div>
      <div class="bottom">
        <p class="type-body-s">© {new Date().getFullYear()} Grzegorz Zawłodzki. Wszelkie prawa zastrzeżone.</p>
        <nav aria-label="Informacje prawne"><ul class="legal">
          <li><button type="button" class="footer-link" data-c15t-open>{chrome.footer.consent.kind === 'on-link' ? chrome.footer.consent.link.label : chrome.footer.consent.label}</button></li>
          {grouped.legal.map((link) => <li><a class="footer-link" href={link.href}>{link.label}</a></li>)}
        </ul></nav>
      </div>
    </div>
  </footer>
)}
<style>
  .site-footer { padding-block: var(--space-l); border-block-start: 1px solid var(--border-default); background: var(--surface-page); container-type: inline-size; }
  .footer-inner { display: grid; gap: var(--space-l); min-inline-size: 0; }
  .brand-row, .partner-row, .bottom { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: var(--space-m); }
  .brand, .atlas-link { display: inline-flex; min-block-size: 44px; align-items: center; }
  .brand :global(svg) { inline-size: 9rem; block-size: auto; }
  .columns { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr)); gap: var(--space-m); }
  .column-title { font-family: var(--font-family-body); font-weight: var(--font-weight-bold); margin-block-end: var(--space-xs); }
  ul { list-style: none; padding: 0; margin: 0; }
  .partner { inline-size: auto; block-size: 3.4rem; object-fit: contain; }
  .socials, .legal { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2xs) var(--space-s); }
  .social-link { display: grid; place-items: center; inline-size: 44px; block-size: 44px; }
  .social-link img { inline-size: 1.5rem; block-size: 1.5rem; }
  .footer-link { display: inline-flex; align-items: center; max-inline-size: 100%; min-block-size: 44px; padding: 0; border: 0; background: transparent; color: var(--text-muted); font: inherit; font-size: var(--typography-body-s-size); text-align: start; text-decoration: none; overflow-wrap: anywhere; cursor: pointer; }
  .bottom { color: var(--text-muted); }
  :is(.footer-link, .brand, .atlas-link, .social-link):focus-visible { outline: 2px solid var(--border-focus); outline-offset: 3px; }
  :is(.footer-link, .brand, .atlas-link, .social-link):active { opacity: .7; }
  @media (hover: hover) and (pointer: fine) { .footer-link:hover { color: var(--text-link); } .social-link:hover { opacity: .7; } }
  @container (width < 48rem) {
    .columns { grid-template-columns: 1fr; text-align: center; }
    .bottom { flex-direction: column; text-align: center; }
    .legal { justify-content: center; }
  }
</style>
