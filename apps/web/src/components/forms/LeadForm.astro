---
import { FORMS } from '../../worker/form';
import Button from '../ui/Button.astro';

type FormKey = keyof typeof FORMS;
interface Props {
  form: FormKey;
  id: string;
  // Names of the fields the slot renders. Every other field of the form is rendered here as a hidden attribution input.
  visible: string[];
  submitLabel: string;
  waitLabel?: string;
  tone?: 'light' | 'dark';
  class?: string;
}
const { form, id, visible, submitLabel, waitLabel = 'Zaczekaj chwilę…', tone = 'light', class: className } = Astro.props;
const names = FORMS[form].fields.map(([name]) => name);
const unknown = visible.filter((name) => !names.includes(name));
if (unknown.length) throw new Error(`LeadForm "${form}" has no field ${unknown.join(', ')}. Field names come from worker/form.ts.`);
const hidden = names.filter((name) => !visible.includes(name));
// Cloudflare's published always-pass test key keeps local builds working. Staging and production builds set the live key.
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '1x00000000000000000000AA';
---
<form
  id={id}
  class:list={['lead-form', tone, className]}
  action={`/api/form?form=${form}`}
  method="post"
  data-lead-form
  data-form={form}
  data-name={FORMS[form].name}
>
  <slot />
  <div class="cf-turnstile" data-sitekey={siteKey} data-language="pl" data-theme={tone === 'dark' ? 'dark' : 'light'} data-size="flexible" data-appearance="interaction-only"></div>
  <Button type="submit" class="submit" label={submitLabel} waitLabel={waitLabel} variant={tone === 'dark' ? 'on-dark' : 'primary'} />
  <p class="status type-body-s" role="status" aria-live="polite"></p>
  <div data-zaw-attribution-fields="v1" hidden>
    {hidden.map((name) => <input type="hidden" name={name} data-zaw-attribution={name} value="" />)}
  </div>
</form>

<script>
  // Turnstile is loaded on demand. The challenge downloads megabytes and its iframe can push content,
  // so the script loads when someone starts using a form and the challenge runs only on submit.
  const TURNSTILE = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit';
  type Turnstile = {
    render(container: Element, options: Record<string, unknown>): string | undefined;
    remove(widgetId: string): void;
  };

  let api: Promise<Turnstile | undefined> | undefined;
  function loadTurnstile() {
    api ??= new Promise((resolve) => {
      const script = Object.assign(document.createElement('script'), { src: TURNSTILE, async: true });
      script.addEventListener('load', () => resolve((window as { turnstile?: Turnstile }).turnstile));
      script.addEventListener('error', () => resolve(undefined));
      document.head.appendChild(script);
    });
    return api;
  }

  const widgets = new WeakMap<Element, string>();
  // Renders a fresh widget and waits for its token. Turnstile also writes the token into a hidden
  // `cf-turnstile-response` input inside the widget, so FormData picks it up.
  async function verify(widget: HTMLElement): Promise<void> {
    const turnstile = await loadTurnstile();
    if (!turnstile) return;
    const previous = widgets.get(widget);
    if (previous) turnstile.remove(previous);
    await new Promise<void>((resolve) => {
      const id = turnstile.render(widget, {
        sitekey: widget.dataset.sitekey,
        language: widget.dataset.language,
        theme: widget.dataset.theme,
        size: widget.dataset.size,
        appearance: widget.dataset.appearance,
        callback: () => resolve(),
        'error-callback': () => resolve(),
        'unsupported-callback': () => resolve(),
      });
      if (id) widgets.set(widget, id);
      else resolve();
    });
  }

  // Without this script the form still posts and the Worker answers with a 303 to the thank-you page.
  for (const form of document.querySelectorAll<HTMLFormElement>('form[data-lead-form]')) {
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const status = form.querySelector<HTMLElement>('.status')!;
    const widget = form.querySelector<HTMLElement>('.cf-turnstile');
    const label = button.querySelector<HTMLElement>('.action-label')!;
    const originalLabel = label.textContent;
    for (const type of ['focusin', 'pointerdown']) form.addEventListener(type, () => void loadTurnstile(), { once: true });
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (form.getAttribute('aria-busy') === 'true') return;
      form.setAttribute('aria-busy', 'true');
      label.textContent = button.dataset.wait ?? originalLabel;
      status.textContent = '';
      if (widget) await verify(widget);
      const response = await fetch(form.action, { method: 'POST', body: new FormData(form) }).catch(() => null);
      if (response?.redirected) {
        location.assign(response.url);
        return;
      }
      status.textContent = response
        ? (await response.text()) || 'Nie udało się wysłać formularza. Spróbuj ponownie.'
        : 'Brak połączenia. Sprawdź internet i spróbuj ponownie.';
      status.dataset.state = 'error';
      label.textContent = originalLabel;
      form.removeAttribute('aria-busy');
    });
  }
</script>

<style>
  .lead-form {
    --form-field-size: clamp(1rem, .89640884rem + .44198895vw, 1.25rem);
    --field-label: var(--text-heading);
    --field-note: var(--text-muted);
    display: grid;
    gap: var(--lead-form-gap, var(--space-s));
    align-content: start;
  }
  .dark {
    --field-label: var(--text-on-dark);
    --field-note: var(--text-on-dark-muted);
  }

  .lead-form :global(.field) { display: grid; gap: var(--space-3xs); }
  .lead-form :global(.field > label) { color: var(--field-label); font-weight: var(--font-weight-medium); }
  /* Same screen-reader-only pattern as Header; shared by both form sections. */
  .lead-form :global(.visually-hidden) {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    padding-block: 0;
    padding-inline: 0;
    margin-block: -1px;
    margin-inline: -1px;
    overflow: clip;
    clip-path: inset(50%);
    white-space: nowrap;
    border-block: 0;
    border-inline: 0;
  }
  .lead-form :global(.required) { color: var(--field-note); font-weight: var(--font-weight-regular); }
  .lead-form :global(:where(input:not([type="checkbox"]):not([type="hidden"]), textarea)) {
    inline-size: 100%;
    min-block-size: 44px;
    padding: var(--space-2xs) var(--space-xs);
    border: var(--border-width-hairline) solid var(--border-default);
    border-radius: var(--radius-sm);
    background: var(--surface-page);
    color: var(--text-heading);
    font: inherit;
    font-size: var(--form-field-size);
    line-height: calc(10 / 7);
    box-shadow: var(--shadow-input);
  }
  .lead-form :global(.field > input) { block-size: 44px; }
  .lead-form :global(textarea) { field-sizing: content; min-block-size: 96px; max-block-size: 12lh; resize: vertical; }
  .lead-form :global(::placeholder) { color: var(--text-muted); opacity: 1; }
  .lead-form :global(:is(input, textarea):focus-visible) { outline: var(--border-width-button) solid var(--border-focus); outline-offset: 2px; }
  .dark :global(:is(input, textarea):focus-visible) { outline-color: var(--border-accent); }
  .lead-form :global(:is(input, textarea):user-invalid) { border-color: var(--border-error); }
  @media (hover: hover) and (pointer: fine) {
    .lead-form :global(:is(input:not([type="checkbox"]):not([type="hidden"]), textarea):hover) { border-color: var(--border-hover); }
  }

  .lead-form :global(.check) {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-xs);
    align-items: start;
    min-block-size: 44px;
    color: var(--field-note);
    cursor: pointer;
  }
  .lead-form :global(.check input) { inline-size: 1.25rem; block-size: 1.25rem; margin: 0.1lh 0 0; accent-color: var(--surface-accent); }
  .lead-form :global(.note) { color: var(--field-note); }
  .dark :global(a) { color: var(--text-link-on-dark); }

  .cf-turnstile:empty { display: none; }

  .lead-form > :global(.submit) { justify-self: start; }
  .lead-form[data-form$="-contact"] > :global(.submit) { justify-self: stretch; }
  .dark > :global(.submit:focus-visible) { outline-color: var(--border-accent); }
  [aria-busy="true"] > :global(.submit) { cursor: progress; opacity: 0.8; }

  .status:empty { display: none; }
  .status { transition: opacity var(--motion-duration-base) var(--motion-easing-out); }
  @starting-style {
    .status:not(:empty) { opacity: 0; }
  }
  @media (prefers-reduced-motion: no-preference) {
    .status { transition: opacity var(--motion-duration-base) var(--motion-easing-out), translate var(--motion-duration-base) var(--motion-easing-out); }
    @starting-style {
      .status:not(:empty) { opacity: 0; translate: 0 -4px; }
    }
  }
  .status[data-state="error"] { color: var(--text-error); font-weight: var(--font-weight-medium); }
  .dark .status[data-state="error"] { color: var(--text-on-dark); }
</style>
