---
import type { Link } from '../../../../studio/sanity.types';
import Icon from './Icon.astro';
import { safeHref } from './block-types';

type Variant = 'primary' | 'secondary' | 'on-dark' | 'text';
type Props = { variant?: Variant; class?: string } & (
  { link: Link; current?: boolean; type?: never } |
  { type: 'submit'; label: string; waitLabel: string; link?: never }
);

const props = Astro.props;
const classes = ['action', 'arrow-trigger', props.variant ?? 'primary', props.class];
const href = props.type !== 'submit' && safeHref(props.link.href);
---
{props.type === 'submit' ? (
  <button type="submit" class:list={classes} data-wait={props.waitLabel}><span class="action-label">{props.label}</span><Icon name="hover-arrow" /></button>
) : href && props.link.label && (
  <a class:list={classes} href={href} aria-current={props.current ? 'page' : undefined}><span class="action-label">{props.link.label}</span><Icon name="hover-arrow" /></a>
)}
<style is:global>
  :is(a, button).action {
    box-sizing: border-box;
    display: inline-flex;
    justify-content: center;
    gap: .4em;
    min-block-size: 52px;
    min-inline-size: 0;
    max-inline-size: 100%;
    padding-block: 8px;
    padding-inline: var(--action-padding-inline, clamp(12px, 4vw, 24px));
    border: 0;
    border-radius: var(--radius-pill);
    font-family: var(--typography-body-family);
    font-size: var(--typography-body-size);
    font-weight: var(--font-weight-medium);
    line-height: 1.5;
    text-align: center;
    text-decoration: none;
    align-items: center;
  }
  .action-label { min-inline-size: 0; white-space: normal; overflow-wrap: break-word; text-wrap: balance; }
  .action > svg { align-self: start; margin-block-start: max(0px, calc((52px - 16px - 1lh) / 2)); }
  .action.primary { background: var(--surface-accent); color: var(--text-on-accent); }
  .action:is(.secondary, .on-dark) { background: var(--surface-page); color: var(--text-link); }
  .action.secondary { box-shadow: inset 0 0 0 var(--border-width-button) currentColor; }
  .action.text { color: var(--text-link); justify-content: start; padding-inline: 0; text-align: start; text-decoration: underline; text-underline-offset: .2em; }
  .action:focus-visible { outline: 3px solid var(--border-focus); outline-offset: 3px; box-shadow: 0 0 0 2px var(--surface-page); }
  .action.secondary:focus-visible { box-shadow: inset 0 0 0 var(--border-width-button) currentColor, 0 0 0 2px var(--surface-page); }
  .action.primary:active { background: var(--text-link-active); }
  .action:is(.secondary, .on-dark):active { background: var(--surface-tint); }
  .action.text:active { color: var(--text-link-active); }
  @media (hover: hover) and (pointer: fine) {
    .action.primary:hover { background: var(--text-link-hover); }
    .action:is(.secondary, .on-dark):hover { background: var(--surface-tint); color: var(--text-link-hover); }
    .action.text:hover { color: var(--text-link-hover); }
  }
  @media (width < 30rem) { a.action:not(.text) { inline-size: 100%; } }
</style>
