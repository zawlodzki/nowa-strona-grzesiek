---
interface Props { title: string; path: string; pl: boolean; }
const { title, path, pl } = Astro.props;
const url = new URL(path, 'https://www.zawlodzki.pl').href;
const encoded = encodeURIComponent(url);
const text = encodeURIComponent(title);
const options = [
  { label: 'X', href: `https://x.com/intent/post?url=${encoded}&text=${text}`, icon: 'm4 3 16 18h-5L3 3h5M4 21 20 3' },
  { label: 'LinkedIn', href: `https://www.linkedin.com/sharing/share-offsite/?url=${encoded}`, icon: 'M4 9v11M4 4v.01M9 20V9h4v2c1-3 7-3 7 2v7M13 20v-7' },
  { label: 'Facebook', href: `https://www.facebook.com/sharer/sharer.php?u=${encoded}`, icon: 'M14 21v-9h3l1-4h-4V6c0-1 .5-2 2-2h2V1h-3c-3 0-5 2-5 5v2H7v4h3v9' },
  { label: 'Email', href: `mailto:?subject=${text}&body=${encoded}`, icon: 'M4 5h16a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Zm-1 2 9 6 9-6' },
  { label: 'WhatsApp', href: `https://wa.me/?text=${text}%20${encoded}`, icon: 'M20 11.5a8 8 0 0 1-12 7L3 20l1.5-5A8 8 0 1 1 20 11.5ZM8 7c-1 1-1 3 2 6s5 3 6 2l-2-2-1 1c-2-1-3-2-4-4l1-1Z' },
];
---
<div class="share">
  <button class="share-trigger" type="button" popovertarget="share-options"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="18" cy="5" r="3" /><circle cx="6" cy="12" r="3" /><circle cx="18" cy="19" r="3" /><path d="m8.6 10.5 6.8-4M8.6 13.5l6.8 4" /></svg>{pl ? 'Udostępnij' : 'Share'}</button>
  <div id="share-options" popover role="dialog" aria-labelledby="share-heading">
    <div class="share-heading">
      <h2 id="share-heading" class="type-heading-xs">{pl ? 'Udostępnij artykuł' : 'Share this article'}</h2>
      <button class="share-close" type="button" popovertarget="share-options" popovertargetaction="hide" aria-label={pl ? 'Zamknij' : 'Close'}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="m6 6 12 12M18 6 6 18" /></svg></button>
    </div>
    <ul class="share-actions" role="list">
      {options.map(({ label, href, icon }) => <li><a class="share-tile" href={href} target={href.startsWith('mailto:') ? undefined : '_blank'} rel="noopener noreferrer"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d={icon} /></svg><span>{label}</span></a></li>)}
      <li><button class="share-tile" type="button" data-copy-url={url}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="8" y="8" width="12" height="13" rx="2" /><path d="M16 8V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h3" /></svg><span>{pl ? 'Kopiuj link' : 'Copy link'}</span></button></li>
    </ul>
    <p role="status" aria-live="polite"></p>
    <label class="manual" hidden>{pl ? 'Skopiuj adres ręcznie' : 'Copy the address manually'}<input readonly value={url} /></label>
  </div>
</div>
<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy-url]').forEach((button) => {
    button.addEventListener('click', async () => {
      const panel = button.closest<HTMLElement>('[popover]')!;
      try {
        await navigator.clipboard.writeText(button.dataset.copyUrl!);
        panel.querySelector('[role="status"]')!.textContent = document.documentElement.lang === 'pl' ? 'Link skopiowany.' : 'Link copied.';
      } catch {
        const label = panel.querySelector<HTMLElement>('.manual')!;
        label.hidden = false;
        const input = label.querySelector('input')!;
        input.focus({ preventScroll: true });
        input.setSelectionRange(0, input.value.length);
      }
    });
  });
</script>
<style>
  .share { display: grid; justify-items: center; }
  button { cursor: pointer; font: inherit; }
  .share-trigger { display: inline-flex; align-items: center; min-block-size: 44px; gap: var(--space-2xs); padding: var(--space-2xs) var(--space-m); border: 1px solid var(--border-hairline); border-radius: var(--radius-pill); background: var(--surface-soft); color: var(--text-link); font-weight: var(--font-weight-medium); }
  svg { flex: none; inline-size: 1.5em; block-size: 1.5em; }
  .share-trigger svg { inline-size: 1.2em; block-size: 1.2em; }
  button:focus-visible, a:focus-visible, input:focus-visible { outline: 2px solid var(--text-link); outline-offset: 3px; }
  [popover] { inline-size: min(23rem, calc(100vi - 2 * var(--space-s))); max-block-size: calc(100dvh - 2 * var(--space-s)); overflow-y: auto; overscroll-behavior: contain; padding: var(--space-s); border: 1px solid var(--border-hairline); border-radius: var(--radius-lg); background: var(--surface-page); color: var(--text-body); box-shadow: var(--shadow-panel); }
  .share-heading { display: flex; align-items: center; justify-content: space-between; gap: var(--space-xs); margin-block-end: var(--space-s); }
  .share-close { display: inline-grid; place-items: center; flex: none; inline-size: 44px; block-size: 44px; padding: var(--space-2xs); border: 0; border-radius: var(--radius-round); background: var(--surface-soft); color: var(--text-link); }
  .share-actions { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); grid-auto-rows: 1fr; gap: var(--space-2xs); list-style: none; padding: 0; margin: 0; }
  .share-actions li { min-inline-size: 0; }
  .share-tile { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: var(--space-2xs); inline-size: 100%; block-size: 100%; min-block-size: 6rem; padding: var(--space-s) var(--space-2xs); border: 1px solid var(--border-hairline); border-radius: var(--radius-md); background: var(--surface-soft); color: var(--text-body); font-size: 1rem; font-weight: var(--font-weight-medium); line-height: 1.5; text-align: center; text-decoration: none; overflow-wrap: anywhere; }
  .share-tile svg { color: var(--text-link); }
  button:active, .share-tile:active { background: var(--surface-tint); color: var(--text-link-active); }
  [role="status"]:not(:empty) { margin-block-start: var(--space-s); font-size: 1rem; color: var(--text-link); }
  input { inline-size: 100%; padding: var(--space-xs); border: 1px solid var(--border-default); border-radius: var(--radius-sm); background: var(--surface-page); color: var(--text-body); }
  .manual:not([hidden]) { display: grid; gap: var(--space-2xs); margin-block-start: var(--space-s); font-size: 1rem; }
  @media (hover: hover) and (pointer: fine) { button:hover, .share-tile:hover { background: var(--surface-tint); color: var(--text-link); border-color: var(--text-link); } }
  @supports (position-area: block-end) {
    [popover] { margin: 0; margin-block-start: .5rem; position-area: block-end span-inline-end; position-try-fallbacks: flip-block, flip-inline, flip-block flip-inline, --share-centered, --share-centered flip-block, --share-viewport; }
    @position-try --share-centered { position-area: block-end; }
    @position-try --share-viewport { position-area: none; inset-block: var(--space-s); inset-inline: var(--space-s); margin: auto; }
    [popover]:has(.manual:not([hidden]), [role="status"]:not(:empty)) { position-area: none; inset-block: var(--space-s); inset-inline: var(--space-s); margin: auto; }
  }
</style>
