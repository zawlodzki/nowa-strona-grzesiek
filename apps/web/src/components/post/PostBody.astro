---
import PortableText from '../portable-text/PortableText.astro';
import type { PortableText as Body } from '../../../../studio/sanity.types';
import type { Resolved } from '../portable-text/types';
interface Props extends Resolved { body: Body; }
const { body, links, images } = Astro.props;
const sections: { id?: string; blocks: Body }[] = [];
for (const block of body) {
  if (!sections.length || (block._type === 'block' && ['h2', 'h3'].includes(block.style ?? ''))) {
    sections.push({ id: block._type === 'block' && ['h2', 'h3'].includes(block.style ?? '') ? `section-${block._key}` : undefined, blocks: [] });
  }
  sections.at(-1)!.blocks.push(block);
}
---
<div class="post-body">
  {sections.map((section) => <div id={section.id} class="body-section"><PortableText value={section.blocks} links={links} images={images} /></div>)}
</div>
<style>
  .post-body { display: grid; gap: var(--space-l); }
  .body-section { scroll-margin-block-start: 7rem; min-inline-size: 0; }
</style>
