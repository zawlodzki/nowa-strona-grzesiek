---
import PortableText from '../portable-text/PortableText.astro';
import Span from '../portable-text/Span.astro';
import type { Resolved } from '../portable-text/types';
import type { PostSection } from './outline';
interface Props extends Resolved { sections: PostSection[]; }
const { sections, links, images } = Astro.props;
---
<div class="post-body">
  {sections.map(({ heading, blocks }) => {
    const Tag = heading?.level ?? 'h2';
    return <div class="body-section">
      {heading && <Tag id={heading.id} data-post-heading>{heading.block.children?.map((span) => <Span span={span} definitions={heading.block.markDefs} links={links} />)}</Tag>}
      <PortableText value={blocks} links={links} images={images} />
    </div>;
  })}
</div>
<style>
  .post-body { display: grid; gap: var(--space-l); }
  .body-section { display: grid; gap: var(--space-s); min-inline-size: 0; }
  [data-post-heading] { scroll-margin-block-start: 7.5rem; }
</style>
