---
import type { NewsletterSignup } from '../../../../studio/sanity.types';
import LeadForm from '../forms/LeadForm.astro';

interface Props { data: NewsletterSignup; id?: string; headingLevel?: 'h1' | 'h2'; }
const { data, id = 'newsletter', headingLevel: Heading = 'h2' } = Astro.props;
const f = (name: string) => `${id}-${name}`;
---
<section id={id} class="content-grid section newsletter" aria-labelledby={f('heading')}>
  <div class="inner">
    <Heading id={f('heading')} class="type-heading-l">Newsletter <span class="accent">Sales Atlas</span></Heading>
    {data.body && <p class="body">{data.body}</p>}
    <LeadForm form="newsletter" id={f('form')} visible={['email', 'newsletter']} submitLabel="Zapisuję się" tone="dark" class="signup">
      <div class="field">
        <label class="visually-hidden" for={f('email')}>Adres e-mail</label>
        <input id={f('email')} name="email" type="email" placeholder="Adres e-mail" autocomplete="email" maxlength="256" required />
      </div>
      <input type="hidden" name="newsletter" value="on" />
    </LeadForm>
    <p class="legal type-body-s">Zapisując się, zamawiasz newsletter Wellbiz sp. z o.o. i zgadzasz się na otrzymywanie e-maili z poradami i ofertami. Wypiszesz się jednym kliknięciem. Link jest w każdej wiadomości. <a href="/regulamin-newslettera">Regulamin newslettera</a>, <a href="/polityka-prywatnosci">Polityka prywatności</a>.</p>
  </div>
</section>

<style>
  .newsletter { background: linear-gradient(45deg, var(--surface-dark) 50%, var(--color-primary-60)); color: var(--text-on-dark); }
  .inner {
    container-type: inline-size;
    display: grid;
    gap: var(--space-s);
    justify-items: center;
    text-align: center;
    margin-inline: auto;
    inline-size: 100%;
    max-inline-size: 44rem;
  }
  :is(h1, h2) { color: var(--text-on-dark); }
  .accent { background: linear-gradient(315deg, var(--color-secondary-60), var(--text-on-dark) 84%); background-clip: text; -webkit-text-fill-color: transparent; }
  .body { color: var(--text-on-dark-muted); max-inline-size: 60ch; }
  .inner > :global(.signup) {
    --newsletter-control-height: clamp(3.125rem, 2.9437rem + .7735vw, 3.5625rem);
    inline-size: 100%;
    max-inline-size: 30rem;
    grid-template-columns: minmax(0, 1fr) max-content;
    align-items: center;
    gap: var(--space-2xs);
  }
  .inner :global(.signup .field) { display: contents; }
  .inner :global(.signup .field > input) { grid-column: 1; grid-row: 1; padding: var(--space-2xs) var(--space-xs); }
  .inner :global(.signup .submit) {
    grid-column: 2;
    grid-row: 1;
    justify-self: stretch;
    border: var(--border-width-button) solid var(--border-accent);
    padding: var(--space-2xs) var(--space-m);
    font-weight: var(--font-weight-regular);
  }
  .inner :global(.signup :is(.field > input, .submit)) {
    block-size: var(--newsletter-control-height);
    min-block-size: var(--newsletter-control-height);
  }
  .inner :global(.signup .cf-turnstile), .inner :global(.signup .status) { grid-column: 1 / -1; }
  @container (width < 30rem) { .inner > :global(.signup) { column-gap: 0; } }
  .legal { color: var(--text-on-dark-muted); max-inline-size: 60ch; }
  .legal a { color: var(--text-link-on-dark); }
  .legal a:active { color: var(--text-on-dark); }
  @media (hover: hover) and (pointer: fine) {
    .legal a:hover { color: var(--text-on-dark); }
  }
</style>
