---
import type { NewsletterSignup } from '../../../../studio/sanity.types';
import { safeHref } from '../portable-text/types';
import LeadForm from '../forms/LeadForm.astro';

interface Props { data: NewsletterSignup; id?: string; headingLevel?: 'h1' | 'h2'; }
const { data, id = 'newsletter', headingLevel: Heading = 'h2' } = Astro.props;
const f = (name: string) => `${id}-${name}`;

// Editors override any of these in Studio; an empty field keeps the default.
const defaults = {
  heading: 'Newsletter',
  headingAccent: 'Sales Atlas',
  emailLabel: 'Adres e-mail',
  emailPlaceholder: 'Adres e-mail',
  submitLabel: 'Zapisuję się',
  waitLabel: 'Zaczekaj chwilę…',
  legal: 'Zapisując się, zamawiasz newsletter Wellbiz sp. z o.o. i zgadzasz się na otrzymywanie e-maili z poradami i ofertami. Wypiszesz się jednym kliknięciem. Link jest w każdej wiadomości.',
};
const copy = Object.fromEntries(Object.entries(defaults).map(([key, value]) => [key, (data.copy?.[key as keyof typeof defaults] ?? '').trim() || value])) as typeof defaults;
const editedLinks = (data.copy?.legalLinks ?? []).flatMap((link) => {
  const href = safeHref(link.href);
  return href && link.label?.trim() ? [{ href, label: link.label }] : [];
});
const legalLinks = editedLinks.length > 0 ? editedLinks : [{ href: '/regulamin-newslettera', label: 'Regulamin newslettera' }, { href: '/polityka-prywatnosci', label: 'Polityka prywatności' }];
---
<section id={id} class="content-grid section newsletter" aria-labelledby={f('heading')}>
  <div class="inner">
    <Heading id={f('heading')} class="type-heading-l">{copy.heading}{' '}<span class="accent">{copy.headingAccent}</span></Heading>
    {data.body && <p class="body">{data.body}</p>}
    <LeadForm form="newsletter" id={f('form')} visible={['email', 'newsletter']} submitLabel={copy.submitLabel} waitLabel={copy.waitLabel} tone="dark" class="signup">
      <div class="field">
        <label class="visually-hidden" for={f('email')}>{copy.emailLabel}</label>
        <input id={f('email')} name="email" type="email" placeholder={copy.emailPlaceholder} autocomplete="email" maxlength="256" required />
      </div>
      <input type="hidden" name="newsletter" value="on" />
    </LeadForm>
    <p class="legal type-body-s">{copy.legal}{' '}{legalLinks.map((link, index) => <>{index > 0 && ', '}<a href={link.href}>{link.label}</a></>)}.</p>
  </div>
</section>

<style>
  .newsletter { background: var(--surface-dark); color: var(--text-on-dark); }
  .inner {
    container-type: inline-size;
    display: grid;
    gap: var(--space-s);
    justify-items: center;
    text-align: center;
    margin-inline: auto;
    inline-size: 100%;
    max-inline-size: 44rem;
  }
  :is(h1, h2) { color: var(--text-on-dark); }
  .accent { color: var(--text-link-on-dark); }
  .body { color: var(--text-on-dark-muted); max-inline-size: 60ch; }
  .inner > :global(.signup) {
    --newsletter-control-height: 52px;
    inline-size: 100%;
    max-inline-size: 30rem;
    grid-template-columns: minmax(0, 1fr) max-content;
    align-items: center;
    gap: var(--space-2xs);
  }
  .inner :global(.signup .field) { display: contents; }
  .inner :global(.signup .field > input) { grid-column: 1; grid-row: 1; padding: var(--space-2xs) var(--space-xs); }
  .inner :global(.signup .submit) {
    grid-column: 2;
    grid-row: 1;
    justify-self: stretch;
    border: 0;
    border-radius: 999px;
    white-space: nowrap;
    padding: var(--space-2xs) var(--space-m);
    font-weight: var(--font-weight-medium);
  }
  .inner :global(.signup :is(.field > input, .submit)) {
    block-size: var(--newsletter-control-height);
    min-block-size: var(--newsletter-control-height);
  }
  .inner :global(.signup .cf-turnstile), .inner :global(.signup .status) { grid-column: 1 / -1; }
  @container (width < 30rem) { .inner > :global(.signup) { grid-template-columns: minmax(0, 1fr); } .inner :global(.signup .submit) { grid-column: 1; grid-row: 2; inline-size: 100%; } }
  @media (hover: hover) and (pointer: fine) { .inner :global(.signup .submit:hover) { background: var(--surface-tint); } }
  @media (width < 30rem) { .inner :global(.signup .submit) { padding-inline: 12px; } }
  .legal { color: var(--text-on-dark-muted); max-inline-size: 60ch; }
  .legal a { color: var(--text-link-on-dark); }
  .legal a:active { color: var(--text-on-dark); }
  @media (hover: hover) and (pointer: fine) {
    .legal a:hover { color: var(--text-on-dark); }
  }
</style>
