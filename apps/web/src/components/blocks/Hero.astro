---
import type { Hero } from '../../../../studio/sanity.types';
import type { ResolvedImage } from '../ui/block-types';
import { consultation } from '../ui/block-types';
import BlockSection from '../ui/BlockSection.astro';
import Button from '../ui/Button.astro';
import MediaImage from '../ui/MediaImage.astro';
interface Props { data: Hero; image?: ResolvedImage; badgeImage?: ResolvedImage; headingLevel?: 'h1' | 'h2'; }
const { data, image, badgeImage, headingLevel: Heading = 'h1' } = Astro.props;
---
<BlockSection kind="hero">
  <div class:list={['hero-layout', { 'has-image': image }]}>
    <div class="copy">
      {data.tagline && <p class="type-tagline">{data.tagline}</p>}
      {data.heading && <Heading class="type-display">{data.heading}</Heading>}
      {data.body && <p>{data.body}</p>}
      <div class="actions"><Button link={data.cta ?? consultation} />
        {(data.badges?.length ?? 0) > 0 && <ul class="badges type-body-s">{data.badges?.map((badge) => <li>{badge}</li>)}</ul>}
      </div>
    </div>
    {image && <div class:list={["portrait", { wide: data.badgeSize === "wide" }]}><div class="portrait-image"><MediaImage image={image} eager portrait /></div>{badgeImage && <img class="image-badge" src={badgeImage.src} alt={badgeImage.alt} width={badgeImage.width} height={badgeImage.height} />}</div>}
  </div>
</BlockSection>
<style>
  .hero-layout { display: grid; gap: var(--space-2xl); align-items: center; }
  .copy { display: flex; flex-direction: column; align-items: start; gap: var(--space-m); max-inline-size: 65ch; }
  .copy > * { overflow-wrap: anywhere; }
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-s); inline-size: 100%; }
  .badges { display: flex; flex-wrap: wrap; gap: var(--space-xs); padding: 0; margin: 0; list-style: none; color: var(--text-muted); }
  /* Match live: compact photo-first below the 992px viewport breakpoint. */
  .hero-layout { gap: var(--space-l); }
  .copy { align-items: center; text-align: center; justify-self: center; }
  .actions { justify-content: center; }
  .portrait { position: relative; display: grid; isolation: isolate; justify-self: center; order: -1; inline-size: min(100%, clamp(7rem, 18.75vw, 9rem)); }
  .portrait > * { grid-area: 1 / 1; }
  /* The cut-out has transparent edges: inset onto the visible torso, not outside its box. */
  .image-badge { position: absolute; z-index: 2; inline-size: 46%; block-size: auto; inset-block-end: -8%; inset-inline-start: 3%; }
  .wide .image-badge { inline-size: 55%; }
  @media (width >= 62rem) {
    .has-image { grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); gap: var(--space-2xl); }
    .copy { align-items: start; text-align: start; justify-self: start; }
    .actions { justify-content: start; }
    .portrait { order: 0; inline-size: min(100%, 27.3rem); }
    .image-badge { inline-size: 34%; }
    .wide .image-badge { inline-size: 52%; }
  }
</style>
