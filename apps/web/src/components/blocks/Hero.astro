---
import { pageHeadingId } from '../../lib/headings';
import type { Hero } from '../../../../studio/sanity.types';
import type { ResolvedImage } from '../ui/block-types';
import { consultation } from '../ui/block-types';
import BlockSection from '../ui/BlockSection.astro';
import Button from '../ui/Button.astro';
import MediaImage from '../ui/MediaImage.astro';
interface Props { data: Hero; image?: ResolvedImage; badgeImage?: ResolvedImage; headingLevel?: 'h1' | 'h2'; }
const { data, image, badgeImage, headingLevel: Heading = 'h1' } = Astro.props;
---
<BlockSection kind="hero">
  <div class:list={['hero-layout', { 'has-image': image }]}>
    <div class="copy">
      {data.tagline && <p class="type-tagline">{data.tagline}</p>}
      {data.heading && <Heading id={pageHeadingId(Astro.locals, data.heading)} class="type-display">{data.heading}</Heading>}
      {data.body && <p>{data.body}</p>}
      <div class="actions"><Button link={data.cta ?? consultation} />
        {(data.badges?.length ?? 0) > 0 && <ul class="badges type-body-s">{data.badges?.map((badge) => <li>{badge}</li>)}</ul>}
      </div>
    </div>
    {image && <div class:list={["portrait", { wide: data.badgeSize === "wide" }]} style={`--portrait-ratio: ${image.width / image.height}`}><div class="portrait-image"><MediaImage image={image} eager portrait /></div>{badgeImage && <img class="image-badge" src={badgeImage.src} alt={badgeImage.alt} width={badgeImage.width} height={badgeImage.height} />}</div>}
  </div>
</BlockSection>
<style>
  :is(h2, h3)[id] { scroll-margin-top: 7.5rem; }
  .hero-layout { display: grid; gap: var(--space-2xl); align-items: center; }
  .copy { display: flex; flex-direction: column; align-items: start; gap: var(--space-m); max-inline-size: 65ch; }
  .copy > * { overflow-wrap: anywhere; }
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-s); inline-size: 100%; }
  .badges { display: flex; flex-wrap: wrap; gap: var(--space-xs); padding: 0; margin: 0; list-style: none; color: var(--text-muted); }
  /* Track MediaImage’s height-capped photo rather than its letterboxed column. */
  .portrait { position: relative; display: grid; isolation: isolate; justify-self: center; inline-size: min(100%, calc(40svh * var(--portrait-ratio))); }
  .portrait > * { grid-area: 1 / 1; }
  /* Inset over the visible torso, inside the cut-out image’s transparent margins. */
  .image-badge { position: absolute; z-index: 2; inline-size: 34%; block-size: auto; inset-block-end: -8%; inset-inline-start: 3%; }
  .wide .image-badge { inline-size: 52%; }
  @container (width >= 48rem) { .portrait { inline-size: min(100%, calc(32rem * var(--portrait-ratio))); } .has-image { grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); } }
</style>
