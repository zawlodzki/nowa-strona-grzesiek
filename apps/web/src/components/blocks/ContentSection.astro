---
import { pageHeadingId } from '../../lib/headings';
import type { ContentSection } from '../../../../studio/sanity.types';
import { safeHref } from '../ui/block-types';
import type { ResolvedImage } from '../ui/block-types';
import BlockSection from '../ui/BlockSection.astro';
import PortableText from '../portable-text/PortableText.astro';
import type { PortableTextValue, Resolved } from '../portable-text/types';
import Diagram from '../diagrams/Diagram.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import MediaImage from '../ui/MediaImage.astro';
interface Props extends Resolved { data: ContentSection; image?: ResolvedImage; }
const { data, image, links, images } = Astro.props;
const { layout = 'list' } = data;
const metrics = layout === 'cards' && Boolean(data.items?.length) && data.items!.every((item) => /^\d+\s+/.test(item.title ?? ''));
const linkOnly = layout === 'list' && Boolean(data.items?.length) && data.items!.every((item) => item.link?.label && safeHref(item.link.href) && !item.text && !item.icon);
function paragraphs(value: PortableTextValue = []): PortableTextValue {
  return value.flatMap((block) => {
    if (block._type !== 'block' || (block.style && block.style !== 'normal') || block.listItem) return [block];
    const lines: NonNullable<typeof block.children>[] = [[]];
    for (const span of block.children ?? []) {
      (span.text ?? '').split(/\r?\n/).forEach((text, index) => {
        if (index) lines.push([]);
        lines.at(-1)!.push({ ...span, text });
      });
    }
    return lines.filter((line) => line.some((span) => span.text?.trim())).map((children, index) => {
      const first = children.find((span) => span.text?.trim());
      const bullet = first && /^\s*(?:→|-)\s+/.test(first.text ?? '');
      return { ...block, _key: `${block._key}-${index}`, children: children.map((span) => span === first && bullet ? { ...span, text: span.text?.replace(/^\s*(?:→|-)\s+/, '') } : span), ...(bullet ? { listItem: 'bullet' as const, level: 1 } : {}) };
    });
  });
}

---
<BlockSection kind="content-section">
  <div class="content-layout">
    <header class="intro">
      {data.tagline && <p class="type-tagline">{data.tagline}</p>}
      {data.heading && <h2 id={pageHeadingId(Astro.locals, data.heading)}>{data.heading}</h2>}
      <slot name="intro"><PortableText value={paragraphs(data.intro)} links={links} images={images} /></slot>
      {linkOnly && <nav class="inline-links" aria-label={data.heading || 'Usługi'}>{data.items?.map((item) => <a href={safeHref(item.link?.href)}>{item.link?.label}</a>)}</nav>}
    </header>
    {!linkOnly && (data.items?.length ?? 0) > 0 && <ul class:list={['items', layout, { metrics }]}>{data.items?.map((item) => {
      const metric = metrics ? /^(\d+)\s+(.+)$/.exec(item.title ?? '') : null;
      const plus = metric && /^\+\s+/.test(item.text ?? '');
      return <li class:list={{ negative: item.icon === 'close' }}>
      {layout === 'checklist' && <Icon name={item.icon === 'close' ? 'close' : 'check'} />}
      <div class="item-copy">
        {metric ? <><h3 id={pageHeadingId(Astro.locals, metric[2])} class="metric-label">{metric[2]}</h3></> : layout === 'checklist' ? item.title && <p class="checklist-title">{item.title}</p> : item.title && <h3 id={pageHeadingId(Astro.locals, item.title)} class="type-heading-xs">{item.title}</h3>}
        {item.text && <p class:list={{ 'metric-text': metrics }}>{(plus ? item.text.replace(/^\+\s+/, '') : item.text).split(/\n+/).map((line) => <span class="text-paragraph">{line}</span>)}</p>}
        {item.link && <Button link={item.link} variant="text" />}
      </div>
    </li>; })}</ul>}
    <slot name="media">{data.media?.kind === 'diagram' && data.media.key ? <Diagram diagram={data.media.key} /> : image && <MediaImage image={image} />}</slot>
  </div>
</BlockSection>
<style>
  :is(h2, h3)[id] { scroll-margin-top: 7.5rem; }
  .content-layout { display: grid; gap: var(--space-l); }
  .intro { display: grid; gap: var(--space-m); max-inline-size: 40rem; overflow-wrap: anywhere; }
  .inline-links { display: flex; flex-wrap: wrap; gap: var(--space-2xs) var(--space-s); }
  .inline-links a { display: inline-flex; align-items: center; min-block-size: 44px; color: var(--text-link); font-weight: var(--font-weight-medium); text-decoration: none; }
  .inline-links a:active { color: var(--text-link-active); }
  @media (hover: hover) and (pointer: fine) { .inline-links a:hover { color: var(--text-link-hover); text-decoration: underline; text-underline-offset: .18em; } }
  .items { list-style: none; padding: 0; margin: 0; display: grid; gap: var(--space-m); }
  .items > li { min-inline-size: 0; }
  .item-copy { display: grid; gap: var(--space-xs); max-inline-size: 65ch; overflow-wrap: anywhere; }
  .cards { grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr)); }
  .cards > li { background: var(--surface-soft); border-radius: var(--radius-lg); padding: var(--space-m); }
  .cards h3 { color: var(--text-link); }
  .checklist-title { font-family: var(--font-family-body); font-size: var(--typography-body-size); font-weight: var(--font-weight-medium); line-height: var(--typography-body-leading); }
  .text-paragraph { display: block; }
  .text-paragraph + .text-paragraph { margin-block-start: var(--space-s); }
  .twoColumn { grid-template-columns: repeat(auto-fit, minmax(min(100%, 24rem), 1fr)); }
  .checklist > li { display: flex; align-items: start; gap: var(--space-xs); }
  .checklist :global(svg) { color: var(--text-link); }
  .checklist li.negative :global(svg) { color: var(--text-error); }
  .list > li { padding-block-end: var(--space-m); border-block-end: 1px solid var(--border-hairline); }
</style>
