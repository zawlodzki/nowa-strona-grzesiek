---
import { pageHeadingId } from '../../lib/headings';
import type { CtaBand } from '../../../../studio/sanity.types';
import { consultation } from '../ui/block-types';
import BlockSection from '../ui/BlockSection.astro';
import Button from '../ui/Button.astro';
interface Props { data: CtaBand; tone?: 'accent' | 'soft'; }
const { data, tone = 'accent' } = Astro.props;
const bare = !data.heading && !data.body;
---
{bare ? (
  <BlockSection kind="cta-band cta-bare"><Button link={data.cta ?? consultation} /></BlockSection>
) : (
  <BlockSection kind="cta-band"><div class:list={['band', tone]}>
    <div class="copy">{data.heading && <h2 id={pageHeadingId(Astro.locals, data.heading)}>{data.heading}</h2>}{data.body && <p>{data.body}</p>}</div>
    <Button link={data.cta ?? consultation} variant={tone === 'accent' ? 'on-dark' : 'primary'} />
  </div></BlockSection>
)}
<style>
  :is(h2, h3)[id] { scroll-margin-top: 7.5rem; }
  .band { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-l); padding: clamp(1.5rem, 5cqi, 4rem); border-radius: var(--radius-lg); background: var(--surface-accent); color: var(--text-on-accent); }
  .band h2 { color: inherit; }
  .copy { min-inline-size: 0; flex: 1 1 24rem; display: grid; gap: var(--space-s); max-inline-size: 65ch; overflow-wrap: anywhere; }
  .soft { background: var(--surface-soft); color: var(--text-body); }
  .band > :global(.action) { flex: 0 0 auto; }
  @media (width < 30rem) { .band { padding-inline: var(--space-xs); } }
  :global(.section:has(+ .cta-bare)) { padding-block-end: var(--space-m); }
  :global(.section.cta-bare) { padding-block-start: 0; }
</style>
