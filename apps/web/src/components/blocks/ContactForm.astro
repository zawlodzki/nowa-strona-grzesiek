---
import type { ContactForm } from '../../../../studio/sanity.types';
import LeadForm from '../forms/LeadForm.astro';
import type { ResolvedImage } from '../portable-text/types';
import { safeHref } from '../portable-text/types';

interface Props {
  data: ContactForm;
  // From the person document. The details column renders only when showDetails is on, an email or phone is present and the block has no channels.
  contact?: { email?: string; telephone?: string; image?: ResolvedImage };
  id?: string;
}
const { data, contact = {}, id = 'kontakt' } = Astro.props;
const variant = data.variant ?? 'landing';
const full = variant === 'full';
const form = data.formId ?? (full ? 'main-contact' : 'landing-contact');
// /kontakt has no hero, so the full variant carries the page's H1.
const Heading = full ? 'h1' : 'h2';
const f = (name: string) => `${id}-${name}`;

// Calendar, consultation and channels belong to the full variant only (/kontakt).
const calendarHref = safeHref(data.calendar?.link?.href);
const calendar = full && data.calendar?.heading && calendarHref ? { ...data.calendar, href: calendarHref } : undefined;
const consultation = full && data.consultation?.heading && data.consultation.body ? data.consultation : undefined;
const social = new Set(['linkedin', 'github', 'x', 'youtube', 'instagram']);
const groups = (full ? data.channels?.groups ?? [] : []).flatMap((group) => {
  const items = (group.items ?? []).flatMap((item) => {
    const href = safeHref(item.href);
    return href && item.kind && item.label?.trim() ? [{ ...item, kind: item.kind, label: item.label, href }] : [];
  });
  return group.title && items.length > 0 ? [{ ...group, title: group.title, icons: items.filter((item) => social.has(item.kind)), rows: items.filter((item) => !social.has(item.kind)) }] : [];
});
const channels = groups.length > 0 ? data.channels : undefined;

const details = data.showDetails !== false && !channels && (contact.email || contact.telephone);
const side = Boolean(calendar || consultation || details);
const tel = contact.telephone?.replace(/[^\d+]/g, '');

// Stroke icons on a 24 grid, drawn in currentColor so they follow the link state.
const icons: Record<string, string> = {
  linkedin: '<rect x="3" y="3" width="18" height="18" rx="3"/><path d="M8 10.5V17M8 7.5v.01M12 17v-6.5m0 2.75a2.75 2.75 0 0 1 5.5 0V17"/>',
  github: '<path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/>',
  x: '<path d="M4 4h4.5L20 20h-4.5zM4 20l6.7-6.7m2.6-2.6L20 4"/>',
  youtube: '<rect x="2" y="5" width="20" height="14" rx="4"/><path d="m10 9 5 3-5 3z"/>',
  instagram: '<rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><path d="M17.5 6.5v.01"/>',
  email: '<rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/>',
  phone: '<path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.96.4 1.9.7 2.8a2 2 0 0 1-.45 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.45c.9.3 1.84.6 2.8.7a2 2 0 0 1 1.7 2z"/>',
  signal: '<path d="M21 11.5a8.4 8.4 0 0 1-12.4 7.6L3 21l1.9-5.6A8.4 8.4 0 1 1 21 11.5z"/>',
  whatsapp: '<path d="M21 11.5a8.4 8.4 0 0 1-12.4 7.6L3 21l1.9-5.6A8.4 8.4 0 1 1 21 11.5z"/><path d="M9.5 8.5c0 3 2.5 5.5 5.5 5.5l1-1.5-2-1-1 1a3.5 3.5 0 0 1-2-2l1-1-1-2z"/>',
};
---
<section id={id} class="content-grid section contact" aria-labelledby={data.heading ? f('heading') : undefined}>
  <div class="inner">
    {(data.tagline || data.heading || data.intro) && (
      <header class="head">
        {data.tagline && <p class="type-tagline">{data.tagline}</p>}
        {data.heading && <Heading id={f('heading')} class="type-heading-l">{data.heading}</Heading>}
        {data.intro && <p class="type-body lines">{data.intro}</p>}
      </header>
    )}
    <div class:list={['card', { split: side, full }]}>
      <LeadForm form={form} id={f('form')} visible={['email', 'phone', 'message', 'newsletter', 'marketing-emails']} submitLabel="Wyślij zapytanie">
        <div class="field">
          <label class="visually-hidden" for={f('email')}>E-mail <span class="required">(wymagane)</span></label>
          <input id={f('email')} name="email" placeholder="E-mail" type="email" autocomplete="email" maxlength="256" required />
        </div>
        <div class="field">
          <label class="visually-hidden" for={f('phone')}>Telefon</label>
          <input id={f('phone')} name="phone" placeholder="Telefon" type="tel" autocomplete="tel" maxlength="256" />
        </div>
        <div class="field">
          <label class="visually-hidden" for={f('message')}>Temat rozmowy</label>
          <textarea id={f('message')} name="message" placeholder="Temat rozmowy" maxlength="5000"></textarea>
        </div>
        <p class="note type-body-s">Twoich danych użyjemy tylko po to, żeby odpowiedzieć na zgłoszenie i umówić rozmowę. Administratorem danych jest Wellbiz sp. z o.o. Szczegóły: <a href="/polityka-prywatnosci">Polityka prywatności</a>.</p>
        <label class="check type-body-s"><input type="checkbox" name="newsletter" /><span>Przy okazji wyślij mi raz w tygodniu nowości dotyczące nowych technologii w sprzedaży B2B. Bez spamu, wypiszesz się jednym kliknięciem.</span></label>
        <label class="check type-body-s"><input type="checkbox" name="marketing-emails" /><span>Chcę otrzymywać od Wellbiz sp. z o.o. informacje o usługach i ofertach na podany adres e-mail.</span></label>
      </LeadForm>
      {side && (
        <div class="side">
          {calendar && (
            <div class="note-block">
              <h2 class="type-heading-s">{calendar.heading}</h2>
              <p>{calendar.text && <>{calendar.text} </>}<a class="strong-link" href={calendar.href}>{calendar.link?.label}</a></p>
            </div>
          )}
          {consultation && (
            <div class="note-block">
              <h2 class="type-heading-s">{consultation.heading}</h2>
              <p class="lines">{consultation.body}</p>
            </div>
          )}
          {details && (
            <aside class="details" aria-labelledby={f('details')}>
              <img class="portrait" src="/brand/contact-profile.avif" width="450" height="450" alt="Grzegorz Zawłodzki" loading="lazy" decoding="async" />
              <h3 id={f('details')} class="type-heading-s">Bezpośredni kontakt</h3>
              <p>Wyślij e-mail, napisz SMS lub zadzwoń.</p>
              <ul class="channel-rows" role="list">
                {contact.email && (
                  <li><a class="with-icon" href={`mailto:${contact.email}`}>
                    <svg viewBox="0 0 20 16" aria-hidden="true"><path d="M2 0h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V2a2 2 0 0 1 2-2m0 3v.5l8 5 8-5V3l-8 5z" /></svg>
                    <span>{contact.email}</span>
                  </a></li>
                )}
                {contact.telephone && tel && (
                  <li><a class="with-icon" href={`tel:${tel}`}>
                    <svg viewBox="0 0 18 18" aria-hidden="true"><path d="M3.6 7.8a15 15 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V17a1 1 0 0 1-1 1A17 17 0 0 1 0 1a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z" /></svg>
                    <span>{contact.telephone}</span>
                  </a></li>
                )}
              </ul>
            </aside>
          )}
        </div>
      )}
    </div>
    {channels && (
      <div class="channels" role="group" aria-labelledby={channels.heading ? f('channels') : undefined}>
        {(channels.tagline || channels.heading) && (
          <header class="head">
            {channels.tagline && <p class="type-tagline">{channels.tagline}</p>}
            {channels.heading && <h2 id={f('channels')} class="type-heading-l">{channels.heading}</h2>}
          </header>
        )}
        <ul class="groups" role="list">
          {groups.map((group) => (
            <li class="group">
              <h3 class="type-heading-s">{group.title}</h3>
              {group.note && <p>{group.note}</p>}
              {group.icons.length > 0 && (
                <ul class="channel-icons" role="list">
                  {group.icons.map((item) => (
                    <li><a class="icon-link" href={item.href} aria-label={item.label}><svg viewBox="0 0 24 24" aria-hidden="true" set:html={icons[item.kind]} /></a></li>
                  ))}
                </ul>
              )}
              {group.rows.length > 0 && (
                <ul class="channel-rows" role="list">
                  {group.rows.map((item) => (
                    <li><a class="with-icon" href={item.href}><svg class="stroke" viewBox="0 0 24 24" aria-hidden="true" set:html={icons[item.kind]} /><span>{item.label}</span></a></li>
                  ))}
                </ul>
              )}
            </li>
          ))}
        </ul>
      </div>
    )}
  </div>
</section>

<style>
  .inner { container-type: inline-size; display: grid; gap: var(--space-l); }
  .head { display: grid; gap: var(--space-2xs); max-inline-size: 40rem; }
  .lines { white-space: pre-line; }
  .card {
    --lead-form-gap: clamp(.5rem, .39640884rem + .44198895vw, .75rem);
    display: grid;
    gap: var(--space-xl);
    padding: var(--layout-box-pad);
    border-radius: var(--radius-lg);
    background: var(--surface-soft);
  }
  @container (width >= 48rem) {
    .split { grid-template-columns: 1.4fr 1fr; gap: var(--space-2xl); }
  }
  .card.full { --lead-form-gap: var(--space-2xs); }
  .side { display: grid; gap: var(--space-xl); align-content: start; }
  .note-block { display: grid; gap: var(--space-2xs); }
  .strong-link { font-weight: var(--font-weight-medium); }
  .details { display: grid; gap: var(--space-xs); align-content: start; }
  .portrait { inline-size: 20%; block-size: auto; aspect-ratio: 1; object-fit: cover; margin-block-end: var(--space-xs); }
  .channel-rows { display: grid; gap: var(--space-3xs); margin: 0; padding: 0; list-style: none; }
  .channel-rows a { min-block-size: 44px; align-items: center; font-weight: var(--font-weight-medium); overflow-wrap: anywhere; }
  .channel-rows svg { block-size: 1cap; }
  .channel-rows svg.stroke { block-size: 1.3cap; }
  .stroke, .channel-icons svg { fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }

  .channels { display: grid; gap: var(--space-l); margin-block-start: var(--space-2xl); }
  .groups {
    display: grid;
    gap: var(--space-xl) var(--space-2xl);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .group { display: grid; gap: var(--space-xs); align-content: start; }
  .channel-icons { display: flex; flex-wrap: wrap; gap: var(--space-2xs); margin: 0; padding: 0; list-style: none; }
  .icon-link {
    display: grid;
    place-items: center;
    inline-size: 44px;
    block-size: 44px;
    border-radius: var(--radius-md);
    background: var(--surface-soft);
    color: var(--text-heading);
  }
  .icon-link svg { inline-size: 1.5rem; block-size: 1.5rem; }
  .icon-link:active { background: var(--surface-tint); color: var(--text-link-active); }
  @media (hover: hover) and (pointer: fine) {
    .icon-link:hover { background: var(--surface-tint); color: var(--text-link-hover); }
  }
</style>
