---
import { pageHeadingId } from '../../lib/headings';
import type { Pricing } from '../../../../studio/sanity.types';
import Button from '../ui/Button.astro';

interface Props { data: Pricing; id?: string; }
const { data, id = 'cennik' } = Astro.props;
const plans = data.plans ?? [];
const hasHighlighted = plans.some((plan) => plan.highlighted);
// Polish skips grouping for four digits by default; the refine wants "6 000 zł".
const whole = new Intl.NumberFormat('pl-PL', { maximumFractionDigits: 0, useGrouping: 'always' });
const cents = new Intl.NumberFormat('pl-PL', { minimumFractionDigits: 2, maximumFractionDigits: 2, useGrouping: 'always' });
const amount = (price: number) => (Number.isInteger(price) ? whole : cents).format(price);
const currency = { PLN: 'zł' } as const;
// Keep the currency beside the amount; Sanity units may already include it.
const priceParts = (plan: NonNullable<Pricing['plans']>[number]) => {
  const symbol = currency[plan.currency ?? 'PLN'] ?? plan.currency;
  const unit = (plan.unit ?? '').trim();
  const suffix = unit === symbol ? '' : unit.startsWith(`${symbol} `) ? unit.slice(symbol.length).trim() : unit;
  return plan.price != null
    ? { value: `${amount(plan.price)} ${symbol}`, unit: suffix }
    : { value: plan.unit || plan.priceNote, unit: '' };
};
const tierLabel = (name = '') => name
  .replace('Wdrożenie powyżej ', 'Ponad ')
  .replace('Wdrożenie 5+ handlowców', 'Zespół 5+')
  .replace('Diagnoza CRM Salesforce', 'Diagnoza Salesforce')
  .replace('Audyt gotowości na AI', 'Gotowość na AI')
  .replace('Audyt istniejącej Asany', 'Audyt Asany')
  .replace('Wdrożenie do ', 'Do ')
  .replace('Audyt AI w sprzedaży', 'Audyt AI');
const ctaLabel = (label = '') => ({
  'Porozmawiajmy o zakresie i cenie': 'Omówmy zakres',
}[label] ?? label.replace(/^Umów rozmowę o .+$/, 'Umów rozmowę'));
---
{plans.length > 0 && (
  <section id={id} class="content-grid section pricing" aria-labelledby={`${id}-heading`}>
    <div class="inner">
      <header class="head">
        {data.tagline && <p class="type-tagline">{data.tagline}</p>}
        <h2 id={`${id}-heading`}>{data.heading}</h2>
      </header>
      <ul class:list={['plans', { single: plans.length === 1 }]} role="list">
        {plans.map((plan) => {
          const price = priceParts(plan);
          return (
            <li class:list={['plan', { highlighted: plan.highlighted }]}>
              <h3 id={pageHeadingId(Astro.locals, plan.name ?? '')} class="tier type-tagline">{tierLabel(plan.name)}</h3>
              <p class="price">
                {plan.price != null
                  ? <><span class="type-price">{price.value}</span>{price.unit && <span class="unit type-body-s"> {price.unit}</span>}</>
                  : <span class="type-heading-m price-label">{price.value}</span>}
              </p>
              <p class="note type-body-s">{(plan.price != null || plan.unit) && plan.priceNote}</p>
              <div class="pricing-action">{plan.cta?.label && <Button link={{ ...plan.cta, label: ctaLabel(plan.cta.label) }} variant={hasHighlighted && !plan.highlighted ? 'secondary' : 'primary'} />}</div>
              <ul class="features" role="list">
                {(plan.features ?? []).map((feature) => (
                  <li class="with-icon"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M6.2 13.4 1.3 8.5l1.4-1.4 3.5 3.5 7.1-7.1 1.4 1.4z" /></svg><span>{feature}</span></li>
                ))}
              </ul>
            </li>
          );
        })}
      </ul>
    </div>
  </section>
)}

<style>
  :is(h2, h3)[id] { scroll-margin-block-start: 7.5rem; }
  .pricing { background: var(--surface-soft); }
  .inner { container-type: inline-size; display: grid; gap: var(--space-xl); }
  .head { display: grid; gap: var(--space-2xs); justify-items: center; text-align: center; max-inline-size: 44rem; justify-self: center; }

  .plans {
    display: grid;
    gap: var(--layout-grid-gap);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .single { grid-template-columns: minmax(0, 28rem); justify-content: center; }
  .plan {
    display: grid;
    grid-row: span 5;
    grid-template-rows: subgrid;
    row-gap: var(--space-s);
    padding: var(--space-l);
    border-radius: var(--radius-lg);
    background: var(--surface-page);
    box-shadow: var(--shadow-card);
  }
  .highlighted { outline: var(--border-width-emphasis) solid var(--border-focus); outline-offset: -2px; }

  .tier {
    justify-self: start;
    padding-block: 0;
    padding-inline: var(--space-2xs);
    align-self: start;
    white-space: nowrap;
    border-radius: var(--radius-sm);
    background: var(--surface-tint);
    color: var(--text-link);
    font-weight: var(--font-weight-medium);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .price { color: var(--text-heading); align-self: start; display: flex; flex-wrap: wrap; align-items: baseline; column-gap: 0.25em; font-variant-numeric: tabular-nums; }
  .type-price { white-space: nowrap; }
  .price-label { min-inline-size: 0; font-family: var(--typography-price-family); overflow-wrap: break-word; }
  .unit { color: var(--text-muted); }
  .note { color: var(--text-muted); }
  .note:empty { min-block-size: 0; }

  .pricing-action {
    --action-padding-inline: var(--space-m);
    display: grid;
    justify-items: center;
    align-items: start;
  }

  .features { display: grid; gap: var(--space-2xs); align-content: start; margin: 0; padding: 0; list-style: none; }
  .features li { display: flex; }
  .features svg { block-size: 1.1cap; fill: var(--color-status-success); }
</style>
