---
import type { Pricing } from '../../../../studio/sanity.types';
import { safeHref } from '../portable-text/types';

interface Props { data: Pricing; id?: string; }
const { data, id = 'cennik' } = Astro.props;
const plans = data.plans ?? [];
// Polish skips grouping for four digits by default; the refine wants "6 000 zł".
const whole = new Intl.NumberFormat('pl-PL', { maximumFractionDigits: 0, useGrouping: 'always' });
const cents = new Intl.NumberFormat('pl-PL', { minimumFractionDigits: 2, maximumFractionDigits: 2, useGrouping: 'always' });
const amount = (price: number) => (Number.isInteger(price) ? whole : cents).format(price);
const currency = { PLN: 'zł' } as const;
---
{plans.length > 0 && (
  <section id={id} class="content-grid section pricing" aria-labelledby={`${id}-heading`}>
    <div class="inner">
      <header class="head">
        {data.tagline && <p class="type-tagline">{data.tagline}</p>}
        <h2 id={`${id}-heading`}>{data.heading}</h2>
      </header>
      <ul class:list={['plans', { single: plans.length === 1 }]} role="list">
        {plans.map((plan) => {
          const href = safeHref(plan.cta?.href);
          return (
            <li class:list={['plan', { highlighted: plan.highlighted }]}>
              <h3 class="tier type-body-s">{plan.name}</h3>
              <p class="price">
                {plan.price !== undefined
                  ? <><span class="type-price">{amount(plan.price)} {currency[plan.currency ?? 'PLN']}</span>{plan.unit && <span class="unit"> {plan.unit}</span>}</>
                  : <span class="type-heading-s">{plan.priceNote}</span>}
              </p>
              <p class="note type-body-s">{plan.price !== undefined && plan.priceNote}</p>
              <div class="action">{href && plan.cta?.label && <a class:list={['cta', { secondary: !plan.highlighted && plans.some((p) => p.highlighted) }]} href={href}>{plan.cta.label}</a>}</div>
              <ul class="features" role="list">
                {(plan.features ?? []).map((feature) => (
                  <li class="with-icon"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M6.2 13.4 1.3 8.5l1.4-1.4 3.5 3.5 7.1-7.1 1.4 1.4z" /></svg><span>{feature}</span></li>
                ))}
              </ul>
            </li>
          );
        })}
      </ul>
    </div>
  </section>
)}

<style>
  .pricing { background: var(--surface-soft); }
  .inner { container-type: inline-size; display: grid; gap: var(--space-xl); }
  .head { display: grid; gap: var(--space-2xs); justify-items: center; text-align: center; max-inline-size: 44rem; justify-self: center; }

  .plans {
    display: grid;
    gap: var(--layout-grid-gap);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .single { grid-template-columns: minmax(0, 28rem); justify-content: center; }
  .plan {
    display: grid;
    grid-row: span 5;
    grid-template-rows: subgrid;
    row-gap: var(--space-s);
    padding: var(--space-l);
    border-radius: var(--radius-lg);
    background: var(--surface-page);
    box-shadow: var(--shadow-card);
  }
  .highlighted { outline: var(--border-width-emphasis) solid var(--border-focus); outline-offset: -2px; }

  .tier {
    justify-self: start;
    padding: var(--space-3xs) var(--space-xs);
    border-radius: var(--radius-sm);
    background: var(--surface-cyan-tint);
    color: var(--text-link);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    overflow-wrap: anywhere;
  }
  .price { color: var(--text-heading); overflow-wrap: anywhere; }
  .type-price { white-space: nowrap; }
  .unit { color: var(--text-muted); }
  .note { color: var(--text-muted); }
  .note:empty { display: none; }

  .cta {
    display: flex;
    align-items: center;
    justify-content: center;
    min-block-size: 48px;
    padding: var(--space-2xs) var(--space-m);
    border-radius: var(--radius-pill);
    background: var(--surface-accent);
    color: var(--text-on-accent);
    font-weight: var(--font-weight-medium);
    text-align: center;
    text-decoration: none;
    overflow-wrap: anywhere;
  }
  .cta.secondary { background: var(--surface-page); color: var(--text-link); box-shadow: inset 0 0 0 var(--border-width-button) var(--border-focus); }
  .cta:focus-visible { outline: var(--border-width-button) solid var(--border-focus); outline-offset: 3px; }
  .cta:active { background: var(--text-link-active); color: var(--text-on-accent); }
  @media (hover: hover) and (pointer: fine) {
    .cta:hover { background: var(--text-link-hover); color: var(--text-on-accent); }
  }
  @media (prefers-reduced-motion: no-preference) {
    .cta { transition: background-color var(--motion-duration-base) var(--motion-easing-out), color var(--motion-duration-base) var(--motion-easing-out); }
  }

  .features { display: grid; gap: var(--space-2xs); align-content: start; margin: 0; padding: 0; list-style: none; }
  .features li { display: flex; }
  .features svg { block-size: 1.1cap; fill: var(--color-status-success); }
</style>
