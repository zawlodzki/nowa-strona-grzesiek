---
import { pageHeadingId } from '../../lib/headings';
import type { LogoStrip } from '../../../../studio/sanity.types';
import type { ResolvedLogo } from '../ui/block-types';
import { safeHref } from '../ui/block-types';
import BlockSection from '../ui/BlockSection.astro';
interface Props { data: LogoStrip; logos: ResolvedLogo[]; }
const { data, logos } = Astro.props;
// Live brand treatments belong to each logo, regardless of the page using this strip.
// White artwork needs inversion. The logo's own flag wins; until production flags are set,
// the names Webflow marked .testimonial-logo.difference keep the live treatment.
const whiteByName = new Set(['smmash', 'iimarbella', 'deky expo']);
const inverts = (logo: ResolvedLogo) => logo.invert ?? whiteByName.has(logo.name?.toLowerCase() ?? '');
const small = new Set(['eagle lasers', 'american lens', '4hfix']);
const tools = data.variant === 'tools';
const hasHead = Boolean(data.tagline || data.title || data.intro);
const ordered = (data.logos ?? []).flatMap((ref) => { const logo = logos.find((item) => item._id === ref._ref); return logo ? [logo] : []; });
---
{ordered.length > 0 && <BlockSection kind="logo-strip"><div class="logos">
  {hasHead && <header class="head">
    {data.tagline && <p class="type-tagline">{data.tagline}</p>}
    {data.title && (tools ? <p class="type-body-s">{data.title}</p> : <h2 id={pageHeadingId(Astro.locals, data.title)}>{data.title}</h2>)}
    {data.intro && <p class="type-body intro">{data.intro}</p>}
  </header>}
  <ul aria-label={data.title || data.intro || 'Logotypy'} class:list={['logo-grid', { tools: data.variant === 'tools' }]}>{ordered.map((logo) => <li tabindex={safeHref(logo.url) ? undefined : 0} class:list={{ difference: inverts(logo), small: small.has(logo.name?.toLowerCase() ?? '')}}>{safeHref(logo.url) ? <a href={safeHref(logo.url)}><img src={logo.image.src} srcset={logo.image.srcset} sizes="8rem" alt={logo.image.alt || logo.name || ''} width={logo.image.width} height={logo.image.height} loading="lazy" decoding="async" /></a> : <img src={logo.image.src} srcset={logo.image.srcset} sizes="8rem" alt={logo.image.alt || logo.name || ''} width={logo.image.width} height={logo.image.height} loading="lazy" decoding="async" />}</li>)}</ul>
</div></BlockSection>}
<style>
  :is(h2, h3)[id] { scroll-margin-top: 7.5rem; }
  .logos { display: grid; gap: var(--space-l); }
  .head { display: grid; gap: var(--space-2xs); justify-items: center; max-inline-size: 48rem; margin-inline: auto; text-align: center; }
  .intro { white-space: pre-line; }
  .logo-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 8rem), 1fr)); align-items: center; gap: var(--space-s); padding: 0; margin: 0; list-style: none; }
  .logo-grid li { display: grid; place-items: center; block-size: 128px; min-inline-size: 0; }
  .logo-grid img { inline-size: 75%; block-size: auto; max-block-size: 128px; object-fit: contain; filter: grayscale(1); opacity: .65; }
  .logo-grid .difference img { filter: invert(1) grayscale(1); }
  .logo-grid .small img { max-inline-size: 40%; }
  .logo-grid a { display: grid; place-items: center; inline-size: 100%; min-block-size: 44px; border-radius: var(--radius-sm); }
  .logo-grid :is(li, a):focus-visible { outline: 2px solid var(--border-focus); outline-offset: 3px; }
  .logo-grid li:focus-visible img, .logo-grid li:has(a:focus-visible) img { filter: none; opacity: 1; }
  .logo-grid li.difference:focus-visible img, .logo-grid li.difference:has(a:focus-visible) img { filter: invert(1); }
  .logo-grid a:active { opacity: .8; }
  @media (hover: hover) and (pointer: fine) {
    .logo-grid li:hover img { filter: none; opacity: 1; }
    .logo-grid li.difference:hover img { filter: invert(1); }
  }
  @media (prefers-reduced-motion: no-preference) {
    .logo-grid img { transition: filter var(--motion-duration-base) var(--motion-easing-out), opacity var(--motion-duration-base) var(--motion-easing-out); }
  }
  @container (width < 30rem) {
    .logo-grid li { block-size: 48px; }
    .logo-grid img { max-block-size: 48px; }
  }
</style>
