---
import type { PromoCard } from '../../../../studio/sanity.types';
import type { ResolvedImage, ResolvedPage } from '../ui/block-types';
import { pageHref } from '../ui/block-types';
import BlockSection from '../ui/BlockSection.astro';
import SalesAtlasBadge from '../site/SalesAtlasBadge.astro';
import Button from '../ui/Button.astro';
import MediaImage from '../ui/MediaImage.astro';
interface Props { data: PromoCard; target?: ResolvedPage; badge?: ResolvedImage; }
const { data, target, badge } = Astro.props;
const atlas = target?.slug?.current === '/sales-atlas-system';
const href = target && target._id === data.target?._ref ? pageHref(target) : undefined;
---
<BlockSection kind="promo-card" tone="dark"><div class:list={['promo', { 'has-badge': badge || atlas, 'atlas-badge': atlas && !badge }]}>
  <div class="copy">
    {data.title && <h2>{data.title}</h2>}
    {(data.points?.length ?? 0) > 0 && <ul class:list={{ single: data.points?.length === 1 }}>{data.points?.map((point) => <li>{point}</li>)}</ul>}
    {href && <Button link={{ _type: 'link', href, label: `Zobacz ${target?.title ?? data.title ?? 'szczegóły'}` }} variant="text" />}
  </div>
  {(badge || atlas) && <div class="badge">{badge ? <MediaImage image={badge} /> : <SalesAtlasBadge />}</div>}
</div></BlockSection>
<style>
  :global(.section.promo-card.dark) { background: linear-gradient(45deg, var(--surface-dark) 50%, var(--surface-accent)); }
  .promo { display: grid; align-items: center; gap: var(--space-l); color: var(--text-on-dark); }
  .copy { display: grid; justify-items: start; gap: var(--space-m); max-inline-size: 65ch; overflow-wrap: anywhere; }
  h2 { color: var(--text-on-dark); }
  ul { display: grid; gap: var(--space-xs); padding-inline-start: 1.2em; margin: 0; }
  .promo :global(.action.text) { color: var(--text-link-on-dark); }
  .promo :global(.action.text:active) { color: var(--text-on-dark); }
  .single { list-style: none; padding-inline-start: 0; }
  .badge { inline-size: min(100%, 10rem); }
  .atlas-badge .badge { inline-size: min(12rem, 48vw); justify-self: center; }
  .atlas-badge .badge :global(.sas-beam) { inline-size: 100%; block-size: auto; aspect-ratio: 355 / 520; }
  @media (768px <= width < 992px) { .atlas-badge .badge { display: none; } }
  @media (width >= 992px) { .atlas-badge .badge { inline-size: 11.92578125rem; } }
  @container (width >= 48rem) { .has-badge { grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); } .badge { inline-size: min(100%, 18rem); justify-self: center; } }
</style>
