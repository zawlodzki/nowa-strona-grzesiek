---
import CtaBand from '../../components/blocks/CtaBand.astro';
import Faq from '../../components/blocks/Faq.astro';
import PostBody from '../../components/post/PostBody.astro';
import PostToc from '../../components/post/PostToc.astro';
import { postOutline } from '../../components/post/outline';
import SharePost from '../../components/post/SharePost.astro';
import { relatedPosts } from '../../components/post/related';
import NewsletterSignup from '../../components/blocks/NewsletterSignup.astro';
import Button from '../../components/ui/Button.astro';
import MediaImage from '../../components/ui/MediaImage.astro';
import { BLOG_PATH } from './routes.ts';
import { localHref, resolveImage, type PostDoc, type Site } from './site.ts';

interface Props { site: Site; post: PostDoc; }
const { site, post } = Astro.props;
const { links, images } = site;
const pl = post.language === 'pl';
const image = resolveImage(site, post.mainImage);
const dateLabel = (iso: string) => new Intl.DateTimeFormat(pl ? 'pl-PL' : 'en-GB', { dateStyle: 'long', timeZone: 'Europe/Warsaw' }).format(new Date(iso));
const person = site.person;
const avatar = resolveImage(site, person?.image);
const linkedIn = person?.sameAs?.find((url) => url.includes('linkedin.com'));
const related = relatedPosts(post, site.posts);
const outline = postOutline(post.body);
const contactHref = post.cta?.href ?? localHref(post.language, '/kontakt');
const faq = (post.faq ?? []).flatMap(({ _key, q, a }) => q && a?.length ? [{ _type: 'faqItem' as const, _key, question: q, answer: a }] : []);
---
<main>
  <article>
    <header class="content-grid section post-head">
      <div class="inner">
        <nav class="type-body-s crumbs" aria-label={pl ? 'Ścieżka nawigacji' : 'Breadcrumbs'}>
          <ol role="list">
            <li><a href={localHref(post.language, '/')}>{pl ? 'Strona główna' : 'Home'}</a></li>
            <li><a href={localHref(post.language, BLOG_PATH)}>Blog</a></li>
            <li><span aria-current="page">{post.title}</span></li>
          </ol>
        </nav>
        <h1>{post.title}</h1>
        <p class="type-body-s meta">
          <time datetime={post.publishedAt}>{dateLabel(post.publishedAt)}</time>
          {post.updatedAt && post.updatedAt.slice(0, 10) !== post.publishedAt.slice(0, 10) && (
            <span>{pl ? 'Aktualizacja' : 'Updated'}: <time datetime={post.updatedAt}>{dateLabel(post.updatedAt)}</time></span>
          )}
          {post.readingTime && <span>{post.readingTime} {pl ? 'min czytania' : 'min read'}</span>}
        </p>
        {image && <MediaImage image={image} eager sizes="(width < 64rem) 100vw, 58rem" />}
      </div>
    </header>
    <div class="post-layout">
      <aside class="toc-column" aria-label={pl ? 'Nawigacja artykułu' : 'Article navigation'}>
        <div class="sticky">
          <PostToc entries={outline.entries} pl={pl} />
          <SharePost title={post.title} path={localHref(post.language, post.path)} pl={pl} />
        </div>
      </aside>
      <div class="post-content"><PostBody sections={outline.sections} links={links} images={images} /></div>
      <aside class="recommendations" aria-label={pl ? 'Polecane' : 'Recommended'}>
        <div class="sticky">
          <div class="sidebar-cta">
            <h2 class="type-heading-xs">{post.cta?.label ?? (pl ? 'Porozmawiajmy o Twojej firmie' : "Let's talk about your business")}</h2>
            <Button link={{ _type: 'link', href: contactHref, label: pl ? 'Umów konsultację' : 'Book a consultation' }} />
          </div>
          {related.length > 0 && <section aria-labelledby="related-heading" data-related-posts inert aria-hidden="true">
            <h2 id="related-heading" class="type-heading-xs">{pl ? 'Sprawdź również' : 'Read also'}</h2>
            <ul role="list">{related.map((other) => <li><a href={localHref(other.language, other.path)}>{other.title}</a></li>)}</ul>
          </section>}
        </div>
      </aside>
    </div>
    {person?.name && (
      <aside class="content-grid section author-section" aria-labelledby="author-heading">
        <div class="author">
          <p id="author-heading" class="type-body-s muted">{pl ? 'O autorze' : 'About the author'}</p>
          <div class="who">
            {avatar && <img class="avatar" src={avatar.src} srcset={avatar.srcset} sizes="5rem" width={avatar.width} height={avatar.height} alt={avatar.alt || person.name} loading="lazy" decoding="async" />}
            <p><strong>{person.name}</strong>{person.jobTitle && <span>{person.jobTitle}</span>}</p>
          </div>
          {pl && <p>Wdrażam CRM, AI w sprzedaży i automatyzacje w firmach.</p>}
          <p class="links">
            <a rel="author" href={localHref(post.language, '/o-mnie')}>{pl ? 'O mnie' : 'About me'}</a>
            {linkedIn && <a rel="me noopener" target="_blank" href={linkedIn}>LinkedIn</a>}
          </p>

        </div>
      </aside>
    )}
    {(
      <CtaBand data={{ _type: 'ctaBand', heading: post.cta?.label ?? (pl ? 'Porozmawiajmy o Twojej firmie' : "Let's talk about your business"), cta: { _type: 'link', label: pl ? 'Umów konsultację' : 'Book a consultation', href: post.cta?.href ?? '/kontakt' } }} />
    )}
    {faq.length > 0 && <Faq data={{ _type: 'faq', heading: pl ? 'Najczęściej zadawane pytania' : 'Frequently asked questions', items: faq }} links={links} images={images} />}
  </article>
  {pl && <NewsletterSignup data={{ _type: 'newsletterSignup', body: 'Raz w tygodniu dostaniesz bezpłatnie, jedno gotowe rozwiązanie, jak skutecznie wykorzystać nowoczesne technologie w sprzedaży B2B.' }} />}
</main>
<style>
  main { --text-link: oklch(from #3a48cc l c h); --text-link-active: oklch(from #3a48cc l c h); --surface-accent: oklch(from #3a48cc l c h); }
  article { --post-gutter: var(--layout-gutter); --post-max: calc(var(--layout-container-max) - 2 * var(--post-gutter)); }
  .post-head .inner { display: grid; justify-items: start; gap: var(--space-m); max-inline-size: var(--measure-prose); }
  .post-head :global(figure) { justify-self: stretch; }
  .crumbs ol { display: flex; flex-wrap: wrap; gap: var(--space-3xs) var(--space-2xs); margin: 0; padding: 0; color: var(--text-muted); }
  .crumbs li { display: flex; gap: var(--space-2xs); min-inline-size: 0; }
  .crumbs li + li::before { content: "/"; color: var(--text-muted); }
  .crumbs [aria-current] { overflow-wrap: anywhere; }
  .crumbs a:active { color: var(--text-link-active); }
  .author-section { padding-block-start: 0; }
  .author {
    display: grid;
    gap: var(--space-s);
    justify-items: start;
    max-inline-size: var(--measure-prose);
    padding: var(--space-l);
    border: 1px solid var(--border-hairline);
    border-radius: var(--radius-lg);
  }
  .who { display: flex; align-items: center; gap: var(--space-s); }
  .who p { display: grid; overflow-wrap: anywhere; }
  .who strong { color: var(--text-heading); }
  .avatar { inline-size: 5rem; block-size: 5rem; flex: none; object-fit: cover; object-position: center top; padding-block-start: var(--space-2xs); border-radius: var(--radius-round); background: var(--surface-soft); }
  .links { display: flex; flex-wrap: wrap; gap: var(--space-m); }
  .author a:active { color: var(--text-link-active); }
  .muted { color: var(--text-muted); }
  .meta { display: flex; flex-wrap: wrap; column-gap: var(--space-s); row-gap: var(--space-3xs); color: var(--text-muted); }
  .post-layout { display: grid; gap: var(--space-xl); inline-size: min(100% - 2 * var(--post-gutter), var(--post-max)); margin-inline: auto; padding-block-end: var(--space-3xl); }
  .post-content { --measure-prose: 72ch; min-inline-size: 0; max-inline-size: 47.5rem; }
  .sticky { display: grid; gap: var(--space-l); }
  .toc-column, .recommendations { min-inline-size: 0; font-size: var(--font-size-body-s, 1rem); }
  .recommendations ul { list-style: none; padding: 0; margin-block: var(--space-s) 0; display: grid; gap: var(--space-xs); }
  .recommendations li a { display: block; padding-block: var(--space-3xs); text-decoration: none; }
  .post-layout a:not(:global(.action)):focus-visible { outline: 2px solid var(--text-link); outline-offset: 3px; }
  .post-layout a:not(:global(.action)):active { color: var(--text-link-active); }
  .sidebar-cta { display: grid; gap: var(--space-m); padding: var(--space-m); border-radius: var(--radius-lg); background: var(--surface-tint); }
  .recommendations li + li { border-block-start: 1px solid var(--border-hairline); padding-block-start: var(--space-xs); }
  @media (hover: hover) and (pointer: fine) { .post-layout a:not(:global(.action)):hover { text-decoration: underline; text-underline-offset: .2em; } }
  .sidebar-cta { display: none; --action-padding-inline: var(--space-2xs); }
  @media (min-width: 56rem) {
    .post-layout { grid-template-columns: 10.625rem minmax(0, 1fr); column-gap: 2.5rem; row-gap: var(--space-m); }
    .recommendations { grid-column: 2; }
    .sticky { position: sticky; inset-block-start: 7rem; padding-block: var(--space-3xs); }
  }
  .recommendations .sticky[data-page-scroll] { position: static; }
  @media (min-width: 80rem) {
    .post-content { font-size: clamp(1.125rem, 0.125rem + 1.25vw, 1.25rem); }
    .post-layout { grid-template-columns: minmax(0, 1fr) minmax(0, 47.5rem) minmax(0, 1fr); column-gap: 1.75rem; }
    .recommendations { grid-column: 3; }
    .sidebar-cta { display: grid; }
    [data-related-posts][inert] { opacity: 0; pointer-events: none; }
  }
  @media (min-width: 80rem) and (prefers-reduced-motion: no-preference) {
    [data-related-posts] { transition: opacity 240ms cubic-bezier(0.23, 1, 0.32, 1), transform 240ms cubic-bezier(0.23, 1, 0.32, 1); }
    [data-related-posts][inert] { transform: translateY(.5rem); }
  }
</style>

<script>
  // Tall recommendations use page scroll; article navigation stays sticky.
  const panels = [...document.querySelectorAll<HTMLElement>('.post-layout .recommendations .sticky')];
  const fitPanels = () => {
    for (const panel of panels) {
      const offset = parseFloat(getComputedStyle(panel).insetBlockStart) || 0;
      panel.toggleAttribute('data-page-scroll', panel.offsetHeight > innerHeight - offset - 16);
    }
  };
  const panelObserver = new ResizeObserver(fitPanels);
  panels.forEach((panel) => panelObserver.observe(panel));
  addEventListener('resize', fitPanels, { passive: true });
  fitPanels();

  const related = document.querySelector<HTMLElement>('[data-related-posts]');
  const content = document.querySelector<HTMLElement>('.post-content');
  if (related && content) {
    const wide = matchMedia('(min-width: 80rem)');
    let scheduled = false;
    const update = () => {
      scheduled = false;
      const rect = content.getBoundingClientRect();
      const visible = !wide.matches || rect.top + rect.height / 2 <= innerHeight / 2;
      related.inert = !visible;
      related.setAttribute('aria-hidden', String(!visible));
    };
    const schedule = () => {
      if (!scheduled) { scheduled = true; requestAnimationFrame(update); }
    };
    addEventListener('scroll', schedule, { passive: true });
    addEventListener('resize', schedule, { passive: true });
    new ResizeObserver(schedule).observe(content);
    document.fonts.ready.then(schedule);
    update();
  }
</script>
