---
// Post cards shared by the blog index and the related posts under each post.
import { localHref, resolveImage, type PostDoc, type Site } from './site.ts';

interface Props { site: Site; posts: PostDoc[]; headingLevel?: 'h2' | 'h3'; eager?: number; featured?: boolean; }
const { site, posts, headingLevel: Heading = 'h2', eager = 0, featured = false } = Astro.props;
---
<ul class:list={["posts", { featured }]} role="list">
  {posts.map((post, index) => {
    const image = resolveImage(site, post.thumbnail ?? post.mainImage);
    return (
      <li class:list={["card", { "featured-card": featured && index === 0 }]}>
        {image ? <img src={image.src} width={image.width} height={image.height} alt={image.alt || post.title} loading={index < eager ? 'eager' : 'lazy'} decoding="async" /> : <span class="thumb-empty" />}
        <Heading class="type-heading-xs"><a class="card-link" href={localHref(post.language, post.path)}>{post.title}</a></Heading>
        <p class="type-body-s excerpt">{post.excerpt}</p>
        <span class="type-body-s cta" aria-hidden="true">{post.language === 'pl' ? 'Czytaj więcej' : 'Read more'}</span>
      </li>
    );
  })}
</ul>
<style>
  .posts {
    display: grid;
    gap: var(--space-2xl) var(--space-l);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
    margin: 0;
    padding: 0;
  }
  .card {
    position: relative;
    display: grid;
    grid-row: span 4;
    grid-template-rows: subgrid;
    row-gap: var(--space-xs);
    align-content: start;
  }
  .card img, .thumb-empty {
    inline-size: 100%;
    block-size: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: var(--radius-md);
    background-color: var(--surface-soft);
  }
  .card :is(h2, h3) { overflow-wrap: break-word; }
  .card-link { color: var(--text-heading); text-decoration: none; }
  .card-link::after { content: ""; position: absolute; inset: 0; }
  .card-link:focus-visible { outline: 2px solid transparent; }
  .card:has(.card-link:focus-visible) { outline: 2px solid var(--border-focus); outline-offset: 4px; border-radius: var(--radius-md); }
  .card:active .card-link { color: var(--text-link-active); }
  @media (hover: hover) and (pointer: fine) {
    .card:hover .card-link { color: var(--text-link-hover); text-decoration: underline; }
  }
  .excerpt {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    overflow: hidden;
    color: var(--text-body);
  }
  .cta { color: var(--text-link); text-decoration: underline; }
  .featured-card { grid-column: 1 / -1; }
  @media (width >= 64rem) {
    .featured-card { grid-template-columns: 2fr 1fr; grid-template-rows: auto auto 1fr; grid-row: span 1; column-gap: var(--space-l); }
    .featured-card img, .featured-card .thumb-empty { grid-row: 1 / 4; }
    .featured-card :is(h2, h3) { font-size: var(--font-size-heading-m, 2rem); }
  }
</style>
