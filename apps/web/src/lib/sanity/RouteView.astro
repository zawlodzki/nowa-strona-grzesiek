---
import Base from '../../layouts/Base.astro';
import BlogIndexView from './BlogIndexView.astro';
import PostView from './PostView.astro';
import Sections from './Sections.astro';
import type { Route } from './routes.ts';
import { seoPage } from './seo.ts';
import { loadSite } from './site.ts';

interface Props { route: Route; }
const { route } = Astro.props;
const site = await loadSite();
const seo = seoPage(site, route);
const titled = route.kind === 'page' && !['hero', 'feature', 'newsletterSignup', 'contactForm'].includes(route.page.sections?.[0]?._type ?? '');
---
<Base seo={seo}>
  {route.kind === 'page' && (
    <main>
      {titled && <header class="content-grid section page-title"><h1>{route.page.title}</h1></header>}
      <Sections site={site} sections={route.page.sections ?? []} headingLevel={titled ? 'h2' : 'h1'} />
    </main>
  )}
  {route.kind === 'post' && <PostView site={site} post={route.post} />}
  {route.kind === 'blogIndex' && <BlogIndexView site={site} route={route} description={seo.kind === 'blogIndex' ? seo.blog.description : ''} />}
</Base>
<style>
  .page-title { padding-block-end: 0; }
  .page-title h1 { max-inline-size: var(--measure-prose); }
</style>
