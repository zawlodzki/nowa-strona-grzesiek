---
import { markdownPath } from '../lib/markdown.ts';
import { serializeGraph } from './graph.ts';
import { buildMeta } from './meta.ts';
import type { SeoPage } from './types.ts';

interface Props {
  page: SeoPage;
}

const { page } = Astro.props;
const meta = buildMeta(page);
---

<title>{meta.title}</title>
<meta name="description" content={meta.description} />
{meta.robots && <meta name="robots" content={meta.robots} />}
<link rel="canonical" href={meta.canonical} />
<link rel="alternate" type="text/markdown" href={new URL(markdownPath(new URL(meta.canonical).pathname), meta.canonical).href} />
{meta.alternates.map(({ hreflang, href }) => <link rel="alternate" hreflang={hreflang} href={href} />)}
{meta.properties.map(([property, content]) => <meta property={property} content={content} />)}
{meta.names.map(([name, content]) => <meta name={name} content={content} />)}
<script type="application/ld+json" set:html={serializeGraph(page)} />
